{
  "Nomor_surat": 81,
  "Nama_surat": "At-Takwir",
  "surat_arabic": "التكوير",
  "Arti_surat_in": "Menggulung",
  "Arti_surat_en": "The Overthrowing",
  "Ayat": [
    {
      "Nomor_ayat": 5801,
      "Ayat_Arabic": "اِذَا الشَّمْسُ كُوِّرَتْۖ",
      "Text_Latin": "izasy-syamsu kuwwirat",
      "Terjemah_in": "Apabila matahari digulung,",
      "Terjemahan_En": "When the sun is rolled up.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "When",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلشَّمۡسُ",
          "Arti_kata_in": "matahari",
          "Arti_kata_en": "the sun",
          "Text_Latin": "as-shamsu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كُوِّرَتۡ",
          "Arti_kata_in": "digulung",
          "Arti_kata_en": "is wrapped up",
          "Text_Latin": "kuwwirat",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5802,
      "Ayat_Arabic": "وَاِذَا النُّجُوْمُ انْكَدَرَتْۖ",
      "Text_Latin": "wa izan-nujumungkadarat",
      "Terjemah_in": "apabila bintang-bintang berjatuhan,",
      "Terjemahan_En": "When the stars are dimmed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلنُّجُومُ",
          "Arti_kata_in": "bintang-bintang",
          "Arti_kata_en": "the stars",
          "Text_Latin": "an-nujumu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱنكَدَرَتۡ",
          "Arti_kata_in": "berjatuhan",
          "Arti_kata_en": "fall losing their luster",
          "Text_Latin": "inkadarat",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5803,
      "Ayat_Arabic": "وَاِذَا الْجِبَالُ سُيِّرَتْۖ",
      "Text_Latin": "wa izal-jibalu suyyirat",
      "Terjemah_in": "apabila gunung-gunung dihancurkan,",
      "Terjemahan_En": "When the mountains are set in motion.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡجِبَالُ",
          "Arti_kata_in": "gunung-gunung",
          "Arti_kata_en": "the mountains",
          "Text_Latin": "al-jibalu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "سُيِّرَتۡ",
          "Arti_kata_in": "dijalankan/dihancurkan",
          "Arti_kata_en": "are moved away",
          "Text_Latin": "suyyirat",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5804,
      "Ayat_Arabic": "وَاِذَا الْعِشَارُ عُطِّلَتْۖ",
      "Text_Latin": "wa izal-'isyaru 'uttilat",
      "Terjemah_in": "apabila unta-unta yang bunting ditinggalkan (tidak terurus),",
      "Terjemahan_En": "When the relationships are suspended.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡعِشَارُ",
          "Arti_kata_in": "unta-unta bunting",
          "Arti_kata_en": "the full-term she-camels",
          "Text_Latin": "al-'isharu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عُطِّلَتۡ",
          "Arti_kata_in": "dibiarkan/ditinggalkan",
          "Arti_kata_en": "(are) left untended;",
          "Text_Latin": "uttilat",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5805,
      "Ayat_Arabic": "وَاِذَا الْوُحُوْشُ حُشِرَتْۖ",
      "Text_Latin": "wa izal-wuhusyu husyirat",
      "Terjemah_in": "apabila binatang-binatang liar dikumpulkan,",
      "Terjemahan_En": "When the beasts are gathered.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡوُحُوشُ",
          "Arti_kata_in": "binatang-binatang liar/buas",
          "Arti_kata_en": "the wild beasts",
          "Text_Latin": "al-wuhushu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "حُشِرَتۡ",
          "Arti_kata_in": "dikumpulkan",
          "Arti_kata_en": "are gathered",
          "Text_Latin": "hushirat",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5806,
      "Ayat_Arabic": "وَاِذَا الْبِحَارُ سُجِّرَتْۖ",
      "Text_Latin": "wa izal-biharu sujjirat",
      "Terjemah_in": "apabila lautan dipanaskan,",
      "Terjemahan_En": "When the oceans are set aflame.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡبِحَارُ",
          "Arti_kata_in": "lautan",
          "Arti_kata_en": "the seas",
          "Text_Latin": "al-biharu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "سُجِّرَتۡ",
          "Arti_kata_in": "dijadikan meluap",
          "Arti_kata_en": "are made to overflow",
          "Text_Latin": "sujjirat",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5807,
      "Ayat_Arabic": "وَاِذَا النُّفُوْسُ زُوِّجَتْۖ",
      "Text_Latin": "wa izan-nufusu zuwwijat",
      "Terjemah_in": "apabila roh-roh dipertemukan (dengan tubuh),",
      "Terjemahan_En": "When the souls are paired.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلنُّفُوسُ",
          "Arti_kata_in": "jiwa/ruh-ruh",
          "Arti_kata_en": "the souls",
          "Text_Latin": "an-nufusu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "زُوِّجَتۡ",
          "Arti_kata_in": "dijodohkan/dipertemukan",
          "Arti_kata_en": "are paired",
          "Text_Latin": "zuwwijat",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5808,
      "Ayat_Arabic": "وَاِذَا الْمَوْءٗدَةُ سُىِٕلَتْۖ",
      "Text_Latin": "wa izal-mau'udatu su'ilat",
      "Terjemah_in": "apabila bayi-bayi perempuan yang dikubur hidup-hidup ditanya,",
      "Terjemahan_En": "When the girl, buried alive, is asked:",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡمَوۡءُۥدَةُ",
          "Arti_kata_in": "bayi perempuan dikubur hidup-hidup",
          "Arti_kata_en": "the female infant buried alive",
          "Text_Latin": "al-mawudatu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "سُئِلَتۡ",
          "Arti_kata_in": "ditanya",
          "Arti_kata_en": "is asked",
          "Text_Latin": "su-ilat",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5809,
      "Ayat_Arabic": "بِاَيِّ ذَنْۢبٍ قُتِلَتْۚ",
      "Text_Latin": "bi'ayyi zambing qutilat",
      "Terjemah_in": "“Karena dosa apa dia dibunuh,”",
      "Terjemahan_En": "For what crime was she killed?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "بِأَيِّ",
          "Arti_kata_in": "karena",
          "Arti_kata_en": "For what",
          "Text_Latin": "bi-ayyi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ذَنۢبٖ",
          "Arti_kata_in": "dosa",
          "Arti_kata_en": "sin",
          "Text_Latin": "dhanbin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "قُتِلَتۡ",
          "Arti_kata_in": "ia dibunuh",
          "Arti_kata_en": "she was killed",
          "Text_Latin": "qutilat",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5810,
      "Ayat_Arabic": "وَاِذَا الصُّحُفُ نُشِرَتْۖ",
      "Text_Latin": "wa izas-suhufu nusyirat",
      "Terjemah_in": "apabila lembaran-lembaran (catatan amal) telah dibuka lebar-lebar,",
      "Terjemahan_En": "When the records are made public.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلصُّحُفُ",
          "Arti_kata_in": "lembaran-lembaran/catatan",
          "Arti_kata_en": "the pages",
          "Text_Latin": "as-suhufu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نُشِرَتۡ",
          "Arti_kata_in": "disebarkan/dibuka",
          "Arti_kata_en": "are laid open",
          "Text_Latin": "nushirat",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5811,
      "Ayat_Arabic": "وَاِذَا السَّمَاۤءُ كُشِطَتْۖ",
      "Text_Latin": "wa izas-sama'u kusyitat",
      "Terjemah_in": "apabila langit dilenyapkan,",
      "Terjemahan_En": "When the sky is peeled away.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلسَّمَآءُ",
          "Arti_kata_in": "langit",
          "Arti_kata_en": "the sky",
          "Text_Latin": "as-samau",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كُشِطَتۡ",
          "Arti_kata_in": "dibuka/tabirnya/dilenyapkan",
          "Arti_kata_en": "is stripped away",
          "Text_Latin": "kushitat",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5812,
      "Ayat_Arabic": "وَاِذَا الْجَحِيْمُ سُعِّرَتْۖ",
      "Text_Latin": "wa izal-jahimu su''irat",
      "Terjemah_in": "apabila (neraka) Jahim dinyalakan,",
      "Terjemahan_En": "When the Fire is set ablaze.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡجَحِيمُ",
          "Arti_kata_in": "neraka",
          "Arti_kata_en": "the Hellfire",
          "Text_Latin": "al-jahimu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "سُعِّرَتۡ",
          "Arti_kata_in": "dinyalakan",
          "Arti_kata_en": "is set ablaze",
          "Text_Latin": "su'irat",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5813,
      "Ayat_Arabic": "وَاِذَا الْجَنَّةُ اُزْلِفَتْۖ",
      "Text_Latin": "wa izal-jannatu uzlifat",
      "Terjemah_in": "dan apabila surga didekatkan,",
      "Terjemahan_En": "When Paradise is brought near.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡجَنَّةُ",
          "Arti_kata_in": "surga",
          "Arti_kata_en": "Paradise",
          "Text_Latin": "al-janatu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أُزۡلِفَتۡ",
          "Arti_kata_in": "didekatkan",
          "Arti_kata_en": "is brought near",
          "Text_Latin": "uz'lifat",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5814,
      "Ayat_Arabic": "عَلِمَتْ نَفْسٌ مَّآ اَحْضَرَتْۗ",
      "Text_Latin": "'alimat nafsum ma ahdarat",
      "Terjemah_in": "setiap jiwa akan mengetahui apa yang telah dikerjakannya.",
      "Terjemahan_En": "Each soul will know what it has readied.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "عَلِمَتۡ",
          "Arti_kata_in": "mengetahu",
          "Arti_kata_en": "Will know",
          "Text_Latin": "alimat",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَفۡسٞ",
          "Arti_kata_in": "diri/jiwa",
          "Arti_kata_en": "a soul",
          "Text_Latin": "nafsun",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَّآ",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَحۡضَرَتۡ",
          "Arti_kata_in": "ia sediakan/kerjakan",
          "Arti_kata_en": "it has brought",
          "Text_Latin": "ahdarat",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5815,
      "Ayat_Arabic": "فَلَآ اُقْسِمُ بِالْخُنَّسِۙ",
      "Text_Latin": "fa la uqsimu bil-khunnas",
      "Terjemah_in": "Aku bersumpah demi bintang-bintang",
      "Terjemahan_En": "I swear by the galaxies.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَلَآ",
          "Arti_kata_in": "maka sungguh",
          "Arti_kata_en": "But nay!",
          "Text_Latin": "fala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أُقۡسِمُ",
          "Arti_kata_in": "Aku bersumpah",
          "Arti_kata_en": "I swear",
          "Text_Latin": "uq'simu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلۡخُنَّسِ",
          "Arti_kata_in": "dengan bintang-bintang",
          "Arti_kata_en": "by the retreating planets",
          "Text_Latin": "bil-khunasi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5816,
      "Ayat_Arabic": "الْجَوَارِ الْكُنَّسِۙ",
      "Text_Latin": "al-jawaril-kunnas",
      "Terjemah_in": "yang beredar lagi terbenam,",
      "Terjemahan_En": "Precisely running their courses.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلۡجَوَارِ",
          "Arti_kata_in": "beredar/terbit",
          "Arti_kata_en": "Those that run",
          "Text_Latin": "al-jawari",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡكُنَّسِ",
          "Arti_kata_in": "berlindung/terbenam",
          "Arti_kata_en": "(and) disappear",
          "Text_Latin": "al-kunasi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5817,
      "Ayat_Arabic": "وَالَّيْلِ اِذَا عَسْعَسَۙ",
      "Text_Latin": "wal-laili iza 'as'as",
      "Terjemah_in": "demi malam apabila telah larut,",
      "Terjemahan_En": "And by the night as it recedes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلَّيۡلِ",
          "Arti_kata_in": "dan malam",
          "Arti_kata_en": "And the night",
          "Text_Latin": "wa-al-layli",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَسۡعَسَ",
          "Arti_kata_in": "hampir habis/pergi",
          "Arti_kata_en": "it departs",
          "Text_Latin": "as'asa",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 5818,
      "Ayat_Arabic": "وَالصُّبْحِ اِذَا تَنَفَّسَۙ",
      "Text_Latin": "was-sub-hi iza tanaffas",
      "Terjemah_in": "demi subuh apabila (fajar) telah menyingsing,",
      "Terjemahan_En": "And by the morn as it breathes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلصُّبۡحِ",
          "Arti_kata_in": "dan pagi/subuh",
          "Arti_kata_en": "And the dawn",
          "Text_Latin": "was-sub'hi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "تَنَفَّسَ",
          "Arti_kata_in": "menyingsing/mulai terang",
          "Arti_kata_en": "it breathes",
          "Text_Latin": "tanaffasa",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5819,
      "Ayat_Arabic": "اِنَّهٗ لَقَوْلُ رَسُوْلٍ كَرِيْمٍۙ",
      "Text_Latin": "innahu laqaulu rasuling karim",
      "Terjemah_in": "sesungguhnya (Al-Qur’an) itu benar-benar firman (Allah yang dibawa oleh) utusan yang mulia (Jibril)",
      "Terjemahan_En": "This is the speech of a noble messenger.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّهُۥ",
          "Arti_kata_in": "sesungguhnya ia",
          "Arti_kata_en": "Indeed it",
          "Text_Latin": "innahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَقَوۡلُ",
          "Arti_kata_in": "benar-benar firman",
          "Arti_kata_en": "(is) surely a word",
          "Text_Latin": "laqawlu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَسُولٖ",
          "Arti_kata_in": "utusan",
          "Arti_kata_en": "(of) a Messenger",
          "Text_Latin": "rasulin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "كَرِيمٖ",
          "Arti_kata_in": "mulia",
          "Arti_kata_en": "noble",
          "Text_Latin": "karimin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5820,
      "Ayat_Arabic": "ذِيْ قُوَّةٍ عِنْدَ ذِى الْعَرْشِ مَكِيْنٍۙ",
      "Text_Latin": "zi quwwatin 'inda zil-'arsyi makin",
      "Terjemah_in": "yang memiliki kekuatan dan kedudukan tinggi di sisi (Allah) yang memiliki ʻArasy,",
      "Terjemahan_En": "Endowed with power, eminent with the Lord of the Throne.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ذِي",
          "Arti_kata_in": "mempunyai",
          "Arti_kata_en": "Possessor of",
          "Text_Latin": "dhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "قُوَّةٍ",
          "Arti_kata_in": "kekuatan",
          "Arti_kata_en": "power",
          "Text_Latin": "quwwatin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عِندَ",
          "Arti_kata_in": "disisi",
          "Arti_kata_en": "with",
          "Text_Latin": "inda",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ذِي",
          "Arti_kata_in": "mempunyai",
          "Arti_kata_en": "(the) Owner of",
          "Text_Latin": "dhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡعَرۡشِ",
          "Arti_kata_in": "'Arsy'",
          "Arti_kata_en": "the Throne",
          "Text_Latin": "al-'arshi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "مَكِينٖ",
          "Arti_kata_in": "kedudukan tinggi",
          "Arti_kata_en": "secure",
          "Text_Latin": "makinin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5821,
      "Ayat_Arabic": "مُّطَاعٍ ثَمَّ اَمِيْنٍۗ",
      "Text_Latin": "muta'in samma amin",
      "Terjemah_in": "yang di sana (Jibril) ditaati lagi dipercaya.",
      "Terjemahan_En": "Obeyed and honest.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مُّطَاعٖ",
          "Arti_kata_in": "ditaati",
          "Arti_kata_en": "One to be obeyed",
          "Text_Latin": "muta'in",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ثَمَّ",
          "Arti_kata_in": "kemudian",
          "Arti_kata_en": "and",
          "Text_Latin": "thamma",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَمِينٖ",
          "Arti_kata_in": "dipercaya",
          "Arti_kata_en": "trustworthy",
          "Text_Latin": "aminin",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5822,
      "Ayat_Arabic": "وَمَا صَاحِبُكُمْ بِمَجْنُوْنٍۚ",
      "Text_Latin": "wa ma sahibukum bimajnun",
      "Terjemah_in": "Temanmu (Nabi Muhammad) itu bukanlah orang gila.",
      "Terjemahan_En": "Your friend is not possessed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَا",
          "Arti_kata_in": "dan tidak/bukanlah",
          "Arti_kata_en": "And not",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "صَاحِبُكُم",
          "Arti_kata_in": "temanmu",
          "Arti_kata_en": "(is) your companion",
          "Text_Latin": "sahibukum",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِمَجۡنُونٖ",
          "Arti_kata_in": "orang gila",
          "Arti_kata_en": "mad",
          "Text_Latin": "bimajnunin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5823,
      "Ayat_Arabic": "وَلَقَدْ رَاٰهُ بِالْاُفُقِ الْمُبِيْنِۚ",
      "Text_Latin": "wa laqad ra'ahu bil-ufuqil-mubin",
      "Terjemah_in": "Sungguh, dia (Nabi Muhammad) benar-benar telah melihatnya (Jibril) di ufuk yang terang.",
      "Terjemahan_En": "He saw him on the luminous horizon.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَقَدۡ",
          "Arti_kata_in": "dan sesungguhnya",
          "Arti_kata_en": "And certainly",
          "Text_Latin": "walaqad",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَءَاهُ",
          "Arti_kata_in": "dia telah melihat",
          "Arti_kata_en": "he saw him",
          "Text_Latin": "raahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلۡأُفُقِ",
          "Arti_kata_in": "di tepi langit/di ufuk",
          "Arti_kata_en": "in the horizon",
          "Text_Latin": "bil-ufuqi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡمُبِينِ",
          "Arti_kata_in": "nyata/terang",
          "Arti_kata_en": "the clear",
          "Text_Latin": "al-mubini",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5824,
      "Ayat_Arabic": "وَمَا هُوَ عَلَى الْغَيْبِ بِضَنِيْنٍۚ",
      "Text_Latin": "wa ma huwa 'alal-gaibi bidanin",
      "Terjemah_in": "Dia (Nabi Muhammad) bukanlah seorang yang kikir (enggan) untuk menerangkan yang gaib.",
      "Terjemahan_En": "And He does not withhold knowledge of the Unseen.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And not",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُوَ",
          "Arti_kata_in": "dia",
          "Arti_kata_en": "he (is)",
          "Text_Latin": "huwa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَى",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "on",
          "Text_Latin": "ala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡغَيۡبِ",
          "Arti_kata_in": "gaib",
          "Arti_kata_en": "the unseen",
          "Text_Latin": "al-ghaybi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "بِضَنِينٖ",
          "Arti_kata_in": "dengan kikir",
          "Arti_kata_en": "a withholder",
          "Text_Latin": "bidaninin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5825,
      "Ayat_Arabic": "وَمَا هُوَ بِقَوْلِ شَيْطٰنٍ رَّجِيْمٍۚ",
      "Text_Latin": "wa ma huwa biqauli syaitanir rajim",
      "Terjemah_in": "(Al-Qur’an) itu bukanlah perkataan setan yang terkutuk.",
      "Terjemahan_En": "And it is not the word of an accursed devil.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And not",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُوَ",
          "Arti_kata_in": "ia",
          "Arti_kata_en": "it",
          "Text_Latin": "huwa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِقَوۡلِ",
          "Arti_kata_in": "perkataan",
          "Arti_kata_en": "(is the) word",
          "Text_Latin": "biqawli",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "شَيۡطَٰنٖ",
          "Arti_kata_in": "syaitan",
          "Arti_kata_en": "(of) Shaitaan",
          "Text_Latin": "shaytanin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "رَّجِيمٖ",
          "Arti_kata_in": "terkutuk",
          "Arti_kata_en": "accursed",
          "Text_Latin": "rajimin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5826,
      "Ayat_Arabic": "فَاَيْنَ تَذْهَبُوْنَۗ",
      "Text_Latin": "fa aina taz-habun",
      "Terjemah_in": "Maka, ke manakah kamu akan pergi?747)",
      "Terjemahan_En": "So where are you heading?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَيۡنَ",
          "Arti_kata_in": "maka kemana",
          "Arti_kata_en": "So where",
          "Text_Latin": "fa-ayna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تَذۡهَبُونَ",
          "Arti_kata_in": "kamu pergi",
          "Arti_kata_en": "are you going",
          "Text_Latin": "tadhhabuna",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5827,
      "Ayat_Arabic": "اِنْ هُوَ اِلَّا ذِكْرٌ لِّلْعٰلَمِيْنَۙ",
      "Text_Latin": "in huwa illa zikrul lil-'alamin",
      "Terjemah_in": "(Al-Qur’an) itu tidak lain, kecuali peringatan bagi semesta alam,",
      "Terjemahan_En": "It is only a Reminder to all mankind.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنۡ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Not",
          "Text_Latin": "in",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُوَ",
          "Arti_kata_in": "ia",
          "Arti_kata_en": "it",
          "Text_Latin": "huwa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "إِلَّا",
          "Arti_kata_in": "kecuali",
          "Arti_kata_en": "(is) except",
          "Text_Latin": "illa",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ذِكۡرٞ",
          "Arti_kata_in": "peringatan",
          "Arti_kata_en": "a reminder",
          "Text_Latin": "dhik'run",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "لِّلۡعَٰلَمِينَ",
          "Arti_kata_in": "bagi semesta alam",
          "Arti_kata_en": "to the worlds",
          "Text_Latin": "lil'alamina",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 5828,
      "Ayat_Arabic": "لِمَنْ شَاۤءَ مِنْكُمْ اَنْ يَّسْتَقِيْمَۗ",
      "Text_Latin": "liman sya'a mingkum ay yastaqim",
      "Terjemah_in": "(yaitu) bagi siapa di antaramu yang hendak menempuh jalan yang lurus.",
      "Terjemahan_En": "To whoever of you wills to go straight.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لِمَن",
          "Arti_kata_in": "bagi siapa",
          "Arti_kata_en": "For whoever",
          "Text_Latin": "liman",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَآءَ",
          "Arti_kata_in": "menghendaki",
          "Arti_kata_en": "wills",
          "Text_Latin": "shaa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مِنكُمۡ",
          "Arti_kata_in": "diantara kamu",
          "Arti_kata_en": "among you",
          "Text_Latin": "minkum",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَن",
          "Arti_kata_in": "untuk",
          "Arti_kata_en": "to",
          "Text_Latin": "an",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "يَسۡتَقِيمَ",
          "Arti_kata_in": "menempuh jalan yang lurus",
          "Arti_kata_en": "take a straight way",
          "Text_Latin": "yastaqima",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5829,
      "Ayat_Arabic": "وَمَا تَشَاۤءُوْنَ اِلَّآ اَنْ يَّشَاۤءَ اللّٰهُ رَبُّ الْعٰلَمِيْنَ ࣖ",
      "Text_Latin": "wa ma tasya'una illa ay yasya'allahu rabbul-'alamin",
      "Terjemah_in": "Kamu tidak dapat berkehendak, kecuali apabila dikehendaki Allah, Tuhan semesta alam.",
      "Terjemahan_En": "But you cannot will, unless God wills—The Lord of the Worlds.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And not",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تَشَآءُونَ",
          "Arti_kata_in": "kamu menghendaki",
          "Arti_kata_en": "you will",
          "Text_Latin": "tashauna",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "إِلَّآ",
          "Arti_kata_in": "kecuali",
          "Arti_kata_en": "except",
          "Text_Latin": "illa",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَن",
          "Arti_kata_in": "bahwa",
          "Arti_kata_en": "that",
          "Text_Latin": "an",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "يَشَآءَ",
          "Arti_kata_in": "menghendaki",
          "Arti_kata_en": "wills",
          "Text_Latin": "yashaa",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "ٱللَّهُ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "Allah",
          "Text_Latin": "al-lahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "رَبُّ",
          "Arti_kata_in": "Tuhan/Pemelihara",
          "Arti_kata_en": "Lord",
          "Text_Latin": "rabbu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "ٱلۡعَٰلَمِينَ",
          "Arti_kata_in": "semesta alam",
          "Arti_kata_en": "(of) the worlds",
          "Text_Latin": "al-'alamina",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    }
  ]
}