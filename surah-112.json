          "Arti_kata_en": "is",
          "Text_Latin": "yakun",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَّهُۥ",
          "Arti_kata_in": "baginya",
          "Arti_kata_en": "for Him",
          "Text_Latin": "lahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "كُفُوًا",
          "Arti_kata_in": "menyamai/setara",
          "Arti_kata_en": "equivalent",
          "Text_Latin": "kufuwan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَحَدُۢ",
          "Arti_kata_in": "seorang",
          "Arti_kata_en": "any [one]",
