  "surat_arabic": "الإخلاص",
  "Arti_surat_in": "Ikhlas",
  "Arti_surat_en": "The Sincerity",
  "Ayat": [
    {
      "Nomor_ayat": 6222,
      "Ayat_Arabic": "قُلْ هُوَ اللّٰهُ اَحَدٌۚ",
      "Text_Latin": "qul huwallahu ahad",
      "Terjemah_in": "Katakanlah (Nabi Muhammad), “Dialah Allah Yang Maha Esa.",
      "Terjemahan_En": "Say, “He is God, the One.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قُلۡ",
          "Arti_kata_in": "katakanlah",
          "Arti_kata_en": "Say",
          "Text_Latin": "qul",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُوَ",
          "Arti_kata_in": "Dia",
          "Arti_kata_en": "He",
          "Text_Latin": "huwa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱللَّهُ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "(is) Allah",
          "Text_Latin": "al-lahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَحَدٌ",
          "Arti_kata_in": "Esa",
          "Arti_kata_en": "the One",
          "Text_Latin": "ahadun",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6223,
      "Ayat_Arabic": "اَللّٰهُ الصَّمَدُۚ",
      "Text_Latin": "allahus-samad",
      "Terjemah_in": "Allah tempat meminta segala sesuatu.",
      "Terjemahan_En": "God, the Absolute.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱللَّهُ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "Allah",
          "Text_Latin": "al-lahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلصَّمَدُ",
          "Arti_kata_in": "tempat bergantung",
          "Arti_kata_en": "the Eternal the Absolute",
          "Text_Latin": "as-samadu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6224,
      "Ayat_Arabic": "لَمْ يَلِدْ وَلَمْ يُوْلَدْۙ",
      "Text_Latin": "lam yalid wa lam yulad",
      "Terjemah_in": "Dia tidak beranak dan tidak pula diperanakkan",
      "Terjemahan_En": "He begets not, nor was He begotten.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَمۡ",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "Not",
          "Text_Latin": "lam",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَلِدۡ",
          "Arti_kata_in": "beranak",
          "Arti_kata_en": "He begets",
          "Text_Latin": "yalid",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَلَمۡ",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "and not",
          "Text_Latin": "walam",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يُولَدۡ",
          "Arti_kata_in": "diperanakkan",
          "Arti_kata_en": "He is begotten",
          "Text_Latin": "yulad",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6225,
      "Ayat_Arabic": "وَلَمْ يَكُنْ لَّهٗ كُفُوًا اَحَدٌ ࣖ",
      "Text_Latin": "wa lam yakul lahu kufuwan ahad",
      "Terjemah_in": "serta tidak ada sesuatu pun yang setara dengan-Nya.”",
      "Terjemahan_En": "And there is nothing comparable to Him.”",
