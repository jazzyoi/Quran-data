{
  "Nomor_surat": 113,
  "Nama_surat": "Al-Falaq",
  "surat_arabic": "الفلق",
  "Arti_surat_in": "Waktu Subuh",
  "Arti_surat_en": "The Daybreak",
  "Ayat": [
    {
      "Nomor_ayat": 6226,
      "Ayat_Arabic": "قُلْ اَعُوْذُ بِرَبِّ الْفَلَقِۙ",
      "Text_Latin": "qul a'uzu birabbil-falaq",
      "Terjemah_in": "Katakanlah (Nabi Muhammad), “Aku berlindung kepada Tuhan yang (menjaga) fajar (subuh)",
      "Terjemahan_En": "Say, “I take refuge with the Lord of Daybreak.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قُلۡ",
          "Arti_kata_in": "katakanlah",
          "Arti_kata_en": "Say",
          "Text_Latin": "qul",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَعُوذُ",
          "Arti_kata_in": "aku berlindung",
          "Arti_kata_en": "I seek refuge",
          "Text_Latin": "a'udhu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِرَبِّ",
          "Arti_kata_in": "Tuhan/Pemelihara",
          "Arti_kata_en": "in (the) Lord",
          "Text_Latin": "birabbi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡفَلَقِ",
          "Arti_kata_in": "subuh",
          "Arti_kata_en": "(of) the dawn",
          "Text_Latin": "al-falaqi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6227,
      "Ayat_Arabic": "مِنْ شَرِّ مَا خَلَقَۙ",
      "Text_Latin": "min syarri ma khalaq",
      "Terjemah_in": "dari kejahatan (makhluk yang) Dia ciptakan,",
      "Terjemahan_En": "From the evil of what He created.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مِن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "From",
          "Text_Latin": "min",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَرِّ",
          "Arti_kata_in": "kejahatan",
          "Arti_kata_en": "(the) evil",
          "Text_Latin": "sharri",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "(of) what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "خَلَقَ",
          "Arti_kata_in": "Dia ciptakan",
          "Arti_kata_en": "He created",
          "Text_Latin": "khalaqa",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6228,
      "Ayat_Arabic": "وَمِنْ شَرِّ غَاسِقٍ اِذَا وَقَبَۙ",
      "Text_Latin": "wa min syarri gasiqin iza waqab",
      "Terjemah_in": "dari kejahatan malam apabila telah gelap gulita,",
      "Terjemahan_En": "And from the evil of the darkness as it gathers.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمِن",
          "Arti_kata_in": "dan dari",
          "Arti_kata_en": "And from",
          "Text_Latin": "wamin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَرِّ",
          "Arti_kata_in": "kejahatan",
          "Arti_kata_en": "(the) evil",
          "Text_Latin": "sharri",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "غَاسِقٍ",
          "Arti_kata_in": "malam yang gelap",
          "Arti_kata_en": "(of) darkness",
          "Text_Latin": "ghasiqin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَقَبَ",
          "Arti_kata_in": "telah gelap/kelam",
          "Arti_kata_en": "it settles",
          "Text_Latin": "waqaba",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6229,
      "Ayat_Arabic": "وَمِنْ شَرِّ النَّفّٰثٰتِ فِى الْعُقَدِۙ",
      "Text_Latin": "wa min syarrin-naffasati fil-'uqad",
      "Terjemah_in": "dari kejahatan perempuan-perempuan (penyihir) yang meniup pada buhul-buhul (talinya),",
      "Terjemahan_En": "And from the evil of those who practice sorcery.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمِن",
          "Arti_kata_in": "dan dari",
          "Arti_kata_en": "And from",
          "Text_Latin": "wamin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَرِّ",
          "Arti_kata_in": "kejahatan",
          "Arti_kata_en": "(the) evil",
          "Text_Latin": "sharri",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلنَّفَّٰثَٰتِ",
          "Arti_kata_in": "orang yang meniup-niup",
          "Arti_kata_en": "(of) the blowers",
          "Text_Latin": "an-nafathati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡعُقَدِ",
          "Arti_kata_in": "ikatan/simpul",
          "Arti_kata_en": "the knots",
          "Text_Latin": "al-'uqadi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6230,
      "Ayat_Arabic": "وَمِنْ شَرِّ حَاسِدٍ اِذَا حَسَدَ ࣖ",
      "Text_Latin": "wa min syarri hasidin iza hasad",
      "Terjemah_in": "dan dari kejahatan orang yang dengki apabila dia dengki.”",
      "Terjemahan_En": "And from the evil of an envious when he envies.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمِن",
          "Arti_kata_in": "dan dari",
          "Arti_kata_en": "And from",
          "Text_Latin": "wamin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَرِّ",
          "Arti_kata_in": "kejahatan",
          "Arti_kata_en": "(the) evil",
          "Text_Latin": "sharri",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "حَاسِدٍ",
          "Arti_kata_in": "orang yang dengki",
          "Arti_kata_en": "(of) an envier",
          "Text_Latin": "hasidin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "حَسَدَ",
          "Arti_kata_in": "ia dengki",
          "Arti_kata_en": "he envies",
          "Text_Latin": "hasada",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    }
  ]
}