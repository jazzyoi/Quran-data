{
  "Nomor_surat": 113,
  "Nama_surat": "Al-Falaq",
  "surat_arabic": "الفلق",
  "Arti_surat_in": "Waktu Subuh",
  "Arti_surat_en": "The Daybreak",
  "Ayat": [
    {
      "Nomor_ayat": 6226,
      "Ayat_Arabic": "قُلْ اَعُوْذُ بِرَبِّ الْفَلَقِۙ",
      "Text_Latin": "qul a'uzu birabbil-falaq",
      "Terjemah_in": "Katakanlah (Nabi Muhammad), “Aku berlindung kepada Tuhan yang (menjaga) fajar (subuh)",
      "Terjemahan_En": "Say, “I take refuge with the Lord of Daybreak.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قُلۡ",
          "Arti_kata": "katakanlah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَعُوذُ",
          "Arti_kata": "aku berlindung",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِرَبِّ",
          "Arti_kata": "Tuhan/Pemelihara",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡفَلَقِ",
          "Arti_kata": "subuh",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6227,
      "Ayat_Arabic": "مِنْ شَرِّ مَا خَلَقَۙ",
      "Text_Latin": "min syarri ma khalaq",
      "Terjemah_in": "dari kejahatan (makhluk yang) Dia ciptakan,",
      "Terjemahan_En": "From the evil of what He created.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مِن",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَرِّ",
          "Arti_kata": "kejahatan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata": "apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "خَلَقَ",
          "Arti_kata": "Dia ciptakan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6228,
      "Ayat_Arabic": "وَمِنْ شَرِّ غَاسِقٍ اِذَا وَقَبَۙ",
      "Text_Latin": "wa min syarri gasiqin iza waqab",
      "Terjemah_in": "dari kejahatan malam apabila telah gelap gulita,",
      "Terjemahan_En": "And from the evil of the darkness as it gathers.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمِن",
          "Arti_kata": "dan dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَرِّ",
          "Arti_kata": "kejahatan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "غَاسِقٍ",
          "Arti_kata": "malam yang gelap",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "إِذَا",
          "Arti_kata": "apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَقَبَ",
          "Arti_kata": "telah gelap/kelam",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6229,
      "Ayat_Arabic": "وَمِنْ شَرِّ النَّفّٰثٰتِ فِى الْعُقَدِۙ",
      "Text_Latin": "wa min syarrin-naffasati fil-'uqad",
      "Terjemah_in": "dari kejahatan perempuan-perempuan (penyihir) yang meniup pada buhul-buhul (talinya),",
      "Terjemahan_En": "And from the evil of those who practice sorcery.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمِن",
          "Arti_kata": "dan dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَرِّ",
          "Arti_kata": "kejahatan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلنَّفَّٰثَٰتِ",
          "Arti_kata": "orang yang meniup-niup",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فِي",
          "Arti_kata": "dalam",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡعُقَدِ",
          "Arti_kata": "ikatan/simpul",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6230,
      "Ayat_Arabic": "وَمِنْ شَرِّ حَاسِدٍ اِذَا حَسَدَ ࣖ",
      "Text_Latin": "wa min syarri hasidin iza hasad",
      "Terjemah_in": "dan dari kejahatan orang yang dengki apabila dia dengki.”",
      "Terjemahan_En": "And from the evil of an envious when he envies.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمِن",
          "Arti_kata": "dan dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَرِّ",
          "Arti_kata": "kejahatan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "حَاسِدٍ",
          "Arti_kata": "orang yang dengki",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "إِذَا",
          "Arti_kata": "apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "حَسَدَ",
          "Arti_kata": "ia dengki",
          "Jenis_kata": null
        }
      ]
    }
  ]
}