{
  "Nomor_surat": 95,
  "Nama_surat": "At-Tin",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Ayat_arabic ": "وَالتِّيْنِ وَالزَّيْتُوْنِۙ",
      "Ayat_latin": "wat-tini waz-zaitun",
      "Terjemah_in": "Demi (buah) tin dan (buah) zaitun,",
      "Terjemah_en": "By the fig and the olive.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَٱلتِّينِ",
          "Arti_kata_in": "demi tin",
          "Arti_kata_en": "By the fig",
          "Text_latin  ": "wat-tini"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "وَٱلزَّيۡتُونِ",
          "Arti_kata_in": "dan zaitun",
          "Arti_kata_en": "and the olive",
          "Text_latin  ": "waz-zaytuni"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Ayat_arabic ": "وَطُوْرِ سِيْنِيْنَۙ",
      "Ayat_latin": "wa turi sinin",
      "Terjemah_in": "demi gunung Sinai,",
      "Terjemah_en": "And Mount Sinai.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَطُورِ",
          "Arti_kata_in": "dan bukit",
          "Arti_kata_en": "And (the) Mount",
          "Text_latin  ": "waturi"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "سِينِينَ",
          "Arti_kata_in": "Sinai",
          "Arti_kata_en": "Sinai",
          "Text_latin  ": "sinina"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Ayat_arabic ": "وَهٰذَا الْبَلَدِ الْاَمِيْنِۙ",
      "Ayat_latin": "wa hazal-baladil-amin",
      "Terjemah_in": "dan demi negeri (Makkah) yang aman ini,",
      "Terjemah_en": "And this safe land.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَهَٰذَا",
          "Arti_kata_in": "dan ini",
          "Arti_kata_en": "And this",
          "Text_latin  ": "wahadha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلۡبَلَدِ",
          "Arti_kata_in": "negri",
          "Arti_kata_en": "[the] city",
          "Text_latin  ": "al-baladi"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلۡأَمِينِ",
          "Arti_kata_in": "aman",
          "Arti_kata_en": "[the] secure",
          "Text_latin  ": "al-amini"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Ayat_arabic ": "لَقَدْ خَلَقْنَا الْاِنْسَانَ فِيْٓ اَحْسَنِ تَقْوِيْمٍۖ",
      "Ayat_latin": "laqad khalaqnal-insana fi ahsani taqwim",
      "Terjemah_in": "sungguh, Kami benar-benar telah menciptakan manusia dalam bentuk yang sebaik-baiknya.",
      "Terjemah_en": "We created man in the best design.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "لَقَدۡ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_latin  ": "laqad"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "خَلَقۡنَا",
          "Arti_kata_in": "Kami telah menciptakan",
          "Arti_kata_en": "We created",
          "Text_latin  ": "khalaqna"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "man",
          "Text_latin  ": "al-insana"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "فِيٓ",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "in",
          "Text_latin  ": "fi"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "أَحۡسَنِ",
          "Arti_kata_in": "sebaik-baik",
          "Arti_kata_en": "(the) best",
          "Text_latin  ": "ahsani"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "تَقۡوِيمٖ",
          "Arti_kata_in": "bentuk",
          "Arti_kata_en": "mould",
          "Text_latin  ": "taqwimin"
        }
      ]
    },
    {
      "Nomor_ayat": 5,
      "Ayat_arabic ": "ثُمَّ رَدَدْنٰهُ اَسْفَلَ سٰفِلِيْنَۙ",
      "Ayat_latin": "summa radadnahu asfala safilin",
      "Terjemah_in": "Kemudian, kami kembalikan dia ke tempat yang serendah-rendahnya,",
      "Terjemah_en": "Then reduced him to the lowest of the low.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ثُمَّ",
          "Arti_kata_in": "kemudian",
          "Arti_kata_en": "Then",
          "Text_latin  ": "thumma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "رَدَدۡنَٰهُ",
          "Arti_kata_in": "Kami kembalikan",
          "Arti_kata_en": "We return him",
          "Text_latin  ": "radadnahu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "أَسۡفَلَ",
          "Arti_kata_in": "lebih rendah/paling rendah",
          "Arti_kata_en": "(to the) lowest",
          "Text_latin  ": "asfala"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "سَٰفِلِينَ",
          "Arti_kata_in": "tempat yang rendah",
          "Arti_kata_en": "(of the) low",
          "Text_latin  ": "safilina"
        }
      ]
    },
    {
      "Nomor_ayat": 6,
      "Ayat_arabic ": "اِلَّا الَّذِيْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِ فَلَهُمْ اَجْرٌ غَيْرُ مَمْنُوْنٍۗ",
      "Ayat_latin": "illallazina amanu wa 'amilus-salihati fa lahum ajrun gairu mamnun",
      "Terjemah_in": "kecuali orang-orang yang beriman dan mengerjakan kebajikan. Maka, mereka akan mendapat pahala yang tidak putus-putusnya.",
      "Terjemah_en": "Except those who believe and do righteous deeds; for them is a reward without end.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "إِلَّا",
          "Arti_kata_in": "kecuali",
          "Arti_kata_en": "Except",
          "Text_latin  ": "illa"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "those who",
          "Text_latin  ": "alladhina"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ءَامَنُواْ",
          "Arti_kata_in": "beriman",
          "Arti_kata_en": "believe",
          "Text_latin  ": "amanu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "وَعَمِلُواْ",
          "Arti_kata_in": "dan mereka berbuat/beramal",
          "Arti_kata_en": "and do",
          "Text_latin  ": "wa'amilu"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "ٱلصَّٰلِحَٰتِ",
          "Arti_kata_in": "kebajikan/saleh",
          "Arti_kata_en": "righteous deeds",
          "Text_latin  ": "as-salihati"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "فَلَهُمۡ",
          "Arti_kata_in": "maka bagi mereka",
          "Arti_kata_en": "then for them",
          "Text_latin  ": "falahum"
        },
        {
          "Nomor_kata": 7,
          "Kata_arabic": "أَجۡرٌ",
          "Arti_kata_in": "pahala",
          "Arti_kata_en": "(is a) reward",
          "Text_latin  ": "ajrun"
        },
        {
          "Nomor_kata": 8,
          "Kata_arabic": "غَيۡرُ",
          "Arti_kata_in": "bukan/tidak",
          "Arti_kata_en": "never",
          "Text_latin  ": "ghayru"
        },
        {
          "Nomor_kata": 9,
          "Kata_arabic": "مَمۡنُونٖ",
          "Arti_kata_in": "terputus",
          "Arti_kata_en": "ending",
          "Text_latin  ": "mamnunin"
        }
      ]
    },
    {
      "Nomor_ayat": 7,
      "Ayat_arabic ": "فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّيْنِۗ",
      "Ayat_latin": "fa ma yukazzibuka ba'du bid-din",
      "Terjemah_in": "Maka, apa alasanmu (wahai orang kafir) mendustakan hari Pembalasan setelah (adanya bukti-bukti) itu?",
      "Terjemah_en": "So why do you still reject the religion?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَمَا",
          "Arti_kata_in": "maka apakah",
          "Arti_kata_en": "Then what",
          "Text_latin  ": "fama"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يُكَذِّبُكَ",
          "Arti_kata_in": "mendustakanmu",
          "Arti_kata_en": "causes you to deny",
          "Text_latin  ": "yukadhibuka"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "بَعۡدُ",
          "Arti_kata_in": "sesudah",
          "Arti_kata_en": "after (this)",
          "Text_latin  ": "ba'du"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "بِٱلدِّينِ",
          "Arti_kata_in": "hari pembalasan/agama",
          "Arti_kata_en": "the judgment",
          "Text_latin  ": "bil-dini"
        }
      ]
    },
    {
      "Nomor_ayat": 8,
      "Ayat_arabic ": "اَلَيْسَ اللّٰهُ بِاَحْكَمِ الْحٰكِمِيْنَ ࣖ",
      "Ayat_latin": "a laisallahu bi'ahkamil-hakimin",
      "Terjemah_in": "Bukankah Allah hakim yang paling adil?",
      "Terjemah_en": "Is God not the Wisest of the wise?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَلَيۡسَ",
          "Arti_kata_in": "bukankah",
          "Arti_kata_en": "Is not",
          "Text_latin  ": "alaysa"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱللَّهُ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "Allah",
          "Text_latin  ": "al-lahu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "بِأَحۡكَمِ",
          "Arti_kata_in": "lebih bijaksana/seadil-adilnya",
          "Arti_kata_en": "(the) Most Just",
          "Text_latin  ": "bi-ahkami"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلۡحَٰكِمِينَ",
          "Arti_kata_in": "para hakim",
          "Arti_kata_en": "(of) the Judges",
          "Text_latin  ": "al-hakimina"
        }
      ]
    }
  ]
}