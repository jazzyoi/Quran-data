{
  "Nomor_surat": 110,
  "Nama_surat": "An-Nashr",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "When",
          "Text_Latin": "idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "جَآءَ",
          "Arti_kata_in": "datang",
          "Arti_kata_en": "comes",
          "Text_Latin": "jaa"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نَصۡرُ",
          "Arti_kata_in": "pertolongan",
          "Arti_kata_en": "(the) Help",
          "Text_Latin": "nasru"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱللَّهِ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "(of) Allah",
          "Text_Latin": "al-lahi"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَٱلۡفَتۡحُ",
          "Arti_kata_in": "dan kemenangan",
          "Arti_kata_en": "and the Victory",
          "Text_Latin": "wal-fathu"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَرَأَيۡتَ",
          "Arti_kata_in": "dan kamu lihat",
          "Arti_kata_en": "And you see",
          "Text_Latin": "wara-ayta"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلنَّاسَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "the people",
          "Text_Latin": "an-nasa"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَدۡخُلُونَ",
          "Arti_kata_in": "masuk",
          "Arti_kata_en": "entering",
          "Text_Latin": "yadkhuluna"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "kedalam",
          "Arti_kata_en": "into",
          "Text_Latin": "fi"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "دِينِ",
          "Arti_kata_in": "agama",
          "Arti_kata_en": "(the) religion",
          "Text_Latin": "dini"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "ٱللَّهِ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "(of) Allah",
          "Text_Latin": "al-lahi"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "أَفۡوَاجٗا",
          "Arti_kata_in": "berbondong-bondong",
          "Arti_kata_en": "(in) multitudes",
          "Text_Latin": "afwajan"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَسَبِّحۡ",
          "Arti_kata_in": "maka bertasbihlah",
          "Arti_kata_en": "Then glorify",
          "Text_Latin": "fasabbih"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بِحَمۡدِ",
          "Arti_kata_in": "dengan memuji",
          "Arti_kata_en": "(the) praises",
          "Text_Latin": "bihamdi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "(of) your Lord",
          "Text_Latin": "rabbika"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَٱسۡتَغۡفِرۡهُۚ",
          "Arti_kata_in": "dan mohonlah ampun",
          "Arti_kata_en": "and ask His forgiveness",
          "Text_Latin": "wa-is'taghfir'hu"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "إِنَّهُۥ",
          "Arti_kata_in": "sesungguhnya Dia",
          "Arti_kata_en": "Indeed He",
          "Text_Latin": "innahu"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "كَانَ",
          "Arti_kata_in": "adalah Dia",
          "Arti_kata_en": "is",
          "Text_Latin": "kana"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "تَوَّابَۢا",
          "Arti_kata_in": "Maha Penerima Taubat",
          "Arti_kata_en": "Oft-Returning",
          "Text_Latin": "tawwaban"
        }
      ]
    }
  ]
}