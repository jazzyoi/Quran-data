{
  "Nomor_surat": 80,
  "Nama_surat": "'Abasa",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Ayat_arabic ": "عَبَسَ وَتَوَلّٰىٓۙ",
      "Ayat_latin": "'abasa wa tawalla",
      "Terjemah_in": "Dia (Nabi Muhammad) berwajah masam dan berpaling",
      "Terjemah_en": "He frowned and turned away.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "عَبَسَ",
          "Arti_kata_in": "dia bermuka masam",
          "Arti_kata_en": "He frowned",
          "Text_latin  ": "abasa"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "وَتَوَلَّىٰٓ",
          "Arti_kata_in": "dan dia berpaling",
          "Arti_kata_en": "and turned away",
          "Text_latin  ": "watawalla"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Ayat_arabic ": "اَنْ جَاۤءَهُ الْاَعْمٰىۗ",
      "Ayat_latin": "an ja'ahul-a'ma",
      "Terjemah_in": "karena seorang tunanetra (Abdullah bin Ummi Maktum) telah datang kepadanya.",
      "Terjemah_en": "When the blind man approached him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَن",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Because",
          "Text_latin  ": "an"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "جَآءَهُ",
          "Arti_kata_in": "datang kepadanya",
          "Arti_kata_en": "came to him",
          "Text_latin  ": "jaahu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلۡأَعۡمَىٰ",
          "Arti_kata_in": "seorang buta",
          "Arti_kata_en": "the blind man",
          "Text_latin  ": "al-a'ma"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Ayat_arabic ": "وَمَا يُدْرِيْكَ لَعَلَّهٗ يَزَّكّٰىٓۙ",
      "Ayat_latin": "wa ma yudrika la'allahu yazzakka",
      "Terjemah_in": "Tahukah engkau (Nabi Muhammad) boleh jadi dia ingin menyucikan dirinya (dari dosa)",
      "Terjemah_en": "But how do you know? Perhaps he was seeking to purify himself.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَمَا",
          "Arti_kata_in": "dan apakah",
          "Arti_kata_en": "But what",
          "Text_latin  ": "wama"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يُدۡرِيكَ",
          "Arti_kata_in": "tahukah kamu",
          "Arti_kata_en": "would make you know",
          "Text_latin  ": "yud'rika"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "لَعَلَّهُۥ",
          "Arti_kata_in": "barangkali dia",
          "Arti_kata_en": "that he might",
          "Text_latin  ": "la'allahu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "يَزَّكَّىٰٓ",
          "Arti_kata_in": "ia membersihkan diri",
          "Arti_kata_en": "purify himself",
          "Text_latin  ": "yazzakka"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Ayat_arabic ": "اَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰىۗ",
      "Ayat_latin": "au yazzakkaru fa tanfa'ahuz-zikra",
      "Terjemah_in": "atau dia (ingin) mendapatkan pengajaran sehingga pengajaran itu bermanfaat baginya?",
      "Terjemah_en": "Or be reminded, and the message would benefit him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَوۡ",
          "Arti_kata_in": "atau",
          "Arti_kata_en": "Or",
          "Text_latin  ": "aw"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَذَّكَّرُ",
          "Arti_kata_in": "ia mendapatkan pengajaran",
          "Arti_kata_en": "be reminded",
          "Text_latin  ": "yadhakkaru"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "فَتَنفَعَهُ",
          "Arti_kata_in": "lalu memberi manfaat kepadanya",
          "Arti_kata_en": "so would benefit him",
          "Text_latin  ": "fatanfa'ahu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلذِّكۡرَىٰٓ",
          "Arti_kata_in": "pengajaran",
          "Arti_kata_en": "the reminder",
          "Text_latin  ": "ad-dhik'ra"
        }
      ]
    },
    {
      "Nomor_ayat": 5,
      "Ayat_arabic ": "اَمَّا مَنِ اسْتَغْنٰىۙ",
      "Ayat_latin": "amma manistagna",
      "Terjemah_in": "Adapun orang yang merasa dirinya serba cukup (para pembesar Quraisy),",
      "Terjemah_en": "But as for him who was indifferent.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَمَّا",
          "Arti_kata_in": "adapun",
          "Arti_kata_en": "As for",
          "Text_latin  ": "amma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مَنِ",
          "Arti_kata_in": "siapa",
          "Arti_kata_en": "(him) who",
          "Text_latin  ": "mani"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱسۡتَغۡنَىٰ",
          "Arti_kata_in": "merasa kaya/cukup",
          "Arti_kata_en": "considers himself free from need",
          "Text_latin  ": "is'taghna"
        }
      ]
    },
    {
      "Nomor_ayat": 6,
      "Ayat_arabic ": "فَاَنْتَ لَهٗ تَصَدّٰىۗ",
      "Ayat_latin": "fa anta lahu tasadda",
      "Terjemah_in": "engkau (Nabi Muhammad) memberi perhatian kepadanya.",
      "Terjemah_en": "You gave him your attention.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَأَنتَ",
          "Arti_kata_in": "maka kamu",
          "Arti_kata_en": "So you",
          "Text_latin  ": "fa-anta"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "لَهُۥ",
          "Arti_kata_in": "kepadanya",
          "Arti_kata_en": "to him",
          "Text_latin  ": "lahu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "تَصَدَّىٰ",
          "Arti_kata_in": "menghadapi/layani",
          "Arti_kata_en": "give attention",
          "Text_latin  ": "tasadda"
        }
      ]
    },
    {
      "Nomor_ayat": 7,
      "Ayat_arabic ": "وَمَا عَلَيْكَ اَلَّا يَزَّكّٰىۗ",
      "Ayat_latin": "wa ma 'alaika alla yazzakka",
      "Terjemah_in": "Padahal, tidak ada (cela) atasmu kalau dia tidak menyucikan diri (beriman).",
      "Terjemah_en": "Though you are not liable if he does not purify himself.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَمَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And not",
          "Text_latin  ": "wama"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "عَلَيۡكَ",
          "Arti_kata_in": "atasmu",
          "Arti_kata_en": "upon you",
          "Text_latin  ": "alayka"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "أَلَّا",
          "Arti_kata_in": "bahwa tidak",
          "Arti_kata_en": "that not",
          "Text_latin  ": "alla"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "يَزَّكَّىٰ",
          "Arti_kata_in": "ia membersihkan diri",
          "Arti_kata_en": "he purifies himself",
          "Text_latin  ": "yazzakka"
        }
      ]
    },
    {
      "Nomor_ayat": 8,
      "Ayat_arabic ": "وَاَمَّا مَنْ جَاۤءَكَ يَسْعٰىۙ",
      "Ayat_latin": "wa amma man ja'aka yas'a",
      "Terjemah_in": "Adapun orang yang datang kepadamu dengan bersegera (untuk mendapatkan pengajaran),",
      "Terjemah_en": "But as for him who came to you seeking.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَأَمَّا",
          "Arti_kata_in": "dan adapun",
          "Arti_kata_en": "But as for",
          "Text_latin  ": "wa-amma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مَن",
          "Arti_kata_in": "siapa/orang",
          "Arti_kata_en": "(he) who",
          "Text_latin  ": "man"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "جَآءَكَ",
          "Arti_kata_in": "datang kapadamu",
          "Arti_kata_en": "came to you",
          "Text_latin  ": "jaaka"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "يَسۡعَىٰ",
          "Arti_kata_in": "berjalan/bersegera",
          "Arti_kata_en": "striving",
          "Text_latin  ": "yas'a"
        }
      ]
    },
    {
      "Nomor_ayat": 9,
      "Ayat_arabic ": "وَهُوَ يَخْشٰىۙ",
      "Ayat_latin": "wa huwa yakhsya",
      "Terjemah_in": "sedangkan dia takut (kepada Allah),",
      "Terjemah_en": "In awe.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَهُوَ",
          "Arti_kata_in": "dan dia",
          "Arti_kata_en": "While he",
          "Text_latin  ": "wahuwa"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَخۡشَىٰ",
          "Arti_kata_in": "ia takut",
          "Arti_kata_en": "fears",
          "Text_latin  ": "yakhsha"
        }
      ]
    },
    {
      "Nomor_ayat": 10,
      "Ayat_arabic ": "فَاَنْتَ عَنْهُ تَلَهّٰىۚ",
      "Ayat_latin": "fa anta 'an-hu talahha",
      "Terjemah_in": "malah engkau (Nabi Muhammad) abaikan.",
      "Terjemah_en": "To him you were inattentive.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَأَنتَ",
          "Arti_kata_in": "maka kamu",
          "Arti_kata_en": "But you",
          "Text_latin  ": "fa-anta"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "عَنۡهُ",
          "Arti_kata_in": "dari padanya",
          "Arti_kata_en": "from him",
          "Text_latin  ": "anhu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "تَلَهَّىٰ",
          "Arti_kata_in": "kamu mengabaikannya",
          "Arti_kata_en": "(are) distracted",
          "Text_latin  ": "talahha"
        }
      ]
    },
    {
      "Nomor_ayat": 11,
      "Ayat_arabic ": "كَلَّآ اِنَّهَا تَذْكِرَةٌ ۚ",
      "Ayat_latin": "kalla innaha tazkirah",
      "Terjemah_in": "Sekali-kali jangan (begitu)! Sesungguhnya (ajaran Allah) itu merupakan peringatan.",
      "Terjemah_en": "Do not. This is a Lesson.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "كَلَّآ",
          "Arti_kata_in": "sekali-kali jangan/tidak",
          "Arti_kata_en": "Nay!",
          "Text_latin  ": "kalla"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِنَّهَا",
          "Arti_kata_in": "sesungguhnya ia/itu",
          "Arti_kata_en": "Indeed it",
          "Text_latin  ": "innaha"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "تَذۡكِرَةٞ",
          "Arti_kata_in": "peringatan/pengajaran",
          "Arti_kata_en": "(is) a reminder",
          "Text_latin  ": "tadhkiratun"
        }
      ]
    },
    {
      "Nomor_ayat": 12,
      "Ayat_arabic ": "فَمَنْ شَاۤءَ ذَكَرَهٗ ۘ",
      "Ayat_latin": "fa man sya'a zakarah",
      "Terjemah_in": "Siapa yang menghendaki tentulah akan memperhatikannya",
      "Terjemah_en": "Whoever wills, shall remember it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَمَن",
          "Arti_kata_in": "maka barang siapa",
          "Arti_kata_en": "So whosoever",
          "Text_latin  ": "faman"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "شَآءَ",
          "Arti_kata_in": "ia menghendaki",
          "Arti_kata_en": "wills",
          "Text_latin  ": "shaa"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ذَكَرَهُۥ",
          "Arti_kata_in": "ia mengingat/memperhatikannya",
          "Arti_kata_en": "may remember it",
          "Text_latin  ": "dhakarahu"
        }
      ]
    },
    {
      "Nomor_ayat": 13,
      "Ayat_arabic ": "فِيْ صُحُفٍ مُّكَرَّمَةٍۙ",
      "Ayat_latin": "fi suhufim mukarramah",
      "Terjemah_in": "di dalam suhuf yang dimuliakan (di sisi Allah),",
      "Terjemah_en": "On honorable pages.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "In",
          "Text_latin  ": "fi"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "صُحُفٖ",
          "Arti_kata_in": "lembaran-lembaran",
          "Arti_kata_en": "sheets",
          "Text_latin  ": "suhufin"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مُّكَرَّمَةٖ",
          "Arti_kata_in": "dimuliakan",
          "Arti_kata_en": "honored",
          "Text_latin  ": "mukarramatin"
        }
      ]
    },
    {
      "Nomor_ayat": 14,
      "Ayat_arabic ": "مَّرْفُوْعَةٍ مُّطَهَّرَةٍ ۢ ۙ",
      "Ayat_latin": "marfu'atim mutahharah",
      "Terjemah_in": "yang ditinggikan (kedudukannya) lagi disucikan",
      "Terjemah_en": "Exalted and purified.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "مَّرۡفُوعَةٖ",
          "Arti_kata_in": "ditinggikan",
          "Arti_kata_en": "Exalted",
          "Text_latin  ": "marfu'atin"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مُّطَهَّرَةِۭ",
          "Arti_kata_in": "disucikan",
          "Arti_kata_en": "purified",
          "Text_latin  ": "mutahharatin"
        }
      ]
    },
    {
      "Nomor_ayat": 15,
      "Ayat_arabic ": "بِاَيْدِيْ سَفَرَةٍۙ",
      "Ayat_latin": "bi'aidi safarah",
      "Terjemah_in": "di tangan para utusan (malaikat)",
      "Terjemah_en": "By the hands of scribes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "بِأَيۡدِي",
          "Arti_kata_in": "di tangan-tangan",
          "Arti_kata_en": "In (the) hands",
          "Text_latin  ": "bi-aydi"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "سَفَرَةٖ",
          "Arti_kata_in": "para utusan",
          "Arti_kata_en": "(of) scribes",
          "Text_latin  ": "safaratin"
        }
      ]
    },
    {
      "Nomor_ayat": 16,
      "Ayat_arabic ": "كِرَامٍۢ بَرَرَةٍۗ",
      "Ayat_latin": "kiramim bararah",
      "Terjemah_in": "yang mulia lagi berbudi.",
      "Terjemah_en": "Noble and devoted.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "كِرَامِۭ",
          "Arti_kata_in": "yang mulia",
          "Arti_kata_en": "Noble",
          "Text_latin  ": "kiramin"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "بَرَرَةٖ",
          "Arti_kata_in": "yang berbakti",
          "Arti_kata_en": "dutiful",
          "Text_latin  ": "bararatin"
        }
      ]
    },
    {
      "Nomor_ayat": 17,
      "Ayat_arabic ": "قُتِلَ الْاِنْسَانُ مَآ اَكْفَرَهٗۗ",
      "Ayat_latin": "qutilal-insanu ma akfarah",
      "Terjemah_in": "Celakalah manusia! Alangkah kufur dia!",
      "Terjemah_en": "Perish man! How thankless he is!",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "قُتِلَ",
          "Arti_kata_in": "dibunuh/binasa",
          "Arti_kata_en": "Is destroyed",
          "Text_latin  ": "qutila"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "the man",
          "Text_latin  ": "al-insanu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مَآ",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "how",
          "Text_latin  ": "ma"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "أَكۡفَرَهُۥ",
          "Arti_kata_in": "kekafirannya",
          "Arti_kata_en": "ungrateful is he!",
          "Text_latin  ": "akfarahu"
        }
      ]
    },
    {
      "Nomor_ayat": 18,
      "Ayat_arabic ": "مِنْ اَيِّ شَيْءٍ خَلَقَهٗۗ",
      "Ayat_latin": "min ayyi syai'in khalaqah",
      "Terjemah_in": "Dari apakah Dia menciptakannya?",
      "Terjemah_en": "From what did He create him?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "مِنۡ",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "From",
          "Text_latin  ": "min"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "أَيِّ",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_latin  ": "ayyi"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "شَيۡءٍ",
          "Arti_kata_in": "sesuatu",
          "Arti_kata_en": "thing",
          "Text_latin  ": "shayin"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "خَلَقَهُۥ",
          "Arti_kata_in": "Dia menciptakannya",
          "Arti_kata_en": "He created him",
          "Text_latin  ": "khalaqahu"
        }
      ]
    },
    {
      "Nomor_ayat": 19,
      "Ayat_arabic ": "مِنْ نُّطْفَةٍۗ خَلَقَهٗ فَقَدَّرَهٗۗ",
      "Ayat_latin": "min nutfah, khalaqahu fa qaddarah",
      "Terjemah_in": "Dia menciptakannya dari setetes mani, lalu menentukan (takdir)-nya.",
      "Terjemah_en": "From a sperm drop He created him, and enabled him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "مِن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "From",
          "Text_latin  ": "min"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "نُّطۡفَةٍ",
          "Arti_kata_in": "setetes mani",
          "Arti_kata_en": "a sperm drop",
          "Text_latin  ": "nut'fatin"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "خَلَقَهُۥ",
          "Arti_kata_in": "Dia menciptakannya",
          "Arti_kata_en": "He created him",
          "Text_latin  ": "khalaqahu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "فَقَدَّرَهُۥ",
          "Arti_kata_in": "lalu Dia menentukannya",
          "Arti_kata_en": "then He proportioned him",
          "Text_latin  ": "faqaddarahu"
        }
      ]
    },
    {
      "Nomor_ayat": 20,
      "Ayat_arabic ": "ثُمَّ السَّبِيْلَ يَسَّرَهٗۙ",
      "Ayat_latin": "summas-sabila yassarah",
      "Terjemah_in": "Kemudian, jalannya Dia mudahkan.746)",
      "Terjemah_en": "Then He eased the way for him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ثُمَّ",
          "Arti_kata_in": "kemudian",
          "Arti_kata_en": "Then",
          "Text_latin  ": "thumma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلسَّبِيلَ",
          "Arti_kata_in": "jalan",
          "Arti_kata_en": "the way",
          "Text_latin  ": "as-sabila"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "يَسَّرَهُۥ",
          "Arti_kata_in": "Dia memudahkannya",
          "Arti_kata_en": "He made easy for him",
          "Text_latin  ": "yassarahu"
        }
      ]
    },
    {
      "Nomor_ayat": 21,
      "Ayat_arabic ": "ثُمَّ اَمَاتَهٗ فَاَقْبَرَهٗۙ",
      "Ayat_latin": "summa amatahu fa aqbarah",
      "Terjemah_in": "Kemudian, Dia mematikannya lalu menguburkannya.",
      "Terjemah_en": "Then He puts him to death, and buries him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ثُمَّ",
          "Arti_kata_in": "kemudian",
          "Arti_kata_en": "Then",
          "Text_latin  ": "thumma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "أَمَاتَهُۥ",
          "Arti_kata_in": "Dia mematikannya",
          "Arti_kata_en": "He causes him to die",
          "Text_latin  ": "amatahu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "فَأَقۡبَرَهُۥ",
          "Arti_kata_in": "lalu Dia memasukkannya dalam kubur",
          "Arti_kata_en": "and provides a grave for him",
          "Text_latin  ": "fa-aqbarahu"
        }
      ]
    },
    {
      "Nomor_ayat": 22,
      "Ayat_arabic ": "ثُمَّ اِذَا شَاۤءَ اَنْشَرَهٗۗ",
      "Ayat_latin": "summa iza sya'a ansyarah",
      "Terjemah_in": "Kemudian, jika menghendaki, Dia membangkitkannya kembali.",
      "Terjemah_en": "Then, when He wills, He will resurrect him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ثُمَّ",
          "Arti_kata_in": "kemudian",
          "Arti_kata_en": "Then",
          "Text_latin  ": "thumma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_latin  ": "idha"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "شَآءَ",
          "Arti_kata_in": "Dia menghendaki",
          "Arti_kata_en": "He wills",
          "Text_latin  ": "shaa"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "أَنشَرَهُۥ",
          "Arti_kata_in": "Dia membangkitkan",
          "Arti_kata_en": "He will resurrect him",
          "Text_latin  ": "ansharahu"
        }
      ]
    },
    {
      "Nomor_ayat": 23,
      "Ayat_arabic ": "كَلَّا لَمَّا يَقْضِ مَآ اَمَرَهٗۗ",
      "Ayat_latin": "kalla lamma yaqdi ma amarah",
      "Terjemah_in": "Sekali-kali jangan (begitu)! Dia (manusia) itu belum melaksanakan apa yang Dia (Allah) perintahkan kepadanya.",
      "Terjemah_en": "But no, he did not fulfill what He has commanded him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "كَلَّا",
          "Arti_kata_in": "sekali-kali jangan",
          "Arti_kata_en": "Nay!",
          "Text_latin  ": "kalla"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "لَمَّا",
          "Arti_kata_in": "belum",
          "Arti_kata_en": "Not",
          "Text_latin  ": "lamma"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "يَقۡضِ",
          "Arti_kata_in": "ia melaksanakan",
          "Arti_kata_en": "he has accomplished",
          "Text_latin  ": "yaqdi"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "مَآ",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_latin  ": "ma"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "أَمَرَهُۥ",
          "Arti_kata_in": "Dia perintahkan kepadanya",
          "Arti_kata_en": "He commanded him",
          "Text_latin  ": "amarahu"
        }
      ]
    },
    {
      "Nomor_ayat": 24,
      "Ayat_arabic ": "فَلْيَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖٓ ۙ",
      "Ayat_latin": "falyanzuril-insanu ila ta'amih",
      "Terjemah_in": "Maka, hendaklah manusia itu memperhatikan makanannya.",
      "Terjemah_en": "Let man consider his food.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَلۡيَنظُرِ",
          "Arti_kata_in": "maka hendaklah ia memperhatikan",
          "Arti_kata_en": "Then let look",
          "Text_latin  ": "falyanzuri"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "the man",
          "Text_latin  ": "al-insanu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "إِلَىٰ",
          "Arti_kata_in": "kepada",
          "Arti_kata_en": "at",
          "Text_latin  ": "ila"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "طَعَامِهِۦٓ",
          "Arti_kata_in": "makanannya",
          "Arti_kata_en": "his food",
          "Text_latin  ": "ta'amihi"
        }
      ]
    },
    {
      "Nomor_ayat": 25,
      "Ayat_arabic ": "اَنَّا صَبَبْنَا الْمَاۤءَ صَبًّاۙ",
      "Ayat_latin": "anna sababnal-ma'a sabba",
      "Terjemah_in": "Sesungguhnya Kami telah mencurahkan air (dari langit) dengan berlimpah.",
      "Terjemah_en": "We pour down water in abundance.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَنَّا",
          "Arti_kata_in": "sesungguhnya kami",
          "Arti_kata_en": "We",
          "Text_latin  ": "anna"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "صَبَبۡنَا",
          "Arti_kata_in": "Kami telah mencurahkan",
          "Arti_kata_en": "[We] poured down",
          "Text_latin  ": "sababna"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلۡمَآءَ",
          "Arti_kata_in": "air",
          "Arti_kata_en": "the water",
          "Text_latin  ": "al-maa"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "صَبّٗا",
          "Arti_kata_in": "tercurah",
          "Arti_kata_en": "(in) abundance",
          "Text_latin  ": "sabban"
        }
      ]
    },
    {
      "Nomor_ayat": 26,
      "Ayat_arabic ": "ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّاۙ",
      "Ayat_latin": "summa syaqaqnal-arda syaqqa",
      "Terjemah_in": "Kemudian, Kami belah bumi dengan sebaik-baiknya.",
      "Terjemah_en": "Then crack the soil open.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ثُمَّ",
          "Arti_kata_in": "kemudian",
          "Arti_kata_en": "Then",
          "Text_latin  ": "thumma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "شَقَقۡنَا",
          "Arti_kata_in": "Kami belah",
          "Arti_kata_en": "We cleaved",
          "Text_latin  ": "shaqaqna"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلۡأَرۡضَ",
          "Arti_kata_in": "bumi",
          "Arti_kata_en": "the earth",
          "Text_latin  ": "al-arda"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "شَقّٗا",
          "Arti_kata_in": "belahan (sebaik-baiknya)",
          "Arti_kata_en": "splitting",
          "Text_latin  ": "shaqqan"
        }
      ]
    },
    {
      "Nomor_ayat": 27,
      "Ayat_arabic ": "فَاَنْۢبَتْنَا فِيْهَا حَبًّاۙ",
      "Ayat_latin": "fa ambatna fiha habba",
      "Terjemah_in": "Lalu, Kami tumbuhkan padanya biji-bijian,",
      "Terjemah_en": "And grow in it grains.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَأَنۢبَتۡنَا",
          "Arti_kata_in": "lalu Kami tumbuhkan",
          "Arti_kata_en": "Then We caused to grow",
          "Text_latin  ": "fa-anbatna"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "فِيهَا",
          "Arti_kata_in": "padanya",
          "Arti_kata_en": "therein",
          "Text_latin  ": "fiha"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "حَبّٗا",
          "Arti_kata_in": "biji-bijian",
          "Arti_kata_en": "grain",
          "Text_latin  ": "habban"
        }
      ]
    },
    {
      "Nomor_ayat": 28,
      "Ayat_arabic ": "وَّعِنَبًا وَّقَضْبًاۙ",
      "Ayat_latin": "wa 'inabaw wa qadba",
      "Terjemah_in": "anggur, sayur-sayuran,",
      "Terjemah_en": "And grapes and herbs.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَعِنَبٗا",
          "Arti_kata_in": "dan angur",
          "Arti_kata_en": "And grapes",
          "Text_latin  ": "wa'inaban"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "وَقَضۡبٗا",
          "Arti_kata_in": "dan sayur-sayuran",
          "Arti_kata_en": "and green vegetables",
          "Text_latin  ": "waqadban"
        }
      ]
    },
    {
      "Nomor_ayat": 29,
      "Ayat_arabic ": "وَّزَيْتُوْنًا وَّنَخْلًاۙ",
      "Ayat_latin": "wa zaitunaw wa nakhla",
      "Terjemah_in": "zaitun, pohon kurma,",
      "Terjemah_en": "And olives and dates.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَزَيۡتُونٗا",
          "Arti_kata_in": "dan zaitun",
          "Arti_kata_en": "And olive",
          "Text_latin  ": "wazaytunan"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "وَنَخۡلٗا",
          "Arti_kata_in": "dan korma",
          "Arti_kata_en": "and date-palms",
          "Text_latin  ": "wanakhlan"
        }
      ]
    },
    {
      "Nomor_ayat": 30,
      "Ayat_arabic ": "وَّحَدَاۤئِقَ غُلْبًا",
      "Ayat_latin": "wa hada'iqa gulba",
      "Terjemah_in": "kebun-kebun (yang) rindang,",
      "Terjemah_en": "And luscious gardens.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَحَدَآئِقَ",
          "Arti_kata_in": "dan kebun-kebun",
          "Arti_kata_en": "And gardens",
          "Text_latin  ": "wahadaiqa"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "غُلۡبٗا",
          "Arti_kata_in": "subur/lebat",
          "Arti_kata_en": "(of) thick foliage",
          "Text_latin  ": "ghul'ban"
        }
      ]
    },
    {
      "Nomor_ayat": 31,
      "Ayat_arabic ": "وَفَاكِهَةً وَّاَبًّا",
      "Ayat_latin": "wa fakihataw wa abba",
      "Terjemah_in": "buah-buahan, dan rerumputan.",
      "Terjemah_en": "And fruits and vegetables.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَفَٰكِهَةٗ",
          "Arti_kata_in": "dan buah-buahan",
          "Arti_kata_en": "And fruits",
          "Text_latin  ": "wafakihatan"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "وَأَبّٗا",
          "Arti_kata_in": "dan ruput-rumputan",
          "Arti_kata_en": "and grass",
          "Text_latin  ": "wa-abban"
        }
      ]
    },
    {
      "Nomor_ayat": 32,
      "Ayat_arabic ": "مَتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْۗ",
      "Ayat_latin": "mata'al lakum wa li'an'amikum",
      "Terjemah_in": "(Semua itu disediakan) untuk kesenanganmu dan hewan-hewan ternakmu.",
      "Terjemah_en": "Enjoyment for you, and for your livestock.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "مَّتَٰعٗا",
          "Arti_kata_in": "kesenangan",
          "Arti_kata_en": "(As) a provision",
          "Text_latin  ": "mata'an"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "لَّكُمۡ",
          "Arti_kata_in": "bagi kalian",
          "Arti_kata_en": "for you",
          "Text_latin  ": "lakum"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "وَلِأَنۡعَٰمِكُمۡ",
          "Arti_kata_in": "dan bagi binatang ternakmu",
          "Arti_kata_en": "and for your cattle",
          "Text_latin  ": "wali-an'amikum"
        }
      ]
    },
    {
      "Nomor_ayat": 33,
      "Ayat_arabic ": "فَاِذَا جَاۤءَتِ الصَّاۤخَّةُ ۖ",
      "Ayat_latin": "fa iza ja'atis-sakhkhah",
      "Terjemah_in": "Maka, apabila datang suara yang memekakkan (dari tiupan sangkakala),",
      "Terjemah_en": "But when the Deafening Noise comes to pass.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَإِذَا",
          "Arti_kata_in": "maka apabila",
          "Arti_kata_en": "But when",
          "Text_latin  ": "fa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "جَآءَتِ",
          "Arti_kata_in": "telah datang",
          "Arti_kata_en": "comes",
          "Text_latin  ": "jaati"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلصَّآخَّةُ",
          "Arti_kata_in": "suara memekakan",
          "Arti_kata_en": "the Deafening Blast",
          "Text_latin  ": "as-sakhatu"
        }
      ]
    },
    {
      "Nomor_ayat": 34,
      "Ayat_arabic ": "يَوْمَ يَفِرُّ الْمَرْءُ مِنْ اَخِيْهِۙ",
      "Ayat_latin": "yauma yafirrul-mar'u min akhih",
      "Terjemah_in": "pada hari itu manusia lari dari saudaranya,",
      "Terjemah_en": "The Day when a person will flee from his brother.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "يَوۡمَ",
          "Arti_kata_in": "pada hari",
          "Arti_kata_en": "(The) Day",
          "Text_latin  ": "yawma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَفِرُّ",
          "Arti_kata_in": "lari",
          "Arti_kata_en": "will flee",
          "Text_latin  ": "yafirru"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلۡمَرۡءُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "a man",
          "Text_latin  ": "al-maru"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "مِنۡ",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "from",
          "Text_latin  ": "min"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "أَخِيهِ",
          "Arti_kata_in": "saudaranya",
          "Arti_kata_en": "his brother",
          "Text_latin  ": "akhihi"
        }
      ]
    },
    {
      "Nomor_ayat": 35,
      "Ayat_arabic ": "وَاُمِّهٖ وَاَبِيْهِۙ",
      "Ayat_latin": "wa ummihi wa abih",
      "Terjemah_in": "(dari) ibu dan bapaknya,",
      "Terjemah_en": "And his mother and his father.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَأُمِّهِۦ",
          "Arti_kata_in": "dan ibunya",
          "Arti_kata_en": "And his mother",
          "Text_latin  ": "wa-ummihi"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "وَأَبِيهِ",
          "Arti_kata_in": "dan bapaknya",
          "Arti_kata_en": "and his father",
          "Text_latin  ": "wa-abihi"
        }
      ]
    },
    {
      "Nomor_ayat": 36,
      "Ayat_arabic ": "وَصَاحِبَتِهٖ وَبَنِيْهِۗ",
      "Ayat_latin": "wa sahibatihi wa banih",
      "Terjemah_in": "serta (dari) istri dan anak-anaknya.",
      "Terjemah_en": "And his consort and his children.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَصَٰحِبَتِهِۦ",
          "Arti_kata_in": "dan istrinya",
          "Arti_kata_en": "And his wife",
          "Text_latin  ": "wasahibatihi"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "وَبَنِيهِ",
          "Arti_kata_in": "dan anak-anaknya",
          "Arti_kata_en": "and his children",
          "Text_latin  ": "wabanihi"
        }
      ]
    },
    {
      "Nomor_ayat": 37,
      "Ayat_arabic ": "لِكُلِّ امْرِئٍ مِّنْهُمْ يَوْمَىِٕذٍ شَأْنٌ يُّغْنِيْهِۗ",
      "Ayat_latin": "likullimri'im min-hum yauma'izin sya'nuy yugnih",
      "Terjemah_in": "Setiap orang dari mereka pada hari itu mempunyai urusan yang menyibukkannya.",
      "Terjemah_en": "Every one of them, on that Day, will have enough to preoccupy him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "لِكُلِّ",
          "Arti_kata_in": "bagi setiap",
          "Arti_kata_en": "For every",
          "Text_latin  ": "likulli"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱمۡرِيٕٖ",
          "Arti_kata_in": "seseorang",
          "Arti_kata_en": "man",
          "Text_latin  ": "im'ri-in"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مِّنۡهُمۡ",
          "Arti_kata_in": "dari mereka",
          "Arti_kata_en": "among them",
          "Text_latin  ": "min'hum"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "يَوۡمَئِذٖ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_latin  ": "yawma-idhin"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "شَأۡنٞ",
          "Arti_kata_in": "urusan",
          "Arti_kata_en": "(will be) a matter",
          "Text_latin  ": "shanun"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "يُغۡنِيهِ",
          "Arti_kata_in": "menyibukkan",
          "Arti_kata_en": "occupying him",
          "Text_latin  ": "yugh'nihi"
        }
      ]
    },
    {
      "Nomor_ayat": 38,
      "Ayat_arabic ": "وُجُوْهٌ يَّوْمَىِٕذٍ مُّسْفِرَةٌۙ",
      "Ayat_latin": "wujuhuy yauma'izim musfirah",
      "Terjemah_in": "Pada hari itu ada wajah-wajah yang berseri-seri,",
      "Terjemah_en": "Faces on that Day will be radiant.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وُجُوهٞ",
          "Arti_kata_in": "wajah-wajah",
          "Arti_kata_en": "Faces",
          "Text_latin  ": "wujuhun"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَوۡمَئِذٖ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_latin  ": "yawma-idhin"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مُّسۡفِرَةٞ",
          "Arti_kata_in": "gembira ria",
          "Arti_kata_en": "(will be) bright",
          "Text_latin  ": "mus'firatun"
        }
      ]
    },
    {
      "Nomor_ayat": 39,
      "Ayat_arabic ": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ ۚ",
      "Ayat_latin": "dahikatum mustabsyirah",
      "Terjemah_in": "tertawa lagi gembira ria.",
      "Terjemah_en": "Laughing and rejoicing.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ضَاحِكَةٞ",
          "Arti_kata_in": "tertawa",
          "Arti_kata_en": "Laughing",
          "Text_latin  ": "dahikatun"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مُّسۡتَبۡشِرَةٞ",
          "Arti_kata_in": "gembira-ria",
          "Arti_kata_en": "rejoicing at good news",
          "Text_latin  ": "mus'tabshiratun"
        }
      ]
    },
    {
      "Nomor_ayat": 40,
      "Ayat_arabic ": "وَوُجُوْهٌ يَّوْمَىِٕذٍ عَلَيْهَا غَبَرَةٌۙ",
      "Ayat_latin": "wa wujuhuy yauma'izin 'alaiha gabarah",
      "Terjemah_in": "Pada hari itu ada (pula) wajah-wajah yang tertutup debu (suram)",
      "Terjemah_en": "And Faces on that Day will be covered with misery.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَوُجُوهٞ",
          "Arti_kata_in": "dan wajah-wajah",
          "Arti_kata_en": "And faces",
          "Text_latin  ": "wawujuhun"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَوۡمَئِذٍ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_latin  ": "yawma-idhin"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "عَلَيۡهَا",
          "Arti_kata_in": "atasnya",
          "Arti_kata_en": "upon them",
          "Text_latin  ": "alayha"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "غَبَرَةٞ",
          "Arti_kata_in": "tertutup debu",
          "Arti_kata_en": "(will be) dust",
          "Text_latin  ": "ghabaratun"
        }
      ]
    },
    {
      "Nomor_ayat": 41,
      "Ayat_arabic ": "تَرْهَقُهَا قَتَرَةٌ ۗ",
      "Ayat_latin": "tarhaquha qatarah",
      "Terjemah_in": "dan tertutup oleh kegelapan (ditimpa kehinaan dan kesusahan).",
      "Terjemah_en": "Overwhelmed by remorse.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "تَرۡهَقُهَا",
          "Arti_kata_in": "menutupinya",
          "Arti_kata_en": "Will cover them",
          "Text_latin  ": "tarhaquha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "قَتَرَةٌ",
          "Arti_kata_in": "kegelapan",
          "Arti_kata_en": "darkness",
          "Text_latin  ": "qataratun"
        }
      ]
    },
    {
      "Nomor_ayat": 42,
      "Ayat_arabic ": "اُولٰۤىِٕكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ ࣖ",
      "Ayat_latin": "ula'ika humul-kafaratul-fajarah",
      "Terjemah_in": "Mereka itulah orang-orang kafir lagi para pendurhaka.",
      "Terjemah_en": "These are the faithless, the vicious.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أُوْلَٰٓئِكَ",
          "Arti_kata_in": "mereka itulah",
          "Arti_kata_en": "Those",
          "Text_latin  ": "ulaika"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "هُمُ",
          "Arti_kata_in": "mereka",
          "Arti_kata_en": "[they]",
          "Text_latin  ": "humu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلۡكَفَرَةُ",
          "Arti_kata_in": "orang-orang kafir",
          "Arti_kata_en": "(are) the disbelievers",
          "Text_latin  ": "al-kafaratu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلۡفَجَرَةُ",
          "Arti_kata_in": "durhaka",
          "Arti_kata_en": "the wicked ones",
          "Text_latin  ": "al-fajaratu"
        }
      ]
    }
  ]
}