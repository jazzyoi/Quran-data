{
  "Nomor_surat": 97,
  "Nama_surat": "Al-Qadr",
  "surat_arabic": "القدر",
  "Arti_surat_in": "Kemuliaan",
  "Arti_surat_en": "The Power",
  "Ayat": [
    {
      "Nomor_ayat": 6126,
      "Ayat_Arabic": "اِنَّآ اَنْزَلْنٰهُ فِيْ لَيْلَةِ الْقَدْرِ",
      "Text_Latin": "inna anzalnahu fi lailatil-qadr",
      "Terjemah_in": "Sesungguhnya Kami telah menurunkannya (Al-Qur’an) pada Lailatulqadar.",
      "Terjemahan_En": "We sent it down on the Night of Decree.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّآ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed We",
          "Text_Latin": "inna",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَنزَلۡنَٰهُ",
          "Arti_kata_in": "Kami telah menurunkannya",
          "Arti_kata_en": "revealed it",
          "Text_Latin": "anzalnahu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "pada",
          "Arti_kata_en": "in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَيۡلَةِ",
          "Arti_kata_in": "malam",
          "Arti_kata_en": "(the) Night",
          "Text_Latin": "laylati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡقَدۡرِ",
          "Arti_kata_in": "kemuliaan",
          "Arti_kata_en": "(of) Power",
          "Text_Latin": "al-qadri",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6127,
      "Ayat_Arabic": "وَمَآ اَدْرٰىكَ مَا لَيْلَةُ الْقَدْرِۗ",
      "Text_Latin": "wa ma adraka ma lailatul-qadr",
      "Terjemah_in": "Tahukah kamu apakah Lailatulqadar itu?",
      "Terjemahan_En": "But what will convey to you what the Night of Decree is?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَآ",
          "Arti_kata_in": "dan apakah",
          "Arti_kata_en": "And what",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَدۡرَىٰكَ",
          "Arti_kata_in": "kamu tahu",
          "Arti_kata_en": "can make you know",
          "Text_Latin": "adraka",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَيۡلَةُ",
          "Arti_kata_in": "malam",
          "Arti_kata_en": "(the) Night",
          "Text_Latin": "laylatu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡقَدۡرِ",
          "Arti_kata_in": "kemuliaan",
          "Arti_kata_en": "(of) Power (is)",
          "Text_Latin": "al-qadri",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6128,
      "Ayat_Arabic": "لَيْلَةُ الْقَدْرِ ەۙ خَيْرٌ مِّنْ اَلْفِ شَهْرٍۗ",
      "Text_Latin": "lailatul-qadri khairum min alfi syahr",
      "Terjemah_in": "Lailatulqadar itu lebih baik daripada seribu bulan.",
      "Terjemahan_En": "The Night of Decree is better than a thousand months.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَيۡلَةُ",
          "Arti_kata_in": "malam",
          "Arti_kata_en": "(The) Night",
          "Text_Latin": "laylatu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡقَدۡرِ",
          "Arti_kata_in": "kemuliaan",
          "Arti_kata_en": "(of) Power",
          "Text_Latin": "al-qadri",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "خَيۡرٞ",
          "Arti_kata_in": "lebih baik",
          "Arti_kata_en": "(is) better",
          "Text_Latin": "khayrun",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مِّنۡ",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "than",
          "Text_Latin": "min",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَلۡفِ",
          "Arti_kata_in": "seribu",
          "Arti_kata_en": "a thousand",
          "Text_Latin": "alfi",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "شَهۡرٖ",
          "Arti_kata_in": "bulan",
          "Arti_kata_en": "month(s)",
          "Text_Latin": "shahrin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6129,
      "Ayat_Arabic": "تَنَزَّلُ الْمَلٰۤىِٕكَةُ وَالرُّوْحُ فِيْهَا بِاِذْنِ رَبِّهِمْۚ مِنْ كُلِّ اَمْرٍۛ",
      "Text_Latin": "tanazzalul-mala'ikatu war-ruhu fiha bi'izni rabbihim, ming kulli amr",
      "Terjemah_in": "Pada malam itu turun para malaikat dan Rūḥ (Jibril) dengan izin Tuhannya untuk mengatur semua urusan.",
      "Terjemahan_En": "In it descend the angels and the Spirit, by the leave of their Lord, with every command.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "تَنَزَّلُ",
          "Arti_kata_in": "turun",
          "Arti_kata_en": "Descend",
          "Text_Latin": "tanazzalu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡمَلَٰٓئِكَةُ",
          "Arti_kata_in": "para malaikat",
          "Arti_kata_en": "the Angels",
          "Text_Latin": "al-malaikatu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَٱلرُّوحُ",
          "Arti_kata_in": "dan Roh/Jibril",
          "Arti_kata_en": "and the Spirit",
          "Text_Latin": "war-ruhu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فِيهَا",
          "Arti_kata_in": "padanya/pada malam",
          "Arti_kata_en": "therein",
          "Text_Latin": "fiha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "بِإِذۡنِ",
          "Arti_kata_in": "dengan izin",
          "Arti_kata_en": "by (the) permission",
          "Text_Latin": "bi-idh'ni",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "رَبِّهِم",
          "Arti_kata_in": "Tuhannya",
          "Arti_kata_en": "(of) their Lord",
          "Text_Latin": "rabbihim",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "مِّن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "for",
          "Text_Latin": "min",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "كُلِّ",
          "Arti_kata_in": "segala",
          "Arti_kata_en": "every",
          "Text_Latin": "kulli",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "أَمۡرٖ",
          "Arti_kata_in": "urusan",
          "Arti_kata_en": "affair",
          "Text_Latin": "amrin",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6130,
      "Ayat_Arabic": "سَلٰمٌ ۛهِيَ حَتّٰى مَطْلَعِ الْفَجْرِ ࣖ",
      "Text_Latin": "salamun hiya hatta matla'il-fajr",
      "Terjemah_in": "Sejahteralah (malam) itu sampai terbit fajar.",
      "Terjemahan_En": "Peace it is; until the rise of dawn.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "سَلَٰمٌ",
          "Arti_kata_in": "sejahtera",
          "Arti_kata_en": "Peace",
          "Text_Latin": "salamun",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هِيَ",
          "Arti_kata_in": "ia/malam itu",
          "Arti_kata_en": "it (is)",
          "Text_Latin": "hiya",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "حَتَّىٰ",
          "Arti_kata_in": "hingga",
          "Arti_kata_en": "until",
          "Text_Latin": "hatta",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَطۡلَعِ",
          "Arti_kata_in": "terbit",
          "Arti_kata_en": "(the) emergence",
          "Text_Latin": "matla'i",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡفَجۡرِ",
          "Arti_kata_in": "fajar",
          "Arti_kata_en": "(of) the dawn",
          "Text_Latin": "al-fajri",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
}