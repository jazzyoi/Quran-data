{
  "Nomor_surat": 93,
  "Nama_surat": "Adh-Dhuha",
  "surat_arabic": "الضحى",
  "Arti_surat_in": "aktu Matahari Sepenggalahan Naik (Dhuha)",
  "Arti_surat_en": "The Morning Brightness",
  "Ayat": [
    {
      "Nomor_ayat": 6080,
      "Ayat_Arabic": "وَالضُّحٰىۙ",
      "Text_Latin": "wad-duha",
      "Terjemah_in": "Demi waktu duha",
      "Terjemahan_En": "By the morning light.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلضُّحَىٰ",
          "Arti_kata_in": "demi matahari naik",
          "Arti_kata_en": "By the morning brightness",
          "Text_Latin": "wad-duha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6081,
      "Ayat_Arabic": "وَالَّيْلِ اِذَا سَجٰىۙ",
      "Text_Latin": "wal-laili iza saja",
      "Terjemah_in": "dan demi waktu malam apabila telah sunyi,",
      "Terjemahan_En": "And the night as it settles.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلَّيۡلِ",
          "Arti_kata_in": "dan malam",
          "Arti_kata_en": "And the night",
          "Text_Latin": "wa-al-layli",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "سَجَىٰ",
          "Arti_kata_in": "telah sunyi",
          "Arti_kata_en": "it covers with darkness",
          "Text_Latin": "saja",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6082,
      "Ayat_Arabic": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىۗ",
      "Text_Latin": "ma wadda'aka rabbuka wa ma qala",
      "Terjemah_in": "Tuhanmu (Nabi Muhammad) tidak meninggalkan dan tidak (pula) membencimu.",
      "Terjemahan_En": "Your Lord did not abandon you, nor did He forget.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "Not",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَدَّعَكَ",
          "Arti_kata_in": "meninggalkan kamu",
          "Arti_kata_en": "has forsaken you",
          "Text_Latin": "wadda'aka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبُّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_Latin": "rabbuka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَمَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "and not",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "قَلَىٰ",
          "Arti_kata_in": "marah/benci",
          "Arti_kata_en": "He is displeased",
          "Text_Latin": "qala",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6083,
      "Ayat_Arabic": "وَلَلْاٰخِرَةُ خَيْرٌ لَّكَ مِنَ الْاُوْلٰىۗ",
      "Text_Latin": "wa lal-akhiratu khairul laka minal-ula",
      "Terjemah_in": "Sungguh, akhirat itu lebih baik bagimu daripada yang permulaan (dunia).",
      "Terjemahan_En": "The Hereafter is better for you than the First.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَلۡأٓخِرَةُ",
          "Arti_kata_in": "dan sungguh kesudahan/akhirat",
          "Arti_kata_en": "And surely the Hereafter",
          "Text_Latin": "walalakhiratu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "خَيۡرٞ",
          "Arti_kata_in": "lebih baik",
          "Arti_kata_en": "(is) better",
          "Text_Latin": "khayrun",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَّكَ",
          "Arti_kata_in": "bagimu",
          "Arti_kata_en": "for you",
          "Text_Latin": "laka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مِنَ",
          "Arti_kata_in": "dari pada",
          "Arti_kata_en": "than",
          "Text_Latin": "mina",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡأُولَىٰ",
          "Arti_kata_in": "permulaan/dunia",
          "Arti_kata_en": "the first",
          "Text_Latin": "al-ula",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6084,
      "Ayat_Arabic": "وَلَسَوْفَ يُعْطِيْكَ رَبُّكَ فَتَرْضٰىۗ",
      "Text_Latin": "wa lasaufa yu'tika rabbuka fa tarda",
      "Terjemah_in": "Sungguh, kelak (di akhirat nanti) Tuhanmu pasti memberikan karunia-Nya kepadamu sehingga engkau rida.",
      "Terjemahan_En": "And your Lord will give you, and you will be satisfied.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَسَوۡفَ",
          "Arti_kata_in": "dan sungguh kelak",
          "Arti_kata_en": "And soon",
          "Text_Latin": "walasawfa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يُعۡطِيكَ",
          "Arti_kata_in": "memberikan kepadamu",
          "Arti_kata_en": "will give you",
          "Text_Latin": "yu'tika",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبُّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_Latin": "rabbuka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فَتَرۡضَىٰٓ",
          "Arti_kata_in": "maka kamu jadi puas",
          "Arti_kata_en": "then you will be satisfied",
          "Text_Latin": "fatarda",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6085,
      "Ayat_Arabic": "اَلَمْ يَجِدْكَ يَتِيْمًا فَاٰوٰىۖ",
      "Text_Latin": "a lam yajidka yatiman fa awa",
      "Terjemah_in": "Bukankah Dia mendapatimu sebagai seorang yatim, lalu Dia melindungi(-mu);",
      "Terjemahan_En": "Did He not find you orphaned, and sheltered you?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَلَمۡ",
          "Arti_kata_in": "apakah tidak/bukanlah",
          "Arti_kata_en": "Did not",
          "Text_Latin": "alam",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَجِدۡكَ",
          "Arti_kata_in": "Dia mendapatimu",
          "Arti_kata_en": "He find you",
          "Text_Latin": "yajid'ka",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَتِيمٗا",
          "Arti_kata_in": "seorang yatim",
          "Arti_kata_en": "an orphan",
          "Text_Latin": "yatiman",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فََٔاوَىٰ",
          "Arti_kata_in": "lalu Dia melindungi",
          "Arti_kata_en": "and gave shelter",
          "Text_Latin": "faawa",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6086,
      "Ayat_Arabic": "وَوَجَدَكَ ضَاۤلًّا فَهَدٰىۖ",
      "Text_Latin": "wa wajadaka dallan fa hada",
      "Terjemah_in": "mendapatimu sebagai seorang yang tidak tahu (tentang syariat), lalu Dia memberimu petunjuk (wahyu);",
      "Terjemahan_En": "And found you wandering, and guided you.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَوَجَدَكَ",
          "Arti_kata_in": "dan Dia mendapatimu",
          "Arti_kata_en": "And He found you",
          "Text_Latin": "wawajadaka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ضَآلّٗا",
          "Arti_kata_in": "sesat/bingung",
          "Arti_kata_en": "lost",
          "Text_Latin": "dallan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَهَدَىٰ",
          "Arti_kata_in": "lalu Dia memberi petunjuk",
          "Arti_kata_en": "so He guided",
          "Text_Latin": "fahada",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6087,
      "Ayat_Arabic": "وَوَجَدَكَ عَاۤىِٕلًا فَاَغْنٰىۗ",
      "Text_Latin": "wa wajadaka 'a'ilan fa agna",
      "Terjemah_in": "dan mendapatimu sebagai seorang yang fakir, lalu Dia memberimu kecukupan?",
      "Terjemahan_En": "And found you in need, and enriched you?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَوَجَدَكَ",
          "Arti_kata_in": "dan Dia mendapatimu",
          "Arti_kata_en": "And He found you",
          "Text_Latin": "wawajadaka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَآئِلٗا",
          "Arti_kata_in": "miskin/kekurangan",
          "Arti_kata_en": "in need",
          "Text_Latin": "ailan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَأَغۡنَىٰ",
          "Arti_kata_in": "lalu Dia memberi kecukupan",
          "Arti_kata_en": "so He made self-sufficient",
          "Text_Latin": "fa-aghna",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6088,
      "Ayat_Arabic": "فَاَمَّا الْيَتِيْمَ فَلَا تَقْهَرْۗ",
      "Text_Latin": "fa ammal-yatima fa la taq-har",
      "Terjemah_in": "Terhadap anak yatim, janganlah engkau berlaku sewenang-wenang.",
      "Terjemahan_En": "Therefore, do not mistreat the orphan.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَمَّا",
          "Arti_kata_in": "maka adapun",
          "Arti_kata_en": "So as for",
          "Text_Latin": "fa-amma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡيَتِيمَ",
          "Arti_kata_in": "anak yatim",
          "Arti_kata_en": "the orphan",
          "Text_Latin": "al-yatima",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَلَا",
          "Arti_kata_in": "maka jangan",
          "Arti_kata_en": "then (do) not",
          "Text_Latin": "fala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "تَقۡهَرۡ",
          "Arti_kata_in": "kamu paksa/bersikap bengis",
          "Arti_kata_en": "oppress",
          "Text_Latin": "taqhar",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6089,
      "Ayat_Arabic": "وَاَمَّا السَّاۤىِٕلَ فَلَا تَنْهَرْ",
      "Text_Latin": "wa ammas-sa'ila fa la tan-har",
      "Terjemah_in": "Terhadap orang yang meminta-minta, janganlah engkau menghardik.",
      "Terjemahan_En": "Nor rebuff the seeker.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَمَّا",
          "Arti_kata_in": "dan adapun",
          "Arti_kata_en": "And as for",
          "Text_Latin": "wa-amma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلسَّآئِلَ",
          "Arti_kata_in": "orang minta-minta",
          "Arti_kata_en": "him who asks",
          "Text_Latin": "as-saila",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَلَا",
          "Arti_kata_in": "maka jangan",
          "Arti_kata_en": "then (do) not",
          "Text_Latin": "fala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "تَنۡهَرۡ",
          "Arti_kata_in": "kamu menghardik",
          "Arti_kata_en": "repel",
          "Text_Latin": "tanhar",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6090,
      "Ayat_Arabic": "وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ ࣖ",
      "Text_Latin": "wa amma bini'mati rabbika fa haddis",
      "Terjemah_in": "Terhadap nikmat Tuhanmu, nyatakanlah (dengan bersyukur).",
      "Terjemahan_En": "But proclaim the blessings of your Lord.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَمَّا",
          "Arti_kata_in": "dan adapun",
          "Arti_kata_en": "But as for",
          "Text_Latin": "wa-amma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بِنِعۡمَةِ",
          "Arti_kata_in": "dengan/terhadap nikmat",
          "Arti_kata_en": "(the) Favor",
          "Text_Latin": "bini'mati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "(of) your Lord",
          "Text_Latin": "rabbika",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فَحَدِّثۡ",
          "Arti_kata_in": "maka hendaklah kamu ceritakan",
          "Arti_kata_en": "narrate",
          "Text_Latin": "fahaddith",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
}