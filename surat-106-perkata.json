{
  "Nomor_surat": 106,
  "Nama_surat": "Quraysh",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لِإِيلَٰفِ",
          "Arti_kata_in": "karena kebiasaan",
          "Arti_kata_en": "For (the) familiarity",
          "Text_Latin": "liilafi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "قُرَيۡشٍ",
          "Arti_kata_in": "orang-orang Qurais",
          "Arti_kata_en": "(of the) Quraish",
          "Text_Latin": "qurayshin"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِۦلَٰفِهِمۡ",
          "Arti_kata_in": "kebiasaan mereka",
          "Arti_kata_en": "Their familiarity",
          "Text_Latin": "ilafihim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رِحۡلَةَ",
          "Arti_kata_in": "perjalanan/bepergian",
          "Arti_kata_en": "(with the) journey",
          "Text_Latin": "rih'lata"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلشِّتَآءِ",
          "Arti_kata_in": "dimusim dingin",
          "Arti_kata_en": "(of) winter",
          "Text_Latin": "as-shitai"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَٱلصَّيۡفِ",
          "Arti_kata_in": "dan musim panas",
          "Arti_kata_en": "and summer",
          "Text_Latin": "was-sayfi"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَلۡيَعۡبُدُواْ",
          "Arti_kata_in": "maka hendaklah mereka menyembah",
          "Arti_kata_en": "So let them worship",
          "Text_Latin": "falya'budu"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَبَّ",
          "Arti_kata_in": "Tuhan",
          "Arti_kata_en": "(the) Lord",
          "Text_Latin": "rabba"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "هَٰذَا",
          "Arti_kata_in": "ini",
          "Arti_kata_en": "(of) this",
          "Text_Latin": "hadha"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡبَيۡتِ",
          "Arti_kata_in": "rumah",
          "Arti_kata_en": "House",
          "Text_Latin": "al-bayti"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِيٓ",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "The One Who",
          "Text_Latin": "alladhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَطۡعَمَهُم",
          "Arti_kata_in": "Dia memberi makan mereka",
          "Arti_kata_en": "feeds them",
          "Text_Latin": "at'amahum"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مِّن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "against",
          "Text_Latin": "min"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "جُوعٖ",
          "Arti_kata_in": "kelaparan",
          "Arti_kata_en": "hunger",
          "Text_Latin": "ju'in"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَءَامَنَهُم",
          "Arti_kata_in": "dan Dia memberikan keamanan mereka",
          "Arti_kata_en": "and gives them security",
          "Text_Latin": "waamanahum"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "مِّنۡ",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "against",
          "Text_Latin": "min"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "خَوۡفِۭ",
          "Arti_kata_in": "ketakutan",
          "Arti_kata_en": "fear",
          "Text_Latin": "khawfin"
        }
      ]
    }
  ]
}