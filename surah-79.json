          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5754,
      "Ayat_Arabic": "يَسْـَٔلُوْنَكَ عَنِ السَّاعَةِ اَيَّانَ مُرْسٰىهَاۗ",
      "Text_Latin": "yas'alunaka 'anis-sa'ati ayyana mursaha",
      "Terjemah_in": "Mereka (orang-orang kafir) bertanya kepadamu (Nabi Muhammad) tentang hari Kiamat, “Kapankah terjadinya?”",
      "Terjemahan_En": "They ask you about the Hour, “When will it take place?”",
