{
  "Nomor_surat": 79,
  "Nama_surat": "An-Nazi'at",
  "surat_arabic": "النازعات",
  "Arti_surat_in": "Malaikat-Malaikat Yang Mencabut",
  "Arti_surat_en": "Those who drag forth",
  "Ayat": [
    {
      "Nomor_ayat": 5713,
      "Ayat_Arabic": "وَالنّٰزِعٰتِ غَرْقًاۙ",
      "Text_Latin": "wan-nazi'ati garqa",
      "Terjemah_in": "Demi (malaikat) yang mencabut (nyawa orang kafir) dengan keras,",
      "Terjemahan_En": "By those who snatch violently.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلنَّٰزِعَٰتِ",
          "Arti_kata": "demi yang mencabut",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "غَرۡقٗا",
          "Arti_kata": "dengan keras",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5714,
      "Ayat_Arabic": "وَّالنّٰشِطٰتِ نَشْطًاۙ",
      "Text_Latin": "wan-nasyitati nasyta",
      "Terjemah_in": "demi (malaikat) yang mencabut (nyawa orang mukmin) dengan lemah lembut,",
      "Terjemahan_En": "And those who remove gently.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلنَّٰشِطَٰتِ",
          "Arti_kata": "dan yang mencabut",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَشۡطٗا",
          "Arti_kata": "perlahan-lahan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5715,
      "Ayat_Arabic": "وَّالسّٰبِحٰتِ سَبْحًاۙ",
      "Text_Latin": "was-sabihati sab-ha",
      "Terjemah_in": "demi (malaikat) yang cepat (menunaikan tugasnya) dengan mudah,",
      "Terjemahan_En": "And those who glide smoothly.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلسَّٰبِحَٰتِ",
          "Arti_kata": "dan yang turun",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "سَبۡحٗا",
          "Arti_kata": "cepat",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5716,
      "Ayat_Arabic": "فَالسّٰبِقٰتِ سَبْقًاۙ",
      "Text_Latin": "fas-sabiqati sabqa",
      "Terjemah_in": "(malaikat) yang bergegas (melaksanakan perintah Allah) dengan cepat,",
      "Terjemahan_En": "And those who race swiftly.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱلسَّٰبِقَٰتِ",
          "Arti_kata": "dan yang mendahului",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "سَبۡقٗا",
          "Arti_kata": "dengan kencang",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5717,
      "Ayat_Arabic": "فَالْمُدَبِّرٰتِ اَمْرًاۘ",
      "Text_Latin": "fal-mudabbirati amra",
      "Terjemah_in": "dan (malaikat) yang mengatur urusan (dunia),744)",
      "Terjemahan_En": "And those who regulate events.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱلۡمُدَبِّرَٰتِ",
          "Arti_kata": "dan yang mengatur",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَمۡرٗا",
          "Arti_kata": "urusan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5718,
      "Ayat_Arabic": "يَوْمَ تَرْجُفُ الرَّاجِفَةُۙ",
      "Text_Latin": "yauma tarjufur-rajifah",
      "Terjemah_in": "(kamu benar-benar akan dibangkitkan) pada hari ketika tiupan pertama mengguncang (alam semesta).",
      "Terjemahan_En": "On the Day when the Quake quakes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَوۡمَ",
          "Arti_kata": "hari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تَرۡجُفُ",
          "Arti_kata": "bergoncang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلرَّاجِفَةُ",
          "Arti_kata": "goncangan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5719,
      "Ayat_Arabic": "تَتْبَعُهَا الرَّادِفَةُ ۗ",
      "Text_Latin": "tatba'uhar-radifah",
      "Terjemah_in": "(Tiupan pertama) itu diiringi oleh tiupan kedua.",
      "Terjemahan_En": "And is followed by the Successor.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "تَتۡبَعُهَا",
          "Arti_kata": "mengikutinya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلرَّادِفَةُ",
          "Arti_kata": "yang mengiringi",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5720,
      "Ayat_Arabic": "قُلُوْبٌ يَّوْمَىِٕذٍ وَّاجِفَةٌۙ",
      "Text_Latin": "qulubuy yauma'iziw wajifah",
      "Terjemah_in": "Hati manusia pada hari itu merasa sangat takut;",
      "Terjemahan_En": "Hearts on that Day will be pounding.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قُلُوبٞ",
          "Arti_kata": "hati-hati",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمَئِذٖ",
          "Arti_kata": "pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَاجِفَةٌ",
          "Arti_kata": "berdebar/sangat takut",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5721,
      "Ayat_Arabic": "اَبْصَارُهَا خَاشِعَةٌ  ۘ",
      "Text_Latin": "absaruha khasyi'ah",
      "Terjemah_in": "pandangannya tertunduk.",
      "Terjemahan_En": "Their sights downcast.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَبۡصَٰرُهَا",
          "Arti_kata": "pandangannya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "خَٰشِعَةٞ",
          "Arti_kata": "takut/tertunduk",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5722,
      "Ayat_Arabic": "يَقُوْلُوْنَ ءَاِنَّا لَمَرْدُوْدُوْنَ فِى الْحَافِرَةِۗ",
      "Text_Latin": "yaquluna a inna lamarduduna fil-hafirah",
      "Terjemah_in": "Mereka (di dunia) berkata, “Apakah kita benar-benar akan dikembalikan pada kehidupan yang semula?745)",
      "Terjemahan_En": "They say, “Are we to be restored to the original condition?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَقُولُونَ",
          "Arti_kata": "mereka berkata",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَءِنَّا",
          "Arti_kata": "apakah sesungguhnya kami",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَمَرۡدُودُونَ",
          "Arti_kata": "sungguh akan dikembalikan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فِي",
          "Arti_kata": "dalam",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡحَافِرَةِ",
          "Arti_kata": "keadaan semula",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5723,
      "Ayat_Arabic": "ءَاِذَا كُنَّا عِظَامًا نَّخِرَةً ۗ",
      "Text_Latin": "a iza kunna 'izaman nakhirah",
      "Terjemah_in": "Apabila kita telah menjadi tulang-belulang yang hancur, apakah kita (akan dibangkitkan juga)?”",
      "Terjemahan_En": "When we have become hollow bones?”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَءِذَا",
          "Arti_kata": "apakah apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "كُنَّا",
          "Arti_kata": "kami adalah/menjadi",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عِظَٰمٗا",
          "Arti_kata": "tulang belulang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "نَّخِرَةٗ",
          "Arti_kata": "hancur",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5724,
      "Ayat_Arabic": "قَالُوْا تِلْكَ اِذًا كَرَّةٌ خَاسِرَةٌ  ۘ",
      "Text_Latin": "qalu tilka izang karratun khasirah",
      "Terjemah_in": "Mereka berkata, “Kalau demikian, itu suatu pengembalian yang merugikan.”",
      "Terjemahan_En": "They say, “This is a losing proposition.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قَالُواْ",
          "Arti_kata": "mereka berkata",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تِلۡكَ",
          "Arti_kata": "itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "إِذٗا",
          "Arti_kata": "jika demikian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "كَرَّةٌ",
          "Arti_kata": "pengembalian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "خَاسِرَةٞ",
          "Arti_kata": "kerugian",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5725,
      "Ayat_Arabic": "فَاِنَّمَا هِيَ زَجْرَةٌ وَّاحِدَةٌۙ",
      "Text_Latin": "fa innama hiya zajratuw wahidah",
      "Terjemah_in": "(Jangan dianggap sulit,) pengembalian itu (dilakukan) hanyalah dengan sekali tiupan.",
      "Terjemahan_En": "But it will be only a single nudge.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِنَّمَا",
          "Arti_kata": "maka sesungguhnya hanyalah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هِيَ",
          "Arti_kata": "ia/pengembalian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "زَجۡرَةٞ",
          "Arti_kata": "teriakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَٰحِدَةٞ",
          "Arti_kata": "satu/satu kali",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5726,
      "Ayat_Arabic": "فَاِذَا هُمْ بِالسَّاهِرَةِۗ",
      "Text_Latin": "fa iza hum bis-sahirah",
      "Terjemah_in": "Seketika itu, mereka hidup kembali di bumi (yang baru).",
      "Terjemahan_En": "And they will be awake.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِذَا",
          "Arti_kata": "maka tiba-tiba",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُم",
          "Arti_kata": "mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلسَّاهِرَةِ",
          "Arti_kata": "di permukaan bumi",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5727,
      "Ayat_Arabic": "هَلْ اَتٰىكَ حَدِيْثُ مُوْسٰىۘ",
      "Text_Latin": "hal ataka hadisu musa",
      "Terjemah_in": "Sudah sampaikah kepadamu (Nabi Muhammad) kisah Musa?",
      "Terjemahan_En": "Has the story of Moses reached you?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "هَلۡ",
          "Arti_kata": "apakah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَتَىٰكَ",
          "Arti_kata": "telah sampai kepadamu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "حَدِيثُ",
          "Arti_kata": "cerita",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مُوسَىٰٓ",
          "Arti_kata": "Musa",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5728,
      "Ayat_Arabic": "اِذْ نَادٰىهُ رَبُّهٗ بِالْوَادِ الْمُقَدَّسِ طُوًىۚ",
      "Text_Latin": "iz nadahu rabbuhu bil-wadil-muqaddasi tuwa",
      "Terjemah_in": "(Ingatlah) ketika Tuhannya menyeru dia (Musa) di lembah suci, yaitu Lembah Tuwa,",
      "Terjemahan_En": "When His Lord called out to him in the sacred valley of Tuwa.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِذۡ",
          "Arti_kata": "tatkala",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَادَىٰهُ",
          "Arti_kata": "memanggilnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبُّهُۥ",
          "Arti_kata": "Tuhannya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "بِٱلۡوَادِ",
          "Arti_kata": "di lembah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡمُقَدَّسِ",
          "Arti_kata": "suci",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "طُوًى",
          "Arti_kata": "Tuwa",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5729,
      "Ayat_Arabic": "اِذْهَبْ اِلٰى فِرْعَوْنَ اِنَّهٗ طَغٰىۖ",
      "Text_Latin": "iz-hab ila fir'auna innahu taga",
      "Terjemah_in": "“Pergilah engkau kepada Fir‘aun! Sesungguhnya dia telah melampaui batas.",
      "Terjemahan_En": "“Go to Pharaoh—he has transgressed.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱذۡهَبۡ",
          "Arti_kata": "pergilah kamu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِلَىٰ",
          "Arti_kata": "kepada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فِرۡعَوۡنَ",
          "Arti_kata": "Fir'aun",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "إِنَّهُۥ",
          "Arti_kata": "sesungguhnya dia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "طَغَىٰ",
          "Arti_kata": "melampui batas",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5730,
      "Ayat_Arabic": "فَقُلْ هَلْ لَّكَ اِلٰٓى اَنْ تَزَكّٰىۙ",
      "Text_Latin": "fa qul hal laka ila an tazakka",
      "Terjemah_in": "Lalu, katakanlah (kepada Fir‘aun), ‘Adakah keinginanmu untuk menyucikan diri (dari kesesatan)",
      "Terjemahan_En": "And say, “Do you care to be cleansed?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَقُلۡ",
          "Arti_kata": "maka katakanlah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هَل",
          "Arti_kata": "apakah/maukah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَّكَ",
          "Arti_kata": "bagimu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "إِلَىٰٓ",
          "Arti_kata": "kepada (untuk)",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَن",
          "Arti_kata": "untuk",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "تَزَكَّىٰ",
          "Arti_kata": "kamu membersihkan diri",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5731,
      "Ayat_Arabic": "وَاَهْدِيَكَ اِلٰى رَبِّكَ فَتَخْشٰىۚ",
      "Text_Latin": "wa ahdiyaka ila rabbika fa takhsya",
      "Terjemah_in": "dan aku akan menunjukimu ke (jalan) Tuhanmu agar engkau takut (kepada-Nya)?’”",
      "Terjemahan_En": "And I will guide you to your Lord, and you will turn reverent.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَهۡدِيَكَ",
          "Arti_kata": "dan aku tunjukkan/pimpin kamu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِلَىٰ",
          "Arti_kata": "kepada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata": "Tuhanmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فَتَخۡشَىٰ",
          "Arti_kata": "maka (supaya) kamu takut",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5732,
      "Ayat_Arabic": "فَاَرٰىهُ الْاٰيَةَ الْكُبْرٰىۖ",
      "Text_Latin": "fa arahul-ayatal-kubra",
      "Terjemah_in": "Lalu, dia (Musa) memperlihatkan mukjizat yang besar kepadanya.",
      "Terjemahan_En": "He showed him the Greatest Miracle.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَرَىٰهُ",
          "Arti_kata": "maka dia memperlihatkan padanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡأٓيَةَ",
          "Arti_kata": "ayat-ayat/mu'jizat",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡكُبۡرَىٰ",
          "Arti_kata": "yang besar",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5733,
      "Ayat_Arabic": "فَكَذَّبَ وَعَصٰىۖ",
      "Text_Latin": "fa kazzaba wa 'asa",
      "Terjemah_in": "Akan tetapi, dia (Fir‘aun) mendustakan (kerasulan) dan mendurhakai (Allah).",
      "Terjemahan_En": "But he denied and defied.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَكَذَّبَ",
          "Arti_kata": "maka dia mendustakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَعَصَىٰ",
          "Arti_kata": "dan dia mendurhakai",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5734,
      "Ayat_Arabic": "ثُمَّ اَدْبَرَ يَسْعٰىۖ",
      "Text_Latin": "summa adbara yas'a",
      "Terjemah_in": "Kemudian, dia berpaling seraya berusaha (menantang Musa).",
      "Terjemahan_En": "Then turned his back, and tried.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ثُمَّ",
          "Arti_kata": "kemudian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَدۡبَرَ",
          "Arti_kata": "dia berpaling",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَسۡعَىٰ",
          "Arti_kata": "dia berusaha/berjalan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5735,
      "Ayat_Arabic": "فَحَشَرَ فَنَادٰىۖ",
      "Text_Latin": "fa hasyara fa nada",
      "Terjemah_in": "Maka, dia mengumpulkan (pembesar-pembesarnya), lalu berseru (memanggil kaumnya).",
      "Terjemahan_En": "And gathered and proclaimed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَحَشَرَ",
          "Arti_kata": "maka dia mengumpulkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فَنَادَىٰ",
          "Arti_kata": "lalu dia berseru",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5736,
      "Ayat_Arabic": "فَقَالَ اَنَا۠ رَبُّكُمُ الْاَعْلٰىۖ",
      "Text_Latin": "fa qala ana rabbukumul-a'la",
      "Terjemah_in": "Dia berkata, “Akulah Tuhanmu yang paling tinggi.”",
      "Terjemahan_En": "He said, “I am your Lord, the most high.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَقَالَ",
          "Arti_kata": "maka dia berkata",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَنَا۠",
          "Arti_kata": "aku",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبُّكُمُ",
          "Arti_kata": "Tuhan kalian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡأَعۡلَىٰ",
          "Arti_kata": "paling tinggi",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5737,
      "Ayat_Arabic": "فَاَخَذَهُ اللّٰهُ نَكَالَ الْاٰخِرَةِ وَالْاُوْلٰىۗ",
      "Text_Latin": "fa akhazahullahu nakalal-akhirati wal-ula",
      "Terjemah_in": "Maka, Allah menghukumnya dengan azab di akhirat dan (siksaan) di dunia.",
      "Terjemahan_En": "So God seized him with an exemplary punishment, in the last and in the first.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَخَذَهُ",
          "Arti_kata": "maka mengambil/menyiksanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱللَّهُ",
          "Arti_kata": "Allah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نَكَالَ",
          "Arti_kata": "siksa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡأٓخِرَةِ",
          "Arti_kata": "akhirat",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَٱلۡأُولَىٰٓ",
          "Arti_kata": "dan dunia",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5738,
      "Ayat_Arabic": "اِنَّ فِيْ ذٰلِكَ لَعِبْرَةً لِّمَنْ يَّخْشٰى ۗ ࣖ",
      "Text_Latin": "inna fi zalika la'ibratal limay yakhsya",
      "Terjemah_in": "Sesungguhnya pada yang demikian itu benar-benar terdapat pelajaran bagi orang yang takut (kepada Allah).",
      "Terjemahan_En": "In this is a lesson for whoever fears.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata": "sesungguhnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فِي",
          "Arti_kata": "di dalam",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ذَٰلِكَ",
          "Arti_kata": "itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَعِبۡرَةٗ",
          "Arti_kata": "benar-benar pelajaran",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "لِّمَن",
          "Arti_kata": "bagi orang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "يَخۡشَىٰٓ",
          "Arti_kata": "takut",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5739,
      "Ayat_Arabic": "ءَاَنْتُمْ اَشَدُّ خَلْقًا اَمِ السَّمَاۤءُ ۚ بَنٰىهَاۗ",
      "Text_Latin": "a antum asyaddu khalqan amis-sama', banaha",
      "Terjemah_in": "Apakah penciptaan kamu yang lebih hebat ataukah langit yang telah dibangun-Nya?",
      "Terjemahan_En": "Are you more difficult to create, or the heaven? He constructed it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ءَأَنتُمۡ",
          "Arti_kata": "apakah kamu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَشَدُّ",
          "Arti_kata": "sangat",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "خَلۡقًا",
          "Arti_kata": "penciptaan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَمِ",
          "Arti_kata": "atau",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلسَّمَآءُۚ",
          "Arti_kata": "langit",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "بَنَىٰهَا",
          "Arti_kata": "Dia telah membinanya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5740,
      "Ayat_Arabic": "رَفَعَ سَمْكَهَا فَسَوّٰىهَاۙ",
      "Text_Latin": "rafa'a samkaha fa sawwaha",
      "Terjemah_in": "Dia telah meninggikan bangunannya, lalu menyempurnakannya.",
      "Terjemahan_En": "He raised its masses, and proportioned it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "رَفَعَ",
          "Arti_kata": "Dia meninggikan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "سَمۡكَهَا",
          "Arti_kata": "bangunannya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَسَوَّىٰهَا",
          "Arti_kata": "lalu Dia sempurnakannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5741,
      "Ayat_Arabic": "وَاَغْطَشَ لَيْلَهَا وَاَخْرَجَ ضُحٰىهَاۖ",
      "Text_Latin": "wa agtasya lailaha wa akhraja duhaha",
      "Terjemah_in": "Dia menjadikan malamnya (gelap gulita) dan menjadikan siangnya (terang benderang).",
      "Terjemahan_En": "And He dimmed its night, and brought out its daylight.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَغۡطَشَ",
          "Arti_kata": "dan Dia jadikan gelap",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَيۡلَهَا",
          "Arti_kata": "malamnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَأَخۡرَجَ",
          "Arti_kata": "dan Dia keluarkan/jadikan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ضُحَىٰهَا",
          "Arti_kata": "paginya/siangnya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5742,
      "Ayat_Arabic": "وَالْاَرْضَ بَعْدَ ذٰلِكَ دَحٰىهَاۗ",
      "Text_Latin": "wal-arda ba'da zalika dahaha",
      "Terjemah_in": "Setelah itu, bumi Dia hamparkan (untuk dihuni).",
      "Terjemahan_En": "And the earth after that He spread.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡأَرۡضَ",
          "Arti_kata": "dan bumi",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بَعۡدَ",
          "Arti_kata": "sesudah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ذَٰلِكَ",
          "Arti_kata": "demikian itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "دَحَىٰهَآ",
          "Arti_kata": "Dia haparkannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5743,
      "Ayat_Arabic": "اَخْرَجَ مِنْهَا مَاۤءَهَا وَمَرْعٰىهَاۖ",
      "Text_Latin": "akhraja min-ha ma'aha wa mar'aha",
      "Terjemah_in": "Darinya (bumi) Dia mengeluarkan air dan (menyediakan) tempat penggembalaan.",
      "Terjemahan_En": "And from it, He produced its water and its pasture.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَخۡرَجَ",
          "Arti_kata": "Dia keluarkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مِنۡهَا",
          "Arti_kata": "dari padanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَآءَهَا",
          "Arti_kata": "airnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَمَرۡعَىٰهَا",
          "Arti_kata": "dan padang rumput/tumbuh-tumbuhannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5744,
      "Ayat_Arabic": "وَالْجِبَالَ اَرْسٰىهَاۙ",
      "Text_Latin": "wal-jibala arsaha",
      "Terjemah_in": "Gunung-gunung Dia pancangkan dengan kukuh.",
      "Terjemahan_En": "And the mountains, He anchored.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡجِبَالَ",
          "Arti_kata": "dan gunung-gunung",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَرۡسَىٰهَا",
          "Arti_kata": "Dia pancangkannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5745,
      "Ayat_Arabic": "مَتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْۗ",
      "Text_Latin": "mata'al lakum wa li'an'amikum",
      "Terjemah_in": "(Semua itu disediakan) untuk kesenanganmu dan hewan ternakmu.",
      "Terjemahan_En": "A source of enjoyment for you and for your animals.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مَتَٰعٗا",
          "Arti_kata": "kesenangan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَّكُمۡ",
          "Arti_kata": "bagi kalian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَلِأَنۡعَٰمِكُمۡ",
          "Arti_kata": "dan untuk binatang ternakmu",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5746,
      "Ayat_Arabic": "فَاِذَا جَاۤءَتِ الطَّاۤمَّةُ الْكُبْرٰىۖ",
      "Text_Latin": "fa iza ja'atit-tammatul-kubra",
      "Terjemah_in": "Maka, apabila malapetaka terbesar (hari Kiamat) telah datang,",
      "Terjemahan_En": "But when the Great Cataclysm arrives.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِذَا",
          "Arti_kata": "maka apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "جَآءَتِ",
          "Arti_kata": "telah datang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلطَّآمَّةُ",
          "Arti_kata": "keributan/malapetaka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡكُبۡرَىٰ",
          "Arti_kata": "besar",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5747,
      "Ayat_Arabic": "يَوْمَ يَتَذَكَّرُ الْاِنْسَانُ مَا سَعٰىۙ",
      "Text_Latin": "yauma yatazakkarul-insanu ma sa'a",
      "Terjemah_in": "pada hari (itu) manusia teringat apa yang telah dikerjakannya",
      "Terjemahan_En": "A Day when man will remember what he has endeavored.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَوۡمَ",
          "Arti_kata": "hari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَتَذَكَّرُ",
          "Arti_kata": "teringat",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَا",
          "Arti_kata": "apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "سَعَىٰ",
          "Arti_kata": "ia telah kerjakan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5748,
      "Ayat_Arabic": "وَبُرِّزَتِ الْجَحِيْمُ لِمَنْ يَّرٰى",
      "Text_Latin": "wa burrizatil-jahimu limay yara",
      "Terjemah_in": "dan (neraka) Jahim diperlihatkan dengan jelas kepada orang yang melihat(-nya).",
      "Terjemahan_En": "And Hell will be displayed to whoever sees.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَبُرِّزَتِ",
          "Arti_kata": "dan diperlihatkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡجَحِيمُ",
          "Arti_kata": "neraka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لِمَن",
          "Arti_kata": "bagi/kepada orang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَرَىٰ",
          "Arti_kata": "ia melihat",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5749,
      "Ayat_Arabic": "فَاَمَّا مَنْ طَغٰىۖ",
      "Text_Latin": "fa amma man taga",
      "Terjemah_in": "Adapun orang yang melampaui batas",
      "Terjemahan_En": "As for him who was defiant.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَمَّا",
          "Arti_kata": "maka adapun",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَن",
          "Arti_kata": "siapa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "طَغَىٰ",
          "Arti_kata": "melampui batas",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5750,
      "Ayat_Arabic": "وَاٰثَرَ الْحَيٰوةَ الدُّنْيَاۙ",
      "Text_Latin": "wa asaral-hayatad-dun-ya",
      "Terjemah_in": "dan lebih mengutamakan kehidupan dunia,",
      "Terjemahan_En": "And preferred the life of this world.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَءَاثَرَ",
          "Arti_kata": "dan ia senang/mengutamakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡحَيَوٰةَ",
          "Arti_kata": "kehidupan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلدُّنۡيَا",
          "Arti_kata": "dunia",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5751,
      "Ayat_Arabic": "فَاِنَّ الْجَحِيْمَ هِيَ الْمَأْوٰىۗ",
      "Text_Latin": "fa innal-jahima hiyal-ma'wa",
      "Terjemah_in": "sesungguhnya (neraka) Jahimlah tempat tinggal(-nya).",
      "Terjemahan_En": "Then Hell is the shelter.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِنَّ",
          "Arti_kata": "maka sesungguhnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡجَحِيمَ",
          "Arti_kata": "neraka",
          "Jenis_kata": null
        },
        {
