    },
    {
      "Nomor_ayat": 5752,
      "Ayat_Arabic": "وَاَمَّا مَنْ خَافَ مَقَامَ رَبِّهٖ وَنَهَى النَّفْسَ عَنِ الْهَوٰىۙ",
      "Text_Latin": "wa amma man khafa maqama rabbihi wa nahan-nafsa 'anil-hawa",
      "Terjemah_in": "Adapun orang-orang yang takut pada kebesaran Tuhannya dan menahan diri dari (keinginan) hawa nafsunya,",
      "Terjemahan_En": "But as for him who feared the Standing of his Lord, and restrained the self from desires.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَمَّا",
