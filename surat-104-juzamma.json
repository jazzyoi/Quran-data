{
  "Nomor_surat": 104,
  "Nama_surat": "Al-Humazah",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Ayat_arabic ": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍۙ",
      "Ayat_latin": "wailul likulli humazatil lumazah",
      "Terjemah_in": "Celakalah setiap pengumpat lagi pencela",
      "Terjemah_en": "Woe to every slanderer backbiter.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَيۡلٞ",
          "Arti_kata_in": "kecelakaan",
          "Arti_kata_en": "Woe",
          "Text_latin  ": "waylun"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "لِّكُلِّ",
          "Arti_kata_in": "bagi setiap",
          "Arti_kata_en": "to every",
          "Text_latin  ": "likulli"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "هُمَزَةٖ",
          "Arti_kata_in": "pengumpat",
          "Arti_kata_en": "slanderer",
          "Text_latin  ": "humazatin"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "لُّمَزَةٍ",
          "Arti_kata_in": "pencela",
          "Arti_kata_en": "backbiter!",
          "Text_latin  ": "lumazatin"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Ayat_arabic ": "ۨالَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗۙ",
      "Ayat_latin": "allazi jama'a malaw wa 'addadah",
      "Terjemah_in": "yang mengumpulkan harta dan menghitung-hitungnya.",
      "Terjemah_en": "Who gathers wealth and counts it over.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "The one who",
          "Text_latin  ": "alladhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "جَمَعَ",
          "Arti_kata_in": "mengumpulkan",
          "Arti_kata_en": "collects",
          "Text_latin  ": "jama'a"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مَالٗا",
          "Arti_kata_in": "harta",
          "Arti_kata_en": "wealth",
          "Text_latin  ": "malan"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "وَعَدَّدَهُۥ",
          "Arti_kata_in": "dan dia menghitungnya",
          "Arti_kata_en": "and counts it",
          "Text_latin  ": "wa'addadahu"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Ayat_arabic ": "يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗۚ",
      "Ayat_latin": "yahsabu anna malahu akhladah",
      "Terjemah_in": "Dia (manusia) mengira bahwa hartanya dapat mengekalkannya.",
      "Terjemah_en": "Thinking that his wealth has made him immortal.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "يَحۡسَبُ",
          "Arti_kata_in": "dia mengira",
          "Arti_kata_en": "Thinking",
          "Text_latin  ": "yahsabu"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "أَنَّ",
          "Arti_kata_in": "bahwasanya",
          "Arti_kata_en": "that",
          "Text_latin  ": "anna"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مَالَهُۥٓ",
          "Arti_kata_in": "hartanya",
          "Arti_kata_en": "his wealth",
          "Text_latin  ": "malahu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "أَخۡلَدَهُۥ",
          "Arti_kata_in": "mengekalkannya",
          "Arti_kata_en": "will make him immortal",
          "Text_latin  ": "akhladahu"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Ayat_arabic ": "كَلَّا لَيُنْۢبَذَنَّ فِى الْحُطَمَةِۖ",
      "Ayat_latin": "kalla layumbazanna fil-hutamah",
      "Terjemah_in": "Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Hutamah.",
      "Terjemah_en": "By no means. He will be thrown into the Crusher.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "كَلَّاۖ",
          "Arti_kata_in": "sekali-kali tidak",
          "Arti_kata_en": "Nay!",
          "Text_latin  ": "kalla"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "لَيُنۢبَذَنَّ",
          "Arti_kata_in": "sungguh dia akan dilemparkan",
          "Arti_kata_en": "Surely he will be thrown",
          "Text_latin  ": "layunbadhanna"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "in",
          "Text_latin  ": "fi"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلۡحُطَمَةِ",
          "Arti_kata_in": "Hutamah",
          "Arti_kata_en": "the Crusher",
          "Text_latin  ": "al-hutamati"
        }
      ]
    },
    {
      "Nomor_ayat": 5,
      "Ayat_arabic ": "وَمَآ اَدْرٰىكَ مَا الْحُطَمَةُ ۗ",
      "Ayat_latin": "wa ma adraka mal-hutamah",
      "Terjemah_in": "Tahukah kamu apakah (neraka) Hutamah?",
      "Terjemah_en": "And what will make you realize what the Crusher is?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَمَآ",
          "Arti_kata_in": "dan apakah",
          "Arti_kata_en": "And what",
          "Text_latin  ": "wama"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "أَدۡرَىٰكَ",
          "Arti_kata_in": "kamu tahu",
          "Arti_kata_en": "will make you know",
          "Text_latin  ": "adraka"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_latin  ": "ma"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلۡحُطَمَةُ",
          "Arti_kata_in": "Hutamah",
          "Arti_kata_en": "the Crusher (is)",
          "Text_latin  ": "al-hutamatu"
        }
      ]
    },
    {
      "Nomor_ayat": 6,
      "Ayat_arabic ": "نَارُ اللّٰهِ الْمُوْقَدَةُۙ",
      "Ayat_latin": "narullahil-muqadah",
      "Terjemah_in": "(Ia adalah) api (azab) Allah yang dinyalakan",
      "Terjemah_en": "God's kindled Fire.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "نَارُ",
          "Arti_kata_in": "api",
          "Arti_kata_en": "A Fire",
          "Text_latin  ": "naru"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱللَّهِ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "Allah",
          "Text_latin  ": "al-lahi"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلۡمُوقَدَةُ",
          "Arti_kata_in": "dinyalakan",
          "Arti_kata_en": "kindled",
          "Text_latin  ": "al-muqadatu"
        }
      ]
    },
    {
      "Nomor_ayat": 7,
      "Ayat_arabic ": "الَّتِيْ تَطَّلِعُ عَلَى الْاَفْـِٕدَةِۗ",
      "Ayat_latin": "allati tattali'u 'alal-af'idah",
      "Terjemah_in": "yang (membakar) naik sampai ke hati.",
      "Terjemah_en": "That laps to the hearts.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ٱلَّتِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "Which",
          "Text_latin  ": "allati"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "تَطَّلِعُ",
          "Arti_kata_in": "naik",
          "Arti_kata_en": "mounts up",
          "Text_latin  ": "tattali'u"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "عَلَى",
          "Arti_kata_in": "ke atas/sampai",
          "Arti_kata_en": "to",
          "Text_latin  ": "ala"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلۡأَفِۡٔدَةِ",
          "Arti_kata_in": "hati",
          "Arti_kata_en": "the hearts",
          "Text_latin  ": "al-afidati"
        }
      ]
    },
    {
      "Nomor_ayat": 8,
      "Ayat_arabic ": "اِنَّهَا عَلَيْهِمْ مُّؤْصَدَةٌۙ",
      "Ayat_latin": "innaha 'alaihim mu'sadah",
      "Terjemah_in": "Sesungguhnya dia (api itu) tertutup rapat (sebagai hukuman) atas mereka,",
      "Terjemah_en": "It closes in on them.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "إِنَّهَا",
          "Arti_kata_in": "sesungguhnya ia (api)",
          "Arti_kata_en": "Indeed it",
          "Text_latin  ": "innaha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "عَلَيۡهِم",
          "Arti_kata_in": "atas mereka",
          "Arti_kata_en": "(will be) upon them",
          "Text_latin  ": "alayhim"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مُّؤۡصَدَةٞ",
          "Arti_kata_in": "terikat/ditutup rapat",
          "Arti_kata_en": "closed over",
          "Text_latin  ": "mu'sadatun"
        }
      ]
    },
    {
      "Nomor_ayat": 9,
      "Ayat_arabic ": "فِيْ عَمَدٍ مُّمَدَّدَةٍ ࣖ",
      "Ayat_latin": "fi 'amadim mumaddadah",
      "Terjemah_in": "(sedangkan mereka) diikat pada tiang-tiang yang panjang.",
      "Terjemah_en": "In extended columns.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فِي",
          "Arti_kata_in": "dalam/pada",
          "Arti_kata_en": "In",
          "Text_latin  ": "fi"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "عَمَدٖ",
          "Arti_kata_in": "tiang",
          "Arti_kata_en": "columns",
          "Text_latin  ": "amadin"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مُّمَدَّدَةِۭ",
          "Arti_kata_in": "panjang",
          "Arti_kata_en": "extended",
          "Text_latin  ": "mumaddadatin"
        }
      ]
    }
  ]
}