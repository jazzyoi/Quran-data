{
  "Nomor_surat": 86,
  "Nama_surat": "Ath-Thariq",
  "surat_arabic": "الطارق",
  "Arti_surat_in": "Yang Datang di Malam Hari",
  "Arti_surat_en": "The Nightcommer",
  "Ayat": [
    {
      "Nomor_ayat": 5932,
      "Ayat_Arabic": "وَالسَّمَاۤءِ وَالطَّارِقِۙ",
      "Text_Latin": "was-sama'i wat-tariq",
      "Terjemah_in": "Demi langit dan yang datang pada malam hari.",
      "Terjemahan_En": "By the sky and at-Tariq.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلسَّمَآءِ",
          "Arti_kata_in": "dan langit",
          "Arti_kata_en": "By the sky",
          "Text_Latin": "was-samai",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَٱلطَّارِقِ",
          "Arti_kata_in": "dan yang datang di malam hari",
          "Arti_kata_en": "and the night comer",
          "Text_Latin": "wat-tariqi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5933,
      "Ayat_Arabic": "وَمَآ اَدْرٰىكَ مَا الطَّارِقُۙ",
      "Text_Latin": "wa ma adraka mat-tariq",
      "Terjemah_in": "Tahukah kamu apakah yang datang pada malam hari itu?",
      "Terjemahan_En": "But what will let you know what at-Tariq is?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَآ",
          "Arti_kata_in": "dan apa",
          "Arti_kata_en": "And what",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَدۡرَىٰكَ",
          "Arti_kata_in": "kamu tahu",
          "Arti_kata_en": "can make you know",
          "Text_Latin": "adraka",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلطَّارِقُ",
          "Arti_kata_in": "yang datang dimalam hari",
          "Arti_kata_en": "the night comer (is)",
          "Text_Latin": "at-tariqu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5934,
      "Ayat_Arabic": "النَّجْمُ الثَّاقِبُۙ",
      "Text_Latin": "an-najmus-saqib",
      "Terjemah_in": "(Itulah) bintang yang bersinar tajam.",
      "Terjemahan_En": "The Piercing Star.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلنَّجۡمُ",
          "Arti_kata_in": "bintang",
          "Arti_kata_en": "(It is) the star",
          "Text_Latin": "an-najmu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلثَّاقِبُ",
          "Arti_kata_in": "cemerlang/menembus",
          "Arti_kata_en": "the piercing!",
          "Text_Latin": "at-thaqibu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5935,
      "Ayat_Arabic": "اِنْ كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌۗ",
      "Text_Latin": "ing kullu nafsil lamma 'alaiha hafiz",
      "Terjemah_in": "Setiap orang pasti ada penjaganya.",
      "Terjemahan_En": "There is no soul without a Protector over it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِن",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "Not",
          "Text_Latin": "in",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "كُلُّ",
          "Arti_kata_in": "setiap",
          "Arti_kata_en": "(is) every",
          "Text_Latin": "kullu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نَفۡسٖ",
          "Arti_kata_in": "jiwa/diri",
          "Arti_kata_en": "soul",
          "Text_Latin": "nafsin",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَّمَّا",
          "Arti_kata_in": "melainkan",
          "Arti_kata_en": "but",
          "Text_Latin": "lamma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "عَلَيۡهَا",
          "Arti_kata_in": "atasnya",
          "Arti_kata_en": "over it",
          "Text_Latin": "alayha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "حَافِظٞ",
          "Arti_kata_in": "penjaga",
          "Arti_kata_en": "(is) a protector",
          "Text_Latin": "hafizun",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5936,
      "Ayat_Arabic": "فَلْيَنْظُرِ الْاِنْسَانُ مِمَّ خُلِقَ",
      "Text_Latin": "falyanzuril-insanu mimma khuliq",
      "Terjemah_in": "Hendaklah manusia memperhatikan dari apa dia diciptakan.",
      "Terjemahan_En": "Let man consider what he was created from.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَلۡيَنظُرِ",
          "Arti_kata_in": "maka hendaklah memperhatikan",
          "Arti_kata_en": "So let see",
          "Text_Latin": "falyanzuri",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "man",
          "Text_Latin": "al-insanu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مِمَّ",
          "Arti_kata_in": "dari apa",
          "Arti_kata_en": "from what",
          "Text_Latin": "mimma",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "خُلِقَ",
          "Arti_kata_in": "ia diciptakan",
          "Arti_kata_en": "he is created",
          "Text_Latin": "khuliqa",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 5937,
      "Ayat_Arabic": "خُلِقَ مِنْ مَّاۤءٍ دَافِقٍۙ",
      "Text_Latin": "khuliqa mim ma'in dafiq",
      "Terjemah_in": "Dia diciptakan dari air (mani) yang memancar,",
      "Terjemahan_En": "He was created from gushing liquid.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "خُلِقَ",
          "Arti_kata_in": "ia diciptakan",
          "Arti_kata_en": "He is created",
          "Text_Latin": "khuliqa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مِن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "from",
          "Text_Latin": "min",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَّآءٖ",
          "Arti_kata_in": "air",
          "Arti_kata_en": "a water",
          "Text_Latin": "main",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "دَافِقٖ",
          "Arti_kata_in": "terpancar",
          "Arti_kata_en": "ejected",
          "Text_Latin": "dafiqin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5938,
      "Ayat_Arabic": "يَّخْرُجُ مِنْۢ بَيْنِ الصُّلْبِ وَالتَّرَاۤىِٕبِۗ",
      "Text_Latin": "yakhruju mim bainis-sulbi wat-tara'ib",
      "Terjemah_in": "yang keluar dari antara tulang sulbi (punggung) dan tulang dada.",
      "Terjemahan_En": "Issuing from between the backbone and the breastbones.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَخۡرُجُ",
          "Arti_kata_in": "ia keluar",
          "Arti_kata_en": "Coming forth",
          "Text_Latin": "yakhruju",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مِنۢ",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "from",
          "Text_Latin": "min",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بَيۡنِ",
          "Arti_kata_in": "antara",
          "Arti_kata_en": "between",
          "Text_Latin": "bayni",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلصُّلۡبِ",
          "Arti_kata_in": "tulang belakang",
          "Arti_kata_en": "the backbone",
          "Text_Latin": "as-sul'bi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَٱلتَّرَآئِبِ",
          "Arti_kata_in": "dan tulang dada",
          "Arti_kata_en": "and the ribs",
          "Text_Latin": "wat-taraibi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5939,
      "Ayat_Arabic": "اِنَّهٗ عَلٰى رَجْعِهٖ لَقَادِرٌۗ",
      "Text_Latin": "innahu 'ala raj'ihi laqadir",
      "Terjemah_in": "Sesungguhnya Dia (Allah) benar-benar kuasa untuk mengembalikannya (hidup setelah mati)",
      "Terjemahan_En": "He is certainly able to return him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّهُۥ",
          "Arti_kata_in": "sesungguhnya Dia",
          "Arti_kata_en": "Indeed He",
          "Text_Latin": "innahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَلَىٰ",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "to",
          "Text_Latin": "ala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَجۡعِهِۦ",
          "Arti_kata_in": "mengembalikanya",
          "Arti_kata_en": "return him",
          "Text_Latin": "raj'ihi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَقَادِرٞ",
          "Arti_kata_in": "benar-benar berkuasa",
          "Arti_kata_en": "(is) Able",
          "Text_Latin": "laqadirun",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5940,
      "Ayat_Arabic": "يَوْمَ تُبْلَى السَّرَاۤىِٕرُۙ",
      "Text_Latin": "yauma tublas-sara'ir",
      "Terjemah_in": "pada hari ditampakkan segala rahasia.",
      "Terjemahan_En": "On the Day when the secrets are disclosed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَوۡمَ",
          "Arti_kata_in": "hari",
          "Arti_kata_en": "(The) Day",
          "Text_Latin": "yawma",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تُبۡلَى",
          "Arti_kata_in": "dibuka/dinampakkan",
          "Arti_kata_en": "will be tested",
          "Text_Latin": "tub'la",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلسَّرَآئِرُ",
          "Arti_kata_in": "rahasia-rahasia",
          "Arti_kata_en": "the secrets",
          "Text_Latin": "as-sarairu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5941,
      "Ayat_Arabic": "فَمَا لَهٗ مِنْ قُوَّةٍ وَّلَا نَاصِرٍۗ",
      "Text_Latin": "fa ma lahu ming quwwatiw wa la nasir",
      "Terjemah_in": "Maka, baginya (manusia) tidak ada lagi kekuatan dan tidak (pula) ada penolong.",
      "Terjemahan_En": "He will have no strength, and no supporter.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَمَا",
          "Arti_kata_in": "maka tidak",
          "Arti_kata_en": "Then not",
          "Text_Latin": "fama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَهُۥ",
          "Arti_kata_in": "baginya",
          "Arti_kata_en": "(is) for him",
          "Text_Latin": "lahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مِن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "any",
          "Text_Latin": "min",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "قُوَّةٖ",
          "Arti_kata_in": "kekuatan",
          "Arti_kata_en": "power",
          "Text_Latin": "quwwatin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَلَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "and not",
          "Text_Latin": "wala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "نَاصِرٖ",
          "Arti_kata_in": "seorang penolong",
          "Arti_kata_en": "any helper",
          "Text_Latin": "nasirin",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5942,
      "Ayat_Arabic": "وَالسَّمَاۤءِ ذَاتِ الرَّجْعِۙ",
      "Text_Latin": "was-sama'i zatir-raj'",
      "Terjemah_in": "Demi langit yang mengandung hujan753)",
      "Terjemahan_En": "By the sky that returns.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلسَّمَآءِ",
          "Arti_kata_in": "dan langit",
          "Arti_kata_en": "By the sky",
          "Text_Latin": "was-samai",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ذَاتِ",
          "Arti_kata_in": "mempunyai/mengandung",
          "Arti_kata_en": "which",
          "Text_Latin": "dhati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلرَّجۡعِ",
          "Arti_kata_in": "air/hujan",
          "Arti_kata_en": "returns",
          "Text_Latin": "ar-raj'i",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5943,
      "Ayat_Arabic": "وَالْاَرْضِ ذَاتِ الصَّدْعِۙ",
      "Text_Latin": "wal-ardi zatis-sad'",
      "Terjemah_in": "dan bumi yang memiliki rekahan (tempat tumbuhnya pepohonan),",
      "Terjemahan_En": "And the earth that cracks open.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡأَرۡضِ",
          "Arti_kata_in": "dan bumi",
          "Arti_kata_en": "And the earth",
          "Text_Latin": "wal-ardi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ذَاتِ",
          "Arti_kata_in": "mempunyai",
          "Arti_kata_en": "which",
          "Text_Latin": "dhati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلصَّدۡعِ",
          "Arti_kata_in": "tumbuh-tumbuhan",
          "Arti_kata_en": "cracks open",
          "Text_Latin": "as-sad'i",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5944,
      "Ayat_Arabic": "اِنَّهٗ لَقَوْلٌ فَصْلٌۙ",
      "Text_Latin": "innahu laqaulun fasl",
      "Terjemah_in": "sesungguhnya (Al-Qur’an) itu benar-benar firman pemisah (antara yang hak dan yang batil)",
      "Terjemahan_En": "It is a Decisive Word.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّهُۥ",
          "Arti_kata_in": "sesungguhnya ia (Al Qur'an)",
          "Arti_kata_en": "Indeed it",
          "Text_Latin": "innahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَقَوۡلٞ",
          "Arti_kata_in": "perkataan/firman",
          "Arti_kata_en": "(is) surely a Word",
          "Text_Latin": "laqawlun",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَصۡلٞ",
          "Arti_kata_in": "terpisah",
          "Arti_kata_en": "decisive",
          "Text_Latin": "faslun",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5945,
      "Ayat_Arabic": "وَّمَا هُوَ بِالْهَزْلِۗ",
      "Text_Latin": "wa ma huwa bil-hazl",
      "Terjemah_in": "dan ia (Al-Qur’an) sama sekali bukan perkataan senda gurau.",
      "Terjemahan_En": "It is no joke.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And not",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُوَ",
          "Arti_kata_in": "ia (Al Qur'an)",
          "Arti_kata_en": "it",
          "Text_Latin": "huwa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلۡهَزۡلِ",
          "Arti_kata_in": "dengan sia-sia/senda gurau",
          "Arti_kata_en": "(is) for amusement",
          "Text_Latin": "bil-hazli",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5946,
      "Ayat_Arabic": "اِنَّهُمْ يَكِيْدُوْنَ كَيْدًاۙ",
      "Text_Latin": "innahum yakiduna kaida",
      "Terjemah_in": "Sesungguhnya mereka (orang kafir) melakukan tipu daya.",
      "Terjemahan_En": "They plot and scheme.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّهُمۡ",
          "Arti_kata_in": "sesungguhnya mereka",
          "Arti_kata_en": "Indeed they",
          "Text_Latin": "innahum",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَكِيدُونَ",
          "Arti_kata_in": "mereka membuat tipu daya",
          "Arti_kata_en": "are plotting",
          "Text_Latin": "yakiduna",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كَيۡدٗا",
