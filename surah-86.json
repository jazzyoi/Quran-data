{
  "Nomor_surat": 86,
  "Nama_surat": "Ath-Thariq",
  "surat_arabic": "الطارق",
  "Arti_surat_in": "Yang Datang di Malam Hari",
  "Arti_surat_en": "The Nightcommer",
  "Ayat": [
    {
      "Nomor_ayat": 5932,
      "Ayat_Arabic": "وَالسَّمَاۤءِ وَالطَّارِقِۙ",
      "Text_Latin": "was-sama'i wat-tariq",
      "Terjemah_in": "Demi langit dan yang datang pada malam hari.",
      "Terjemahan_En": "By the sky and at-Tariq.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلسَّمَآءِ",
          "Arti_kata": "dan langit",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَٱلطَّارِقِ",
          "Arti_kata": "dan yang datang di malam hari",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5933,
      "Ayat_Arabic": "وَمَآ اَدْرٰىكَ مَا الطَّارِقُۙ",
      "Text_Latin": "wa ma adraka mat-tariq",
      "Terjemah_in": "Tahukah kamu apakah yang datang pada malam hari itu?",
      "Terjemahan_En": "But what will let you know what at-Tariq is?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَآ",
          "Arti_kata": "dan apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَدۡرَىٰكَ",
          "Arti_kata": "kamu tahu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata": "apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلطَّارِقُ",
          "Arti_kata": "yang datang dimalam hari",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5934,
      "Ayat_Arabic": "النَّجْمُ الثَّاقِبُۙ",
      "Text_Latin": "an-najmus-saqib",
      "Terjemah_in": "(Itulah) bintang yang bersinar tajam.",
      "Terjemahan_En": "The Piercing Star.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلنَّجۡمُ",
          "Arti_kata": "bintang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلثَّاقِبُ",
          "Arti_kata": "cemerlang/menembus",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5935,
      "Ayat_Arabic": "اِنْ كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌۗ",
      "Text_Latin": "ing kullu nafsil lamma 'alaiha hafiz",
      "Terjemah_in": "Setiap orang pasti ada penjaganya.",
      "Terjemahan_En": "There is no soul without a Protector over it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِن",
          "Arti_kata": "tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "كُلُّ",
          "Arti_kata": "setiap",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نَفۡسٖ",
          "Arti_kata": "jiwa/diri",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَّمَّا",
          "Arti_kata": "melainkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "عَلَيۡهَا",
          "Arti_kata": "atasnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "حَافِظٞ",
          "Arti_kata": "penjaga",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5936,
      "Ayat_Arabic": "فَلْيَنْظُرِ الْاِنْسَانُ مِمَّ خُلِقَ",
      "Text_Latin": "falyanzuril-insanu mimma khuliq",
      "Terjemah_in": "Hendaklah manusia memperhatikan dari apa dia diciptakan.",
      "Terjemahan_En": "Let man consider what he was created from.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَلۡيَنظُرِ",
          "Arti_kata": "maka hendaklah memperhatikan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مِمَّ",
          "Arti_kata": "dari apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "خُلِقَ",
          "Arti_kata": "ia diciptakan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5937,
      "Ayat_Arabic": "خُلِقَ مِنْ مَّاۤءٍ دَافِقٍۙ",
      "Text_Latin": "khuliqa mim ma'in dafiq",
      "Terjemah_in": "Dia diciptakan dari air (mani) yang memancar,",
      "Terjemahan_En": "He was created from gushing liquid.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "خُلِقَ",
          "Arti_kata": "ia diciptakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مِن",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَّآءٖ",
          "Arti_kata": "air",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "دَافِقٖ",
          "Arti_kata": "terpancar",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5938,
      "Ayat_Arabic": "يَّخْرُجُ مِنْۢ بَيْنِ الصُّلْبِ وَالتَّرَاۤىِٕبِۗ",
      "Text_Latin": "yakhruju mim bainis-sulbi wat-tara'ib",
      "Terjemah_in": "yang keluar dari antara tulang sulbi (punggung) dan tulang dada.",
      "Terjemahan_En": "Issuing from between the backbone and the breastbones.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَخۡرُجُ",
          "Arti_kata": "ia keluar",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مِنۢ",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بَيۡنِ",
          "Arti_kata": "antara",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلصُّلۡبِ",
          "Arti_kata": "tulang belakang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَٱلتَّرَآئِبِ",
          "Arti_kata": "dan tulang dada",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5939,
      "Ayat_Arabic": "اِنَّهٗ عَلٰى رَجْعِهٖ لَقَادِرٌۗ",
      "Text_Latin": "innahu 'ala raj'ihi laqadir",
      "Terjemah_in": "Sesungguhnya Dia (Allah) benar-benar kuasa untuk mengembalikannya (hidup setelah mati)",
      "Terjemahan_En": "He is certainly able to return him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّهُۥ",
          "Arti_kata": "sesungguhnya Dia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَلَىٰ",
          "Arti_kata": "atas",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَجۡعِهِۦ",
          "Arti_kata": "mengembalikanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَقَادِرٞ",
          "Arti_kata": "benar-benar berkuasa",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5940,
      "Ayat_Arabic": "يَوْمَ تُبْلَى السَّرَاۤىِٕرُۙ",
      "Text_Latin": "yauma tublas-sara'ir",
      "Terjemah_in": "pada hari ditampakkan segala rahasia.",
      "Terjemahan_En": "On the Day when the secrets are disclosed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَوۡمَ",
          "Arti_kata": "hari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تُبۡلَى",
          "Arti_kata": "dibuka/dinampakkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلسَّرَآئِرُ",
          "Arti_kata": "rahasia-rahasia",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5941,
      "Ayat_Arabic": "فَمَا لَهٗ مِنْ قُوَّةٍ وَّلَا نَاصِرٍۗ",
      "Text_Latin": "fa ma lahu ming quwwatiw wa la nasir",
      "Terjemah_in": "Maka, baginya (manusia) tidak ada lagi kekuatan dan tidak (pula) ada penolong.",
      "Terjemahan_En": "He will have no strength, and no supporter.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَمَا",
          "Arti_kata": "maka tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَهُۥ",
          "Arti_kata": "baginya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مِن",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "قُوَّةٖ",
          "Arti_kata": "kekuatan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَلَا",
          "Arti_kata": "dan tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "نَاصِرٖ",
          "Arti_kata": "seorang penolong",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5942,
      "Ayat_Arabic": "وَالسَّمَاۤءِ ذَاتِ الرَّجْعِۙ",
      "Text_Latin": "was-sama'i zatir-raj'",
      "Terjemah_in": "Demi langit yang mengandung hujan753)",
      "Terjemahan_En": "By the sky that returns.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلسَّمَآءِ",
          "Arti_kata": "dan langit",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ذَاتِ",
          "Arti_kata": "mempunyai/mengandung",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلرَّجۡعِ",
          "Arti_kata": "air/hujan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5943,
      "Ayat_Arabic": "وَالْاَرْضِ ذَاتِ الصَّدْعِۙ",
      "Text_Latin": "wal-ardi zatis-sad'",
      "Terjemah_in": "dan bumi yang memiliki rekahan (tempat tumbuhnya pepohonan),",
      "Terjemahan_En": "And the earth that cracks open.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡأَرۡضِ",
          "Arti_kata": "dan bumi",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ذَاتِ",
          "Arti_kata": "mempunyai",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلصَّدۡعِ",
          "Arti_kata": "tumbuh-tumbuhan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5944,
      "Ayat_Arabic": "اِنَّهٗ لَقَوْلٌ فَصْلٌۙ",
      "Text_Latin": "innahu laqaulun fasl",
      "Terjemah_in": "sesungguhnya (Al-Qur’an) itu benar-benar firman pemisah (antara yang hak dan yang batil)",
      "Terjemahan_En": "It is a Decisive Word.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّهُۥ",
          "Arti_kata": "sesungguhnya ia (Al Qur'an)",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَقَوۡلٞ",
          "Arti_kata": "perkataan/firman",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَصۡلٞ",
          "Arti_kata": "terpisah",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5945,
      "Ayat_Arabic": "وَّمَا هُوَ بِالْهَزْلِۗ",
      "Text_Latin": "wa ma huwa bil-hazl",
      "Terjemah_in": "dan ia (Al-Qur’an) sama sekali bukan perkataan senda gurau.",
      "Terjemahan_En": "It is no joke.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَا",
          "Arti_kata": "dan tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُوَ",
          "Arti_kata": "ia (Al Qur'an)",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلۡهَزۡلِ",
          "Arti_kata": "dengan sia-sia/senda gurau",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5946,
      "Ayat_Arabic": "اِنَّهُمْ يَكِيْدُوْنَ كَيْدًاۙ",
      "Text_Latin": "innahum yakiduna kaida",
      "Terjemah_in": "Sesungguhnya mereka (orang kafir) melakukan tipu daya.",
      "Terjemahan_En": "They plot and scheme.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّهُمۡ",
          "Arti_kata": "sesungguhnya mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَكِيدُونَ",
          "Arti_kata": "mereka membuat tipu daya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كَيۡدٗا",
          "Arti_kata": "tipu daya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5947,
      "Ayat_Arabic": "وَّاَكِيْدُ كَيْدًاۖ",
      "Text_Latin": "wa akidu kaida",
      "Terjemah_in": "Aku pun membalasnya dengan tipu daya.",
      "Terjemahan_En": "But I plot and scheme.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَكِيدُ",
          "Arti_kata": "dan AKu membuat tipu daya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "كَيۡدٗا",
          "Arti_kata": "tipu daya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5948,
      "Ayat_Arabic": "فَمَهِّلِ الْكٰفِرِيْنَ اَمْهِلْهُمْ رُوَيْدًا ࣖ",
      "Text_Latin": "fa mahhilil-kafirina am-hil-hum ruwaida",
      "Terjemah_in": "Maka, tangguhkanlah orang-orang kafir itu. Biarkanlah mereka sejenak (bersenang-senang).",
      "Terjemahan_En": "Therefore, give the blasphemers respite, a brief respite.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَمَهِّلِ",
          "Arti_kata": "maka beri tangguhlah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡكَٰفِرِينَ",
          "Arti_kata": "orang-orang kafir",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَمۡهِلۡهُمۡ",
          "Arti_kata": "beritangguhlah mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "رُوَيۡدَۢا",
          "Arti_kata": "sedikit/sebentar",
          "Jenis_kata": null
        }
      ]
    }
  ]
}