{
  "Nomor_surat": 90,
  "Nama_surat": "Al-Balad",
  "surat_arabic": "البلد",
  "Arti_surat_in": "Negeri",
  "Arti_surat_en": "The City",
  "Ayat": [
    {
      "Nomor_ayat": 6024,
      "Ayat_Arabic": "لَآ اُقْسِمُ بِهٰذَا الْبَلَدِۙ",
      "Text_Latin": "la uqsimu bihazal-balad",
      "Terjemah_in": "Aku bersumpah demi negeri ini (Makkah),",
      "Terjemahan_En": "I swear by this land.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَآ",
          "Arti_kata_in": "sungguh",
          "Arti_kata_en": "Nay!",
          "Text_Latin": "la",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أُقۡسِمُ",
          "Arti_kata_in": "Aku bersumpah",
          "Arti_kata_en": "I swear",
          "Text_Latin": "uq'simu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِهَٰذَا",
          "Arti_kata_in": "dengan ini",
          "Arti_kata_en": "by this",
          "Text_Latin": "bihadha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡبَلَدِ",
          "Arti_kata_in": "negeri",
          "Arti_kata_en": "city",
          "Text_Latin": "al-baladi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6025,
      "Ayat_Arabic": "وَاَنْتَ حِلٌّۢ بِهٰذَا الْبَلَدِۙ",
      "Text_Latin": "wa anta hillum bihazal-balad",
      "Terjemah_in": "sedangkan engkau (Nabi Muhammad) bertempat tinggal di negeri (Makkah) ini.",
      "Terjemahan_En": "And you are a resident of this land.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَنتَ",
          "Arti_kata_in": "dan kamu",
          "Arti_kata_en": "And you",
          "Text_Latin": "wa-anta",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "حِلُّۢ",
          "Arti_kata_in": "halal/bertempat",
          "Arti_kata_en": "(are) free (to dwell)",
          "Text_Latin": "hillun",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِهَٰذَا",
          "Arti_kata_in": "dengan ini",
          "Arti_kata_en": "in this",
          "Text_Latin": "bihadha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡبَلَدِ",
          "Arti_kata_in": "negeri",
          "Arti_kata_en": "city",
          "Text_Latin": "al-baladi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6026,
      "Ayat_Arabic": "وَوَالِدٍ وَّمَا وَلَدَۙ",
      "Text_Latin": "wa walidiw wa ma walad",
      "Terjemah_in": "(Aku juga bersumpah) demi bapak dan anaknya,",
      "Terjemahan_En": "And by a father and what he fathered.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَوَالِدٖ",
          "Arti_kata_in": "demi bapak",
          "Arti_kata_en": "And the begetter",
          "Text_Latin": "wawalidin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَمَا",
          "Arti_kata_in": "dan apa",
          "Arti_kata_en": "and what",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَلَدَ",
          "Arti_kata_in": "ia lahirkan (anak)",
          "Arti_kata_en": "he begot",
          "Text_Latin": "walada",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6027,
      "Ayat_Arabic": "لَقَدْ خَلَقْنَا الْاِنْسَانَ فِيْ كَبَدٍۗ",
      "Text_Latin": "laqad khalaqnal-insana fi kabad",
      "Terjemah_in": "sungguh, Kami benar-benar telah menciptakan manusia dalam keadaan susah payah.",
      "Terjemahan_En": "We created man in distress.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَقَدۡ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Certainly",
          "Text_Latin": "laqad",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "خَلَقۡنَا",
          "Arti_kata_in": "Kami telah menciptakan",
          "Arti_kata_en": "We have created",
          "Text_Latin": "khalaqna",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "man",
          "Text_Latin": "al-insana",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "(to be) in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "كَبَدٍ",
          "Arti_kata_in": "susah payah",
          "Arti_kata_en": "hardship",
          "Text_Latin": "kabadin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6028,
      "Ayat_Arabic": "اَيَحْسَبُ اَنْ لَّنْ يَّقْدِرَ عَلَيْهِ اَحَدٌ ۘ",
      "Text_Latin": "a yahsabu al lay yaqdira 'alaihi ahad",
      "Terjemah_in": "Apakah dia (manusia) itu mengira bahwa tidak ada seorang pun yang berkuasa atasnya?",
      "Terjemahan_En": "Does he think that no one has power over him?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَيَحۡسَبُ",
          "Arti_kata_in": "apakah (manusia) menyangka",
          "Arti_kata_en": "Does he think",
          "Text_Latin": "ayahsabu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَن",
          "Arti_kata_in": "bahwa",
          "Arti_kata_en": "that",
          "Text_Latin": "an",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَّن",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "not",
          "Text_Latin": "lan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَقۡدِرَ",
          "Arti_kata_in": "berkuasa",
          "Arti_kata_en": "has power",
          "Text_Latin": "yaqdira",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "عَلَيۡهِ",
          "Arti_kata_in": "atasnya",
          "Arti_kata_en": "over him",
          "Text_Latin": "alayhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "أَحَدٞ",
          "Arti_kata_in": "seseorang/satu",
          "Arti_kata_en": "anyone",
          "Text_Latin": "ahadun",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6029,
      "Ayat_Arabic": "يَقُوْلُ اَهْلَكْتُ مَالًا لُّبَدًاۗ",
      "Text_Latin": "yaqulu ahlaktu malal lubada",
      "Terjemah_in": "Dia mengatakan, “Aku telah menghabiskan harta yang banyak.”",
      "Terjemahan_En": "He says, “I have used up so much money.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَقُولُ",
          "Arti_kata_in": "ia berkata",
          "Arti_kata_en": "He will say",
          "Text_Latin": "yaqulu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَهۡلَكۡتُ",
          "Arti_kata_in": "aku telah binasakan/habiskan",
          "Arti_kata_en": "I have squandered",
          "Text_Latin": "ahlaktu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَالٗا",
          "Arti_kata_in": "harta",
          "Arti_kata_en": "wealth",
          "Text_Latin": "malan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لُّبَدًا",
          "Arti_kata_in": "banyak",
          "Arti_kata_en": "abundant",
          "Text_Latin": "lubadan",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6030,
      "Ayat_Arabic": "اَيَحْسَبُ اَنْ لَّمْ يَرَهٗٓ اَحَدٌۗ",
      "Text_Latin": "a yahsabu al lam yarahu ahad",
      "Terjemah_in": "Apakah dia mengira bahwa tidak ada seorang pun yang melihatnya?",
      "Terjemahan_En": "Does he think that no one sees him?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَيَحۡسَبُ",
          "Arti_kata_in": "apakah ia menyangka",
          "Arti_kata_en": "Does he think",
          "Text_Latin": "ayahsabu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَن",
          "Arti_kata_in": "bahwa",
          "Arti_kata_en": "that",
          "Text_Latin": "an",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَّمۡ",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "not",
          "Text_Latin": "lam",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَرَهُۥٓ",
          "Arti_kata_in": "berkuasa",
          "Arti_kata_en": "sees him",
          "Text_Latin": "yarahu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَحَدٌ",
          "Arti_kata_in": "seorang/satu",
          "Arti_kata_en": "anyone",
          "Text_Latin": "ahadun",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6031,
      "Ayat_Arabic": "اَلَمْ نَجْعَلْ لَّهٗ عَيْنَيْنِۙ",
      "Text_Latin": "a lam naj'al lahu 'ainain",
      "Terjemah_in": "Bukankah Kami telah menjadikan untuknya sepasang mata,",
      "Terjemahan_En": "Did We not give him two eyes?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَلَمۡ",
          "Arti_kata_in": "bukankah",
          "Arti_kata_en": "Have not",
          "Text_Latin": "alam",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَجۡعَل",
          "Arti_kata_in": "Kami jadikan",
          "Arti_kata_en": "We made",
          "Text_Latin": "naj'al",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَّهُۥ",
          "Arti_kata_in": "baginya",
          "Arti_kata_en": "for him",
          "Text_Latin": "lahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "عَيۡنَيۡنِ",
          "Arti_kata_in": "dua buah mata",
          "Arti_kata_en": "two eyes",
          "Text_Latin": "aynayni",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6032,
      "Ayat_Arabic": "وَلِسَانًا وَّشَفَتَيْنِۙ",
      "Text_Latin": "wa lisanaw wa syafatain",
      "Terjemah_in": "lidah, dan sepasang bibir,",
      "Terjemahan_En": "And a tongue, and two lips?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلِسَانٗا",
          "Arti_kata_in": "dan lisan/lidah",
          "Arti_kata_en": "And a tongue",
          "Text_Latin": "walisanan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَشَفَتَيۡنِ",
          "Arti_kata_in": "dan dua buah bibir",
          "Arti_kata_en": "and two lips",
          "Text_Latin": "washafatayni",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6033,
      "Ayat_Arabic": "وَهَدَيْنٰهُ النَّجْدَيْنِۙ",
      "Text_Latin": "wa hadainahun-najdain",
      "Terjemah_in": "serta Kami juga telah menunjukkan kepadanya dua jalan (kebajikan dan kejahatan)?",
      "Terjemahan_En": "And We showed him the two ways?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَهَدَيۡنَٰهُ",
          "Arti_kata_in": "dan Kami telah tunjukannya",
          "Arti_kata_en": "And shown him",
          "Text_Latin": "wahadaynahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلنَّجۡدَيۡنِ",
          "Arti_kata_in": "dua jalan",
          "Arti_kata_en": "the two ways",
          "Text_Latin": "an-najdayni",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6034,
      "Ayat_Arabic": "فَلَا اقْتَحَمَ الْعَقَبَةَ ۖ",
      "Text_Latin": "fa laqtahamal-'aqabah",
      "Terjemah_in": "Maka, tidakkah sebaiknya dia menempuh jalan (kebajikan) yang mendaki dan sukar?",
      "Terjemahan_En": "But he did not brave the ascent.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَلَا",
          "Arti_kata_in": "maka/tetapi tidak",
          "Arti_kata_en": "But not",
          "Text_Latin": "fala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱقۡتَحَمَ",
          "Arti_kata_in": "ia menempuh",
          "Arti_kata_en": "he has attempted",
          "Text_Latin": "iq'tahama",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡعَقَبَةَ",
          "Arti_kata_in": "pendakian/mendaki",
          "Arti_kata_en": "the steep path",
          "Text_Latin": "al-'aqabata",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6035,
      "Ayat_Arabic": "وَمَآ اَدْرٰىكَ مَا الْعَقَبَةُ ۗ",
      "Text_Latin": "wa ma adraka mal-'aqabah",
      "Terjemah_in": "Tahukah kamu apakah jalan yang mendaki dan sukar itu?",
      "Terjemahan_En": "And what will explain to you what the ascent is?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَآ",
          "Arti_kata_in": "da apakah",
          "Arti_kata_en": "And what",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَدۡرَىٰكَ",
          "Arti_kata_in": "kamu tahu",
          "Arti_kata_en": "can make you know",
          "Text_Latin": "adraka",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡعَقَبَةُ",
          "Arti_kata_in": "pendakian itu",
          "Arti_kata_en": "the steep path is",
          "Text_Latin": "al-'aqabatu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6036,
      "Ayat_Arabic": "فَكُّ رَقَبَةٍۙ",
      "Text_Latin": "fakku raqabah",
      "Terjemah_in": "(Itulah upaya) melepaskan perbudakan",
      "Terjemahan_En": "The freeing of a slave.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَكُّ",
          "Arti_kata_in": "memerdekakan",
          "Arti_kata_en": "(It is) freeing",
          "Text_Latin": "fakku",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَقَبَةٍ",
          "Arti_kata_in": "budak",
          "Arti_kata_en": "a neck",
          "Text_Latin": "raqabatin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6037,
      "Ayat_Arabic": "اَوْ اِطْعَامٌ فِيْ يَوْمٍ ذِيْ مَسْغَبَةٍۙ",
      "Text_Latin": "au it'amun fi yaumin zi masgabah",
      "Terjemah_in": "atau memberi makan pada hari terjadi kelaparan",
      "Terjemahan_En": "Or the feeding on a day of hunger.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَوۡ",
          "Arti_kata_in": "atau",
          "Arti_kata_en": "Or",
          "Text_Latin": "aw",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِطۡعَٰمٞ",
          "Arti_kata_in": "memberi makan",
          "Arti_kata_en": "feeding",
          "Text_Latin": "it'amun",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "pada",
          "Arti_kata_en": "in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَوۡمٖ",
          "Arti_kata_in": "hari",
          "Arti_kata_en": "a day",
          "Text_Latin": "yawmin",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ذِي",
          "Arti_kata_in": "mempunyai",
          "Arti_kata_en": "of",
          "Text_Latin": "dhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "مَسۡغَبَةٖ",
          "Arti_kata_in": "kelaparan",
          "Arti_kata_en": "severe hunger",
          "Text_Latin": "masghabatin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6038,
      "Ayat_Arabic": "يَّتِيْمًا ذَا مَقْرَبَةٍۙ",
      "Text_Latin": "yatiman za maqrabah",
      "Terjemah_in": "(kepada) anak yatim yang memiliki hubungan kekerabatan",
      "Terjemahan_En": "An orphan near of kin.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَتِيمٗا",
          "Arti_kata_in": "anak yatim",
          "Arti_kata_en": "An orphan",
          "Text_Latin": "yatiman",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
