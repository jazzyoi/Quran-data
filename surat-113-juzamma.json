{
  "Nomor_surat": 113,
  "Nama_surat": "Al-Falaq",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Ayat_arabic ": "قُلْ اَعُوْذُ بِرَبِّ الْفَلَقِۙ",
      "Ayat_latin": "qul a'uzu birabbil-falaq",
      "Terjemah_in": "Katakanlah (Nabi Muhammad), “Aku berlindung kepada Tuhan yang (menjaga) fajar (subuh)",
      "Terjemah_en": "Say, “I take refuge with the Lord of Daybreak.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "قُلۡ",
          "Arti_kata_in": "katakanlah",
          "Arti_kata_en": "Say",
          "Text_latin  ": "qul"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "أَعُوذُ",
          "Arti_kata_in": "aku berlindung",
          "Arti_kata_en": "I seek refuge",
          "Text_latin  ": "a'udhu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "بِرَبِّ",
          "Arti_kata_in": "Tuhan/Pemelihara",
          "Arti_kata_en": "in (the) Lord",
          "Text_latin  ": "birabbi"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلۡفَلَقِ",
          "Arti_kata_in": "subuh",
          "Arti_kata_en": "(of) the dawn",
          "Text_latin  ": "al-falaqi"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Ayat_arabic ": "مِنْ شَرِّ مَا خَلَقَۙ",
      "Ayat_latin": "min syarri ma khalaq",
      "Terjemah_in": "dari kejahatan (makhluk yang) Dia ciptakan,",
      "Terjemah_en": "From the evil of what He created.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "مِن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "From",
          "Text_latin  ": "min"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "شَرِّ",
          "Arti_kata_in": "kejahatan",
          "Arti_kata_en": "(the) evil",
          "Text_latin  ": "sharri"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "(of) what",
          "Text_latin  ": "ma"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "خَلَقَ",
          "Arti_kata_in": "Dia ciptakan",
          "Arti_kata_en": "He created",
          "Text_latin  ": "khalaqa"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Ayat_arabic ": "وَمِنْ شَرِّ غَاسِقٍ اِذَا وَقَبَۙ",
      "Ayat_latin": "wa min syarri gasiqin iza waqab",
      "Terjemah_in": "dari kejahatan malam apabila telah gelap gulita,",
      "Terjemah_en": "And from the evil of the darkness as it gathers.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَمِن",
          "Arti_kata_in": "dan dari",
          "Arti_kata_en": "And from",
          "Text_latin  ": "wamin"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "شَرِّ",
          "Arti_kata_in": "kejahatan",
          "Arti_kata_en": "(the) evil",
          "Text_latin  ": "sharri"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "غَاسِقٍ",
          "Arti_kata_in": "malam yang gelap",
          "Arti_kata_en": "(of) darkness",
          "Text_latin  ": "ghasiqin"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_latin  ": "idha"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "وَقَبَ",
          "Arti_kata_in": "telah gelap/kelam",
          "Arti_kata_en": "it settles",
          "Text_latin  ": "waqaba"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Ayat_arabic ": "وَمِنْ شَرِّ النَّفّٰثٰتِ فِى الْعُقَدِۙ",
      "Ayat_latin": "wa min syarrin-naffasati fil-'uqad",
      "Terjemah_in": "dari kejahatan perempuan-perempuan (penyihir) yang meniup pada buhul-buhul (talinya),",
      "Terjemah_en": "And from the evil of those who practice sorcery.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَمِن",
          "Arti_kata_in": "dan dari",
          "Arti_kata_en": "And from",
          "Text_latin  ": "wamin"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "شَرِّ",
          "Arti_kata_in": "kejahatan",
          "Arti_kata_en": "(the) evil",
          "Text_latin  ": "sharri"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلنَّفَّٰثَٰتِ",
          "Arti_kata_in": "orang yang meniup-niup",
          "Arti_kata_en": "(of) the blowers",
          "Text_latin  ": "an-nafathati"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "in",
          "Text_latin  ": "fi"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "ٱلۡعُقَدِ",
          "Arti_kata_in": "ikatan/simpul",
          "Arti_kata_en": "the knots",
          "Text_latin  ": "al-'uqadi"
        }
      ]
    },
    {
      "Nomor_ayat": 5,
      "Ayat_arabic ": "وَمِنْ شَرِّ حَاسِدٍ اِذَا حَسَدَ ࣖ",
      "Ayat_latin": "wa min syarri hasidin iza hasad",
      "Terjemah_in": "dan dari kejahatan orang yang dengki apabila dia dengki.”",
      "Terjemah_en": "And from the evil of an envious when he envies.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَمِن",
          "Arti_kata_in": "dan dari",
          "Arti_kata_en": "And from",
          "Text_latin  ": "wamin"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "شَرِّ",
          "Arti_kata_in": "kejahatan",
          "Arti_kata_en": "(the) evil",
          "Text_latin  ": "sharri"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "حَاسِدٍ",
          "Arti_kata_in": "orang yang dengki",
          "Arti_kata_en": "(of) an envier",
          "Text_latin  ": "hasidin"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_latin  ": "idha"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "حَسَدَ",
          "Arti_kata_in": "ia dengki",
          "Arti_kata_en": "he envies",
          "Text_latin  ": "hasada"
        }
      ]
    }
  ]
}