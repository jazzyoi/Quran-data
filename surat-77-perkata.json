        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَيۡلٞ",
          "Arti_kata_in": "kecelakaan",
          "Arti_kata_en": "Woe",
          "Text_Latin": "waylun"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمَئِذٖ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_Latin": "yawma-idhin"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لِّلۡمُكَذِّبِينَ",
          "Arti_kata_in": "bagi orang-orang yang mendustakan",
          "Arti_kata_en": "to the deniers",
          "Text_Latin": "lil'mukadhibina"
        }
