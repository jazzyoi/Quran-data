          "Text_Latin": "nut'bi'uhumu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡأٓخِرِينَ",
          "Arti_kata_in": "orang-orang yang kemudian",
          "Arti_kata_en": "(with) the later ones",
          "Text_Latin": "al-akhirina"
