    },
    {
      "Nomor_ayat": 5638,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَلَمۡ",
          "Arti_kata_in": "tidaklah/bukanlah",
          "Arti_kata_en": "Did not",
          "Text_Latin": "alam"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نُهۡلِكِ",
          "Arti_kata_in": "Kami telah membinasakan",
          "Arti_kata_en": "We destroy",
          "Text_Latin": "nuh'liki"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡأَوَّلِينَ",
          "Arti_kata_in": "orang-orang yang dahulu",
          "Arti_kata_en": "the former (people)",
          "Text_Latin": "al-awalina"
