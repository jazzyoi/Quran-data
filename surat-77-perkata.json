      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لِأَيِّ",
          "Arti_kata_in": "untuk manakah",
          "Arti_kata_en": "For what",
          "Text_Latin": "li-ayyi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمٍ",
          "Arti_kata_in": "hari",
          "Arti_kata_en": "Day",
          "Text_Latin": "yawmin"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أُجِّلَتۡ",
          "Arti_kata_in": "ditentukan/ditangguhkan",
          "Arti_kata_en": "are (these) postponed",
          "Text_Latin": "ujjilat"
        }
      ]
    },
