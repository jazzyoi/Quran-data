{
  "Nomor_surat": 77,
  "Nama_surat": "Al-Mursalat",
  "Ayat": [
    {
      "Nomor_ayat": 5623,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡمُرۡسَلَٰتِ",
          "Arti_kata_in": "demi yang dikirim",
          "Arti_kata_en": "By the ones sent forth",
          "Text_Latin": "wal-mur'salati"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عُرۡفٗا",
          "Arti_kata_in": "kebaikan",
          "Arti_kata_en": "one after another",
          "Text_Latin": "ur'fan"
        }
      ]
    },
    {
      "Nomor_ayat": 5624,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱلۡعَٰصِفَٰتِ",
          "Arti_kata_in": "lalu yang bertiup",
          "Arti_kata_en": "And the winds that blow",
          "Text_Latin": "fal-'asifati"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَصۡفٗا",
          "Arti_kata_in": "keras/kencang",
          "Arti_kata_en": "violently",
          "Text_Latin": "asfan"
        }
      ]
    },
    {
      "Nomor_ayat": 5625,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلنَّٰشِرَٰتِ",
          "Arti_kata_in": "dan yang menyebarkan",
          "Arti_kata_en": "And the ones that scatter",
          "Text_Latin": "wan-nashirati"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَشۡرٗا",
          "Arti_kata_in": "sebaran seluas-luasnya",
          "Arti_kata_en": "far and wide",
          "Text_Latin": "nashran"
        }
      ]
    },
    {
      "Nomor_ayat": 5626,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱلۡفَٰرِقَٰتِ",
          "Arti_kata_in": "lalu yang membedakan/memisahkan",
          "Arti_kata_en": "And those who separate",
          "Text_Latin": "fal-fariqati"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فَرۡقٗا",
          "Arti_kata_in": "sebeda-bedanya",
          "Arti_kata_en": "(by the) Criterion",
          "Text_Latin": "farqan"
        }
      ]
    },
    {
      "Nomor_ayat": 5627,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱلۡمُلۡقِيَٰتِ",
          "Arti_kata_in": "lalu yang menyampaikan",
          "Arti_kata_en": "And those who bring down",
          "Text_Latin": "fal-mul'qiyati"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ذِكۡرًا",
          "Arti_kata_in": "peringatan/pengajaran",
          "Arti_kata_en": "(the) Reminder",
          "Text_Latin": "dhik'ran"
        }
      ]
    },
    {
      "Nomor_ayat": 5628,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "عُذۡرًا",
          "Arti_kata_in": "alasan/pembelaan",
          "Arti_kata_en": "(As) justification",
          "Text_Latin": "udh'ran"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَوۡ",
          "Arti_kata_in": "atau",
          "Arti_kata_en": "or",
          "Text_Latin": "aw"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نُذۡرًا",
          "Arti_kata_in": "peringatan",
          "Arti_kata_en": "warning",
          "Text_Latin": "nudh'ran"
        }
      ]
    },
    {
      "Nomor_ayat": 5629,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّمَا",
          "Arti_kata_in": "sesungguhnya hanyalah",
          "Arti_kata_en": "Indeed what",
          "Text_Latin": "innama"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تُوعَدُونَ",
          "Arti_kata_in": "kamu dijanjikan",
          "Arti_kata_en": "you are promised",
          "Text_Latin": "tu'aduna"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَوَٰقِعٞ",
          "Arti_kata_in": "pasti terjadi",
          "Arti_kata_en": "will surely occur",
          "Text_Latin": "lawaqi'un"
        }
      ]
    },
    {
      "Nomor_ayat": 5630,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِذَا",
          "Arti_kata_in": "maka apabila",
          "Arti_kata_en": "So when",
          "Text_Latin": "fa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلنُّجُومُ",
          "Arti_kata_in": "bintang-bintang",
          "Arti_kata_en": "the stars",
          "Text_Latin": "an-nujumu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "طُمِسَتۡ",
          "Arti_kata_in": "dihapuskan",
          "Arti_kata_en": "are obliterated",
          "Text_Latin": "tumisat"
        }
      ]
    },
    {
      "Nomor_ayat": 5631,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلسَّمَآءُ",
          "Arti_kata_in": "langit",
          "Arti_kata_en": "the heaven",
          "Text_Latin": "as-samau"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فُرِجَتۡ",
          "Arti_kata_in": "dibelah",
          "Arti_kata_en": "is cleft asunder",
          "Text_Latin": "furijat"
        }
      ]
    },
    {
      "Nomor_ayat": 5632,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡجِبَالُ",
          "Arti_kata_in": "gunung-gunung",
          "Arti_kata_en": "the mountains",
          "Text_Latin": "al-jibalu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نُسِفَتۡ",
          "Arti_kata_in": "dihancurkan",
          "Arti_kata_en": "are blown away",
          "Text_Latin": "nusifat"
        }
      ]
    },
    {
      "Nomor_ayat": 5633,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلرُّسُلُ",
          "Arti_kata_in": "rasul-rasul",
          "Arti_kata_en": "the Messengers",
          "Text_Latin": "ar-rusulu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أُقِّتَتۡ",
          "Arti_kata_in": "ditetapkan waktunya",
          "Arti_kata_en": "are gathered to their appointed time",
          "Text_Latin": "uqqitat"
        }
      ]
    },
    {
