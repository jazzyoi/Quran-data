          "Kata_Arabic": "أَدۡرَىٰكَ",
          "Arti_kata_in": "tahukah kamu",
          "Arti_kata_en": "will make you know",
          "Text_Latin": "adraka"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apakah",
          "Arti_kata_en": "what",
          "Text_Latin": "ma"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَوۡمُ",
          "Arti_kata_in": "hari",
          "Arti_kata_en": "(is the) Day",
          "Text_Latin": "yawmu"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡفَصۡلِ",
          "Arti_kata_in": "keputusan",
          "Arti_kata_en": "(of) the Judgment",
          "Text_Latin": "al-fasli"
        }
