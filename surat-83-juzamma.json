{
  "Nomor_surat": 83,
  "Nama_surat": "Al-Muthaffifin",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Ayat_arabic ": "وَيْلٌ لِّلْمُطَفِّفِيْنَۙ",
      "Ayat_latin": "wailul lil-mutaffifin",
      "Terjemah_in": "Celakalah orang-orang yang curang (dalam menakar dan menimbang)!",
      "Terjemah_en": "Woe to the defrauders.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَيۡلٞ",
          "Arti_kata_in": "kecelakaan",
          "Arti_kata_en": "Woe",
          "Text_latin  ": "waylun"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "لِّلۡمُطَفِّفِينَ",
          "Arti_kata_in": "bagi orang-orang yang curang",
          "Arti_kata_en": "to those who give less",
          "Text_latin  ": "lil'mutaffifina"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Ayat_arabic ": "الَّذِيْنَ اِذَا اكْتَالُوْا عَلَى النَّاسِ يَسْتَوْفُوْنَۖ",
      "Ayat_latin": "allazina izaktalu 'alan-nasi yastaufun",
      "Terjemah_in": "(Mereka adalah) orang-orang yang apabila menerima takaran dari orang lain, mereka minta dipenuhi.",
      "Terjemah_en": "Those who, when they take a measure from people, they take in full.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "Those who",
          "Text_latin  ": "alladhina"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_latin  ": "idha"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱكۡتَالُواْ",
          "Arti_kata_in": "mereka menerima takaran",
          "Arti_kata_en": "they take a measure",
          "Text_latin  ": "ik'talu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "عَلَى",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "from",
          "Text_latin  ": "ala"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "ٱلنَّاسِ",
          "Arti_kata_in": "manusia (orang lain)",
          "Arti_kata_en": "the people",
          "Text_latin  ": "an-nasi"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "يَسۡتَوۡفُونَ",
          "Arti_kata_in": "mereka minta dipenuhi",
          "Arti_kata_en": "they take in full",
          "Text_latin  ": "yastawfuna"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Ayat_arabic ": "وَاِذَا كَالُوْهُمْ اَوْ وَّزَنُوْهُمْ يُخْسِرُوْنَۗ",
      "Ayat_latin": "wa iza kaluhum aw wazanuhum yukhsirun",
      "Terjemah_in": "(Sebaliknya,) apabila mereka menakar atau menimbang untuk orang lain, mereka kurangi.",
      "Terjemah_en": "But when they measure or weigh to others, they cheat.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "But when",
          "Text_latin  ": "wa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "كَالُوهُمۡ",
          "Arti_kata_in": "mereka menakar",
          "Arti_kata_en": "they give by measure (to) them",
          "Text_latin  ": "kaluhum"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "أَو",
          "Arti_kata_in": "atau",
          "Arti_kata_en": "or",
          "Text_latin  ": "aw"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "وَّزَنُوهُمۡ",
          "Arti_kata_in": "mereka menimbang",
          "Arti_kata_en": "they weigh (for) them",
          "Text_latin  ": "wazanuhum"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "يُخۡسِرُونَ",
          "Arti_kata_in": "mengurangi",
          "Arti_kata_en": "they give less",
          "Text_latin  ": "yukh'siruna"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Ayat_arabic ": "اَلَا يَظُنُّ اُولٰۤىِٕكَ اَنَّهُمْ مَّبْعُوْثُوْنَۙ",
      "Ayat_latin": "ala yazunnu ula'ika annahum mab'usun",
      "Terjemah_in": "Tidakkah mereka mengira (bahwa) sesungguhnya mereka akan dibangkitkan",
      "Terjemah_en": "Do these not know that they will be resurrected?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَلَا",
          "Arti_kata_in": "tidakkah",
          "Arti_kata_en": "Do not",
          "Text_latin  ": "ala"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَظُنُّ",
          "Arti_kata_in": "mereka menyangka",
          "Arti_kata_en": "think",
          "Text_latin  ": "yazunnu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "أُوْلَٰٓئِكَ",
          "Arti_kata_in": "mereka itu",
          "Arti_kata_en": "those",
          "Text_latin  ": "ulaika"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "أَنَّهُم",
          "Arti_kata_in": "bahwa sesungguhnya mereka",
          "Arti_kata_en": "that they",
          "Text_latin  ": "annahum"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "مَّبۡعُوثُونَ",
          "Arti_kata_in": "orang-orang yang dibangkitkan",
          "Arti_kata_en": "(will be) resurrected",
          "Text_latin  ": "mab'uthuna"
        }
      ]
    },
    {
      "Nomor_ayat": 5,
      "Ayat_arabic ": "لِيَوْمٍ عَظِيْمٍۙ",
      "Ayat_latin": "liyaumin 'azim",
      "Terjemah_in": "pada suatu hari yang besar (Kiamat),",
      "Terjemah_en": "For a Great Day?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "لِيَوۡمٍ",
          "Arti_kata_in": "pada hari",
          "Arti_kata_en": "For a Day",
          "Text_latin  ": "liyawmin"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "عَظِيمٖ",
          "Arti_kata_in": "yang besar",
          "Arti_kata_en": "Great",
          "Text_latin  ": "azimin"
        }
      ]
    },
    {
      "Nomor_ayat": 6,
      "Ayat_arabic ": "يَّوْمَ يَقُوْمُ النَّاسُ لِرَبِّ الْعٰلَمِيْنَۗ",
      "Ayat_latin": "yauma yaqumun-nasu lirabbil-'alamin",
      "Terjemah_in": "(yaitu) hari (ketika) manusia bangkit menghadap Tuhan seluruh alam?",
      "Terjemah_en": "The Day when mankind will stand before the Lord of the Worlds?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "يَوۡمَ",
          "Arti_kata_in": "hari",
          "Arti_kata_en": "(The) Day",
          "Text_latin  ": "yawma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَقُومُ",
          "Arti_kata_in": "wahai kaumku",
          "Arti_kata_en": "will stand",
          "Text_latin  ": "yaqumu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلنَّاسُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "mankind",
          "Text_latin  ": "an-nasu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "لِرَبِّ",
          "Arti_kata_in": "kapada Tuhan/Pemelihara",
          "Arti_kata_en": "before (the) Lord",
          "Text_latin  ": "lirabbi"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "ٱلۡعَٰلَمِينَ",
          "Arti_kata_in": "semesta alam",
          "Arti_kata_en": "(of) the worlds",
          "Text_latin  ": "al-'alamina"
        }
      ]
    },
    {
      "Nomor_ayat": 7,
      "Ayat_arabic ": "كَلَّآ اِنَّ كِتٰبَ الْفُجَّارِ لَفِيْ سِجِّيْنٍۗ",
      "Ayat_latin": "kalla inna kitabal-fujjari lafi sijjin",
      "Terjemah_in": "Jangan sekali-kali begitu! Sesungguhnya catatan orang yang durhaka benar-benar (tersimpan) dalam Sijjīn.748)",
      "Terjemah_en": "Not at all. The record of the wicked is in Sijjeen.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "كَلَّآ",
          "Arti_kata_in": "sekali-kali jangan begitu",
          "Arti_kata_en": "Nay!",
          "Text_latin  ": "kalla"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_latin  ": "inna"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "كِتَٰبَ",
          "Arti_kata_in": "catatan",
          "Arti_kata_en": "(the) record",
          "Text_latin  ": "kitaba"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلۡفُجَّارِ",
          "Arti_kata_in": "orang-orang durhaka",
          "Arti_kata_en": "(of) the wicked",
          "Text_latin  ": "al-fujari"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "لَفِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "(is) surely in",
          "Text_latin  ": "lafi"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "سِجِّينٖ",
          "Arti_kata_in": "sijjin",
          "Arti_kata_en": "Sijjin",
          "Text_latin  ": "sijjinin"
        }
      ]
    },
    {
      "Nomor_ayat": 8,
      "Ayat_arabic ": "وَمَآ اَدْرٰىكَ مَا سِجِّيْنٌۗ",
      "Ayat_latin": "wa ma adraka ma sijjin",
      "Terjemah_in": "Tahukah engkau apakah Sijjīn itu?",
      "Terjemah_en": "But how can you know what Sijjeen is?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَمَآ",
          "Arti_kata_in": "dan apakah",
          "Arti_kata_en": "And what",
          "Text_latin  ": "wama"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "أَدۡرَىٰكَ",
          "Arti_kata_in": "kamu tahu",
          "Arti_kata_en": "can make you know",
          "Text_latin  ": "adraka"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_latin  ": "ma"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "سِجِّينٞ",
          "Arti_kata_in": "sijjin",
          "Arti_kata_en": "(is) Sijjin",
          "Text_latin  ": "sijjinun"
        }
      ]
    },
    {
      "Nomor_ayat": 9,
      "Ayat_arabic ": "كِتٰبٌ مَّرْقُوْمٌۗ",
      "Ayat_latin": "kitabum marqum",
      "Terjemah_in": "(Ia adalah) kitab yang berisi catatan (amal).",
      "Terjemah_en": "A numerical book.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "كِتَٰبٞ",
          "Arti_kata_in": "kitab/catatan",
          "Arti_kata_en": "A book",
          "Text_latin  ": "kitabun"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مَّرۡقُومٞ",
          "Arti_kata_in": "tertulis",
          "Arti_kata_en": "written",
          "Text_latin  ": "marqumun"
        }
      ]
    },
    {
      "Nomor_ayat": 10,
      "Ayat_arabic ": "وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَۙ",
      "Ayat_latin": "wailuy yauma'izil lil-mukazzibin",
      "Terjemah_in": "Celakalah pada hari itu bagi para pendusta,",
      "Terjemah_en": "Woe on that Day to the deniers.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَيۡلٞ",
          "Arti_kata_in": "dan kecelakaan",
          "Arti_kata_en": "Woe",
          "Text_latin  ": "waylun"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَوۡمَئِذٖ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_latin  ": "yawma-idhin"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "لِّلۡمُكَذِّبِينَ",
          "Arti_kata_in": "bagi orang-orang yang mendustakan",
          "Arti_kata_en": "to the deniers",
          "Text_latin  ": "lil'mukadhibina"
        }
      ]
    },
    {
      "Nomor_ayat": 11,
      "Ayat_arabic ": "الَّذِيْنَ يُكَذِّبُوْنَ بِيَوْمِ الدِّيْنِۗ",
      "Ayat_latin": "allazina yukazzibuna biyaumid-din",
      "Terjemah_in": "yaitu orang-orang yang mendustakan hari Pembalasan.",
      "Terjemah_en": "Those who deny the Day of Reckoning.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "Those who",
          "Text_latin  ": "alladhina"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يُكَذِّبُونَ",
          "Arti_kata_in": "(mereka) mendustakan",
          "Arti_kata_en": "deny",
          "Text_latin  ": "yukadhibuna"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "بِيَوۡمِ",
          "Arti_kata_in": "dengan hari",
          "Arti_kata_en": "(the) Day",
          "Text_latin  ": "biyawmi"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلدِّينِ",
          "Arti_kata_in": "pembalasan",
          "Arti_kata_en": "(of) the Judgment",
          "Text_latin  ": "ad-dini"
        }
      ]
    },
    {
      "Nomor_ayat": 12,
      "Ayat_arabic ": "وَمَا يُكَذِّبُ بِهٖٓ اِلَّا كُلُّ مُعْتَدٍ اَثِيْمٍۙ",
      "Ayat_latin": "wa ma yukazzibu bihi illa kullu mu'tadin asim",
      "Terjemah_in": "Tidak ada yang mendustakannya, kecuali setiap orang yang melampaui batas lagi sangat berdosa.",
      "Terjemah_en": "But none denies it except the sinful aggressor.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَمَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And not",
          "Text_latin  ": "wama"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يُكَذِّبُ",
          "Arti_kata_in": "mendustakan",
          "Arti_kata_en": "can deny",
          "Text_latin  ": "yukadhibu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "بِهِۦٓ",
          "Arti_kata_in": "dengannya",
          "Arti_kata_en": "[of] it",
          "Text_latin  ": "bihi"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "إِلَّا",
          "Arti_kata_in": "kecuali",
          "Arti_kata_en": "except",
          "Text_latin  ": "illa"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "كُلُّ",
          "Arti_kata_in": "setiap",
          "Arti_kata_en": "every",
          "Text_latin  ": "kullu"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "مُعۡتَدٍ",
          "Arti_kata_in": "orang yang melampui batas",
          "Arti_kata_en": "transgressor",
          "Text_latin  ": "mu'tadin"
        },
        {
          "Nomor_kata": 7,
          "Kata_arabic": "أَثِيمٍ",
          "Arti_kata_in": "orang yang berbuat dosa",
          "Arti_kata_en": "sinful",
          "Text_latin  ": "athimin"
        }
      ]
    },
    {
      "Nomor_ayat": 13,
      "Ayat_arabic ": "اِذَا تُتْلٰى عَلَيْهِ اٰيٰتُنَا قَالَ اَسَاطِيْرُ الْاَوَّلِيْنَۗ",
      "Ayat_latin": "iza tutla 'alaihi ayatuna qala asatirul-awwalin",
      "Terjemah_in": "Apabila dibacakan kepadanya ayat-ayat Kami, dia berkata, “(Itu adalah) dongeng orang-orang dahulu.”",
      "Terjemah_en": "When Our revelations are recited to him, he says, “Legends of the ancients.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "When",
          "Text_latin  ": "idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "تُتۡلَىٰ",
          "Arti_kata_in": "dibacakan",
          "Arti_kata_en": "are recited",
          "Text_latin  ": "tut'la"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "عَلَيۡهِ",
          "Arti_kata_in": "atasnya/kepadanya",
          "Arti_kata_en": "to him",
          "Text_latin  ": "alayhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ءَايَٰتُنَا",
          "Arti_kata_in": "ayat-ayat Kami",
          "Arti_kata_en": "Our Verses",
          "Text_latin  ": "ayatuna"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "قَالَ",
          "Arti_kata_in": "ia berkata",
          "Arti_kata_en": "he says",
          "Text_latin  ": "qala"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "أَسَٰطِيرُ",
          "Arti_kata_in": "dongen-dongen",
          "Arti_kata_en": "Stories",
          "Text_latin  ": "asatiru"
        },
        {
          "Nomor_kata": 7,
          "Kata_arabic": "ٱلۡأَوَّلِينَ",
          "Arti_kata_in": "orang-orang dahulu",
          "Arti_kata_en": "(of) the former (people)",
          "Text_latin  ": "al-awalina"
        }
      ]
    },
    {
      "Nomor_ayat": 14,
      "Ayat_arabic ": "كَلَّا بَلْ ۜرَانَ عَلٰى قُلُوْبِهِمْ مَّا كَانُوْا يَكْسِبُوْنَ",
      "Ayat_latin": "kalla bal rana 'ala qulubihim ma kanu yaksibun",
      "Terjemah_in": "Sekali-kali tidak! Bahkan, apa yang selalu mereka kerjakan itu telah menutupi hati mereka.",
      "Terjemah_en": "Not at all. Their hearts have become corroded by what they used to earn.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "كَلَّاۖ",
          "Arti_kata_in": "sekali-kali jangan/tidak",
          "Arti_kata_en": "Nay!",
          "Text_latin  ": "kalla"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "بَلۡۜ",
          "Arti_kata_in": "bahkan",
          "Arti_kata_en": "But",
          "Text_latin  ": "bal"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "رَانَ",
          "Arti_kata_in": "menutup",
          "Arti_kata_en": "(the) stain has covered",
          "Text_latin  ": "rana"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "عَلَىٰ",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "[over]",
          "Text_latin  ": "ala"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "قُلُوبِهِم",
          "Arti_kata_in": "hati mereka",
          "Arti_kata_en": "their hearts",
          "Text_latin  ": "qulubihim"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "مَّا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "(for) what",
          "Text_latin  ": "ma"
        },
        {
          "Nomor_kata": 7,
          "Kata_arabic": "كَانُواْ",
          "Arti_kata_in": "adalah mereka",
          "Arti_kata_en": "they were",
          "Text_latin  ": "kanu"
        },
        {
          "Nomor_kata": 8,
          "Kata_arabic": "يَكۡسِبُونَ",
          "Arti_kata_in": "mereka usahakan",
          "Arti_kata_en": "earning",
          "Text_latin  ": "yaksibuna"
        }
      ]
    },
    {
      "Nomor_ayat": 15,
      "Ayat_arabic ": "كَلَّآ اِنَّهُمْ عَنْ رَّبِّهِمْ يَوْمَىِٕذٍ لَّمَحْجُوْبُوْنَۗ",
      "Ayat_latin": "kalla innahum 'ar rabbihim yauma'izil lamahjubun",
      "Terjemah_in": "Sekali-kali tidak!749) Sesungguhnya mereka pada hari itu benar-benar terhalang dari (rahmat) Tuhannya.",
      "Terjemah_en": "Not at all. On that Day, they will be screened from their Lord.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "كَلَّآ",
          "Arti_kata_in": "sekali-kali jangan/tidak",
          "Arti_kata_en": "Nay!",
          "Text_latin  ": "kalla"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِنَّهُمۡ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed they",
          "Text_latin  ": "innahum"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "عَن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "from",
          "Text_latin  ": "an"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "رَّبِّهِمۡ",
          "Arti_kata_in": "Tuhan mereka",
          "Arti_kata_en": "their Lord",
          "Text_latin  ": "rabbihim"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "يَوۡمَئِذٖ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_latin  ": "yawma-idhin"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "لَّمَحۡجُوبُونَ",
          "Arti_kata_in": "benar-benar tertutup",
          "Arti_kata_en": "surely will be partitioned",
          "Text_latin  ": "lamahjubuna"
        }
      ]
    },
    {
      "Nomor_ayat": 16,
      "Ayat_arabic ": "ثُمَّ اِنَّهُمْ لَصَالُوا الْجَحِيْمِۗ",
      "Ayat_latin": "summa innahum lasalul-jahim",
      "Terjemah_in": "Sesungguhnya mereka kemudian benar-benar masuk (neraka) Jahim.",
      "Terjemah_en": "Then they will roast in Hell.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ثُمَّ",
          "Arti_kata_in": "kemudian",
          "Arti_kata_en": "Then",
          "Text_latin  ": "thumma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِنَّهُمۡ",
          "Arti_kata_in": "sesungguhnya mereka",
          "Arti_kata_en": "indeed they",
          "Text_latin  ": "innahum"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "لَصَالُواْ",
          "Arti_kata_in": "benar-benar mereka masuk",
          "Arti_kata_en": "(surely) will burn",
          "Text_latin  ": "lasalu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلۡجَحِيمِ",
          "Arti_kata_in": "neraka",
          "Arti_kata_en": "(in) the Hellfire",
          "Text_latin  ": "al-jahimi"
        }
      ]
    },
    {
      "Nomor_ayat": 17,
      "Ayat_arabic ": "ثُمَّ يُقَالُ هٰذَا الَّذِيْ كُنْتُمْ بِهٖ تُكَذِّبُوْنَۗ",
      "Ayat_latin": "summa yuqalu hazallazi kuntum bihi tukazzibun",
      "Terjemah_in": "Lalu dikatakan (kepada mereka), “Inilah (azab) yang selalu kamu dustakan.”",
      "Terjemah_en": "Then it will be said, “This is what you used to deny.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ثُمَّ",
          "Arti_kata_in": "kemudian",
          "Arti_kata_en": "Then",
          "Text_latin  ": "thumma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يُقَالُ",
          "Arti_kata_in": "dikatakan",
          "Arti_kata_en": "it will be said",
          "Text_latin  ": "yuqalu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "هَٰذَا",
          "Arti_kata_in": "ini",
          "Arti_kata_en": "This",
          "Text_latin  ": "hadha"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang (azab)",
          "Arti_kata_en": "(is) what",
          "Text_latin  ": "alladhi"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "كُنتُم",
          "Arti_kata_in": "kalian adalah",
          "Arti_kata_en": "you used (to)",
          "Text_latin  ": "kuntum"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "بِهِۦ",
          "Arti_kata_in": "dengannya/padanya",
          "Arti_kata_en": "[of it]",
          "Text_latin  ": "bihi"
        },
        {
          "Nomor_kata": 7,
          "Kata_arabic": "تُكَذِّبُونَ",
          "Arti_kata_in": "kamu mendustakan",
          "Arti_kata_en": "deny",
          "Text_latin  ": "tukadhibuna"
        }
      ]
    },
    {
      "Nomor_ayat": 18,
      "Ayat_arabic ": "كَلَّآ اِنَّ كِتٰبَ الْاَبْرَارِ لَفِيْ عِلِّيِّيْنَۗ",
      "Ayat_latin": "kalla inna kitabal-abrari lafi 'illiyyin",
      "Terjemah_in": "Sekali-kali tidak! Sesungguhnya catatan orang-orang yang berbakti benar-benar tersimpan dalam ‘Illiyyīn.750)",
      "Terjemah_en": "No indeed; the record of the righteous is in Elliyyeen.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "كَلَّآ",
          "Arti_kata_in": "sekali-kali jangan/tidak",
          "Arti_kata_en": "Nay!",
          "Text_latin  ": "kalla"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_latin  ": "inna"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "كِتَٰبَ",
          "Arti_kata_in": "kitab/catatan",
          "Arti_kata_en": "(the) record",
          "Text_latin  ": "kitaba"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلۡأَبۡرَارِ",
          "Arti_kata_in": "orang-orang yang baik",
          "Arti_kata_en": "(of) the righteous",
          "Text_latin  ": "al-abrari"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "لَفِي",
          "Arti_kata_in": "benar-benar dalam",
          "Arti_kata_en": "(will be) surely in",
          "Text_latin  ": "lafi"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "عِلِّيِّينَ",
          "Arti_kata_in": "illiyyin",
          "Arti_kata_en": "Illiyin",
          "Text_latin  ": "illiyyina"
        }
      ]
    },
    {
      "Nomor_ayat": 19,
      "Ayat_arabic ": "وَمَآ اَدْرٰىكَ مَا عِلِّيُّوْنَۗ",
      "Ayat_latin": "wa ma adraka ma 'illiyyun",
      "Terjemah_in": "Tahukah engkau apakah ‘Illiyyīn itu?",
      "Terjemah_en": "But how can you know what Elliyyoon is?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَمَآ",
          "Arti_kata_in": "dan apakah",
          "Arti_kata_en": "And what",
          "Text_latin  ": "wama"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "أَدۡرَىٰكَ",
          "Arti_kata_in": "kamu tahu",
          "Arti_kata_en": "can make you know",
          "Text_latin  ": "adraka"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_latin  ": "ma"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "عِلِّيُّونَ",
          "Arti_kata_in": "illiyyin",
          "Arti_kata_en": "(is) Illiyun",
          "Text_latin  ": "illiyyuna"
        }
      ]
    },
    {
      "Nomor_ayat": 20,
      "Ayat_arabic ": "كِتٰبٌ مَّرْقُوْمٌۙ",
      "Ayat_latin": "kitabum marqum",
      "Terjemah_in": "(Itulah) kitab yang berisi catatan (amal)",
      "Terjemah_en": "A numerical book.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "كِتَٰبٞ",
          "Arti_kata_in": "catatan/kitab",
          "Arti_kata_en": "A book",
          "Text_latin  ": "kitabun"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مَّرۡقُومٞ",
          "Arti_kata_in": "tertulis",
          "Arti_kata_en": "written",
          "Text_latin  ": "marqumun"
        }
      ]
    },
    {
      "Nomor_ayat": 21,
      "Ayat_arabic ": "يَّشْهَدُهُ الْمُقَرَّبُوْنَۗ",
      "Ayat_latin": "yasy-haduhul-muqarrabun",
      "Terjemah_in": "yang disaksikan oleh (malaikat-malaikat) yang didekatkan (kepada Allah).",
      "Terjemah_en": "Witnessed by those brought near.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "يَشۡهَدُهُ",
          "Arti_kata_in": "menyaksikannya",
          "Arti_kata_en": "Witness it",
          "Text_latin  ": "yashhaduhu"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلۡمُقَرَّبُونَ",
          "Arti_kata_in": "(mailaikat) yang didekatkan",
          "Arti_kata_en": "those brought near",
          "Text_latin  ": "al-muqarabuna"
        }
      ]
    },
    {
      "Nomor_ayat": 22,
      "Ayat_arabic ": "اِنَّ الْاَبْرَارَ لَفِيْ نَعِيْمٍۙ",
      "Ayat_latin": "innal-abrara lafi na'im",
      "Terjemah_in": "Sesungguhnya orang-orang yang berbakti benar-benar berada dalam (surga yang penuh) kenikmatan.",
      "Terjemah_en": "Indeed, the righteous will be amid bliss.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_latin  ": "inna"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلۡأَبۡرَارَ",
          "Arti_kata_in": "orang-orang yang baik",
          "Arti_kata_en": "the righteous",
          "Text_latin  ": "al-abrara"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "لَفِي",
          "Arti_kata_in": "benar-benar dalam",
          "Arti_kata_en": "(will be) surely in",
          "Text_latin  ": "lafi"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "نَعِيمٍ",
          "Arti_kata_in": "kenikmatan/kesenangan",
          "Arti_kata_en": "bliss",
          "Text_latin  ": "na'imin"
        }
      ]
    },
    {
      "Nomor_ayat": 23,
      "Ayat_arabic ": "عَلَى الْاَرَاۤىِٕكِ يَنْظُرُوْنَۙ",
      "Ayat_latin": "'alal-ara'iki yanzurun",
      "Terjemah_in": "Mereka (duduk) di atas dipan-dipan (sambil) melepas pandangan.",
      "Terjemah_en": "On thrones, looking on.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "عَلَى",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "On",
          "Text_latin  ": "ala"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلۡأَرَآئِكِ",
          "Arti_kata_in": "dipan",
          "Arti_kata_en": "thrones",
          "Text_latin  ": "al-araiki"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "يَنظُرُونَ",
          "Arti_kata_in": "mereka melihat/memandang",
          "Arti_kata_en": "observing",
          "Text_latin  ": "yanzuruna"
        }
      ]
    },
    {
      "Nomor_ayat": 24,
      "Ayat_arabic ": "تَعْرِفُ فِيْ وُجُوْهِهِمْ نَضْرَةَ النَّعِيْمِۚ",
      "Ayat_latin": "ta'rifu fi wujuhihim nadratan na'im",
      "Terjemah_in": "Engkau dapat mengetahui pada wajah mereka gemerlapnya kenikmatan.",
      "Terjemah_en": "You will recognize on their faces the radiance of bliss.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "تَعۡرِفُ",
          "Arti_kata_in": "kamu mengenal/melihat",
          "Arti_kata_en": "You will recognize",
          "Text_latin  ": "ta'rifu"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "in",
          "Text_latin  ": "fi"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "وُجُوهِهِمۡ",
          "Arti_kata_in": "wajah mereka",
          "Arti_kata_en": "their faces",
          "Text_latin  ": "wujuhihim"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "نَضۡرَةَ",
          "Arti_kata_in": "bersinar/bercahaya",
          "Arti_kata_en": "(the) radiance",
          "Text_latin  ": "nadrata"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "ٱلنَّعِيمِ",
          "Arti_kata_in": "kesenangan/kenikmatan",
          "Arti_kata_en": "(of) bliss",
          "Text_latin  ": "an-na'imi"
        }
      ]
    },
    {
      "Nomor_ayat": 25,
      "Ayat_arabic ": "يُسْقَوْنَ مِنْ رَّحِيْقٍ مَّخْتُوْمٍۙ",
      "Ayat_latin": "yusqauna mir rahiqim makhtum",
      "Terjemah_in": "Mereka diberi minum dari khamar murni (tidak memabukkan) yang (tempatnya) masih diberi lak (sebagai jaminan keasliannya).",
      "Terjemah_en": "They will be given to drink a sealed wine.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "يُسۡقَوۡنَ",
          "Arti_kata_in": "mereka diberi minuman",
          "Arti_kata_en": "They will be given to drink",
          "Text_latin  ": "yus'qawna"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مِن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "of",
          "Text_latin  ": "min"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "رَّحِيقٖ",
          "Arti_kata_in": "minuman yang terpilih",
          "Arti_kata_en": "a pure wine",
          "Text_latin  ": "rahiqin"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "مَّخۡتُومٍ",
          "Arti_kata_in": "dicap/dilak",
          "Arti_kata_en": "sealed",
          "Text_latin  ": "makhtumin"
        }
      ]
    },
    {
      "Nomor_ayat": 26,
      "Ayat_arabic ": "خِتٰمُهٗ مِسْكٌ ۗوَفِيْ ذٰلِكَ فَلْيَتَنَافَسِ الْمُتَنٰفِسُوْنَۗ",
      "Ayat_latin": "khitamuhu misk, wa fi zalika falyatanafasil-mutanafisun",
      "Terjemah_in": "Laknya terbuat dari kasturi. Untuk (mendapatkan) yang demikian itu hendaknya orang berlomba-lomba.",
      "Terjemah_en": "Whose seal is musk—this is what competitors should compete for.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "خِتَٰمُهُۥ",
          "Arti_kata_in": "capnya/laknya",
          "Arti_kata_en": "Its seal",
          "Text_latin  ": "khitamuhu"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مِسۡكٞۚ",
          "Arti_kata_in": "kasturi",
          "Arti_kata_en": "(will be of) musk",
          "Text_latin  ": "mis'kun"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "وَفِي",
          "Arti_kata_in": "dan untuk",
          "Arti_kata_en": "And for",
          "Text_latin  ": "wafi"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ذَٰلِكَ",
          "Arti_kata_in": "itu adalah",
          "Arti_kata_en": "that",
          "Text_latin  ": "dhalika"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "فَلۡيَتَنَافَسِ",
          "Arti_kata_in": "maka hendaklah berlomba-lomba",
          "Arti_kata_en": "let aspire",
          "Text_latin  ": "falyatanafasi"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "ٱلۡمُتَنَٰفِسُونَ",
          "Arti_kata_in": "orang-orang yang berlomba",
          "Arti_kata_en": "the aspirers",
          "Text_latin  ": "al-mutanafisuna"
        }
      ]
    },
    {
      "Nomor_ayat": 27,
      "Ayat_arabic ": "وَمِزَاجُهٗ مِنْ تَسْنِيْمٍۙ",
      "Ayat_latin": "wa mizajuhu min tasnim",
      "Terjemah_in": "Campurannya terbuat dari tasnīm,",
      "Terjemah_en": "Its mixture is of Tasneem.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَمِزَاجُهُۥ",
          "Arti_kata_in": "dan campurannya",
          "Arti_kata_en": "And its mixture",
          "Text_latin  ": "wamizajuhu"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مِن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "(is) of",
          "Text_latin  ": "min"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "تَسۡنِيمٍ",
          "Arti_kata_in": "tasnim",
          "Arti_kata_en": "Tasnim",
          "Text_latin  ": "tasnimin"
        }
      ]
    },
    {
      "Nomor_ayat": 28,
      "Ayat_arabic ": "عَيْنًا يَّشْرَبُ بِهَا الْمُقَرَّبُوْنَۗ",
      "Ayat_latin": "'ainay yasyrabu bihal-muqarrabun",
      "Terjemah_in": "(yaitu) mata air yang diminum oleh mereka yang didekatkan (kepada Allah).",
      "Terjemah_en": "A spring from which those brought near drink.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "عَيۡنٗا",
          "Arti_kata_in": "mata air",
          "Arti_kata_en": "A spring",
          "Text_latin  ": "aynan"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَشۡرَبُ",
          "Arti_kata_in": "meminum",
          "Arti_kata_en": "will drink",
          "Text_latin  ": "yashrabu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "بِهَا",
          "Arti_kata_in": "dengannya/padanya",
          "Arti_kata_en": "from it",
          "Text_latin  ": "biha"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلۡمُقَرَّبُونَ",
          "Arti_kata_in": "orang-orang yang didekatkan",
          "Arti_kata_en": "those brought near",
          "Text_latin  ": "al-muqarabuna"
        }
      ]
    },
    {
      "Nomor_ayat": 29,
      "Ayat_arabic ": "اِنَّ الَّذِيْنَ اَجْرَمُوْا كَانُوْا مِنَ الَّذِيْنَ اٰمَنُوْا يَضْحَكُوْنَۖ",
      "Ayat_latin": "innallazina ajramu kanu minallazina amanu yad-hakun",
      "Terjemah_in": "Sesungguhnya orang-orang yang berdosa adalah mereka yang dahulu selalu mentertawakan orang-orang yang beriman.",
      "Terjemah_en": "Those who committed crimes used to laugh at those who believed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_latin  ": "inna"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "those who",
          "Text_latin  ": "alladhina"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "أَجۡرَمُواْ",
          "Arti_kata_in": "(mereka) berdosa",
          "Arti_kata_en": "committed crimes",
          "Text_latin  ": "ajramu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "كَانُواْ",
          "Arti_kata_in": "adalah mereka",
          "Arti_kata_en": "used (to)",
          "Text_latin  ": "kanu"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "مِنَ",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "at",
          "Text_latin  ": "mina"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "those who",
          "Text_latin  ": "alladhina"
        },
        {
          "Nomor_kata": 7,
          "Kata_arabic": "ءَامَنُواْ",
          "Arti_kata_in": "beriman",
          "Arti_kata_en": "believed",
          "Text_latin  ": "amanu"
        },
        {
          "Nomor_kata": 8,
          "Kata_arabic": "يَضۡحَكُونَ",
          "Arti_kata_in": "menertawakan",
          "Arti_kata_en": "laugh",
          "Text_latin  ": "yadhakuna"
        }
      ]
    },
    {
      "Nomor_ayat": 30,
      "Ayat_arabic ": "وَاِذَا مَرُّوْا بِهِمْ يَتَغَامَزُوْنَۖ",
      "Ayat_latin": "wa iza marru bihim yatagamazun",
      "Terjemah_in": "Apabila mereka (orang-orang yang beriman) melintas di hadapan mereka, mereka saling mengedip-ngedipkan matanya.",
      "Terjemah_en": "And when they passed by them, they would wink at one another.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_latin  ": "wa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مَرُّواْ",
          "Arti_kata_in": "(orang-orang beriman) lewat",
          "Arti_kata_en": "they passed",
          "Text_latin  ": "marru"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "بِهِمۡ",
          "Arti_kata_in": "pada mereka",
          "Arti_kata_en": "by them",
          "Text_latin  ": "bihim"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "يَتَغَامَزُونَ",
          "Arti_kata_in": "mereka saling mengedipkan mata",
          "Arti_kata_en": "they winked at one another",
          "Text_latin  ": "yataghamazuna"
        }
      ]
    },
    {
      "Nomor_ayat": 31,
      "Ayat_arabic ": "وَاِذَا انْقَلَبُوْٓا اِلٰٓى اَهْلِهِمُ انْقَلَبُوْا فَكِهِيْنَۖ",
      "Ayat_latin": "wa izangqalabu ila ahlihimungqalabu fakihin",
      "Terjemah_in": "Apabila kembali kepada kaumnya, mereka kembali dengan gembira ria (dan sombong).",
      "Terjemah_en": "And when they went back to their families, they would go back exulting.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_latin  ": "wa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱنقَلَبُوٓاْ",
          "Arti_kata_in": "(orang-orang berdosa) kembali",
          "Arti_kata_en": "they returned",
          "Text_latin  ": "inqalabu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "إِلَىٰٓ",
          "Arti_kata_in": "kepada",
          "Arti_kata_en": "to",
          "Text_latin  ": "ila"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "أَهۡلِهِمُ",
          "Arti_kata_in": "keluarganya/kaumnya",
          "Arti_kata_en": "their people",
          "Text_latin  ": "ahlihimu"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "ٱنقَلَبُواْ",
          "Arti_kata_in": "mereka kembali",
          "Arti_kata_en": "they would return",
          "Text_latin  ": "inqalabu"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "فَكِهِينَ",
          "Arti_kata_in": "riang gembira",
          "Arti_kata_en": "jesting",
          "Text_latin  ": "fakihina"
        }
      ]
    },
    {
      "Nomor_ayat": 32,
      "Ayat_arabic ": "وَاِذَا رَاَوْهُمْ قَالُوْٓا اِنَّ هٰٓؤُلَاۤءِ لَضَاۤلُّوْنَۙ",
      "Ayat_latin": "wa iza ra'auhum qalu inna ha'ula'i ladallun",
      "Terjemah_in": "Apabila melihat (orang-orang mukmin), mereka mengatakan, “Sesungguhnya mereka benar-benar orang-orang sesat,”",
      "Terjemah_en": "And if they saw them, they would say, “These people are lost.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_latin  ": "wa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "رَأَوۡهُمۡ",
          "Arti_kata_in": "mereka melihat",
          "Arti_kata_en": "they saw them",
          "Text_latin  ": "ra-awhum"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "قَالُوٓاْ",
          "Arti_kata_in": "mereka berkata",
          "Arti_kata_en": "they said",
          "Text_latin  ": "qalu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_latin  ": "inna"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "هَٰٓؤُلَآءِ",
          "Arti_kata_in": "mereka itu (orang-orang beriman)",
          "Arti_kata_en": "these",
          "Text_latin  ": "haulai"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "لَضَآلُّونَ",
          "Arti_kata_in": "orang-orang sesat",
          "Arti_kata_en": "surely have gone astray",
          "Text_latin  ": "ladalluna"
        }
      ]
    },
    {
      "Nomor_ayat": 33,
      "Ayat_arabic ": "وَمَآ اُرْسِلُوْا عَلَيْهِمْ حٰفِظِيْنَۗ",
      "Ayat_latin": "wa ma ursilu 'alaihim hafizin",
      "Terjemah_in": "padahal mereka (orang-orang yang berdosa itu) tidak diutus sebagai penjaga (orang-orang mukmin).",
      "Terjemah_en": "Yet they were not sent as guardians over them.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَمَآ",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "But not",
          "Text_latin  ": "wama"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "أُرۡسِلُواْ",
          "Arti_kata_in": "dikirim",
          "Arti_kata_en": "they had been sent",
          "Text_latin  ": "ur'silu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "عَلَيۡهِمۡ",
          "Arti_kata_in": "atasnya",
          "Arti_kata_en": "over them",
          "Text_latin  ": "alayhim"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "حَٰفِظِينَ",
          "Arti_kata_in": "penjaga-penjaga",
          "Arti_kata_en": "(as) guardians",
          "Text_latin  ": "hafizina"
        }
      ]
    },
    {
      "Nomor_ayat": 34,
      "Ayat_arabic ": "فَالْيَوْمَ الَّذِيْنَ اٰمَنُوْا مِنَ الْكُفَّارِ يَضْحَكُوْنَۙ",
      "Ayat_latin": "fal-yaumallazina amanu minal-kuffari yad-hakun",
      "Terjemah_in": "Pada hari ini (hari Kiamat), orang-orang yang berimanlah yang mentertawakan orang-orang kafir.",
      "Terjemah_en": "But on that Day, those who believed will laugh at the unbelievers.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَٱلۡيَوۡمَ",
          "Arti_kata_in": "maka pada hari",
          "Arti_kata_en": "So today",
          "Text_latin  ": "fal-yawma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "those who",
          "Text_latin  ": "alladhina"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ءَامَنُواْ",
          "Arti_kata_in": "beriman",
          "Arti_kata_en": "believed",
          "Text_latin  ": "amanu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "مِنَ",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "at",
          "Text_latin  ": "mina"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "ٱلۡكُفَّارِ",
          "Arti_kata_in": "orang-orang kafir",
          "Arti_kata_en": "the disbelievers",
          "Text_latin  ": "al-kufari"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "يَضۡحَكُونَ",
          "Arti_kata_in": "menertawakan mereka",
          "Arti_kata_en": "they will laugh",
          "Text_latin  ": "yadhakuna"
        }
      ]
    },
    {
      "Nomor_ayat": 35,
      "Ayat_arabic ": "عَلَى الْاَرَاۤىِٕكِ يَنْظُرُوْنَۗ",
      "Ayat_latin": "'alal-ara'iki yanzurun",
      "Terjemah_in": "Mereka (duduk) di atas dipan-dipan (sambil) melepas pandangan.",
      "Terjemah_en": "On luxurious furnishings, looking on.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "عَلَى",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "On",
          "Text_latin  ": "ala"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلۡأَرَآئِكِ",
          "Arti_kata_in": "dipan",
          "Arti_kata_en": "the thrones",
          "Text_latin  ": "al-araiki"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "يَنظُرُونَ",
          "Arti_kata_in": "mereka memandang/melihat",
          "Arti_kata_en": "observing",
          "Text_latin  ": "yanzuruna"
        }
      ]
    },
    {
      "Nomor_ayat": 36,
      "Ayat_arabic ": "هَلْ ثُوِّبَ الْكُفَّارُ مَا كَانُوْا يَفْعَلُوْنَ ࣖ",
      "Ayat_latin": "hal suwwibal-kuffaru ma kanu yaf'alun",
      "Terjemah_in": "Apakah orang-orang kafir itu telah diberi balasan (hukuman) terhadap apa yang selalu mereka perbuat?",
      "Terjemah_en": "Have the unbelievers been repaid for what they used to do?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "هَلۡ",
          "Arti_kata_in": "apakah",
          "Arti_kata_en": "Have (not)",
          "Text_latin  ": "hal"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ثُوِّبَ",
          "Arti_kata_in": "diberi ganjaran/balasan",
          "Arti_kata_en": "been paid",
          "Text_latin  ": "thuwwiba"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلۡكُفَّارُ",
          "Arti_kata_in": "orang-orang kafir",
          "Arti_kata_en": "the disbelievers",
          "Text_latin  ": "al-kufaru"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "(for) what",
          "Text_latin  ": "ma"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "كَانُواْ",
          "Arti_kata_in": "adalah mereka",
          "Arti_kata_en": "they used (to)",
          "Text_latin  ": "kanu"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "يَفۡعَلُونَ",
          "Arti_kata_in": "mereka kerjakan",
          "Arti_kata_en": "do",
          "Text_latin  ": "yaf 'aluna"
        }
      ]
    }
  ]
}