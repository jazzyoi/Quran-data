{
  "Nomor_surat": 107,
  "Nama_surat": "Al-Ma'un",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَرَءَيۡتَ",
          "Arti_kata_in": "tahukah kamu",
          "Arti_kata_en": "Have you seen",
          "Text_Latin": "ara-ayta"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "the one who",
          "Text_Latin": "alladhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يُكَذِّبُ",
          "Arti_kata_in": "dia mendustakan",
          "Arti_kata_en": "denies",
          "Text_Latin": "yukadhibu"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "بِٱلدِّينِ",
          "Arti_kata_in": "dengan agama",
          "Arti_kata_en": "the Judgment",
          "Text_Latin": "bil-dini"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَذَٰلِكَ",
          "Arti_kata_in": "maka itulah",
          "Arti_kata_en": "Then that",
          "Text_Latin": "fadhalika"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "(is) the one who",
          "Text_Latin": "alladhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَدُعُّ",
          "Arti_kata_in": "dia menghardik",
          "Arti_kata_en": "repulses",
          "Text_Latin": "yadu'u"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡيَتِيمَ",
          "Arti_kata_in": "anak yatim",
          "Arti_kata_en": "the orphan",
          "Text_Latin": "al-yatima"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And (does) not",
          "Text_Latin": "wala"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَحُضُّ",
          "Arti_kata_in": "menganjurkan",
          "Arti_kata_en": "feel the urge",
          "Text_Latin": "yahuddu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَىٰ",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "to",
          "Text_Latin": "ala"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "طَعَامِ",
          "Arti_kata_in": "memberi makan",
          "Arti_kata_en": "feed",
          "Text_Latin": "ta'ami"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡمِسۡكِينِ",
          "Arti_kata_in": "orang miskin",
          "Arti_kata_en": "the poor",
          "Text_Latin": "al-mis'kini"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَوَيۡلٞ",
          "Arti_kata_in": "maka celakalah",
          "Arti_kata_en": "So woe",
          "Text_Latin": "fawaylun"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لِّلۡمُصَلِّينَ",
          "Arti_kata_in": "orang yang sholat",
          "Arti_kata_en": "to those who pray",
          "Text_Latin": "lil'musallina"
        }
      ]
    },
    {
      "Nomor_ayat": 5,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "Those who",
          "Text_Latin": "alladhina"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُمۡ",
          "Arti_kata_in": "mereka",
          "Arti_kata_en": "[they]",
          "Text_Latin": "hum"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَن",
          "Arti_kata_in": "dar",
          "Arti_kata_en": "of",
          "Text_Latin": "an"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "صَلَاتِهِمۡ",
          "Arti_kata_in": "sholat mereka",
          "Arti_kata_en": "their prayers",
          "Text_Latin": "salatihim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "سَاهُونَ",
          "Arti_kata_in": "lalai",
          "Arti_kata_en": "(are) neglectful",
          "Text_Latin": "sahuna"
        }
      ]
    },
    {
      "Nomor_ayat": 6,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "Those who",
          "Text_Latin": "alladhina"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُمۡ",
          "Arti_kata_in": "mereka",
          "Arti_kata_en": "[they]",
          "Text_Latin": "hum"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يُرَآءُونَ",
          "Arti_kata_in": "mereka berbuat ria",
          "Arti_kata_en": "make show",
          "Text_Latin": "yurauna"
        }
      ]
    },
    {
      "Nomor_ayat": 7,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَيَمۡنَعُونَ",
          "Arti_kata_in": "dan mereka mencegah/enggan",
          "Arti_kata_en": "And they deny",
          "Text_Latin": "wayamna'una"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡمَاعُونَ",
          "Arti_kata_in": "pertolongan",
          "Arti_kata_en": "[the] small kindness",
          "Text_Latin": "al-ma'una"
        }
      ]
    }
  ]
}