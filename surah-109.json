{
  "Nomor_surat": 109,
  "Nama_surat": "Al-Kafirun",
  "surat_arabic": "الكافرون",
  "Arti_surat_in": "Orang-orang Kafir",
  "Arti_surat_en": "The Disbelievers",
  "Ayat": [
    {
      "Nomor_ayat": 6208,
      "Ayat_Arabic": "قُلْ يٰٓاَيُّهَا الْكٰفِرُوْنَۙ",
      "Text_Latin": "qul ya ayyuhal-kafirun",
      "Terjemah_in": "Katakanlah (Nabi Muhammad), “Wahai orang-orang kafir,",
      "Terjemahan_En": "Say, “O disbelievers.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قُلۡ",
          "Arti_kata_in": "katakanlah",
          "Arti_kata_en": "Say",
          "Text_Latin": "qul",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَٰٓأَيُّهَا",
          "Arti_kata_in": "wahai",
          "Arti_kata_en": "O",
          "Text_Latin": "yaayyuha",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡكَٰفِرُونَ",
          "Arti_kata_in": "orang-orang kafir",
          "Arti_kata_en": "disbelievers",
          "Text_Latin": "al-kafiruna",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6209,
      "Ayat_Arabic": "لَآ اَعْبُدُ مَا تَعْبُدُوْنَۙ",
      "Text_Latin": "la a'budu ma ta'budun",
      "Terjemah_in": "aku tidak akan menyembah apa yang kamu sembah.",
      "Terjemahan_En": "I do not worship what you worship.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَآ",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "Not",
          "Text_Latin": "la",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَعۡبُدُ",
          "Arti_kata_in": "aku menyembah",
          "Arti_kata_en": "I worship",
          "Text_Latin": "a'budu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "تَعۡبُدُونَ",
          "Arti_kata_in": "kamu sembah",
          "Arti_kata_en": "you worship",
          "Text_Latin": "ta'buduna",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6210,
      "Ayat_Arabic": "وَلَآ اَنْتُمْ عٰبِدُوْنَ مَآ اَعْبُدُۚ",
      "Text_Latin": "wa la antum 'abiduna ma a'bud",
      "Terjemah_in": "Kamu juga bukan penyembah apa yang aku sembah.",
      "Terjemahan_En": "Nor do you worship what I worship.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَآ",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And not",
          "Text_Latin": "wala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَنتُمۡ",
          "Arti_kata_in": "kamu",
          "Arti_kata_en": "you",
          "Text_Latin": "antum",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَٰبِدُونَ",
          "Arti_kata_in": "menyembah",
          "Arti_kata_en": "(are) worshippers",
          "Text_Latin": "abiduna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَآ",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "(of) what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَعۡبُدُ",
          "Arti_kata_in": "aku sembah",
          "Arti_kata_en": "I worship",
          "Text_Latin": "a'budu",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6211,
      "Ayat_Arabic": "وَلَآ اَنَا۠ عَابِدٌ مَّا عَبَدْتُّمْۙ",
      "Text_Latin": "wa la ana 'abidum ma 'abattum",
      "Terjemah_in": "Aku juga tidak pernah menjadi penyembah apa yang kamu sembah.",
      "Terjemahan_En": "Nor do I serve what you serve.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَآ",
          "Arti_kata_in": "dan bukanlah",
          "Arti_kata_en": "And not",
          "Text_Latin": "wala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَنَا۠",
          "Arti_kata_in": "aku",
          "Arti_kata_en": "I am",
          "Text_Latin": "ana",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَابِدٞ",
          "Arti_kata_in": "menjadi penyembah",
          "Arti_kata_en": "a worshipper",
          "Text_Latin": "abidun",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَّا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "(of) what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "عَبَدتُّمۡ",
          "Arti_kata_in": "kamu sembah",
          "Arti_kata_en": "you worship",
          "Text_Latin": "abadttum",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6212,
      "Ayat_Arabic": "وَلَآ اَنْتُمْ عٰبِدُوْنَ مَآ اَعْبُدُۗ",
      "Text_Latin": "wa la antum 'abiduna ma a'bud",
      "Terjemah_in": "Kamu tidak pernah (pula) menjadi penyembah apa yang aku sembah.",
      "Terjemahan_En": "Nor do you serve what I serve.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَآ",
          "Arti_kata_in": "dan bukanlah",
          "Arti_kata_en": "And not",
          "Text_Latin": "wala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَنتُمۡ",
          "Arti_kata_in": "kamu",
          "Arti_kata_en": "you are",
          "Text_Latin": "antum",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَٰبِدُونَ",
          "Arti_kata_in": "menyembah",
          "Arti_kata_en": "worshippers",
          "Text_Latin": "abiduna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَآ",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "(of) what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَعۡبُدُ",
          "Arti_kata_in": "aku sembah",
          "Arti_kata_en": "I worship",
          "Text_Latin": "a'budu",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6213,
      "Ayat_Arabic": "لَكُمْ دِيْنُكُمْ وَلِيَ دِيْنِ ࣖ",
      "Text_Latin": "lakum dinukum wa liya din",
      "Terjemah_in": "Untukmu agamamu dan untukku agamaku.”",
      "Terjemahan_En": "You have your way, and I have my way.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَكُمۡ",
          "Arti_kata_in": "bagi kalian",
          "Arti_kata_en": "For you",
          "Text_Latin": "lakum",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "دِينُكُمۡ",
          "Arti_kata_in": "agamamu",
          "Arti_kata_en": "(is) your religion",
          "Text_Latin": "dinukum",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَلِيَ",
          "Arti_kata_in": "bagiku",
          "Arti_kata_en": "and for me",
          "Text_Latin": "waliya",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "دِينِ",
          "Arti_kata_in": "agamaku",
          "Arti_kata_en": "(is) my religion",
          "Text_Latin": "dini",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
}