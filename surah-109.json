        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَعۡبُدُ",
          "Arti_kata": "aku sembah",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6213,
      "Ayat_Arabic": "لَكُمْ دِيْنُكُمْ وَلِيَ دِيْنِ ࣖ",
      "Text_Latin": "lakum dinukum wa liya din",
      "Terjemah_in": "Untukmu agamamu dan untukku agamaku.”",
      "Terjemahan_En": "You have your way, and I have my way.”",
