          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَٰبِدُونَ",
          "Arti_kata": "menyembah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
