{
  "Nomor_surat": 79,
  "Nama_surat": "An-Nazi'at",
  "Ayat": [
    {
      "Nomor_ayat": 5713,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلنَّٰزِعَٰتِ",
          "Arti_kata_in": "demi yang mencabut",
          "Arti_kata_en": "By those who extract",
          "Text_Latin": "wan-nazi'ati"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "غَرۡقٗا",
          "Arti_kata_in": "dengan keras",
          "Arti_kata_en": "violently",
          "Text_Latin": "gharqan"
        }
      ]
    },
    {
      "Nomor_ayat": 5714,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلنَّٰشِطَٰتِ",
          "Arti_kata_in": "dan yang mencabut",
          "Arti_kata_en": "And those who draw out",
          "Text_Latin": "wan-nashitati"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَشۡطٗا",
          "Arti_kata_in": "perlahan-lahan",
          "Arti_kata_en": "gently",
          "Text_Latin": "nashtan"
        }
      ]
    },
    {
      "Nomor_ayat": 5715,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلسَّٰبِحَٰتِ",
          "Arti_kata_in": "dan yang turun",
          "Arti_kata_en": "And those who glide",
          "Text_Latin": "was-sabihati"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "سَبۡحٗا",
          "Arti_kata_in": "cepat",
          "Arti_kata_en": "swimming",
          "Text_Latin": "sabhan"
        }
      ]
    },
    {
      "Nomor_ayat": 5716,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱلسَّٰبِقَٰتِ",
          "Arti_kata_in": "dan yang mendahului",
          "Arti_kata_en": "And those who race each other",
          "Text_Latin": "fas-sabiqati"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "سَبۡقٗا",
          "Arti_kata_in": "dengan kencang",
          "Arti_kata_en": "(in) a race",
          "Text_Latin": "sabqan"
        }
      ]
    },
    {
      "Nomor_ayat": 5717,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱلۡمُدَبِّرَٰتِ",
          "Arti_kata_in": "dan yang mengatur",
          "Arti_kata_en": "And those who arrange",
          "Text_Latin": "fal-mudabirati"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَمۡرٗا",
          "Arti_kata_in": "urusan",
          "Arti_kata_en": "(the) matter",
          "Text_Latin": "amran"
        }
      ]
    },
    {
      "Nomor_ayat": 5718,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَوۡمَ",
          "Arti_kata_in": "hari",
          "Arti_kata_en": "(The) Day",
          "Text_Latin": "yawma"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تَرۡجُفُ",
          "Arti_kata_in": "bergoncang",
          "Arti_kata_en": "will quake",
          "Text_Latin": "tarjufu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلرَّاجِفَةُ",
          "Arti_kata_in": "goncangan",
          "Arti_kata_en": "the quaking one",
          "Text_Latin": "ar-rajifatu"
        }
      ]
    },
    {
      "Nomor_ayat": 5719,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "تَتۡبَعُهَا",
          "Arti_kata_in": "mengikutinya",
          "Arti_kata_en": "Follows it",
          "Text_Latin": "tatba'uha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلرَّادِفَةُ",
          "Arti_kata_in": "yang mengiringi",
          "Arti_kata_en": "the subsequent",
          "Text_Latin": "ar-radifatu"
        }
      ]
    },
    {
      "Nomor_ayat": 5720,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قُلُوبٞ",
          "Arti_kata_in": "hati-hati",
          "Arti_kata_en": "Hearts",
          "Text_Latin": "qulubun"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمَئِذٖ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_Latin": "yawma-idhin"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَاجِفَةٌ",
          "Arti_kata_in": "berdebar/sangat takut",
          "Arti_kata_en": "will palpitate",
          "Text_Latin": "wajifatun"
        }
      ]
    },
    {
      "Nomor_ayat": 5721,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَبۡصَٰرُهَا",
          "Arti_kata_in": "pandangannya",
          "Arti_kata_en": "Their eyes",
          "Text_Latin": "absaruha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "خَٰشِعَةٞ",
          "Arti_kata_in": "takut/tertunduk",
          "Arti_kata_en": "humbled",
          "Text_Latin": "khashi'atun"
        }
      ]
    },
    {
      "Nomor_ayat": 5722,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَقُولُونَ",
          "Arti_kata_in": "mereka berkata",
          "Arti_kata_en": "They say",
          "Text_Latin": "yaquluna"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَءِنَّا",
          "Arti_kata_in": "apakah sesungguhnya kami",
          "Arti_kata_en": "Will we",
          "Text_Latin": "a-inna"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَمَرۡدُودُونَ",
          "Arti_kata_in": "sungguh akan dikembalikan",
          "Arti_kata_en": "indeed be returned",
          "Text_Latin": "lamarduduna"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "to",
          "Text_Latin": "fi"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡحَافِرَةِ",
          "Arti_kata_in": "keadaan semula",
          "Arti_kata_en": "the former state",
          "Text_Latin": "al-hafirati"
        }
      ]
    },
    {
      "Nomor_ayat": 5723,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَءِذَا",
          "Arti_kata_in": "apakah apabila",
          "Arti_kata_en": "What! When",
          "Text_Latin": "a-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "كُنَّا",
          "Arti_kata_in": "kami adalah/menjadi",
          "Arti_kata_en": "we are",
          "Text_Latin": "kunna"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عِظَٰمٗا",
          "Arti_kata_in": "tulang belulang",
          "Arti_kata_en": "bones",
          "Text_Latin": "izaman"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "نَّخِرَةٗ",
          "Arti_kata_in": "hancur",
          "Arti_kata_en": "decayed",
          "Text_Latin": "nakhiratan"
        }
      ]
    },
    {
      "Nomor_ayat": 5724,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قَالُواْ",
          "Arti_kata_in": "mereka berkata",
          "Arti_kata_en": "They say",
          "Text_Latin": "qalu"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تِلۡكَ",
          "Arti_kata_in": "itu",
          "Arti_kata_en": "This",
          "Text_Latin": "til'ka"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "إِذٗا",
          "Arti_kata_in": "jika demikian",
          "Arti_kata_en": "then",
          "Text_Latin": "idhan"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "كَرَّةٌ",
          "Arti_kata_in": "pengembalian",
          "Arti_kata_en": "(would be) a return",
          "Text_Latin": "karratun"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "خَاسِرَةٞ",
          "Arti_kata_in": "kerugian",
          "Arti_kata_en": "losing",
          "Text_Latin": "khasiratun"
        }
      ]
    },
    {
      "Nomor_ayat": 5725,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِنَّمَا",
          "Arti_kata_in": "maka sesungguhnya hanyalah",
          "Arti_kata_en": "Then only",
          "Text_Latin": "fa-innama"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هِيَ",
          "Arti_kata_in": "ia/pengembalian",
          "Arti_kata_en": "it",
          "Text_Latin": "hiya"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "زَجۡرَةٞ",
          "Arti_kata_in": "teriakan",
          "Arti_kata_en": "(will be) a shout",
          "Text_Latin": "zajratun"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَٰحِدَةٞ",
          "Arti_kata_in": "satu/satu kali",
          "Arti_kata_en": "single",
          "Text_Latin": "wahidatun"
        }
      ]
    },
    {
      "Nomor_ayat": 5726,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِذَا",
          "Arti_kata_in": "maka tiba-tiba",
          "Arti_kata_en": "And behold!",
          "Text_Latin": "fa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُم",
          "Arti_kata_in": "mereka",
          "Arti_kata_en": "They",
          "Text_Latin": "hum"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلسَّاهِرَةِ",
          "Arti_kata_in": "di permukaan bumi",
          "Arti_kata_en": "(will be) awakened",
          "Text_Latin": "bil-sahirati"
        }
      ]
    },
    {
      "Nomor_ayat": 5727,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "هَلۡ",
          "Arti_kata_in": "apakah",
          "Arti_kata_en": "Has",
          "Text_Latin": "hal"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَتَىٰكَ",
          "Arti_kata_in": "telah sampai kepadamu",
          "Arti_kata_en": "(there) come to you",
          "Text_Latin": "ataka"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "حَدِيثُ",
          "Arti_kata_in": "cerita",
          "Arti_kata_en": "(the) story",
          "Text_Latin": "hadithu"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مُوسَىٰٓ",
          "Arti_kata_in": "Musa",
          "Arti_kata_en": "(of) Musa",
          "Text_Latin": "musa"
        }
      ]
    },
    {
      "Nomor_ayat": 5728,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِذۡ",
          "Arti_kata_in": "tatkala",
          "Arti_kata_en": "When",
          "Text_Latin": "idh"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَادَىٰهُ",
          "Arti_kata_in": "memanggilnya",
          "Arti_kata_en": "called him",
          "Text_Latin": "nadahu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبُّهُۥ",
          "Arti_kata_in": "Tuhannya",
          "Arti_kata_en": "his Lord",
          "Text_Latin": "rabbuhu"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "بِٱلۡوَادِ",
          "Arti_kata_in": "di lembah",
          "Arti_kata_en": "in the valley",
          "Text_Latin": "bil-wadi"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡمُقَدَّسِ",
          "Arti_kata_in": "suci",
          "Arti_kata_en": "the sacred",
          "Text_Latin": "al-muqadasi"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "طُوًى",
          "Arti_kata_in": "Tuwa",
          "Arti_kata_en": "(of) Tuwa",
          "Text_Latin": "tuwan"
        }
      ]
    },
    {
      "Nomor_ayat": 5729,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱذۡهَبۡ",
          "Arti_kata_in": "pergilah kamu",
          "Arti_kata_en": "Go",
          "Text_Latin": "idh'hab"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِلَىٰ",
          "Arti_kata_in": "kepada",
          "Arti_kata_en": "to",
          "Text_Latin": "ila"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فِرۡعَوۡنَ",
          "Arti_kata_in": "Fir'aun",
          "Arti_kata_en": "Firaun",
          "Text_Latin": "fir'awna"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "إِنَّهُۥ",
          "Arti_kata_in": "sesungguhnya dia",
          "Arti_kata_en": "Indeed he",
          "Text_Latin": "innahu"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "طَغَىٰ",
          "Arti_kata_in": "melampui batas",
          "Arti_kata_en": "(has) transgressed",
          "Text_Latin": "tagha"
        }
      ]
    },
    {
      "Nomor_ayat": 5730,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَقُلۡ",
          "Arti_kata_in": "maka katakanlah",
          "Arti_kata_en": "And say",
          "Text_Latin": "faqul"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هَل",
          "Arti_kata_in": "apakah/maukah",
          "Arti_kata_en": "Would",
          "Text_Latin": "hal"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَّكَ",
          "Arti_kata_in": "bagimu",
          "Arti_kata_en": "[for] you",
          "Text_Latin": "laka"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "إِلَىٰٓ",
          "Arti_kata_in": "kepada (untuk)",
          "Arti_kata_en": "[until]",
          "Text_Latin": "ila"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَن",
          "Arti_kata_in": "untuk",
          "Arti_kata_en": "[that]",
          "Text_Latin": "an"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "تَزَكَّىٰ",
          "Arti_kata_in": "kamu membersihkan diri",
          "Arti_kata_en": "purify yourself",
          "Text_Latin": "tazakka"
        }
      ]
    },
    {
      "Nomor_ayat": 5731,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَهۡدِيَكَ",
          "Arti_kata_in": "dan aku tunjukkan/pimpin kamu",
          "Arti_kata_en": "And I will guide you",
          "Text_Latin": "wa-ahdiyaka"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِلَىٰ",
          "Arti_kata_in": "kepada",
          "Arti_kata_en": "to",
          "Text_Latin": "ila"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_Latin": "rabbika"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فَتَخۡشَىٰ",
          "Arti_kata_in": "maka (supaya) kamu takut",
          "Arti_kata_en": "so you would fear",
          "Text_Latin": "fatakhsha"
        }
      ]
    },
    {
      "Nomor_ayat": 5732,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَرَىٰهُ",
          "Arti_kata_in": "maka dia memperlihatkan padanya",
          "Arti_kata_en": "Then he showed him",
          "Text_Latin": "fa-arahu"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡأٓيَةَ",
          "Arti_kata_in": "ayat-ayat/mu'jizat",
          "Arti_kata_en": "the sign",
          "Text_Latin": "al-ayata"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡكُبۡرَىٰ",
          "Arti_kata_in": "yang besar",
          "Arti_kata_en": "the great",
          "Text_Latin": "al-kub'ra"
        }
      ]
    },
    {
      "Nomor_ayat": 5733,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَكَذَّبَ",
          "Arti_kata_in": "maka dia mendustakan",
          "Arti_kata_en": "But he denied",
          "Text_Latin": "fakadhaba"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَعَصَىٰ",
          "Arti_kata_in": "dan dia mendurhakai",
          "Arti_kata_en": "and disobeyed",
          "Text_Latin": "wa'asa"
        }
      ]
    },
    {
      "Nomor_ayat": 5734,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ثُمَّ",
          "Arti_kata_in": "kemudian",
          "Arti_kata_en": "Then",
          "Text_Latin": "thumma"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَدۡبَرَ",
          "Arti_kata_in": "dia berpaling",
          "Arti_kata_en": "he turned his back",
          "Text_Latin": "adbara"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَسۡعَىٰ",
          "Arti_kata_in": "dia berusaha/berjalan",
          "Arti_kata_en": "striving",
          "Text_Latin": "yas'a"
        }
      ]
    },
    {
      "Nomor_ayat": 5735,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَحَشَرَ",
          "Arti_kata_in": "maka dia mengumpulkan",
          "Arti_kata_en": "And he gathered",
          "Text_Latin": "fahashara"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فَنَادَىٰ",
          "Arti_kata_in": "lalu dia berseru",
          "Arti_kata_en": "and called out",
          "Text_Latin": "fanada"
        }
      ]
    },
    {
      "Nomor_ayat": 5736,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَقَالَ",
          "Arti_kata_in": "maka dia berkata",
          "Arti_kata_en": "Then he said",
          "Text_Latin": "faqala"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَنَا۠",
          "Arti_kata_in": "aku",
          "Arti_kata_en": "I am",
          "Text_Latin": "ana"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبُّكُمُ",
          "Arti_kata_in": "Tuhan kalian",
          "Arti_kata_en": "your Lord",
          "Text_Latin": "rabbukumu"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡأَعۡلَىٰ",
          "Arti_kata_in": "paling tinggi",
