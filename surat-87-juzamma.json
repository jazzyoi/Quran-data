          "Arti_kata_en": "[the] former",
          "Text_latin  ": "al-ula"
        }
      ]
    },
    {
      "Nomor_ayat": 19,
      "Ayat_arabic ": "صُحُفِ اِبْرٰهِيْمَ وَمُوْسٰى ࣖ",
