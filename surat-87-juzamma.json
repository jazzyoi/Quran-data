        }
      ]
    },
    {
      "Nomor_ayat": 17,
      "Ayat_arabic ": "وَالْاٰخِرَةُ خَيْرٌ وَّاَبْقٰىۗ",
      "Ayat_latin": "wal-akhiratu khairuw wa abqa",
      "Terjemah_in": "padahal kehidupan akhirat itu lebih baik dan lebih kekal.",
      "Terjemah_en": "Though the Hereafter is better, and more lasting.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَٱلۡأٓخِرَةُ",
          "Arti_kata_in": "dan akherat",
          "Arti_kata_en": "While the Hereafter",
