{
  "Nomor_surat": 83,
  "Nama_surat": "Al-Muthaffifin",
  "surat_arabic": "المطففين",
  "Arti_surat_in": "Orang-orang yang Curang",
  "Arti_surat_en": "The Defrauding",
  "Ayat": [
    {
      "Nomor_ayat": 5849,
      "Ayat_Arabic": "وَيْلٌ لِّلْمُطَفِّفِيْنَۙ",
      "Text_Latin": "wailul lil-mutaffifin",
      "Terjemah_in": "Celakalah orang-orang yang curang (dalam menakar dan menimbang)!",
      "Terjemahan_En": "Woe to the defrauders.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَيۡلٞ",
          "Arti_kata": "kecelakaan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لِّلۡمُطَفِّفِينَ",
          "Arti_kata": "bagi orang-orang yang curang",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5850,
      "Ayat_Arabic": "الَّذِيْنَ اِذَا اكْتَالُوْا عَلَى النَّاسِ يَسْتَوْفُوْنَۖ",
      "Text_Latin": "allazina izaktalu 'alan-nasi yastaufun",
      "Terjemah_in": "(Mereka adalah) orang-orang yang apabila menerima takaran dari orang lain, mereka minta dipenuhi.",
      "Terjemahan_En": "Those who, when they take a measure from people, they take in full.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِينَ",
          "Arti_kata": "orang-orang yang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata": "apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱكۡتَالُواْ",
          "Arti_kata": "mereka menerima takaran",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "عَلَى",
          "Arti_kata": "atas",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلنَّاسِ",
