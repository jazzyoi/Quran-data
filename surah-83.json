          "Kata_Arabic": "يَسۡتَوۡفُونَ",
          "Arti_kata": "mereka minta dipenuhi",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5851,
      "Ayat_Arabic": "وَاِذَا كَالُوْهُمْ اَوْ وَّزَنُوْهُمْ يُخْسِرُوْنَۗ",
      "Text_Latin": "wa iza kaluhum aw wazanuhum yukhsirun",
      "Terjemah_in": "(Sebaliknya,) apabila mereka menakar atau menimbang untuk orang lain, mereka kurangi.",
      "Terjemahan_En": "But when they measure or weigh to others, they cheat.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata": "dan apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "كَالُوهُمۡ",
          "Arti_kata": "mereka menakar",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَو",
          "Arti_kata": "atau",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَّزَنُوهُمۡ",
          "Arti_kata": "mereka menimbang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "يُخۡسِرُونَ",
          "Arti_kata": "mengurangi",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5852,
      "Ayat_Arabic": "اَلَا يَظُنُّ اُولٰۤىِٕكَ اَنَّهُمْ مَّبْعُوْثُوْنَۙ",
      "Text_Latin": "ala yazunnu ula'ika annahum mab'usun",
      "Terjemah_in": "Tidakkah mereka mengira (bahwa) sesungguhnya mereka akan dibangkitkan",
      "Terjemahan_En": "Do these not know that they will be resurrected?",
