{
  "Nomor_surat": 75,
  "Nama_surat": "Al-Qiyamah",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَآ",
          "Arti_kata_in": "benar-benar",
          "Arti_kata_en": "Nay!",
          "Text_Latin": "la"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أُقۡسِمُ",
          "Arti_kata_in": "aku bersumpah",
          "Arti_kata_en": "I swear",
          "Text_Latin": "uq'simu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِيَوۡمِ",
          "Arti_kata_in": "dengan hari",
          "Arti_kata_en": "by (the) Day",
          "Text_Latin": "biyawmi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡقِيَٰمَةِ",
          "Arti_kata_in": "kiamat",
          "Arti_kata_en": "(of) the Resurrection",
          "Text_Latin": "al-qiyamati"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَآ",
          "Arti_kata_in": "dan benar-benar",
          "Arti_kata_en": "And nay!",
          "Text_Latin": "wala"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أُقۡسِمُ",
          "Arti_kata_in": "aku bersumpah",
          "Arti_kata_en": "I swear",
          "Text_Latin": "uq'simu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلنَّفۡسِ",
          "Arti_kata_in": "dengan jiwa",
          "Arti_kata_en": "by the soul",
          "Text_Latin": "bil-nafsi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱللَّوَّامَةِ",
          "Arti_kata_in": "mencela/menyesali",
          "Arti_kata_en": "self-accusing",
          "Text_Latin": "al-lawamati"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَيَحۡسَبُ",
          "Arti_kata_in": "apakah mengira",
          "Arti_kata_en": "Does think",
          "Text_Latin": "ayahsabu"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "[the] man",
          "Text_Latin": "al-insanu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَلَّن",
          "Arti_kata_in": "bahwa tidak",
          "Arti_kata_en": "that not",
          "Text_Latin": "allan"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "نَّجۡمَعَ",
          "Arti_kata_in": "Kami mengumpulkan",
          "Arti_kata_en": "We will assemble",
          "Text_Latin": "najma'a"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "عِظَامَهُۥ",
          "Arti_kata_in": "tulang-belulangnya",
          "Arti_kata_en": "his bones",
          "Text_Latin": "izamahu"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "بَلَىٰ",
          "Arti_kata_in": "yang benar/bahkan",
          "Arti_kata_en": "Nay!",
          "Text_Latin": "bala"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "قَٰدِرِينَ",
          "Arti_kata_in": "berkuasa",
          "Arti_kata_en": "[We are] able",
          "Text_Latin": "qadirina"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَىٰٓ",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "on",
          "Text_Latin": "ala"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "that",
          "Text_Latin": "an"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "نُّسَوِّيَ",
          "Arti_kata_in": "Kami menyempurnakan",
          "Arti_kata_en": "We can restore",
          "Text_Latin": "nusawwiya"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "بَنَانَهُۥ",
          "Arti_kata_in": "jari-jemarinya",
          "Arti_kata_en": "his fingertips",
          "Text_Latin": "bananahu"
        }
      ]
    },
    {
      "Nomor_ayat": 5,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "بَلۡ",
          "Arti_kata_in": "bahkan",
          "Arti_kata_en": "Nay!",
          "Text_Latin": "bal"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يُرِيدُ",
          "Arti_kata_in": "menghendaki",
          "Arti_kata_en": "Desires",
          "Text_Latin": "yuridu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "[the] man",
          "Text_Latin": "al-insanu"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لِيَفۡجُرَ",
          "Arti_kata_in": "untuk membuat durhaka",
          "Arti_kata_en": "to give (the) lie",
          "Text_Latin": "liyafjura"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَمَامَهُۥ",
          "Arti_kata_in": "di hadapannya/di masa depan",
          "Arti_kata_en": "(to) what is before him",
          "Text_Latin": "amamahu"
        }
      ]
    },
    {
      "Nomor_ayat": 6,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَسَۡٔلُ",
          "Arti_kata_in": "ia bertanya",
          "Arti_kata_en": "He asks",
          "Text_Latin": "yasalu"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَيَّانَ",
          "Arti_kata_in": "bilakah",
          "Arti_kata_en": "When",
          "Text_Latin": "ayyana"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَوۡمُ",
          "Arti_kata_in": "hari",
          "Arti_kata_en": "(is the) Day",
          "Text_Latin": "yawmu"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡقِيَٰمَةِ",
          "Arti_kata_in": "kiamat",
          "Arti_kata_en": "(of) the Resurrection",
          "Text_Latin": "al-qiyamati"
        }
      ]
    },
    {
      "Nomor_ayat": 7,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِذَا",
          "Arti_kata_in": "maka tatkala",
          "Arti_kata_en": "So when",
          "Text_Latin": "fa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بَرِقَ",
          "Arti_kata_in": "bingung/takut",
          "Arti_kata_en": "is dazzled",
          "Text_Latin": "bariqa"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡبَصَرُ",
          "Arti_kata_in": "pandangan/mata",
          "Arti_kata_en": "the vision",
          "Text_Latin": "al-basaru"
        }
      ]
    },
    {
      "Nomor_ayat": 8,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَخَسَفَ",
          "Arti_kata_in": "dan gelap/hilang cahaya",
          "Arti_kata_en": "And becomes dark",
          "Text_Latin": "wakhasafa"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡقَمَرُ",
          "Arti_kata_in": "bulan",
          "Arti_kata_en": "the moon",
          "Text_Latin": "al-qamaru"
        }
      ]
    },
    {
      "Nomor_ayat": 9,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَجُمِعَ",
          "Arti_kata_in": "dan dikumpulkan",
          "Arti_kata_en": "And are joined",
          "Text_Latin": "wajumi'a"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلشَّمۡسُ",
          "Arti_kata_in": "matahari",
          "Arti_kata_en": "the sun",
          "Text_Latin": "as-shamsu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَٱلۡقَمَرُ",
          "Arti_kata_in": "dan bulan",
          "Arti_kata_en": "and the moon",
          "Text_Latin": "wal-qamaru"
        }
      ]
    },
    {
      "Nomor_ayat": 10,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَقُولُ",
          "Arti_kata_in": "berkata",
          "Arti_kata_en": "Will say",
          "Text_Latin": "yaqulu"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "[the] man",
          "Text_Latin": "al-insanu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَوۡمَئِذٍ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_Latin": "yawma-idhin"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَيۡنَ",
          "Arti_kata_in": "dimana/kemana",
          "Arti_kata_en": "Where",
          "Text_Latin": "ayna"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡمَفَرُّ",
          "Arti_kata_in": "tempat lari",
          "Arti_kata_en": "(is) the escape",
          "Text_Latin": "al-mafaru"
        }
      ]
    },
    {
      "Nomor_ayat": 11,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّا",
          "Arti_kata_in": "sekali-kali tidak",
          "Arti_kata_en": "By no means!",
          "Text_Latin": "kalla"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَا",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "(There is) no",
          "Text_Latin": "la"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَزَرَ",
          "Arti_kata_in": "tempat lari/berlindung",
          "Arti_kata_en": "refuge",
          "Text_Latin": "wazara"
        }
      ]
    },
    {
      "Nomor_ayat": 12,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِلَىٰ",
          "Arti_kata_in": "kepada",
          "Arti_kata_en": "To",
          "Text_Latin": "ila"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_Latin": "rabbika"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَوۡمَئِذٍ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_Latin": "yawma-idhin"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡمُسۡتَقَرُّ",
          "Arti_kata_in": "tempat menetap/kembali",
          "Arti_kata_en": "(is) the place of rest",
          "Text_Latin": "al-mus'taqaru"
        }
      ]
    },
    {
      "Nomor_ayat": 13,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يُنَبَّؤُاْ",
          "Arti_kata_in": "diberitahukan",
          "Arti_kata_en": "Will be informed",
          "Text_Latin": "yunabba-u"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "[the] man",
          "Text_Latin": "al-insanu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَوۡمَئِذِۭ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_Latin": "yawma-idhin"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "بِمَا",
          "Arti_kata_in": "tentang apa",
          "Arti_kata_en": "of what",
          "Text_Latin": "bima"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "قَدَّمَ",
          "Arti_kata_in": "dia kerjakan/dahulukan",
          "Arti_kata_en": "he sent forth",
          "Text_Latin": "qaddama"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "وَأَخَّرَ",
          "Arti_kata_in": "dia akhirkan/lalaikan",
          "Arti_kata_en": "and kept back",
          "Text_Latin": "wa-akhara"
        }
      ]
    },
    {
      "Nomor_ayat": 14,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "بَلِ",
          "Arti_kata_in": "bahkan",
          "Arti_kata_en": "Nay!",
          "Text_Latin": "bali"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "[The] man",
          "Text_Latin": "al-insanu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَىٰ",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "against",
          "Text_Latin": "ala"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "نَفۡسِهِۦ",
          "Arti_kata_in": "dirinya",
          "Arti_kata_en": "himself",
          "Text_Latin": "nafsihi"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "بَصِيرَةٞ",
          "Arti_kata_in": "melihat terang (menjadi saksi)",
          "Arti_kata_en": "(will be) a witness",
          "Text_Latin": "basiratun"
        }
      ]
    },
    {
      "Nomor_ayat": 15,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَوۡ",
          "Arti_kata_in": "walaupun/meskipun",
          "Arti_kata_en": "Even if",
          "Text_Latin": "walaw"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَلۡقَىٰ",
          "Arti_kata_in": "dia lemparkan/kemukakan",
          "Arti_kata_en": "he presents",
          "Text_Latin": "alqa"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَعَاذِيرَهُۥ",
          "Arti_kata_in": "uzurnya/alasan-alasannya",
          "Arti_kata_en": "his excuses",
          "Text_Latin": "ma'adhirahu"
        }
      ]
    },
    {
      "Nomor_ayat": 16,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَا",
          "Arti_kata_in": "jangan",
          "Arti_kata_en": "Not",
          "Text_Latin": "la"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تُحَرِّكۡ",
          "Arti_kata_in": "kamu gerakkan",
          "Arti_kata_en": "move",
          "Text_Latin": "tuharrik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِهِۦ",
          "Arti_kata_in": "dengannya/padanya",
          "Arti_kata_en": "with it",
          "Text_Latin": "bihi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لِسَانَكَ",
          "Arti_kata_in": "lisanmu/lidahmu",
          "Arti_kata_en": "your tongue",
          "Text_Latin": "lisanaka"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "لِتَعۡجَلَ",
          "Arti_kata_in": "karena kamu hendak bersegera",
          "Arti_kata_en": "to hasten",
          "Text_Latin": "lita'jala"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "بِهِۦٓ",
          "Arti_kata_in": "dengannya/padanya",
          "Arti_kata_en": "with it",
          "Text_Latin": "bihi"
        }
      ]
    },
    {
      "Nomor_ayat": 17,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_Latin": "inna"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَلَيۡنَا",
          "Arti_kata_in": "atas Kami",
          "Arti_kata_en": "upon Us",
          "Text_Latin": "alayna"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "جَمۡعَهُۥ",
          "Arti_kata_in": "mengumpulkannya",
          "Arti_kata_en": "(is) its collection",
          "Text_Latin": "jam'ahu"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَقُرۡءَانَهُۥ",
          "Arti_kata_in": "dan membacakannya",
          "Arti_kata_en": "and its recitation",
          "Text_Latin": "waqur'anahu"
        }
      ]
    },
    {
      "Nomor_ayat": 18,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِذَا",
          "Arti_kata_in": "maka apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "fa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "قَرَأۡنَٰهُ",
          "Arti_kata_in": "Kami telah membacakannya",
          "Arti_kata_en": "We have recited it",
          "Text_Latin": "qaranahu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَٱتَّبِعۡ",
          "Arti_kata_in": "maka ikutilah",
          "Arti_kata_en": "then follow",
          "Text_Latin": "fa-ittabi'"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "قُرۡءَانَهُۥ",
          "Arti_kata_in": "bacaannya",
          "Arti_kata_en": "its recitation",
          "Text_Latin": "qur'anahu"
        }
      ]
    },
    {
      "Nomor_ayat": 19,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ثُمَّ",
          "Arti_kata_in": "kemudian",
          "Arti_kata_en": "Then",
          "Text_Latin": "thumma"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "indeed",
          "Text_Latin": "inna"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَيۡنَا",
          "Arti_kata_in": "atas Kami",
          "Arti_kata_en": "upon Us",
          "Text_Latin": "alayna"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "بَيَانَهُۥ",
          "Arti_kata_in": "penjelasannya",
          "Arti_kata_en": "(is) its explanation",
          "Text_Latin": "bayanahu"
        }
      ]
    },
    {
      "Nomor_ayat": 20,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّا",
          "Arti_kata_in": "tidak sekali-kali",
          "Arti_kata_en": "No!",
          "Text_Latin": "kalla"
        },
