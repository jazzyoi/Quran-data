{
  "Nomor_surat": 91,
  "Nama_surat": "Asy-Syams",
  "surat_arabic": "الشمس",
  "Arti_surat_in": "Matahari",
  "Arti_surat_en": "The Sun",
  "Ayat": [
    {
      "Nomor_ayat": 6044,
      "Ayat_Arabic": "وَالشَّمْسِ وَضُحٰىهَاۖ",
      "Text_Latin": "wasy-syamsi wa duhaha",
      "Terjemah_in": "Demi matahari dan sinarnya pada waktu duha (ketika matahari naik sepenggalah),",
      "Terjemahan_En": "By the sun and its radiance.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلشَّمۡسِ",
          "Arti_kata_in": "demi matahari",
          "Arti_kata_en": "By the sun",
          "Text_Latin": "was-shamsi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَضُحَىٰهَا",
          "Arti_kata_in": "dan cahayanya pagi hari",
          "Arti_kata_en": "and its brightness",
          "Text_Latin": "waduhaha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6045,
      "Ayat_Arabic": "وَالْقَمَرِ اِذَا تَلٰىهَاۖ",
      "Text_Latin": "wal-qamari iza talaha",
      "Terjemah_in": "demi bulan saat mengiringinya,",
      "Terjemahan_En": "And the moon as it follows it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡقَمَرِ",
          "Arti_kata_in": "dan bulan",
          "Arti_kata_en": "And the moon",
          "Text_Latin": "wal-qamari",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "تَلَىٰهَا",
          "Arti_kata_in": "mengiringinya",
          "Arti_kata_en": "it follows it",
          "Text_Latin": "talaha",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6046,
      "Ayat_Arabic": "وَالنَّهَارِ اِذَا جَلّٰىهَاۖ",
      "Text_Latin": "wan-nahari iza jallaha",
      "Terjemah_in": "demi siang saat menampakkannya,",
      "Terjemahan_En": "And the day as it reveals it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلنَّهَارِ",
          "Arti_kata_in": "dan siang",
          "Arti_kata_en": "And the day",
          "Text_Latin": "wan-nahari",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "جَلَّىٰهَا",
          "Arti_kata_in": "menampakkannya",
          "Arti_kata_en": "it displays it",
          "Text_Latin": "jallaha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6047,
      "Ayat_Arabic": "وَالَّيْلِ اِذَا يَغْشٰىهَاۖ",
      "Text_Latin": "wal-laili iza yagsyaha",
      "Terjemah_in": "demi malam saat menutupinya (gelap gulita),",
      "Terjemahan_En": "And the night as it conceals it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلَّيۡلِ",
          "Arti_kata_in": "dan malam",
          "Arti_kata_en": "And the night",
          "Text_Latin": "wa-al-layli",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَغۡشَىٰهَا",
          "Arti_kata_in": "menutupinya",
          "Arti_kata_en": "it covers it",
          "Text_Latin": "yaghshaha",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6048,
      "Ayat_Arabic": "وَالسَّمَاۤءِ وَمَا بَنٰىهَاۖ",
      "Text_Latin": "was-sama'i wa ma banaha",
      "Terjemah_in": "demi langit serta pembuatannya,",
      "Terjemahan_En": "And the sky and He who built it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلسَّمَآءِ",
          "Arti_kata_in": "dan langit",
          "Arti_kata_en": "And the heaven",
          "Text_Latin": "was-samai",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَمَا",
          "Arti_kata_in": "dan apa",
          "Arti_kata_en": "and He Who",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بَنَىٰهَا",
          "Arti_kata_in": "pembinaannya",
          "Arti_kata_en": "constructed it",
          "Text_Latin": "banaha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6049,
      "Ayat_Arabic": "وَالْاَرْضِ وَمَا طَحٰىهَاۖ",
      "Text_Latin": "wal-ardi wa ma tahaha",
      "Terjemah_in": "demi bumi serta penghamparannya,",
      "Terjemahan_En": "And the earth and He who spread it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡأَرۡضِ",
          "Arti_kata_in": "dan bumi",
          "Arti_kata_en": "And the earth",
          "Text_Latin": "wal-ardi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَمَا",
          "Arti_kata_in": "dan apa",
          "Arti_kata_en": "and He Who",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "طَحَىٰهَا",
          "Arti_kata_in": "penghamparannya",
          "Arti_kata_en": "spread it",
          "Text_Latin": "tahaha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6050,
      "Ayat_Arabic": "وَنَفْسٍ وَّمَا سَوّٰىهَاۖ",
      "Text_Latin": "wa nafsiw wa ma sawwaha",
      "Terjemah_in": "dan demi jiwa serta penyempurnaan (ciptaan)-nya,",
      "Terjemahan_En": "And the soul and He who proportioned it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَنَفۡسٖ",
          "Arti_kata_in": "dan manusia/jiwa",
          "Arti_kata_en": "And (the) soul",
          "Text_Latin": "wanafsin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَمَا",
          "Arti_kata_in": "dan apa",
          "Arti_kata_en": "and He Who",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "سَوَّىٰهَا",
          "Arti_kata_in": "penyempurnaanya",
          "Arti_kata_en": "proportioned it",
          "Text_Latin": "sawwaha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6051,
      "Ayat_Arabic": "فَاَلْهَمَهَا فُجُوْرَهَا وَتَقْوٰىهَاۖ",
      "Text_Latin": "fa al-hamaha fujuraha wa taqwaha",
      "Terjemah_in": "lalu Dia mengilhamkan kepadanya (jalan) kejahatan dan ketakwaannya,",
      "Terjemahan_En": "And inspired it with its wickedness and its righteousness.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَلۡهَمَهَا",
          "Arti_kata_in": "maka Dia mengilhamkan padanya",
          "Arti_kata_en": "And He inspired it",
          "Text_Latin": "fa-alhamaha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فُجُورَهَا",
          "Arti_kata_in": "kedurhakaanya",
          "Arti_kata_en": "(to understand) what is wrong for it",
          "Text_Latin": "fujuraha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَتَقۡوَىٰهَا",
          "Arti_kata_in": "dan ketaqwaannya",
          "Arti_kata_en": "and what is right for it",
          "Text_Latin": "wataqwaha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6052,
      "Ayat_Arabic": "قَدْ اَفْلَحَ مَنْ زَكّٰىهَاۖ",
      "Text_Latin": "qad aflaha man zakkaha",
      "Terjemah_in": "sungguh beruntung orang yang menyucikannya (jiwa itu)",
      "Terjemahan_En": "Successful is he who purifies it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قَدۡ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_Latin": "qad",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَفۡلَحَ",
          "Arti_kata_in": "beruntung",
          "Arti_kata_en": "he succeeds",
          "Text_Latin": "aflaha",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَن",
          "Arti_kata_in": "siapa/orang",
          "Arti_kata_en": "who",
          "Text_Latin": "man",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "زَكَّىٰهَا",
          "Arti_kata_in": "mensucikannya",
          "Arti_kata_en": "purifies it",
          "Text_Latin": "zakkaha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6053,
      "Ayat_Arabic": "وَقَدْ خَابَ مَنْ دَسّٰىهَاۗ",
      "Text_Latin": "wa qad khaba man dassaha",
      "Terjemah_in": "dan sungguh rugi orang yang mengotorinya.",
      "Terjemahan_En": "Failing is he who corrupts it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَقَدۡ",
          "Arti_kata_in": "dan sesungguhnya",
          "Arti_kata_en": "And indeed",
          "Text_Latin": "waqad",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "خَابَ",
          "Arti_kata_in": "celaka/rugi",
          "Arti_kata_en": "he fails",
          "Text_Latin": "khaba",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَن",
          "Arti_kata_in": "orang",
          "Arti_kata_en": "who",
          "Text_Latin": "man",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "دَسَّىٰهَا",
          "Arti_kata_in": "mengotorinya",
          "Arti_kata_en": "corrupts it",
          "Text_Latin": "dassaha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6054,
      "Ayat_Arabic": "كَذَّبَتْ ثَمُوْدُ بِطَغْوٰىهَآ  ۖ",
      "Text_Latin": "kazzabas samudu bitagwaha",
      "Terjemah_in": "(Kaum) Samud telah mendustakan (rasulnya) karena mereka melampaui batas",
      "Terjemahan_En": "Thamood denied in its pride.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَذَّبَتۡ",
          "Arti_kata_in": "telah mendustakan",
          "Arti_kata_en": "Denied",
          "Text_Latin": "kadhabat",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ثَمُودُ",
          "Arti_kata_in": "Samud",
          "Arti_kata_en": "Thamud",
          "Text_Latin": "thamudu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِطَغۡوَىٰهَآ",
          "Arti_kata_in": "dan melampui batas",
          "Arti_kata_en": "by their transgression",
          "Text_Latin": "bitaghwaha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6055,
      "Ayat_Arabic": "اِذِ انْۢبَعَثَ اَشْقٰىهَاۖ",
      "Text_Latin": "izimba'asa asyqaha",
      "Terjemah_in": "ketika orang yang paling celaka di antara mereka bangkit (untuk menyembelih unta betina Allah).",
      "Terjemahan_En": "When it followed its most wicked.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِذِ",
          "Arti_kata_in": "ketika",
          "Arti_kata_en": "When",
          "Text_Latin": "idhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱنۢبَعَثَ",
          "Arti_kata_in": "bangkit",
          "Arti_kata_en": "(was) sent forth",
          "Text_Latin": "inba'atha",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَشۡقَىٰهَا",
          "Arti_kata_in": "orang yang lebih celaka diantaranya",
          "Arti_kata_en": "(the) most wicked of them",
          "Text_Latin": "ashqaha",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6056,
      "Ayat_Arabic": "فَقَالَ لَهُمْ رَسُوْلُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقْيٰهَاۗ",
      "Text_Latin": "fa qala lahum rasulullahi naqatallahi wa suqyaha",
      "Terjemah_in": "Rasul Allah (Saleh) lalu berkata kepada mereka, “(Biarkanlah) unta betina Allah ini beserta minumannya.”",
      "Terjemahan_En": "The messenger of God said to them, “This is the she-camel of God, so let her drink.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَقَالَ",
          "Arti_kata_in": "dan berkata",
          "Arti_kata_en": "But said",
          "Text_Latin": "faqala",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَهُمۡ",
          "Arti_kata_in": "kepada mereka",
          "Arti_kata_en": "to them",
          "Text_Latin": "lahum",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَسُولُ",
          "Arti_kata_in": "rasul",
          "Arti_kata_en": "(the) Messenger",
          "Text_Latin": "rasulu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱللَّهِ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "(of) Allah",
          "Text_Latin": "al-lahi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "نَاقَةَ",
          "Arti_kata_in": "unta betina",
          "Arti_kata_en": "(It is the) she-camel",
          "Text_Latin": "naqata",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "ٱللَّهِ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "(of) Allah",
          "Text_Latin": "al-lahi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "وَسُقۡيَٰهَا",
          "Arti_kata_in": "dan minumannya",
          "Arti_kata_en": "and her drink",
          "Text_Latin": "wasuq'yaha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6057,
      "Ayat_Arabic": "فَكَذَّبُوْهُ فَعَقَرُوْهَاۖ فَدَمْدَمَ عَلَيْهِمْ رَبُّهُمْ بِذَنْۢبِهِمْ فَسَوّٰىهَاۖ",
      "Text_Latin": "fa kazzabuhu fa 'aqaruha fa damdama 'alaihim rabbuhum bizambihim fa sawwaha",
      "Terjemah_in": "Namun, mereka kemudian mendustakannya (Saleh) dan menyembelih (unta betina) itu. Maka, Tuhan membinasakan mereka karena dosa-dosanya, lalu meratakan mereka (dengan tanah).",
      "Terjemahan_En": "But they called him a liar, and hamstrung her. So their Lord crushed them for their sin, and leveled it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَكَذَّبُوهُ",
          "Arti_kata_in": "dan mendustakan",
          "Arti_kata_en": "But they denied him",
          "Text_Latin": "fakadhabuhu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فَعَقَرُوهَا",
          "Arti_kata_in": "maka mereka melukai/menyembelih",
          "Arti_kata_en": "and they hamstrung her",
          "Text_Latin": "fa'aqaruha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَدَمۡدَمَ",
          "Arti_kata_in": "maka menurunkan azab/membinasakan",
          "Arti_kata_en": "So destroyed",
          "Text_Latin": "fadamdama",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "عَلَيۡهِمۡ",
          "Arti_kata_in": "atas mereka",
          "Arti_kata_en": "them",
          "Text_Latin": "alayhim",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "رَبُّهُم",
          "Arti_kata_in": "Tuhan mereka",
          "Arti_kata_en": "their Lord",
          "Text_Latin": "rabbuhum",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "بِذَنۢبِهِمۡ",
          "Arti_kata_in": "dengan dosa-dosa mereka",
          "Arti_kata_en": "for their sin",
          "Text_Latin": "bidhanbihim",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "فَسَوَّىٰهَا",
          "Arti_kata_in": "dan Dia meratakannya",
          "Arti_kata_en": "and leveled them",
          "Text_Latin": "fasawwaha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6058,
      "Ayat_Arabic": "وَلَا يَخَافُ عُقْبٰهَا ࣖ",
      "Text_Latin": "wa la yakhafu 'uqbaha",
      "Terjemah_in": "Dia tidak takut terhadap akibatnya.",
      "Terjemahan_En": "And He does not fear its sequel.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And not",
          "Text_Latin": "wala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَخَافُ",
          "Arti_kata_in": "takut",
          "Arti_kata_en": "He fears",
          "Text_Latin": "yakhafu",
          "Jenis_kata": "Fiil Mudhorik"
        },
