          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "يُؤۡمِنُواْ",
          "Arti_kata": "mereka beriman",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "بِٱللَّهِ",
          "Arti_kata": "kepada Allah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "ٱلۡعَزِيزِ",
          "Arti_kata": "Maha Perkasa",
          "Jenis_kata": null
        },
        {
