        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡيَوۡمِ",
          "Arti_kata": "dan hari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡمَوۡعُودِ",
          "Arti_kata": "dijanjikan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5912,
      "Ayat_Arabic": "وَشَاهِدٍ وَّمَشْهُوْدٍۗ",
      "Text_Latin": "wa syahidiw wa masy-hud",
      "Terjemah_in": "demi yang menyaksikan dan yang disaksikan,",
      "Terjemahan_En": "And by the witness and the witnessed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَشَاهِدٖ",
          "Arti_kata": "Demi yang menyaksikan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَمَشۡهُودٖ",
          "Arti_kata": "dan yang disaksikan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5913,
      "Ayat_Arabic": "قُتِلَ اَصْحٰبُ الْاُخْدُوْدِۙ",
      "Text_Latin": "qutila as-habul-ukhdud",
      "Terjemah_in": "binasalah orang-orang yang membuat parit (tempat menyiksa orang mukmin)",
      "Terjemahan_En": "Destroyed were the People of the Trench.",
      "Kata": [
