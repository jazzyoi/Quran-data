          "Kata_Arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "(are) in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "تَكۡذِيبٖ",
          "Arti_kata_in": "kedustaan",
          "Arti_kata_en": "denial",
          "Text_Latin": "takdhibin",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5929,
      "Ayat_Arabic": "وَّاللّٰهُ مِنْ وَّرَاۤىِٕهِمْ مُّحِيْطٌۚ",
      "Text_Latin": "wallahu miw wara'ihim muhit",
      "Terjemah_in": "padahal Allah mengepung dari belakang mereka.",
      "Terjemahan_En": "And God encloses them from beyond.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱللَّهُ",
          "Arti_kata_in": "dan Allah",
          "Arti_kata_en": "But Allah",
          "Text_Latin": "wal-lahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مِن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "from",
          "Text_Latin": "min",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَرَآئِهِم",
          "Arti_kata_in": "belakang mereka",
          "Arti_kata_en": "behind them",
          "Text_Latin": "waraihim",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مُّحِيطُۢ",
          "Arti_kata_in": "meliputi/mengepung",
          "Arti_kata_en": "encompasses",
          "Text_Latin": "muhitun",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5930,
      "Ayat_Arabic": "بَلْ هُوَ قُرْاٰنٌ مَّجِيْدٌۙ",
      "Text_Latin": "bal huwa qur'anum majid",
      "Terjemah_in": "Bahkan, (yang didustakan itu) Al-Qur’an yang mulia",
      "Terjemahan_En": "In fact, it is a Glorious Quran.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "بَلۡ",
          "Arti_kata_in": "bahkan",
          "Arti_kata_en": "Nay!",
          "Text_Latin": "bal",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُوَ",
          "Arti_kata_in": "dia",
