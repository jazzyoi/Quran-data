{
  "Nomor_surat": 85,
  "Nama_surat": "Al-Buruj",
  "surat_arabic": "البروج",
  "Arti_surat_in": "Gugusan Bintang",
  "Arti_surat_en": "The Mansions of the Stars",
  "Ayat": [
    {
      "Nomor_ayat": 5910,
      "Ayat_Arabic": "وَالسَّمَاۤءِ ذَاتِ الْبُرُوْجِۙ",
      "Text_Latin": "was-sama'i zatil-buruj",
      "Terjemah_in": "Demi langit yang mempunyai gugusan bintang,",
      "Terjemahan_En": "By the sky with the constellations.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلسَّمَآءِ",
          "Arti_kata": "demi langit",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ذَاتِ",
          "Arti_kata": "memiliki",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡبُرُوجِ",
          "Arti_kata": "gugusan bintang-bintang",
          "Jenis_kata": null
        }
      ]
    },
    {
