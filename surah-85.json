          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5914,
      "Ayat_Arabic": "النَّارِ ذَاتِ الْوَقُوْدِۙ",
      "Text_Latin": "an-nari zatil-waqud",
