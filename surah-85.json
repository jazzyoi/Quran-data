          "Kata_Arabic": "فِي",
          "Arti_kata_in": "pada",
          "Arti_kata_en": "In",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَوۡحٖ",
          "Arti_kata_in": "papan/batu tulis",
          "Arti_kata_en": "a Tablet",
          "Text_Latin": "lawhin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَّحۡفُوظِۭ",
          "Arti_kata_in": "terpelihara",
          "Arti_kata_en": "Guarded",
