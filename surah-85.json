          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡوَقُودِ",
          "Arti_kata": "kayu bakar",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5915,
      "Ayat_Arabic": "اِذْ هُمْ عَلَيْهَا قُعُوْدٌۙ",
      "Text_Latin": "iz hum 'alaiha qu'ud",
      "Terjemah_in": "Ketika (itu) mereka (hanya) duduk di sekitarnya.",
      "Terjemahan_En": "While they sat around it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِذۡ",
          "Arti_kata": "ketika",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُمۡ",
          "Arti_kata": "mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَيۡهَا",
          "Arti_kata": "atas mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "قُعُودٞ",
          "Arti_kata": "duduk",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5916,
      "Ayat_Arabic": "وَّهُمْ عَلٰى مَا يَفْعَلُوْنَ بِالْمُؤْمِنِيْنَ شُهُوْدٌ  ۗ",
      "Text_Latin": "wa hum 'ala ma yaf'aluna bil-mu'minina syuhud",
      "Terjemah_in": "Mereka menyaksikan apa yang mereka perbuat terhadap orang-orang mukmin.",
      "Terjemahan_En": "And were witnessing what they did to the believers.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَهُمۡ",
          "Arti_kata": "dan mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَلَىٰ",
          "Arti_kata": "atas",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata": "apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَفۡعَلُونَ",
          "Arti_kata": "mereka perbuat",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "بِٱلۡمُؤۡمِنِينَ",
          "Arti_kata": "terhadap orang-orang yang beriman",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "شُهُودٞ",
          "Arti_kata": "menyaksikan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5917,
      "Ayat_Arabic": "وَمَا نَقَمُوْا مِنْهُمْ اِلَّآ اَنْ يُّؤْمِنُوْا بِاللّٰهِ الْعَزِيْزِ الْحَمِيْدِۙ",
      "Text_Latin": "wa ma naqamu min-hum illa ay yu'minu billahil-'azizil-hamid",
      "Terjemah_in": "Tidaklah mereka menyiksa (membakar) orang-orang mukmin itu, kecuali karena mereka beriman kepada Allah Yang Maha Perkasa lagi Maha Terpuji,",
      "Terjemahan_En": "They begrudged them only because they believed in God the Almighty, the Praiseworthy.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَا",
          "Arti_kata": "dan tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَقَمُواْ",
          "Arti_kata": "mereka menyiksa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مِنۡهُمۡ",
          "Arti_kata": "di antara mereka",
          "Jenis_kata": null
        },
