{
  "Nomor_surat": 108,
  "Nama_surat": "Al-Kautsar",
  "surat_arabic": "الكوثر",
  "Arti_surat_in": "Nikmat yang Berlimpah",
  "Arti_surat_en": "The Abundance",
  "Ayat": [
    {
      "Nomor_ayat": 6205,
      "Ayat_Arabic": "اِنَّآ اَعْطَيْنٰكَ الْكَوْثَرَۗ",
      "Text_Latin": "inna a'tainakal-kausar",
      "Terjemah_in": "Sesungguhnya Kami telah memberimu (Nabi Muhammad) nikmat yang banyak.",
      "Terjemahan_En": "We have given you plenty.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّآ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed, We",
          "Text_Latin": "inna",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَعۡطَيۡنَٰكَ",
          "Arti_kata_in": "Aku telah memberikan",
          "Arti_kata_en": "have given you",
          "Text_Latin": "a'taynaka",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡكَوۡثَرَ",
          "Arti_kata_in": "nikmat yang banyak",
          "Arti_kata_en": "Al-Kauthar",
          "Text_Latin": "al-kawthara",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6206,
      "Ayat_Arabic": "فَصَلِّ لِرَبِّكَ وَانْحَرْۗ",
      "Text_Latin": "fa salli lirabbika wan-har",
      "Terjemah_in": "Maka, laksanakanlah salat karena Tuhanmu dan berkurbanlah!",
      "Terjemahan_En": "So pray to your Lord and sacrifice.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَصَلِّ",
          "Arti_kata_in": "maka dirikanlah sholat",
          "Arti_kata_en": "So pray",
          "Text_Latin": "fasalli",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لِرَبِّكَ",
          "Arti_kata_in": "karena Tuhanmu",
          "Arti_kata_en": "to your Lord",
          "Text_Latin": "lirabbika",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَٱنۡحَرۡ",
          "Arti_kata_in": "dan berkurbanlah",
          "Arti_kata_en": "and sacrifice",
          "Text_Latin": "wa-in'har",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6207,
      "Ayat_Arabic": "اِنَّ شَانِئَكَ هُوَ الْاَبْتَرُ ࣖ",
      "Text_Latin": "inna syani'aka huwal-abtar",
      "Terjemah_in": "Sesungguhnya orang yang membencimu, dialah yang terputus (dari rahmat Allah).",
      "Terjemahan_En": "He who hates you is the loser.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_Latin": "inna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَانِئَكَ",
          "Arti_kata_in": "orang yang membencimu",
          "Arti_kata_en": "your enemy",
          "Text_Latin": "shani-aka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "هُوَ",
          "Arti_kata_in": "dia",
          "Arti_kata_en": "he (is)",
          "Text_Latin": "huwa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡأَبۡتَرُ",
          "Arti_kata_in": "terputus",
          "Arti_kata_en": "the one cut off",
          "Text_Latin": "al-abtaru",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
}