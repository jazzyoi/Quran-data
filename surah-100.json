{
  "Nomor_surat": 100,
  "Nama_surat": "Al-'Adiyat",
  "surat_arabic": "العاديات",
  "Arti_surat_in": "Berlari Kencang",
  "Arti_surat_en": "The Courser",
  "Ayat": [
    {
      "Nomor_ayat": 6147,
      "Ayat_Arabic": "وَالْعٰدِيٰتِ ضَبْحًاۙ",
      "Text_Latin": "wal-'adiyati dab-ha",
      "Terjemah_in": "Demi kuda-kuda perang yang berlari kencang terengah-engah,",
      "Terjemahan_En": "By the racers panting.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡعَٰدِيَٰتِ",
          "Arti_kata_in": "demi yang berlari kencang",
          "Arti_kata_en": "By the racers",
          "Text_Latin": "wal-'adiyati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ضَبۡحٗا",
          "Arti_kata_in": "terengah-engah",
          "Arti_kata_en": "panting",
          "Text_Latin": "dabhan",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6148,
      "Ayat_Arabic": "فَالْمُوْرِيٰتِ قَدْحًاۙ",
      "Text_Latin": "fal-muriyati qad-ha",
      "Terjemah_in": "yang memercikkan bunga api (dengan entakan kakinya),",
      "Terjemahan_En": "Igniting sparks.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱلۡمُورِيَٰتِ",
          "Arti_kata_in": "lalu yang memercikkan/terbitkan",
          "Arti_kata_en": "And the producers of sparks",
          "Text_Latin": "fal-muriyati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "قَدۡحٗا",
          "Arti_kata_in": "api",
          "Arti_kata_en": "striking",
          "Text_Latin": "qadhan",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6149,
      "Ayat_Arabic": "فَالْمُغِيْرٰتِ صُبْحًاۙ",
      "Text_Latin": "fal-mugirati sub-ha",
      "Terjemah_in": "yang menyerang (dengan tiba-tiba) pada waktu pagi",
      "Terjemahan_En": "Raiding at dawn.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱلۡمُغِيرَٰتِ",
          "Arti_kata_in": "lalu yang menyerang",
          "Arti_kata_en": "And the chargers",
          "Text_Latin": "fal-mughirati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "صُبۡحٗا",
          "Arti_kata_in": "diwaktu subuh/pagi",
          "Arti_kata_en": "(at) dawn",
          "Text_Latin": "sub'han",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6150,
      "Ayat_Arabic": "فَاَثَرْنَ بِهٖ نَقْعًاۙ",
      "Text_Latin": "fa asarna bihi naq'a",
      "Terjemah_in": "sehingga menerbangkan debu,",
      "Terjemahan_En": "Raising clouds of dust.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَثَرۡنَ",
          "Arti_kata_in": "lalu ia menerbangkan",
          "Arti_kata_en": "Then raise",
          "Text_Latin": "fa-atharna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بِهِۦ",
          "Arti_kata_in": "dengannya/karenanya",
          "Arti_kata_en": "thereby",
          "Text_Latin": "bihi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نَقۡعٗا",
          "Arti_kata_in": "debu",
          "Arti_kata_en": "dust",
          "Text_Latin": "naq'an",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6151,
      "Ayat_Arabic": "فَوَسَطْنَ بِهٖ جَمْعًاۙ",
      "Text_Latin": "fa wasatna bihi jam'a",
      "Terjemah_in": "lalu menyerbu ke tengah-tengah kumpulan musuh,",
      "Terjemahan_En": "Storming into the midst.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَوَسَطۡنَ",
          "Arti_kata_in": "maka ia menyerbu ketengah",
          "Arti_kata_en": "Then penetrate (in the) center",
          "Text_Latin": "fawasatna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بِهِۦ",
          "Arti_kata_in": "dengannya",
          "Arti_kata_en": "thereby",
          "Text_Latin": "bihi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "جَمۡعًا",
          "Arti_kata_in": "kumpulan",
          "Arti_kata_en": "(of) troops",
          "Text_Latin": "jam'an",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6152,
      "Ayat_Arabic": "اِنَّ الْاِنْسَانَ لِرَبِّهٖ لَكَنُوْدٌ ۚ",
      "Text_Latin": "innal-insana lirabbihi lakanud",
      "Terjemah_in": "sesungguhnya manusia itu sangatlah ingkar kepada Tuhannya.",
      "Terjemahan_En": "Indeed, the human being is ungrateful to his Lord.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata_in": "sungguh",
          "Arti_kata_en": "Indeed",
          "Text_Latin": "inna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "mankind",
          "Text_Latin": "al-insana",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لِرَبِّهِۦ",
          "Arti_kata_in": "kepada Tuhannya",
          "Arti_kata_en": "to his Lord",
          "Text_Latin": "lirabbihi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَكَنُودٞ",
          "Arti_kata_in": "sangat ingkar/tidak berterima kasih",
          "Arti_kata_en": "(is) surely ungrateful",
          "Text_Latin": "lakanudun",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6153,
      "Ayat_Arabic": "وَاِنَّهٗ عَلٰى ذٰلِكَ لَشَهِيْدٌۚ",
      "Text_Latin": "wa innahu 'ala zalika lasyahid",
      "Terjemah_in": "Sesungguhnya dia benar-benar menjadi saksi atas hal itu (keingkarannya).",
      "Terjemahan_En": "And he bears witness to that.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِنَّهُۥ",
          "Arti_kata_in": "dan sesungguhnya ia",
          "Arti_kata_en": "And indeed he",
          "Text_Latin": "wa-innahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَلَىٰ",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "to",
          "Text_Latin": "ala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ذَٰلِكَ",
          "Arti_kata_in": "yang demikian/itu",
          "Arti_kata_en": "that",
          "Text_Latin": "dhalika",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَشَهِيدٞ",
          "Arti_kata_in": "benar-benar menyaksikan",
          "Arti_kata_en": "surely (is) a witness",
          "Text_Latin": "lashahidun",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6154,
      "Ayat_Arabic": "وَاِنَّهٗ لِحُبِّ الْخَيْرِ لَشَدِيْدٌ ۗ",
      "Text_Latin": "wa innahu lihubbil-khairi lasyadid",
      "Terjemah_in": "Sesungguhnya cintanya pada harta benar-benar berlebihan.",
      "Terjemahan_En": "And he is fierce in his love of wealth.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِنَّهُۥ",
          "Arti_kata_in": "dan sesungguhnya dia",
          "Arti_kata_en": "And indeed he (is)",
          "Text_Latin": "wa-innahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لِحُبِّ",
          "Arti_kata_in": "benar-benar cinta",
          "Arti_kata_en": "in (the) love",
          "Text_Latin": "lihubbi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡخَيۡرِ",
          "Arti_kata_in": "kebaikan (harta)",
          "Arti_kata_en": "(of) wealth",
          "Text_Latin": "al-khayri",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَشَدِيدٌ",
          "Arti_kata_in": "sungguh sangat",
          "Arti_kata_en": "(is) surely intense",
          "Text_Latin": "lashadidun",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6155,
      "Ayat_Arabic": "۞ اَفَلَا يَعْلَمُ اِذَا بُعْثِرَ مَا فِى الْقُبُوْرِۙ",
      "Text_Latin": "a fa la ya'lamu iza bu'sira ma fil-qubur",
      "Terjemah_in": "Maka, tidakkah dia mengetahui (apa yang akan dialaminya) apabila dikeluarkan apa yang ada di dalam kubur",
      "Terjemahan_En": "Does he not know? When the contents of the graves are scattered around.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "۞أَفَلَا",
          "Arti_kata_in": "maka apakah tidak",
          "Arti_kata_en": "But does not",
          "Text_Latin": "afala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَعۡلَمُ",
          "Arti_kata_in": "dia mengetahui",
          "Arti_kata_en": "he know",
          "Text_Latin": "ya'lamu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "بُعۡثِرَ",
          "Arti_kata_in": "dibangkitkan",
          "Arti_kata_en": "will be scattered",
          "Text_Latin": "bu'thira",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "(is) in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "ٱلۡقُبُورِ",
          "Arti_kata_in": "kubur",
          "Arti_kata_en": "the graves",
          "Text_Latin": "al-quburi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6156,
      "Ayat_Arabic": "وَحُصِّلَ مَا فِى الصُّدُوْرِۙ",
      "Text_Latin": "wa hussila ma fis-sudur",
      "Terjemah_in": "dan ditampakkan apa yang tersimpan di dalam dada?",
      "Terjemahan_En": "And the contents of the hearts are obtained.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَحُصِّلَ",
          "Arti_kata_in": "dan dilahirkan",
          "Arti_kata_en": "And is made apparent",
          "Text_Latin": "wahussila",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "(is) in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلصُّدُورِ",
          "Arti_kata_in": "dada",
          "Arti_kata_en": "the breasts",
          "Text_Latin": "as-suduri",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6157,
      "Ayat_Arabic": "اِنَّ رَبَّهُمْ بِهِمْ يَوْمَىِٕذٍ لَّخَبِيْرٌ ࣖ",
      "Text_Latin": "inna rabbahum bihim yauma'izil lakhabir",
      "Terjemah_in": "Sesungguhnya Tuhan mereka pada hari itu benar-benar Maha Teliti terhadap (keadaan) mereka.",
      "Terjemahan_En": "Their Lord, on that Day, is fully informed of them.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_Latin": "inna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَبَّهُم",
          "Arti_kata_in": "Tuhan mereka",
          "Arti_kata_en": "their Lord",
          "Text_Latin": "rabbahum",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِهِمۡ",
          "Arti_kata_in": "pada mereka",
          "Arti_kata_en": "about them",
          "Text_Latin": "bihim",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَوۡمَئِذٖ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_Latin": "yawma-idhin",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "لَّخَبِيرُۢ",
          "Arti_kata_in": "benar-benar Maha Mengetahui",
          "Arti_kata_en": "(is) surely All-Aware",
          "Text_Latin": "lakhabirun",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
}