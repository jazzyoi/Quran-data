{
  "Nomor_surat": 88,
  "Nama_surat": "Al-Ghasyiyah",
  "surat_arabic": "الغاشية",
  "Arti_surat_in": "Hari Pembalasan",
  "Arti_surat_en": "The Overwhelming",
  "Ayat": [
    {
      "Nomor_ayat": 5968,
      "Ayat_Arabic": "هَلْ اَتٰىكَ حَدِيْثُ الْغَاشِيَةِۗ",
      "Text_Latin": "hal ataka hadisul-gasyiyah",
      "Terjemah_in": "Sudahkah sampai kepadamu berita tentang al-Gāsyiyah (hari Kiamat yang menutupi kesadaran manusia dengan kedahsyatannya)?",
      "Terjemahan_En": "Has there come to you the news of the overwhelming?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "هَلۡ",
          "Arti_kata": "apakah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَتَىٰكَ",
          "Arti_kata": "telah datang kepadamu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "حَدِيثُ",
          "Arti_kata": "cerita/berita",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡغَٰشِيَةِ",
          "Arti_kata": "peristiwa yang dahsyat",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5969,
      "Ayat_Arabic": "وُجُوْهٌ يَّوْمَىِٕذٍ خَاشِعَةٌ  ۙ",
      "Text_Latin": "wujuhuy yauma'izin khasyi'ah",
      "Terjemah_in": "Pada hari itu banyak wajah yang tertunduk hina",
      "Terjemahan_En": "Faces on that Day will be shamed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وُجُوهٞ",
          "Arti_kata": "wajah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمَئِذٍ",
          "Arti_kata": "pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "خَٰشِعَةٌ",
          "Arti_kata": "tertunduk",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5970,
      "Ayat_Arabic": "عَامِلَةٌ نَّاصِبَةٌ  ۙ",
      "Text_Latin": "'amilatun nasibah",
      "Terjemah_in": "(karena) berusaha keras (menghindari azab neraka) lagi kepayahan (karena dibelenggu).",
      "Terjemahan_En": "Laboring and exhausted.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "عَامِلَةٞ",
          "Arti_kata": "kerja keras",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَّاصِبَةٞ",
          "Arti_kata": "letih/kepayahan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5971,
      "Ayat_Arabic": "تَصْلٰى نَارًا حَامِيَةً  ۙ",
      "Text_Latin": "tasla naran hamiyah",
      "Terjemah_in": "Mereka memasuki api (neraka) yang sangat panas.",
      "Terjemahan_En": "Roasting in a scorching Fire.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "تَصۡلَىٰ",
          "Arti_kata": "ia memasuki",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَارًا",
          "Arti_kata": "api/neraka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "حَامِيَةٗ",
          "Arti_kata": "sangat panas",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5972,
      "Ayat_Arabic": "تُسْقٰى مِنْ عَيْنٍ اٰنِيَةٍ ۗ",
      "Text_Latin": "tusqa min 'ainin aniyah",
      "Terjemah_in": "(Mereka) diberi minum dari sumber mata air yang sangat panas.",
      "Terjemahan_En": "Given to drink from a flaming spring.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "تُسۡقَىٰ",
          "Arti_kata": "ia diberikan minuman",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مِنۡ",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَيۡنٍ",
          "Arti_kata": "mata air",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ءَانِيَةٖ",
          "Arti_kata": "sangat panas/mendidih",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5973,
      "Ayat_Arabic": "لَيْسَ لَهُمْ طَعَامٌ اِلَّا مِنْ ضَرِيْعٍۙ",
      "Text_Latin": "laisa lahum ta'amun illa min dari'",
      "Terjemah_in": "Tidak ada makanan bagi mereka selain dari pohon yang berduri,",
      "Terjemahan_En": "They will have no food except thorns.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَّيۡسَ",
          "Arti_kata": "tidak ada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَهُمۡ",
          "Arti_kata": "bagi mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "طَعَامٌ",
          "Arti_kata": "makanan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "إِلَّا",
          "Arti_kata": "kecuali",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "مِن",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "ضَرِيعٖ",
          "Arti_kata": "pohon berduri",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5974,
      "Ayat_Arabic": "لَّا يُسْمِنُ وَلَا يُغْنِيْ مِنْ جُوْعٍۗ",
      "Text_Latin": "la yusminu wa la yugni min ju'",
      "Terjemah_in": "yang tidak menggemukkan dan tidak pula menghilangkan lapar.",
      "Terjemahan_En": "That neither nourishes, nor satisfies hunger.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَّا",
          "Arti_kata": "tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يُسۡمِنُ",
          "Arti_kata": "menggemukkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَلَا",
          "Arti_kata": "dan tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يُغۡنِي",
          "Arti_kata": "mencukupi/menghilangkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "مِن",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "جُوعٖ",
          "Arti_kata": "lapar",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5975,
      "Ayat_Arabic": "وُجُوْهٌ يَّوْمَىِٕذٍ نَّاعِمَةٌ  ۙ",
      "Text_Latin": "wujuhuy yauma'izin na'imah",
      "Terjemah_in": "Pada hari itu banyak (pula) wajah yang berseri-seri,",
      "Terjemahan_En": "Faces on that Day will be joyful.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وُجُوهٞ",
          "Arti_kata": "wajah-wajah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمَئِذٖ",
          "Arti_kata": "pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نَّاعِمَةٞ",
          "Arti_kata": "penuh kenikmatan/berseri-seri",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5976,
      "Ayat_Arabic": "لِّسَعْيِهَا رَاضِيَةٌ  ۙ",
      "Text_Latin": "lisa'yiha radiyah",
      "Terjemah_in": "merasa puas karena usahanya.",
      "Terjemahan_En": "Satisfied with their endeavor.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لِّسَعۡيِهَا",
          "Arti_kata": "karena usahanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَاضِيَةٞ",
          "Arti_kata": "merasa senang",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5977,
      "Ayat_Arabic": "فِيْ جَنَّةٍ عَالِيَةٍۙ",
      "Text_Latin": "fi jannatin 'aliyah",
      "Terjemah_in": "(Mereka) dalam surga yang tinggi.",
      "Terjemahan_En": "In a lofty Garden.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فِي",
          "Arti_kata": "dalam",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "جَنَّةٍ",
          "Arti_kata": "sorga",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَالِيَةٖ",
          "Arti_kata": "yang tinggi",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5978,
      "Ayat_Arabic": "لَّا تَسْمَعُ فِيْهَا لَاغِيَةً ۗ",
      "Text_Latin": "la tasma'u fiha lagiyah",
      "Terjemah_in": "Di sana kamu tidak mendengar (perkataan) yang tidak berguna.",
      "Terjemahan_En": "In it you will hear no nonsense.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَّا",
          "Arti_kata": "tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تَسۡمَعُ",
          "Arti_kata": "kamu mendengar",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فِيهَا",
          "Arti_kata": "di dalamnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَٰغِيَةٗ",
          "Arti_kata": "sia-sia/tidak berguna",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5979,
      "Ayat_Arabic": "فِيْهَا عَيْنٌ جَارِيَةٌ  ۘ",
      "Text_Latin": "fiha 'ainun jariyah",
      "Terjemah_in": "Di sana ada mata air yang mengalir.",
      "Terjemahan_En": "In it is a flowing spring.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فِيهَا",
          "Arti_kata": "di dalamnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَيۡنٞ",
          "Arti_kata": "mata air",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "جَارِيَةٞ",
          "Arti_kata": "mengalir",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5980,
      "Ayat_Arabic": "فِيْهَا سُرُرٌ مَّرْفُوْعَةٌ  ۙ",
      "Text_Latin": "fiha sururum marfu'ah",
      "Terjemah_in": "Di sana ada (pula) dipan-dipan yang ditinggikan,",
      "Terjemahan_En": "In it are raised beds.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فِيهَا",
          "Arti_kata": "di dalamnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "سُرُرٞ",
          "Arti_kata": "tempat tempat duduk",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَّرۡفُوعَةٞ",
          "Arti_kata": "yang tinggi",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5981,
      "Ayat_Arabic": "وَّاَكْوَابٌ مَّوْضُوْعَةٌ  ۙ",
      "Text_Latin": "wa akwabum maudu'ah",
      "Terjemah_in": "gelas-gelas yang tersedia (di dekatnya),",
      "Terjemahan_En": "And cups set in place.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَكۡوَابٞ",
          "Arti_kata": "dan gelas-gelas",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَّوۡضُوعَةٞ",
          "Arti_kata": "terletak/tersedia",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5982,
      "Ayat_Arabic": "وَّنَمَارِقُ مَصْفُوْفَةٌ  ۙ",
      "Text_Latin": "wa namariqu masfufah",
      "Terjemah_in": "bantal-bantal sandaran yang tersusun,",
      "Terjemahan_En": "And cushions set in rows.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَنَمَارِقُ",
          "Arti_kata": "dan bantal-bantal",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَصۡفُوفَةٞ",
          "Arti_kata": "berbaris/tersusun",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5983,
      "Ayat_Arabic": "وَّزَرَابِيُّ مَبْثُوْثَةٌ  ۗ",
      "Text_Latin": "wa zarabiyyu mabsusah",
      "Terjemah_in": "dan permadani-permadani yang terhampar.",
      "Terjemahan_En": "And carpets spread around.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَزَرَابِيُّ",
          "Arti_kata": "dan permadani",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَبۡثُوثَةٌ",
          "Arti_kata": "terhampar",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5984,
      "Ayat_Arabic": "اَفَلَا يَنْظُرُوْنَ اِلَى الْاِبِلِ كَيْفَ خُلِقَتْۗ",
      "Text_Latin": "a fa la yanzuruna ilal-ibili kaifa khuliqat",
      "Terjemah_in": "Tidakkah mereka memperhatikan unta, bagaimana ia diciptakan?",
      "Terjemahan_En": "Do they not look at the camels—how they are created?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَفَلَا",
          "Arti_kata": "maka apakah tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَنظُرُونَ",
          "Arti_kata": "mereka memperhatikan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "إِلَى",
          "Arti_kata": "kepada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡإِبِلِ",
          "Arti_kata": "unta",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "كَيۡفَ",
          "Arti_kata": "bagaimana",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "خُلِقَتۡ",
          "Arti_kata": "ia diciptakan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5985,
      "Ayat_Arabic": "وَاِلَى السَّمَاۤءِ كَيْفَ رُفِعَتْۗ",
      "Text_Latin": "wa ilas-sama'i kaifa rufi'at",
      "Terjemah_in": "Bagaimana langit ditinggikan?",
      "Terjemahan_En": "And at the sky—how it is raised?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِلَى",
          "Arti_kata": "dan kepada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلسَّمَآءِ",
          "Arti_kata": "langit",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كَيۡفَ",
          "Arti_kata": "bagaimana",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "رُفِعَتۡ",
          "Arti_kata": "ia ditinggikan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5986,
      "Ayat_Arabic": "وَاِلَى الْجِبَالِ كَيْفَ نُصِبَتْۗ",
      "Text_Latin": "wa ilal-jibali kaifa nusibat",
      "Terjemah_in": "Bagaimana gunung-gunung ditegakkan?",
      "Terjemahan_En": "And at the mountains—how they are installed?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِلَى",
          "Arti_kata": "dan kepada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡجِبَالِ",
          "Arti_kata": "gunung-gunung",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كَيۡفَ",
          "Arti_kata": "bagaimana",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "نُصِبَتۡ",
          "Arti_kata": "ia ditegakkan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5987,
      "Ayat_Arabic": "وَاِلَى الْاَرْضِ كَيْفَ سُطِحَتْۗ",
      "Text_Latin": "wa ilal-ardi kaifa sutihat",
      "Terjemah_in": "Bagaimana pula bumi dihamparkan?",
      "Terjemahan_En": "And at the earth—how it is spread out?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِلَى",
          "Arti_kata": "dan kepada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡأَرۡضِ",
          "Arti_kata": "bumi",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كَيۡفَ",
          "Arti_kata": "bagaimana",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "سُطِحَتۡ",
          "Arti_kata": "ia dihamparkan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5988,
      "Ayat_Arabic": "فَذَكِّرْۗ اِنَّمَآ اَنْتَ مُذَكِّرٌۙ",
      "Text_Latin": "fa zakkir, innama anta muzakkir",
