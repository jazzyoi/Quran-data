{
  "Nomor_surat": 96,
  "Nama_surat": "Al-'Alaq",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Ayat_arabic ": "اِقْرَأْ بِاسْمِ رَبِّكَ الَّذِيْ خَلَقَۚ",
      "Ayat_latin": "iqra' bismi rabbikallazi khalaq",
      "Terjemah_in": "Bacalah dengan (menyebut) nama Tuhanmu yang menciptakan!",
      "Terjemah_en": "Read: In the Name of your Lord who created.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ٱقۡرَأۡ",
          "Arti_kata_in": "bacalah",
          "Arti_kata_en": "Read",
          "Text_latin  ": "iq'ra"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "بِٱسۡمِ",
          "Arti_kata_in": "dengan nama",
          "Arti_kata_en": "in (the) name",
          "Text_latin  ": "bi-is'mi"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "(of) your Lord",
          "Text_latin  ": "rabbika"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "the One Who",
          "Text_latin  ": "alladhi"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "خَلَقَ",
          "Arti_kata_in": "menciptakan",
          "Arti_kata_en": "created",
          "Text_latin  ": "khalaqa"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Ayat_arabic ": "خَلَقَ الْاِنْسَانَ مِنْ عَلَقٍۚ",
      "Ayat_latin": "khalaqal-insana min 'alaq",
      "Terjemah_in": "Dia menciptakan manusia dari segumpal darah.",
      "Terjemah_en": "Created man from a clot.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "خَلَقَ",
          "Arti_kata_in": "menciptakan",
          "Arti_kata_en": "He created",
          "Text_latin  ": "khalaqa"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "man",
          "Text_latin  ": "al-insana"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مِنۡ",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "from",
          "Text_latin  ": "min"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "عَلَقٍ",
          "Arti_kata_in": "segumpal darah",
          "Arti_kata_en": "a clinging substance",
          "Text_latin  ": "alaqin"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Ayat_arabic ": "اِقْرَأْ وَرَبُّكَ الْاَكْرَمُۙ",
      "Ayat_latin": "iqra' wa rabbukal-akram",
      "Terjemah_in": "Bacalah! Tuhanmulah Yang Maha Mulia,",
      "Terjemah_en": "Read: And your Lord is the Most Generous.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ٱقۡرَأۡ",
          "Arti_kata_in": "bacalah",
          "Arti_kata_en": "Read",
          "Text_latin  ": "iq'ra"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "وَرَبُّكَ",
          "Arti_kata_in": "dan Tuhanmu",
          "Arti_kata_en": "and your Lord",
          "Text_latin  ": "warabbuka"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلۡأَكۡرَمُ",
          "Arti_kata_in": "amat mulia",
          "Arti_kata_en": "(is) the Most Generous",
          "Text_latin  ": "al-akramu"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Ayat_arabic ": "الَّذِيْ عَلَّمَ بِالْقَلَمِۙ",
      "Ayat_latin": "allazi 'allama bil-qalam",
      "Terjemah_in": "yang mengajar (manusia) dengan pena.",
      "Terjemah_en": "He who taught by the pen.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "The One Who",
          "Text_latin  ": "alladhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "عَلَّمَ",
          "Arti_kata_in": "Dia mengajar",
          "Arti_kata_en": "taught",
          "Text_latin  ": "allama"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "بِٱلۡقَلَمِ",
          "Arti_kata_in": "dengan kalam",
          "Arti_kata_en": "by the pen",
          "Text_latin  ": "bil-qalami"
        }
      ]
    },
    {
      "Nomor_ayat": 5,
      "Ayat_arabic ": "عَلَّمَ الْاِنْسَانَ مَا لَمْ يَعْلَمْۗ",
      "Ayat_latin": "'allamal-insana ma lam ya'lam",
      "Terjemah_in": "Dia mengajarkan manusia apa yang tidak diketahuinya.",
      "Terjemah_en": "Taught man what he never knew.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "عَلَّمَ",
          "Arti_kata_in": "Dia mengajarkan",
          "Arti_kata_en": "Taught",
          "Text_latin  ": "allama"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "man",
          "Text_latin  ": "al-insana"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_latin  ": "ma"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "لَمۡ",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "not",
          "Text_latin  ": "lam"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "يَعۡلَمۡ",
          "Arti_kata_in": "dia ketahui",
          "Arti_kata_en": "he knew",
          "Text_latin  ": "ya'lam"
        }
      ]
    },
    {
      "Nomor_ayat": 6,
      "Ayat_arabic ": "كَلَّآ اِنَّ الْاِنْسَانَ لَيَطْغٰىٓ ۙ",
      "Ayat_latin": "kalla innal-insana layatga",
      "Terjemah_in": "Sekali-kali tidak! Sesungguhnya manusia itu benar-benar melampaui batas",
      "Terjemah_en": "In fact, man oversteps all bounds.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "كَلَّآ",
          "Arti_kata_in": "sekali-kali tidak",
          "Arti_kata_en": "Nay!",
          "Text_latin  ": "kalla"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_latin  ": "inna"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "man",
          "Text_latin  ": "al-insana"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "لَيَطۡغَىٰٓ",
          "Arti_kata_in": "benar-benar melampui batas",
          "Arti_kata_en": "surely transgresses",
          "Text_latin  ": "layatgha"
        }
      ]
    },
    {
      "Nomor_ayat": 7,
      "Ayat_arabic ": "اَنْ رَّاٰهُ اسْتَغْنٰىۗ",
      "Ayat_latin": "ar ra'ahustagna",
      "Terjemah_in": "ketika melihat dirinya serba berkecukupan.",
      "Terjemah_en": "When he considers himself exempt.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَن",
          "Arti_kata_in": "bahwa",
          "Arti_kata_en": "Because",
          "Text_latin  ": "an"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "رَّءَاهُ",
          "Arti_kata_in": "ia melihatnya",
          "Arti_kata_en": "he sees himself",
          "Text_latin  ": "raahu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱسۡتَغۡنَىٰٓ",
          "Arti_kata_in": "dia serba cukup",
          "Arti_kata_en": "self-sufficient",
          "Text_latin  ": "is'taghna"
        }
      ]
    },
    {
      "Nomor_ayat": 8,
      "Ayat_arabic ": "اِنَّ اِلٰى رَبِّكَ الرُّجْعٰىۗ",
      "Ayat_latin": "inna ila rabbikar-ruj'a",
      "Terjemah_in": "Sesungguhnya hanya kepada Tuhanmulah tempat kembali(-mu).",
      "Terjemah_en": "But to your Lord is the return.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_latin  ": "inna"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِلَىٰ",
          "Arti_kata_in": "kepada",
          "Arti_kata_en": "to",
          "Text_latin  ": "ila"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_latin  ": "rabbika"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلرُّجۡعَىٰٓ",
          "Arti_kata_in": "tempat kembali",
          "Arti_kata_en": "(is) the return",
          "Text_latin  ": "ar-ruj'a"
        }
      ]
    },
    {
      "Nomor_ayat": 9,
      "Ayat_arabic ": "اَرَاَيْتَ الَّذِيْ يَنْهٰىۙ",
      "Ayat_latin": "a ra'aitallazi yan-ha",
      "Terjemah_in": "Tahukah kamu tentang orang yang melarang",
      "Terjemah_en": "Have you seen him who prevents?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَرَءَيۡتَ",
          "Arti_kata_in": "apakah kamu lihat/pendapatmu",
          "Arti_kata_en": "Have you seen",
          "Text_latin  ": "ara-ayta"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang/orang-orang",
          "Arti_kata_en": "the one who",
          "Text_latin  ": "alladhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "يَنۡهَىٰ",
          "Arti_kata_in": "ia melarang",
          "Arti_kata_en": "forbids",
          "Text_latin  ": "yanha"
        }
      ]
    },
    {
      "Nomor_ayat": 10,
      "Ayat_arabic ": "عَبْدًا اِذَا صَلّٰىۗ",
      "Ayat_latin": "'abdan iza salla",
      "Terjemah_in": "seorang hamba ketika dia melaksanakan salat?",
      "Terjemah_en": "A servant when he prays?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "عَبۡدًا",
          "Arti_kata_in": "hamba",
          "Arti_kata_en": "A slave",
          "Text_latin  ": "abdan"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_latin  ": "idha"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "صَلَّىٰٓ",
          "Arti_kata_in": "sholat",
          "Arti_kata_en": "he prays",
          "Text_latin  ": "salla"
        }
      ]
    },
    {
      "Nomor_ayat": 11,
      "Ayat_arabic ": "اَرَاَيْتَ اِنْ كَانَ عَلَى الْهُدٰىٓۙ",
      "Ayat_latin": "a ra'aita ing kana 'alal-huda",
      "Terjemah_in": "Bagaimana pendapatmu kalau terbukti dia berada di dalam kebenaran",
      "Terjemah_en": "Do you think he is upon guidance?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَرَءَيۡتَ",
          "Arti_kata_in": "apakah kamu lihat/pendapatmu",
          "Arti_kata_en": "Have you seen",
          "Text_latin  ": "ara-ayta"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِن",
          "Arti_kata_in": "jika",
          "Arti_kata_en": "if",
          "Text_latin  ": "in"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "كَانَ",
          "Arti_kata_in": "adalah",
          "Arti_kata_en": "he is",
          "Text_latin  ": "kana"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "عَلَى",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "upon",
          "Text_latin  ": "ala"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "ٱلۡهُدَىٰٓ",
          "Arti_kata_in": "petunjuk",
          "Arti_kata_en": "[the] guidance",
          "Text_latin  ": "al-huda"
        }
      ]
    },
    {
      "Nomor_ayat": 12,
      "Ayat_arabic ": "اَوْ اَمَرَ بِالتَّقْوٰىۗ",
      "Ayat_latin": "au amara bit-taqwa",
      "Terjemah_in": "atau dia menyuruh bertakwa (kepada Allah)?",
      "Terjemah_en": "Or advocates righteousness?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَوۡ",
          "Arti_kata_in": "atau",
          "Arti_kata_en": "Or",
          "Text_latin  ": "aw"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "أَمَرَ",
          "Arti_kata_in": "dia menyuruh",
          "Arti_kata_en": "he enjoins",
          "Text_latin  ": "amara"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "بِٱلتَّقۡوَىٰٓ",
          "Arti_kata_in": "dengan taqwa",
          "Arti_kata_en": "[of the] righteousness",
          "Text_latin  ": "bil-taqwa"
        }
      ]
    },
    {
      "Nomor_ayat": 13,
      "Ayat_arabic ": "اَرَاَيْتَ اِنْ كَذَّبَ وَتَوَلّٰىۗ",
      "Ayat_latin": "a ra'aita ing kazzaba wa tawalla",
      "Terjemah_in": "Bagaimana pendapatmu kalau dia mendustakan (kebenaran) dan berpaling (dari keimanan)?",
      "Terjemah_en": "Do you see how he disbelieved and turned away?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَرَءَيۡتَ",
          "Arti_kata_in": "apakah kamu lihat/pendapatmu",
          "Arti_kata_en": "Have you seen",
          "Text_latin  ": "ara-ayta"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِن",
          "Arti_kata_in": "jika",
          "Arti_kata_en": "if",
          "Text_latin  ": "in"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "كَذَّبَ",
          "Arti_kata_in": "mendustakan",
          "Arti_kata_en": "he denies",
          "Text_latin  ": "kadhaba"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "وَتَوَلَّىٰٓ",
          "Arti_kata_in": "dan dia berpaling",
          "Arti_kata_en": "and turns away",
          "Text_latin  ": "watawalla"
        }
      ]
    },
    {
      "Nomor_ayat": 14,
      "Ayat_arabic ": "اَلَمْ يَعْلَمْ بِاَنَّ اللّٰهَ يَرٰىۗ",
      "Ayat_latin": "a lam ya'lam bi'annallaha yara",
      "Terjemah_in": "Tidakkah dia mengetahui bahwa sesungguhnya Allah melihat (segala perbuatannya)?",
      "Terjemah_en": "Does he not know that God sees?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَلَمۡ",
          "Arti_kata_in": "apakah tidak/tidaklah",
          "Arti_kata_en": "Does not",
          "Text_latin  ": "alam"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَعۡلَم",
          "Arti_kata_in": "dia mengetahui",
          "Arti_kata_en": "he know",
          "Text_latin  ": "ya'lam"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "بِأَنَّ",
          "Arti_kata_in": "bahwa sesungguhnya",
          "Arti_kata_en": "that",
          "Text_latin  ": "bi-anna"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱللَّهَ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "Allah",
          "Text_latin  ": "al-laha"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "يَرَىٰ",
          "Arti_kata_in": "Dia melihat",
          "Arti_kata_en": "sees",
          "Text_latin  ": "yara"
        }
      ]
    },
    {
      "Nomor_ayat": 15,
      "Ayat_arabic ": "كَلَّا لَىِٕنْ لَّمْ يَنْتَهِ ەۙ لَنَسْفَعًاۢ بِالنَّاصِيَةِۙ",
      "Ayat_latin": "kalla la'il lam yantahi lanasfa'am bin-nasiyah",
      "Terjemah_in": "Sekali-kali tidak! Sungguh, jika dia tidak berhenti (berbuat demikian), niscaya Kami tarik ubun-ubunnya (ke dalam neraka),",
      "Terjemah_en": "No. If he does not desist, We will drag him by the forelock.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "كَلَّا",
          "Arti_kata_in": "sekali-kali tidak",
          "Arti_kata_en": "Nay!",
          "Text_latin  ": "kalla"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "لَئِن",
          "Arti_kata_in": "sungguh jika",
          "Arti_kata_en": "If",
          "Text_latin  ": "la-in"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "لَّمۡ",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "not",
          "Text_latin  ": "lam"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "يَنتَهِ",
          "Arti_kata_in": "dia berhenti",
          "Arti_kata_en": "he desists",
          "Text_latin  ": "yantahi"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "لَنَسۡفَعَۢا",
          "Arti_kata_in": "niscaya kami pegang/tarik",
          "Arti_kata_en": "surely We will drag him",
          "Text_latin  ": "lanasfa'an"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "بِٱلنَّاصِيَةِ",
          "Arti_kata_in": "dengan umbun-umbun",
          "Arti_kata_en": "by the forelock",
          "Text_latin  ": "bil-nasiyati"
        }
      ]
    },
    {
      "Nomor_ayat": 16,
      "Ayat_arabic ": "نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍۚ",
      "Ayat_latin": "nasiyating kazibatin khati'ah",
      "Terjemah_in": "(yaitu) ubun-ubun orang yang mendustakan (kebenaran) dan durhaka.",
      "Terjemah_en": "A deceitful, sinful forelock.",
      "Kata": [
        {
          "Nomor_kata": 1,
