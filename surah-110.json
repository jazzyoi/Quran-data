{
  "Nomor_surat": 110,
  "Nama_surat": "An-Nashr",
  "surat_arabic": "النصر",
  "Arti_surat_in": "Pertolongan",
  "Arti_surat_en": "The Divine Support",
  "Ayat": [
    {
      "Nomor_ayat": 6214,
      "Ayat_Arabic": "اِذَا جَاۤءَ نَصْرُ اللّٰهِ وَالْفَتْحُۙ",
      "Text_Latin": "iza ja'a nasrullahi wal-fat-h",
      "Terjemah_in": "Apabila telah datang pertolongan Allah dan kemenangan",
      "Terjemahan_En": "When there comes God’s victory, and conquest.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "When",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "جَآءَ",
          "Arti_kata_in": "datang",
          "Arti_kata_en": "comes",
          "Text_Latin": "jaa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نَصۡرُ",
          "Arti_kata_in": "pertolongan",
          "Arti_kata_en": "(the) Help",
          "Text_Latin": "nasru",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱللَّهِ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "(of) Allah",
          "Text_Latin": "al-lahi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَٱلۡفَتۡحُ",
          "Arti_kata_in": "dan kemenangan",
          "Arti_kata_en": "and the Victory",
          "Text_Latin": "wal-fathu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6215,
      "Ayat_Arabic": "وَرَاَيْتَ النَّاسَ يَدْخُلُوْنَ فِيْ دِيْنِ اللّٰهِ اَفْوَاجًاۙ",
      "Text_Latin": "wa ra'aitan-nasa yadkhuluna fi dinillahi afwaja",
      "Terjemah_in": "dan engkau melihat manusia berbondong-bondong masuk agama Allah,",
      "Terjemahan_En": "And you see the people entering God’s religion in multitudes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَرَأَيۡتَ",
          "Arti_kata_in": "dan kamu lihat",
          "Arti_kata_en": "And you see",
          "Text_Latin": "wara-ayta",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلنَّاسَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "the people",
          "Text_Latin": "an-nasa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَدۡخُلُونَ",
          "Arti_kata_in": "masuk",
          "Arti_kata_en": "entering",
          "Text_Latin": "yadkhuluna",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "kedalam",
          "Arti_kata_en": "into",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "دِينِ",
          "Arti_kata_in": "agama",
          "Arti_kata_en": "(the) religion",
          "Text_Latin": "dini",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "ٱللَّهِ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "(of) Allah",
          "Text_Latin": "al-lahi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "أَفۡوَاجٗا",
          "Arti_kata_in": "berbondong-bondong",
          "Arti_kata_en": "(in) multitudes",
          "Text_Latin": "afwajan",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6216,
      "Ayat_Arabic": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُۗ اِنَّهٗ كَانَ تَوَّابًا ࣖ",
      "Text_Latin": "fa sabbih bihamdi rabbika wastagfir-h, innahu kana tawwaba",
      "Terjemah_in": "bertasbihlah dengan memuji Tuhanmu dan mohonlah ampun kepada-Nya. Sesungguhnya Dia Maha Penerima tobat.",
      "Terjemahan_En": "Then celebrate the praise of your Lord, and seek His forgiveness. He is the Accepter of Repentance.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَسَبِّحۡ",
          "Arti_kata_in": "maka bertasbihlah",
          "Arti_kata_en": "Then glorify",
          "Text_Latin": "fasabbih",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بِحَمۡدِ",
          "Arti_kata_in": "dengan memuji",
          "Arti_kata_en": "(the) praises",
          "Text_Latin": "bihamdi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "(of) your Lord",
          "Text_Latin": "rabbika",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَٱسۡتَغۡفِرۡهُۚ",
          "Arti_kata_in": "dan mohonlah ampun",
          "Arti_kata_en": "and ask His forgiveness",
          "Text_Latin": "wa-is'taghfir'hu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "إِنَّهُۥ",
          "Arti_kata_in": "sesungguhnya Dia",
          "Arti_kata_en": "Indeed He",
          "Text_Latin": "innahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "كَانَ",
          "Arti_kata_in": "adalah Dia",
          "Arti_kata_en": "is",
          "Text_Latin": "kana",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "تَوَّابَۢا",
          "Arti_kata_in": "Maha Penerima Taubat",
          "Arti_kata_en": "Oft-Returning",
          "Text_Latin": "tawwaban",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    }
  ]
}