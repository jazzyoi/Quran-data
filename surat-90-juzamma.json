    },
    {
      "Nomor_ayat": 19,
      "Ayat_arabic ": "وَالَّذِيْنَ كَفَرُوْا بِاٰيٰتِنَا هُمْ اَصْحٰبُ الْمَشْـَٔمَةِۗ",
