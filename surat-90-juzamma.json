          "Kata_arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "those who",
          "Text_latin  ": "alladhina"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "ءَامَنُواْ",
          "Arti_kata_in": "beriman",
          "Arti_kata_en": "believe",
          "Text_latin  ": "amanu"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "وَتَوَاصَوۡاْ",
          "Arti_kata_in": "dan mereka saling berwasiat/berpesan",
          "Arti_kata_en": "and enjoin each other",
          "Text_latin  ": "watawasaw"
        },
        {
          "Nomor_kata": 7,
          "Kata_arabic": "بِٱلصَّبۡرِ",
          "Arti_kata_in": "dengan kesabaran",
