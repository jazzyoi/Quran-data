    },
    {
      "Nomor_ayat": 18,
      "Ayat_arabic ": "اُولٰۤىِٕكَ اَصْحٰبُ الْمَيْمَنَةِۗ",
      "Ayat_latin": "ula'ika as-habul-maimanah",
      "Terjemah_in": "Mereka itulah golongan kanan.",
      "Terjemah_en": "These are the people of happiness.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أُوْلَٰٓئِكَ",
