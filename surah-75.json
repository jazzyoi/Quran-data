        }
      ]
    },
    {
      "Nomor_ayat": 5576,
      "Ayat_Arabic": "تَظُنُّ اَنْ يُّفْعَلَ بِهَا فَاقِرَةٌ ۗ",
      "Text_Latin": "tazunnu ay yuf'ala biha faqirah",
      "Terjemah_in": "(karena) mereka yakin akan ditimpakan kepadanya malapetaka yang sangat dahsyat.",
      "Terjemahan_En": "Realizing that a back-breaker has befallen them.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "تَظُنُّ",
          "Arti_kata": "ia mengira",
          "Jenis_kata": null
