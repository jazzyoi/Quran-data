    },
    {
      "Nomor_ayat": 5587,
      "Ayat_Arabic": "اَيَحْسَبُ الْاِنْسَانُ اَنْ يُّتْرَكَ سُدًىۗ",
      "Text_Latin": "a yahsabul-insanu ay yutraka suda",
