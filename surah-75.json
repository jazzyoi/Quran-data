      "Terjemahan_En": "Does man think that he will be left without purpose?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَيَحۡسَبُ",
          "Arti_kata": "apakah mengira",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
