    },
    {
      "Nomor_ayat": 5577,
      "Ayat_Arabic": "كَلَّآ اِذَا بَلَغَتِ التَّرَاقِيَۙ",
      "Text_Latin": "kalla iza balagatit-taraqi",
      "Terjemah_in": "Sekali-kali tidak! Apabila (nyawa) telah sampai di kerongkongan,",
      "Terjemahan_En": "Indeed, when it has reached the breast-bones.",
      "Kata": [
