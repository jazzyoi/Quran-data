      "Terjemah_in": "Bukankah dia dahulu setetes mani yang ditumpahkan (ke dalam rahim)?",
      "Terjemahan_En": "Was he not a drop of ejaculated semen?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَلَمۡ",
          "Arti_kata": "bukankah",
          "Jenis_kata": null
