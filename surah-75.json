          "Kata_Arabic": "وَتَوَلَّىٰ",
          "Arti_kata": "dan dia berpaling",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5584,
      "Ayat_Arabic": "ثُمَّ ذَهَبَ اِلٰٓى اَهْلِهٖ يَتَمَطّٰىۗ",
      "Text_Latin": "summa zahaba ila ahlihi yatamatta",
      "Terjemah_in": "Kemudian, dia pergi kepada keluarganya dengan menyombongkan diri.",
      "Terjemahan_En": "Then he went to his family, full of pride.",
