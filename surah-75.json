{
  "Nomor_surat": 75,
  "Nama_surat": "Al-Qiyamah",
  "surat_arabic": "القيامة",
  "Arti_surat_in": "Kiamat",
  "Arti_surat_en": "The Resurrection",
  "Ayat": [
    {
      "Nomor_ayat": 5552,
      "Ayat_Arabic": "لَآ اُقْسِمُ بِيَوْمِ الْقِيٰمَةِۙ",
      "Text_Latin": "la uqsimu biyaumil-qiyamah",
      "Terjemah_in": "Aku bersumpah demi hari Kiamat.",
      "Terjemahan_En": "I swear by the Day of Resurrection.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَآ",
          "Arti_kata": "benar-benar",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أُقۡسِمُ",
          "Arti_kata": "aku bersumpah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِيَوۡمِ",
          "Arti_kata": "dengan hari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡقِيَٰمَةِ",
          "Arti_kata": "kiamat",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5553,
      "Ayat_Arabic": "وَلَآ اُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ",
      "Text_Latin": "wa la uqsimu bin-nafsil-lawwamah",
      "Terjemah_in": "Aku bersumpah demi jiwa yang sangat menyesali (dirinya sendiri).",
      "Terjemahan_En": "And I swear by the blaming soul.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَآ",
          "Arti_kata": "dan benar-benar",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أُقۡسِمُ",
          "Arti_kata": "aku bersumpah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلنَّفۡسِ",
          "Arti_kata": "dengan jiwa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱللَّوَّامَةِ",
          "Arti_kata": "mencela/menyesali",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5554,
      "Ayat_Arabic": "اَيَحْسَبُ الْاِنْسَانُ اَلَّنْ نَّجْمَعَ عِظَامَهٗ ۗ",
      "Text_Latin": "a yahsabul-insanu allan najma'a 'izamah",
      "Terjemah_in": "Apakah manusia mengira bahwa Kami tidak akan mengumpulkan (kembali) tulang-belulangnya?",
      "Terjemahan_En": "Does man think that We will not reassemble his bones?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَيَحۡسَبُ",
          "Arti_kata": "apakah mengira",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَلَّن",
          "Arti_kata": "bahwa tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "نَّجۡمَعَ",
          "Arti_kata": "Kami mengumpulkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "عِظَامَهُۥ",
          "Arti_kata": "tulang-belulangnya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5555,
      "Ayat_Arabic": "بَلٰى قٰدِرِيْنَ عَلٰٓى اَنْ نُّسَوِّيَ بَنَانَهٗ",
      "Text_Latin": "bala qadirina 'ala an nusawwiya bananah",
      "Terjemah_in": "Tentu, (bahkan) Kami mampu menyusun (kembali) jari-jemarinya dengan sempurna.",
      "Terjemahan_En": "Yes indeed; We are Able to reconstruct his fingertips.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "بَلَىٰ",
          "Arti_kata": "yang benar/bahkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "قَٰدِرِينَ",
          "Arti_kata": "berkuasa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَىٰٓ",
          "Arti_kata": "atas",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَن",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "نُّسَوِّيَ",
          "Arti_kata": "Kami menyempurnakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "بَنَانَهُۥ",
          "Arti_kata": "jari-jemarinya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5556,
      "Ayat_Arabic": "بَلْ يُرِيْدُ الْاِنْسَانُ لِيَفْجُرَ اَمَامَهٗۚ",
      "Text_Latin": "bal yuridul-insanu liyafjura amamah",
      "Terjemah_in": "Akan tetapi, manusia hendak berbuat maksiat terus-menerus.",
      "Terjemahan_En": "But man wants to deny what is ahead of him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "بَلۡ",
          "Arti_kata": "bahkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يُرِيدُ",
          "Arti_kata": "menghendaki",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لِيَفۡجُرَ",
          "Arti_kata": "untuk membuat durhaka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَمَامَهُۥ",
          "Arti_kata": "di hadapannya/di masa depan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5557,
      "Ayat_Arabic": "يَسْـَٔلُ اَيَّانَ يَوْمُ الْقِيٰمَةِۗ",
      "Text_Latin": "yas'alu ayyana yaumul-qiyamah",
      "Terjemah_in": "Dia bertanya, “Kapankah hari Kiamat itu?”",
      "Terjemahan_En": "He asks, “When is the Day of Resurrection?”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَسَۡٔلُ",
          "Arti_kata": "ia bertanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَيَّانَ",
          "Arti_kata": "bilakah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَوۡمُ",
          "Arti_kata": "hari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡقِيَٰمَةِ",
          "Arti_kata": "kiamat",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5558,
      "Ayat_Arabic": "فَاِذَا بَرِقَ الْبَصَرُۙ",
      "Text_Latin": "fa iza bariqal-basar",
      "Terjemah_in": "Apabila mata terbelalak (ketakutan),",
      "Terjemahan_En": "When vision is dazzled.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِذَا",
          "Arti_kata": "maka tatkala",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بَرِقَ",
          "Arti_kata": "bingung/takut",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡبَصَرُ",
          "Arti_kata": "pandangan/mata",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5559,
      "Ayat_Arabic": "وَخَسَفَ الْقَمَرُۙ",
      "Text_Latin": "wa khasafal-qamar",
      "Terjemah_in": "bulan pun telah hilang cahayanya,",
      "Terjemahan_En": "And the moon is eclipsed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَخَسَفَ",
          "Arti_kata": "dan gelap/hilang cahaya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡقَمَرُ",
          "Arti_kata": "bulan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5560,
      "Ayat_Arabic": "وَجُمِعَ الشَّمْسُ وَالْقَمَرُۙ",
      "Text_Latin": "wa jumi'asy-syamsu wal-qamar",
      "Terjemah_in": "serta matahari dan bulan dikumpulkan,",
      "Terjemahan_En": "And the sun and the moon are joined together.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَجُمِعَ",
          "Arti_kata": "dan dikumpulkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلشَّمۡسُ",
          "Arti_kata": "matahari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَٱلۡقَمَرُ",
          "Arti_kata": "dan bulan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5561,
      "Ayat_Arabic": "يَقُوْلُ الْاِنْسَانُ يَوْمَىِٕذٍ اَيْنَ الْمَفَرُّۚ",
      "Text_Latin": "yaqulul-insanu yauma'izin ainal-mafarr",
      "Terjemah_in": "pada hari itu manusia berkata, “Ke mana tempat lari?”",
      "Terjemahan_En": "On that Day, man will say, “Where is the escape?”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَقُولُ",
          "Arti_kata": "berkata",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَوۡمَئِذٍ",
          "Arti_kata": "pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَيۡنَ",
          "Arti_kata": "dimana/kemana",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡمَفَرُّ",
          "Arti_kata": "tempat lari",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5562,
      "Ayat_Arabic": "كَلَّا لَا وَزَرَۗ",
      "Text_Latin": "kalla la wazar",
      "Terjemah_in": "Sekali-kali tidak! Tidak ada tempat berlindung.",
      "Terjemahan_En": "No indeed! There is no refuge.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّا",
          "Arti_kata": "sekali-kali tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَا",
          "Arti_kata": "tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَزَرَ",
          "Arti_kata": "tempat lari/berlindung",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5563,
      "Ayat_Arabic": "اِلٰى رَبِّكَ يَوْمَىِٕذِ ِۨالْمُسْتَقَرُّۗ",
      "Text_Latin": "ila rabbika yauma'izinil-mustaqarr",
      "Terjemah_in": "(Hanya) kepada Tuhanmu tempat kembali pada hari itu.",
      "Terjemahan_En": "To your Lord on that Day is the settlement.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِلَىٰ",
          "Arti_kata": "kepada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata": "Tuhanmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَوۡمَئِذٍ",
          "Arti_kata": "pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡمُسۡتَقَرُّ",
          "Arti_kata": "tempat menetap/kembali",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5564,
      "Ayat_Arabic": "يُنَبَّؤُا الْاِنْسَانُ يَوْمَىِٕذٍۢ بِمَا قَدَّمَ وَاَخَّرَۗ",
      "Text_Latin": "yunabba'ul-insanu yauma'izim bima qaddama wa akhkhar",
      "Terjemah_in": "Pada hari itu diberitakan kepada manusia apa yang telah dia kerjakan dan apa yang telah dia lalaikan.",
      "Terjemahan_En": "On that Day man will be informed of everything he put forward, and everything he left behind.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يُنَبَّؤُاْ",
          "Arti_kata": "diberitahukan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَوۡمَئِذِۭ",
          "Arti_kata": "pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "بِمَا",
          "Arti_kata": "tentang apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "قَدَّمَ",
          "Arti_kata": "dia kerjakan/dahulukan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "وَأَخَّرَ",
          "Arti_kata": "dia akhirkan/lalaikan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5565,
      "Ayat_Arabic": "بَلِ الْاِنْسَانُ عَلٰى نَفْسِهٖ بَصِيْرَةٌۙ",
      "Text_Latin": "balil-insanu 'ala nafsihi basirah",
      "Terjemah_in": "Bahkan, manusia menjadi saksi atas dirinya sendiri735)",
      "Terjemahan_En": "And man will be evidence against himself.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "بَلِ",
          "Arti_kata": "bahkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَىٰ",
          "Arti_kata": "atas",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "نَفۡسِهِۦ",
          "Arti_kata": "dirinya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "بَصِيرَةٞ",
          "Arti_kata": "melihat terang (menjadi saksi)",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5566,
      "Ayat_Arabic": "وَّلَوْ اَلْقٰى مَعَاذِيْرَهٗۗ",
      "Text_Latin": "walau alqa ma'azirah",
      "Terjemah_in": "walaupun dia mengemukakan alasan-alasan(-nya).",
      "Terjemahan_En": "Even as he presents his excuses.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَوۡ",
          "Arti_kata": "walaupun/meskipun",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَلۡقَىٰ",
          "Arti_kata": "dia lemparkan/kemukakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَعَاذِيرَهُۥ",
          "Arti_kata": "uzurnya/alasan-alasannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5567,
      "Ayat_Arabic": "لَا تُحَرِّكْ بِهٖ لِسَانَكَ لِتَعْجَلَ بِهٖۗ",
      "Text_Latin": "la tuharrik bihi lisanaka lita'jala bih",
      "Terjemah_in": "Jangan engkau (Nabi Muhammad) gerakkan lidahmu (untuk membaca Al-Qur’an) karena hendak tergesa-gesa (menguasai)-nya.",
      "Terjemahan_En": "Do not wag your tongue with it, to hurry on with it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَا",
          "Arti_kata": "jangan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تُحَرِّكۡ",
          "Arti_kata": "kamu gerakkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِهِۦ",
          "Arti_kata": "dengannya/padanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لِسَانَكَ",
          "Arti_kata": "lisanmu/lidahmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "لِتَعۡجَلَ",
          "Arti_kata": "karena kamu hendak bersegera",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "بِهِۦٓ",
          "Arti_kata": "dengannya/padanya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5568,
      "Ayat_Arabic": "اِنَّ عَلَيْنَا جَمْعَهٗ وَقُرْاٰنَهٗ ۚ",
      "Text_Latin": "inna 'alaina jam'ahu wa qur'anah",
      "Terjemah_in": "Sesungguhnya tugas Kamilah untuk mengumpulkan (dalam hatimu) dan membacakannya.",
      "Terjemahan_En": "Upon Us is its collection and its recitation.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata": "sesungguhnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَلَيۡنَا",
          "Arti_kata": "atas Kami",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "جَمۡعَهُۥ",
          "Arti_kata": "mengumpulkannya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَقُرۡءَانَهُۥ",
          "Arti_kata": "dan membacakannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5569,
      "Ayat_Arabic": "فَاِذَا قَرَأْنٰهُ فَاتَّبِعْ قُرْاٰنَهٗ ۚ",
      "Text_Latin": "fa iza qara'nahu fattabi' qur'anah",
      "Terjemah_in": "Maka, apabila Kami telah selesai membacakannya, ikutilah bacaannya itu.",
      "Terjemahan_En": "Then, when We have recited it, follow its recitation.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِذَا",
          "Arti_kata": "maka apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "قَرَأۡنَٰهُ",
          "Arti_kata": "Kami telah membacakannya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَٱتَّبِعۡ",
          "Arti_kata": "maka ikutilah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "قُرۡءَانَهُۥ",
          "Arti_kata": "bacaannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5570,
      "Ayat_Arabic": "ثُمَّ اِنَّ عَلَيْنَا بَيَانَهٗ ۗ",
      "Text_Latin": "summa inna 'alaina bayanah",
      "Terjemah_in": "Kemudian, sesungguhnya tugas Kami (pula)-lah (untuk) menjelaskannya.",
      "Terjemahan_En": "Then upon Us is its explanation.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ثُمَّ",
          "Arti_kata": "kemudian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata": "sesungguhnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَيۡنَا",
          "Arti_kata": "atas Kami",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "بَيَانَهُۥ",
          "Arti_kata": "penjelasannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5571,
      "Ayat_Arabic": "كَلَّا بَلْ تُحِبُّوْنَ الْعَاجِلَةَۙ",
      "Text_Latin": "kalla bal tuhibbunal-'ajilah",
      "Terjemah_in": "Sekali-kali tidak! Bahkan, kamu mencintai kehidupan dunia,",
      "Terjemahan_En": "Alas, you love the fleeting life.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّا",
          "Arti_kata": "tidak sekali-kali",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بَلۡ",
          "Arti_kata": "bahkan/tetapi",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "تُحِبُّونَ",
          "Arti_kata": "kamu mencintai",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡعَاجِلَةَ",
          "Arti_kata": "yang cepat",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5572,
      "Ayat_Arabic": "وَتَذَرُوْنَ الْاٰخِرَةَۗ",
      "Text_Latin": "wa tazarunal-akhirah",
      "Terjemah_in": "dan mengabaikan (kehidupan) akhirat.",
      "Terjemahan_En": "And you disregard the Hereafter.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَتَذَرُونَ",
          "Arti_kata": "dan kamu meninggalkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡأٓخِرَةَ",
          "Arti_kata": "akhirat",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5573,
      "Ayat_Arabic": "وُجُوْهٌ يَّوْمَىِٕذٍ نَّاضِرَةٌۙ",
      "Text_Latin": "wujuhuy yauma'izin nadirah",
      "Terjemah_in": "Wajah-wajah (orang mukmin) pada hari itu berseri-seri",
      "Terjemahan_En": "Faces on that Day will be radiant.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وُجُوهٞ",
          "Arti_kata": "wajah-wajah",
