    {
      "Nomor_ayat": 5905,
      "Ayat_Arabic": "وَاِذَا قُرِئَ عَلَيْهِمُ الْقُرْاٰنُ لَا يَسْجُدُوْنَ ۗ ۩",
      "Text_Latin": "wa iza quri'a 'alaihimul-qur'anu la yasjudun",
