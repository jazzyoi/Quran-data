{
  "Nomor_surat": 94,
  "Nama_surat": "Al-Insyirah",
  "surat_arabic": "الشرح",
  "Arti_surat_in": "Melapangkan",
  "Arti_surat_en": "The Expansion",
  "Ayat": [
    {
      "Nomor_ayat": 6091,
      "Ayat_Arabic": "اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ",
      "Text_Latin": "a lam nasyrah laka sadrak",
      "Terjemah_in": "Bukankah Kami telah melapangkan dadamu (Nabi Muhammad),",
      "Terjemahan_En": "Did We not soothe your heart?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَلَمۡ",
          "Arti_kata_in": "apakah tidak/bukankah",
          "Arti_kata_en": "Have not",
          "Text_Latin": "alam",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَشۡرَحۡ",
          "Arti_kata_in": "Kami melapangkan",
          "Arti_kata_en": "We expanded",
          "Text_Latin": "nashrah",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَكَ",
          "Arti_kata_in": "bagimu",
          "Arti_kata_en": "for you",
          "Text_Latin": "laka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "صَدۡرَكَ",
          "Arti_kata_in": "dadamu",
          "Arti_kata_en": "your breast",
          "Text_Latin": "sadraka",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6092,
      "Ayat_Arabic": "وَوَضَعْنَا عَنْكَ وِزْرَكَۙ",
      "Text_Latin": "wa wada'na 'angka wizrak",
      "Terjemah_in": "meringankan beban (tugas-tugas kenabian) darimu",
      "Terjemahan_En": "And lift from you your burden.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَوَضَعۡنَا",
          "Arti_kata_in": "dan Kami letakkan/turunkan",
          "Arti_kata_en": "And We removed",
          "Text_Latin": "wawada'na",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَنكَ",
          "Arti_kata_in": "dari kamu",
          "Arti_kata_en": "from you",
          "Text_Latin": "anka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وِزۡرَكَ",
          "Arti_kata_in": "bebanmu",
          "Arti_kata_en": "your burden",
          "Text_Latin": "wiz'raka",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6093,
      "Ayat_Arabic": "الَّذِيْٓ اَنْقَضَ ظَهْرَكَۙ",
      "Text_Latin": "allazi angqada zahrak",
      "Terjemah_in": "yang memberatkan punggungmu,",
      "Terjemahan_En": "Which weighed down your back?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِيٓ",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "Which",
          "Text_Latin": "alladhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَنقَضَ",
          "Arti_kata_in": "memberatkan",
          "Arti_kata_en": "weighed upon",
          "Text_Latin": "anqada",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ظَهۡرَكَ",
          "Arti_kata_in": "punggungmu",
          "Arti_kata_en": "your back",
          "Text_Latin": "zahraka",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6094,
      "Ayat_Arabic": "وَرَفَعْنَا لَكَ ذِكْرَكَۗ",
      "Text_Latin": "wa rafa'na laka zikrak",
      "Terjemah_in": "dan meninggikan (derajat)-mu (dengan selalu) menyebut-nyebut (nama)-mu?",
      "Terjemahan_En": "And raised for you your reputation?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَرَفَعۡنَا",
          "Arti_kata_in": "dan Kami tinggikan",
          "Arti_kata_en": "And We raised high",
          "Text_Latin": "warafa'na",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَكَ",
          "Arti_kata_in": "bagimu",
          "Arti_kata_en": "for you",
          "Text_Latin": "laka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ذِكۡرَكَ",
          "Arti_kata_in": "sebutanmu",
          "Arti_kata_en": "your esteem",
          "Text_Latin": "dhik'raka",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6095,
      "Ayat_Arabic": "فَاِنَّ مَعَ الْعُسْرِ يُسْرًاۙ",
      "Text_Latin": "fa inna ma'al-'usri yusra",
      "Terjemah_in": "Maka, sesungguhnya beserta kesulitan ada kemudahan.",
      "Terjemahan_En": "With hardship comes ease.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِنَّ",
          "Arti_kata_in": "maka sesungguhnya",
          "Arti_kata_en": "So indeed",
          "Text_Latin": "fa-inna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَعَ",
          "Arti_kata_in": "beserta",
          "Arti_kata_en": "with",
          "Text_Latin": "ma'a",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡعُسۡرِ",
          "Arti_kata_in": "kesulitan",
          "Arti_kata_en": "the hardship",
          "Text_Latin": "al-'us'ri",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يُسۡرًا",
          "Arti_kata_in": "kemudahan",
          "Arti_kata_en": "(is) ease",
          "Text_Latin": "yus'ran",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6096,
      "Ayat_Arabic": "اِنَّ مَعَ الْعُسْرِ يُسْرًاۗ",
      "Text_Latin": "inna ma'al-'usri yusra",
      "Terjemah_in": "Sesungguhnya beserta kesulitan ada kemudahan.",
      "Terjemahan_En": "With hardship comes ease.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_Latin": "inna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَعَ",
          "Arti_kata_in": "beserta",
          "Arti_kata_en": "with",
          "Text_Latin": "ma'a",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡعُسۡرِ",
          "Arti_kata_in": "kesulitan",
          "Arti_kata_en": "the hardship",
          "Text_Latin": "al-'us'ri",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يُسۡرٗا",
          "Arti_kata_in": "kemudahan",
          "Arti_kata_en": "(is) ease",
          "Text_Latin": "yus'ran",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6097,
      "Ayat_Arabic": "فَاِذَا فَرَغْتَ فَانْصَبْۙ",
      "Text_Latin": "fa iza faragta fansab",
      "Terjemah_in": "Apabila engkau telah selesai (dengan suatu kebajikan), teruslah bekerja keras (untuk kebajikan yang lain)",
      "Terjemahan_En": "When your work is done, turn to devotion.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِذَا",
          "Arti_kata_in": "maka apabila",
          "Arti_kata_en": "So when",
          "Text_Latin": "fa-idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فَرَغۡتَ",
          "Arti_kata_in": "kamu telah selesai",
          "Arti_kata_en": "you are free",
          "Text_Latin": "faraghta",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَٱنصَبۡ",
          "Arti_kata_in": "maka kerja keraslah kamu",
          "Arti_kata_en": "then stand up",
          "Text_Latin": "fa-insab",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6098,
      "Ayat_Arabic": "وَاِلٰى رَبِّكَ فَارْغَبْ ࣖ",
      "Text_Latin": "wa ila rabbika fargab",
      "Terjemah_in": "dan hanya kepada Tuhanmu berharaplah!",
      "Terjemahan_En": "And to your Lord turn for everything.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِلَىٰ",
          "Arti_kata_in": "dan hanya",
          "Arti_kata_en": "And to",
          "Text_Latin": "wa-ila",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_Latin": "rabbika",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَٱرۡغَب",
          "Arti_kata_in": "maka kamu berharap",
          "Arti_kata_en": "turn your attention",
          "Text_Latin": "fa-ir'ghab",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
}