{
  "Nomor_surat": 87,
  "Nama_surat": "Al-A’laa",
  "surat_arabic": "الأعلى",
  "Arti_surat_in": "Yang Paling Tinggi",
  "Arti_surat_en": "The Most High",
  "Ayat": [
    {
      "Nomor_ayat": 5949,
      "Ayat_Arabic": "سَبِّحِ اسْمَ رَبِّكَ الْاَعْلَىۙ",
      "Text_Latin": "sabbihisma rabbikal-a'la",
      "Terjemah_in": "Sucikanlah nama Tuhanmu Yang Maha Tinggi,",
      "Terjemahan_En": "Praise the Name of your Lord, the Most High.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "سَبِّحِ",
          "Arti_kata_in": "sucikanlah",
          "Arti_kata_en": "Glorify",
          "Text_Latin": "sabbihi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱسۡمَ",
          "Arti_kata_in": "nama",
          "Arti_kata_en": "(the) name",
          "Text_Latin": "is'ma",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "(of) your Lord",
          "Text_Latin": "rabbika",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡأَعۡلَى",
          "Arti_kata_in": "Maha Tinggi",
          "Arti_kata_en": "the Most High",
          "Text_Latin": "al-a'la",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5950,
      "Ayat_Arabic": "الَّذِيْ خَلَقَ فَسَوّٰىۖ",
      "Text_Latin": "allazi khalaqa fa sawwa",
      "Terjemah_in": "yang menciptakan, lalu menyempurnakan (ciptaan-Nya),",
      "Terjemahan_En": "He who creates and regulates.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "The One Who",
          "Text_Latin": "alladhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "خَلَقَ",
          "Arti_kata_in": "Dia menciptakan",
          "Arti_kata_en": "created",
          "Text_Latin": "khalaqa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَسَوَّىٰ",
          "Arti_kata_in": "lalu Dia menyempurnakan",
          "Arti_kata_en": "then proportioned",
          "Text_Latin": "fasawwa",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5951,
      "Ayat_Arabic": "وَالَّذِيْ قَدَّرَ فَهَدٰىۖ",
      "Text_Latin": "wallazi qaddara fa hada",
      "Terjemah_in": "yang menentukan kadar (masing-masing) dan memberi petunjuk,",
      "Terjemahan_En": "He who measures and guides.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلَّذِي",
          "Arti_kata_in": "dan yang",
          "Arti_kata_en": "And the One Who",
          "Text_Latin": "wa-alladhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "قَدَّرَ",
          "Arti_kata_in": "Dia menentukan",
          "Arti_kata_en": "measured",
          "Text_Latin": "qaddara",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَهَدَىٰ",
          "Arti_kata_in": "lalu Dia memberi petunjuk",
          "Arti_kata_en": "then guided",
          "Text_Latin": "fahada",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5952,
      "Ayat_Arabic": "وَالَّذِيْٓ اَخْرَجَ الْمَرْعٰىۖ",
      "Text_Latin": "wallazi akhrajal-mar'a",
      "Terjemah_in": "dan yang menumbuhkan (rerumputan) padang gembala,",
      "Terjemahan_En": "He who produces the pasture.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلَّذِيٓ",
          "Arti_kata_in": "dan yang",
          "Arti_kata_en": "And the One Who",
          "Text_Latin": "wa-alladhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَخۡرَجَ",
          "Arti_kata_in": "Dia keluarkan",
          "Arti_kata_en": "brings forth",
          "Text_Latin": "akhraja",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡمَرۡعَىٰ",
          "Arti_kata_in": "rumput-rumputan",
          "Arti_kata_en": "the pasture",
          "Text_Latin": "al-mar'a",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5953,
      "Ayat_Arabic": "فَجَعَلَهٗ غُثَاۤءً اَحْوٰىۖ",
      "Text_Latin": "fa ja'alahu gusa'an ahwa",
      "Terjemah_in": "lalu menjadikannya kering kehitam-hitaman.",
      "Terjemahan_En": "And then turns it into light debris.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَجَعَلَهُۥ",
          "Arti_kata_in": "lalu Dia jadikannya",
          "Arti_kata_en": "And then made it",
          "Text_Latin": "faja'alahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "غُثَآءً",
          "Arti_kata_in": "kering",
          "Arti_kata_en": "stubble",
          "Text_Latin": "ghuthaan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَحۡوَىٰ",
          "Arti_kata_in": "kehitam-hitaman",
          "Arti_kata_en": "dark",
          "Text_Latin": "ahwa",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5954,
      "Ayat_Arabic": "سَنُقْرِئُكَ فَلَا تَنْسٰىٓ  ۖ",
      "Text_Latin": "sanuqri'uka fa la tansa",
      "Terjemah_in": "Kami akan membacakan (Al-Qur’an) kepadamu (Nabi Muhammad) sehingga engkau tidak akan lupa,",
      "Terjemahan_En": "We will make you read, so do not forget.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "سَنُقۡرِئُكَ",
          "Arti_kata_in": "Kami bacakan kepadamu",
          "Arti_kata_en": "We will make you recite",
          "Text_Latin": "sanuq'ri-uka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فَلَا",
          "Arti_kata_in": "maka tidak",
          "Arti_kata_en": "so not",
          "Text_Latin": "fala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "تَنسَىٰٓ",
          "Arti_kata_in": "kamu lupa",
          "Arti_kata_en": "you will forget",
          "Text_Latin": "tansa",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5955,
      "Ayat_Arabic": "اِلَّا مَا شَاۤءَ اللّٰهُ ۗاِنَّهٗ يَعْلَمُ الْجَهْرَ وَمَا يَخْفٰىۗ",
      "Text_Latin": "illa ma sya'allah, innahu ya'lamul-jahra wa ma yakhfa",
      "Terjemah_in": "kecuali jika Allah menghendaki. Sesungguhnya Dia mengetahui yang terang dan yang tersembunyi.",
      "Terjemahan_En": "Except what God wills. He knows what is declared, and what is hidden.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِلَّا",
          "Arti_kata_in": "kecuali",
          "Arti_kata_en": "Except",
          "Text_Latin": "illa",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "شَآءَ",
          "Arti_kata_in": "dikehendaki",
          "Arti_kata_en": "wills",
          "Text_Latin": "shaa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱللَّهُۚ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "Allah",
          "Text_Latin": "al-lahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "إِنَّهُۥ",
          "Arti_kata_in": "sesungguhnya Dia",
          "Arti_kata_en": "Indeed, He",
          "Text_Latin": "innahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "يَعۡلَمُ",
          "Arti_kata_in": "mengetahui",
          "Arti_kata_en": "knows",
          "Text_Latin": "ya'lamu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "ٱلۡجَهۡرَ",
          "Arti_kata_in": "terang",
          "Arti_kata_en": "the manifest",
          "Text_Latin": "al-jahra",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "وَمَا",
          "Arti_kata_in": "dan apa",
          "Arti_kata_en": "and what",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "يَخۡفَىٰ",
          "Arti_kata_in": "tersembunyi",
          "Arti_kata_en": "is hidden",
          "Text_Latin": "yakhfa",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5956,
      "Ayat_Arabic": "وَنُيَسِّرُكَ لِلْيُسْرٰىۖ",
      "Text_Latin": "wa nuyassiruka lil-yusra",
      "Terjemah_in": "Kami akan melapangkan bagimu jalan kemudahan (dalam segala urusan).",
      "Terjemahan_En": "We will ease you into the Easy Way.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَنُيَسِّرُكَ",
          "Arti_kata_in": "dan Kami memudahkan",
          "Arti_kata_en": "And We will ease you",
          "Text_Latin": "wanuyassiruka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لِلۡيُسۡرَىٰ",
          "Arti_kata_in": "untuk kemudahan",
          "Arti_kata_en": "to the ease",
          "Text_Latin": "lil'yus'ra",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5957,
      "Ayat_Arabic": "فَذَكِّرْ اِنْ نَّفَعَتِ الذِّكْرٰىۗ",
      "Text_Latin": "fa zakkir in nafa'atiz-zikra",
      "Terjemah_in": "Maka, sampaikanlah peringatan jika peringatan itu bermanfaat.",
      "Terjemahan_En": "So remind, if reminding helps.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَذَكِّرۡ",
          "Arti_kata_in": "maka berilah peringatan",
          "Arti_kata_en": "So remind",
          "Text_Latin": "fadhakkir",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِن",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "if",
          "Text_Latin": "in",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نَّفَعَتِ",
          "Arti_kata_in": "berguna",
          "Arti_kata_en": "benefits",
          "Text_Latin": "nafa'ati",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلذِّكۡرَىٰ",
          "Arti_kata_in": "peringatan",
          "Arti_kata_en": "the reminder",
          "Text_Latin": "ad-dhik'ra",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5958,
      "Ayat_Arabic": "سَيَذَّكَّرُ مَنْ يَّخْشٰىۙ",
      "Text_Latin": "sayazzakkaru may yakhsya",
      "Terjemah_in": "Orang yang takut (kepada Allah) akan mengambil pelajaran,",
      "Terjemahan_En": "The reverent will remember.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "سَيَذَّكَّرُ",
          "Arti_kata_in": "akan menerima peringatan",
          "Arti_kata_en": "He will pay heed",
          "Text_Latin": "sayadhakkaru",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَن",
          "Arti_kata_in": "orang yang",
          "Arti_kata_en": "(one) who",
          "Text_Latin": "man",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَخۡشَىٰ",
          "Arti_kata_in": "ia takut",
          "Arti_kata_en": "fears (Allah)",
          "Text_Latin": "yakhsha",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5959,
      "Ayat_Arabic": "وَيَتَجَنَّبُهَا الْاَشْقَىۙ",
      "Text_Latin": "wa yatajannabuhal-asyqa",
      "Terjemah_in": "sedangkan orang-orang yang celaka (kafir) akan menjauhinya,",
      "Terjemahan_En": "But the wretched will avoid it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَيَتَجَنَّبُهَا",
          "Arti_kata_in": "dan akan menjauhi",
          "Arti_kata_en": "And will avoid it",
          "Text_Latin": "wayatajannabuha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡأَشۡقَى",
          "Arti_kata_in": "orang yang celaka",
          "Arti_kata_en": "the wretched one",
          "Text_Latin": "al-ashqa",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5960,
      "Ayat_Arabic": "الَّذِيْ يَصْلَى النَّارَ الْكُبْرٰىۚ",
      "Text_Latin": "allazi yaslan-naral-kubra",
      "Terjemah_in": "(yaitu) orang yang akan memasuki api (neraka) yang besar.",
      "Terjemahan_En": "He who will enter the Gigantic Fire.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "The one who",
          "Text_Latin": "alladhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَصۡلَى",
          "Arti_kata_in": "ia akan masuk",
          "Arti_kata_en": "will burn",
          "Text_Latin": "yasla",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلنَّارَ",
          "Arti_kata_in": "api/neraka",
          "Arti_kata_en": "(in) the Fire",
          "Text_Latin": "an-nara",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡكُبۡرَىٰ",
          "Arti_kata_in": "yang besar",
          "Arti_kata_en": "[the] great",
          "Text_Latin": "al-kub'ra",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5961,
      "Ayat_Arabic": "ثُمَّ لَا يَمُوْتُ فِيْهَا وَلَا يَحْيٰىۗ",
      "Text_Latin": "summa la yamutu fiha wa la yahya",
      "Terjemah_in": "Selanjutnya, dia tidak mati dan tidak (pula) hidup di sana.",
      "Terjemahan_En": "Where he will neither die, nor live.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ثُمَّ",
          "Arti_kata_in": "kemudian",
          "Arti_kata_en": "Then",
          "Text_Latin": "thumma",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَا",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "not",
          "Text_Latin": "la",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَمُوتُ",
          "Arti_kata_in": "ia mati",
          "Arti_kata_en": "he will die",
          "Text_Latin": "yamutu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فِيهَا",
          "Arti_kata_in": "di dalamnya",
          "Arti_kata_en": "therein",
          "Text_Latin": "fiha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَلَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "and not",
          "Text_Latin": "wala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "يَحۡيَىٰ",
          "Arti_kata_in": "ia hidup",
          "Arti_kata_en": "will live",
          "Text_Latin": "yahya",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5962,
      "Ayat_Arabic": "قَدْ اَفْلَحَ مَنْ تَزَكّٰىۙ",
      "Text_Latin": "qad aflaha man tazakka",
      "Terjemah_in": "Sungguh, beruntung orang yang menyucikan diri (dari kekafiran)",
      "Terjemahan_En": "Successful is he who purifies himself.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قَدۡ",
          "Arti_kata_in": "sungguh",
          "Arti_kata_en": "Certainly",
          "Text_Latin": "qad",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَفۡلَحَ",
          "Arti_kata_in": "beruntung",
          "Arti_kata_en": "has succeeded",
          "Text_Latin": "aflaha",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَن",
          "Arti_kata_in": "siapa/orang",
          "Arti_kata_en": "(one) who",
          "Text_Latin": "man",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "تَزَكَّىٰ",
          "Arti_kata_in": "dia membersihkan diri",
          "Arti_kata_en": "purifies (himself)",
          "Text_Latin": "tazakka",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5963,
      "Ayat_Arabic": "وَذَكَرَ اسْمَ رَبِّهٖ فَصَلّٰىۗ",
      "Text_Latin": "wa zakarasma rabbihi fa salla",
      "Terjemah_in": "dan mengingat nama Tuhannya, lalu dia salat.",
      "Terjemahan_En": "And mentions the name of his Lord, and prays.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَذَكَرَ",
          "Arti_kata_in": "dan dia mengingat",
          "Arti_kata_en": "And remembers",
          "Text_Latin": "wadhakara",
          "Jenis_kata": "Fiil Madhi"
        },
        {
