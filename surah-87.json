      "Terjemah_in": "Adapun kamu (orang-orang kafir) mengutamakan kehidupan dunia,",
      "Terjemahan_En": "But you prefer the present life.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "بَلۡ",
          "Arti_kata_in": "bahkan/tetapi",
          "Arti_kata_en": "Nay!",
          "Text_Latin": "bal",
          "Jenis_kata": "Isim"
