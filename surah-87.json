      "Text_Latin": "suhufi ibrahima wa musa",
      "Terjemah_in": "(yaitu) suhuf (yang diturunkan kepada) Ibrahim dan Musa.",
      "Terjemahan_En": "The Scriptures of Abraham and Moses.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "صُحُفِ",
          "Arti_kata": "kitab",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِبۡرَٰهِيمَ",
          "Arti_kata": "Ibrahim",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَمُوسَىٰ",
