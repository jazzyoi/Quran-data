          "Kata_Arabic": "وَأَبۡقَىٰٓ",
          "Arti_kata_in": "dan lebih kekal",
          "Arti_kata_en": "and ever lasting",
          "Text_Latin": "wa-abqa",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5966,
      "Ayat_Arabic": "اِنَّ هٰذَا لَفِى الصُّحُفِ الْاُوْلٰىۙ",
