          "Kata_Arabic": "ٱلدُّنۡيَا",
          "Arti_kata_in": "dunia",
          "Arti_kata_en": "(of) the world",
          "Text_Latin": "ad-dun'ya",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5965,
      "Ayat_Arabic": "وَالْاٰخِرَةُ خَيْرٌ وَّاَبْقٰىۗ",
