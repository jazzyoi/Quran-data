        }
      ]
    },
    {
      "Nomor_ayat": 5701,
      "Ayat_Arabic": "وَكُلَّ شَيْءٍ اَحْصَيْنٰهُ كِتٰبًاۙ",
      "Text_Latin": "wa kulla syai'in ahsainahu kitaba",
      "Terjemah_in": "Segala sesuatu telah Kami catat dalam kitab (catatan amal manusia).",
      "Terjemahan_En": "But We have enumerated everything in writing.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَكُلَّ",
          "Arti_kata": "dan tiap-tiap/segala",
