    },
    {
      "Nomor_ayat": 5699,
      "Ayat_Arabic": "اِنَّهُمْ كَانُوْا لَا يَرْجُوْنَ حِسَابًاۙ",
      "Text_Latin": "innahum kanu la yarjuna hisaba",
      "Terjemah_in": "Sesungguhnya mereka tidak pernah mengharapkan perhitungan.",
      "Terjemahan_En": "For they were not anticipating any reckoning.",
      "Kata": [
        {
