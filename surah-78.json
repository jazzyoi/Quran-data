          "Kata_Arabic": "كِتَٰبٗا",
          "Arti_kata": "suatu kitab",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5702,
      "Ayat_Arabic": "فَذُوْقُوْا فَلَنْ نَّزِيْدَكُمْ اِلَّا عَذَابًا ࣖ",
      "Text_Latin": "fa zuqu fa lan nazidakum illa 'azaba",
      "Terjemah_in": "Oleh karena itu, rasakanlah! Tidak akan Kami tambahkan kepadamu, kecuali azab.",
      "Terjemahan_En": "So taste! We will increase you only in suffering.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَذُوقُواْ",
          "Arti_kata": "maka rasakanlah",
