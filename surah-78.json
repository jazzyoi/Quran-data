          "Arti_kata": "minuman",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5697,
      "Ayat_Arabic": "اِلَّا حَمِيْمًا وَّغَسَّاقًاۙ",
