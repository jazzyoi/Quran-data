    },
    {
      "Nomor_ayat": 5708,
      "Ayat_Arabic": "جَزَاۤءً مِّنْ رَّبِّكَ عَطَاۤءً حِسَابًاۙ",
      "Text_Latin": "jaza'am mir rabbika 'ata'an hisaba",
      "Terjemah_in": "(Hal itu) sebagai balasan (dan) pemberian yang banyak dari Tuhanmu,",
      "Terjemahan_En": "A reward from your Lord, a fitting gift.",
