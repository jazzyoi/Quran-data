          "Kata_Arabic": "حِسَابٗا",
          "Arti_kata": "perhitungan/cukup",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5709,
      "Ayat_Arabic": "رَّبِّ السَّمٰوٰتِ وَالْاَرْضِ وَمَا بَيْنَهُمَا الرَّحْمٰنِ لَا يَمْلِكُوْنَ مِنْهُ خِطَابًاۚ",
      "Text_Latin": "rabbis-samawati wal-ardi wa ma bainahumar-rahmani la yamlikuna min-hu khitaba",
      "Terjemah_in": "(yaitu) Tuhan (pemelihara) langit, bumi, dan apa yang ada di antara keduanya, Yang Maha Pengasih. Mereka tidak memiliki (hak) berbicara dengan-Nya.",
      "Terjemahan_En": "Lord of the heavens and the earth, and everything between them—The Most Merciful—none can argue with Him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "رَّبِّ",
          "Arti_kata": "Tuhan/Pemelihara",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلسَّمَٰوَٰتِ",
          "Arti_kata": "langit(jamak)",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَٱلۡأَرۡضِ",
          "Arti_kata": "dan bumi",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَمَا",
          "Arti_kata": "dan apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "بَيۡنَهُمَا",
          "Arti_kata": "diantara keduanya",
          "Jenis_kata": null
        },
        {
