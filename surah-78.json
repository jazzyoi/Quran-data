    {
      "Nomor_ayat": 5700,
      "Ayat_Arabic": "وَّكَذَّبُوْا بِاٰيٰتِنَا كِذَّابًاۗ",
      "Text_Latin": "wa kazzabu bi'ayatina kizzaba",
      "Terjemah_in": "Mereka benar-benar mendustakan ayat-ayat Kami.",
      "Terjemahan_En": "And they denied Our signs utterly.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَكَذَّبُواْ",
          "Arti_kata": "dan mereka mendustakan",
          "Jenis_kata": null
