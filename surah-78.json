          "Arti_kata": "sesuatu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَحۡصَيۡنَٰهُ",
          "Arti_kata": "Kami telah mengumpulkannya",
