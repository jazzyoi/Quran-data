          "Kata_Arabic": "كَانَتۡ",
          "Arti_kata": "adalah ia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مِرۡصَادٗا",
          "Arti_kata": "tempat penantian/disediakan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5694,
      "Ayat_Arabic": "لِّلطّٰغِيْنَ مَاٰبًاۙ",
      "Text_Latin": "lit-tagina ma'aba",
      "Terjemah_in": "(dan) menjadi tempat kembali bagi orang-orang yang melampaui batas.",
      "Terjemahan_En": "For the oppressors, a destination.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لِّلطَّٰغِينَ",
          "Arti_kata": "bagi orang-orang yang melampui batas",
