          "Kata_Arabic": "مََٔابٗا",
          "Arti_kata": "tempat kembali",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5695,
      "Ayat_Arabic": "لّٰبِثِيْنَ فِيْهَآ اَحْقَابًاۚ",
      "Text_Latin": "labisina fiha ahqaba",
      "Terjemah_in": "Mereka tinggal di sana dalam masa yang lama.",
      "Terjemahan_En": "Where they will remain for eons.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَّٰبِثِينَ",
          "Arti_kata": "mereka tinggal",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فِيهَآ",
          "Arti_kata": "didalamnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَحۡقَابٗا",
          "Arti_kata": "beberapa lama",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5696,
      "Ayat_Arabic": "لَا يَذُوْقُوْنَ فِيْهَا بَرْدًا وَّلَا شَرَابًاۙ",
      "Text_Latin": "la yazuquna fiha bardaw wa la syaraba",
      "Terjemah_in": "Mereka tidak merasakan kesejukan di dalamnya dan tidak (pula mendapat) minuman,",
      "Terjemahan_En": "They will taste therein neither coolness, nor drink.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَّا",
          "Arti_kata": "tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَذُوقُونَ",
          "Arti_kata": "merasakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فِيهَا",
          "Arti_kata": "di dalamnya",
          "Jenis_kata": null
