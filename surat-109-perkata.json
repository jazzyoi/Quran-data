{
  "Nomor_surat": 109,
  "Nama_surat": "Al-Kafirun",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قُلۡ",
          "Arti_kata_in": "katakanlah",
          "Arti_kata_en": "Say",
          "Text_Latin": "qul"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَٰٓأَيُّهَا",
          "Arti_kata_in": "wahai",
          "Arti_kata_en": "O",
          "Text_Latin": "yaayyuha"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡكَٰفِرُونَ",
          "Arti_kata_in": "orang-orang kafir",
          "Arti_kata_en": "disbelievers",
          "Text_Latin": "al-kafiruna"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَآ",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "Not",
          "Text_Latin": "la"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَعۡبُدُ",
          "Arti_kata_in": "aku menyembah",
          "Arti_kata_en": "I worship",
          "Text_Latin": "a'budu"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "تَعۡبُدُونَ",
          "Arti_kata_in": "kamu sembah",
          "Arti_kata_en": "you worship",
          "Text_Latin": "ta'buduna"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَآ",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And not",
          "Text_Latin": "wala"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَنتُمۡ",
          "Arti_kata_in": "kamu",
          "Arti_kata_en": "you",
          "Text_Latin": "antum"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَٰبِدُونَ",
          "Arti_kata_in": "menyembah",
          "Arti_kata_en": "(are) worshippers",
          "Text_Latin": "abiduna"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَآ",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "(of) what",
          "Text_Latin": "ma"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَعۡبُدُ",
          "Arti_kata_in": "aku sembah",
          "Arti_kata_en": "I worship",
          "Text_Latin": "a'budu"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَآ",
          "Arti_kata_in": "dan bukanlah",
          "Arti_kata_en": "And not",
          "Text_Latin": "wala"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَنَا۠",
          "Arti_kata_in": "aku",
          "Arti_kata_en": "I am",
          "Text_Latin": "ana"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَابِدٞ",
          "Arti_kata_in": "menjadi penyembah",
          "Arti_kata_en": "a worshipper",
          "Text_Latin": "abidun"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَّا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "(of) what",
          "Text_Latin": "ma"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "عَبَدتُّمۡ",
          "Arti_kata_in": "kamu sembah",
          "Arti_kata_en": "you worship",
          "Text_Latin": "abadttum"
        }
      ]
    },
    {
      "Nomor_ayat": 5,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَآ",
          "Arti_kata_in": "dan bukanlah",
          "Arti_kata_en": "And not",
          "Text_Latin": "wala"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَنتُمۡ",
          "Arti_kata_in": "kamu",
          "Arti_kata_en": "you are",
          "Text_Latin": "antum"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَٰبِدُونَ",
          "Arti_kata_in": "menyembah",
          "Arti_kata_en": "worshippers",
          "Text_Latin": "abiduna"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَآ",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "(of) what",
          "Text_Latin": "ma"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَعۡبُدُ",
          "Arti_kata_in": "aku sembah",
          "Arti_kata_en": "I worship",
          "Text_Latin": "a'budu"
        }
      ]
    },
    {
      "Nomor_ayat": 6,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لَكُمۡ",
          "Arti_kata_in": "bagi kalian",
          "Arti_kata_en": "For you",
          "Text_Latin": "lakum"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "دِينُكُمۡ",
          "Arti_kata_in": "agamamu",
          "Arti_kata_en": "(is) your religion",
          "Text_Latin": "dinukum"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَلِيَ",
          "Arti_kata_in": "bagiku",
          "Arti_kata_en": "and for me",
          "Text_Latin": "waliya"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "دِينِ",
          "Arti_kata_in": "agamaku",
          "Arti_kata_en": "(is) my religion",
          "Text_Latin": "dini"
        }
      ]
    }
  ]
}