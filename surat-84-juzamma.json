{
  "Nomor_surat": 84,
  "Nama_surat": "Al-Insyiqaq",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Ayat_arabic ": "اِذَا السَّمَاۤءُ انْشَقَّتْۙ",
      "Ayat_latin": "izas-sama'unsyaqqat",
      "Terjemah_in": "Apabila langit terbelah",
      "Terjemah_en": "When the sky is ruptured.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "When",
          "Text_latin  ": "idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلسَّمَآءُ",
          "Arti_kata_in": "langit",
          "Arti_kata_en": "the sky",
          "Text_latin  ": "as-samau"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱنشَقَّتۡ",
          "Arti_kata_in": "terbelah",
          "Arti_kata_en": "is split asunder",
          "Text_latin  ": "inshaqqat"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Ayat_arabic ": "وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْۙ",
      "Ayat_latin": "wa azinat lirabbiha wa huqqat",
      "Terjemah_in": "serta patuh kepada Tuhannya dan sudah semestinya patuh.",
      "Terjemah_en": "And hearkens to its Lord, as it must.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَأَذِنَتۡ",
          "Arti_kata_in": "dan ia patuh",
          "Arti_kata_en": "And has listened",
          "Text_latin  ": "wa-adhinat"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "لِرَبِّهَا",
          "Arti_kata_in": "kepada Tuhannya",
          "Arti_kata_en": "to its Lord",
          "Text_latin  ": "lirabbiha"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "وَحُقَّتۡ",
          "Arti_kata_in": "dan ia semestinya",
          "Arti_kata_en": "and was obligated",
          "Text_latin  ": "wahuqqat"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Ayat_arabic ": "وَاِذَا الْاَرْضُ مُدَّتْۙ",
      "Ayat_latin": "wa izal-ardu muddat",
      "Terjemah_in": "Apabila bumi diratakan,",
      "Terjemah_en": "And when the earth is leveled out.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_latin  ": "wa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلۡأَرۡضُ",
          "Arti_kata_in": "bumi",
          "Arti_kata_en": "the earth",
          "Text_latin  ": "al-ardu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "مُدَّتۡ",
          "Arti_kata_in": "dipanjangkan/diratakan",
          "Arti_kata_en": "is spread",
          "Text_latin  ": "muddat"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Ayat_arabic ": "وَاَلْقَتْ مَا فِيْهَا وَتَخَلَّتْۙ",
      "Ayat_latin": "wa alqat ma fiha wa takhallat",
      "Terjemah_in": "memuntahkan apa yang ada di dalamnya dan menjadi kosong,",
      "Terjemah_en": "And casts out what is in it, and becomes empty.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَأَلۡقَتۡ",
          "Arti_kata_in": "dan ia melemparkan",
          "Arti_kata_en": "And has cast out",
          "Text_latin  ": "wa-alqat"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_latin  ": "ma"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "فِيهَا",
          "Arti_kata_in": "di dalamnya",
          "Arti_kata_en": "(is) in it",
          "Text_latin  ": "fiha"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "وَتَخَلَّتۡ",
          "Arti_kata_in": "dan ia menjadi sunyi/kosong",
          "Arti_kata_en": "and becomes empty",
          "Text_latin  ": "watakhallat"
        }
      ]
    },
    {
      "Nomor_ayat": 5,
      "Ayat_arabic ": "وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْۗ",
      "Ayat_latin": "wa azinat lirabbiha wa huqqat",
      "Terjemah_in": "serta patuh kepada Tuhannya, dan sudah semestinya patuh.",
      "Terjemah_en": "And hearkens to its Lord, as it must.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَأَذِنَتۡ",
          "Arti_kata_in": "dan ia patuh",
          "Arti_kata_en": "And has listened",
          "Text_latin  ": "wa-adhinat"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "لِرَبِّهَا",
          "Arti_kata_in": "kepada Tuhannya",
          "Arti_kata_en": "to its Lord",
          "Text_latin  ": "lirabbiha"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "وَحُقَّتۡ",
          "Arti_kata_in": "dan ia semestinya",
          "Arti_kata_en": "and was obligated",
          "Text_latin  ": "wahuqqat"
        }
      ]
    },
    {
      "Nomor_ayat": 6,
      "Ayat_arabic ": "يٰٓاَيُّهَا الْاِنْسَانُ اِنَّكَ كَادِحٌ اِلٰى رَبِّكَ كَدْحًا فَمُلٰقِيْهِۚ",
      "Ayat_latin": "ya ayyuhal-insanu innaka kadihun ila rabbika kad-han fa mulaqih",
      "Terjemah_in": "Wahai manusia, sesungguhnya engkau telah bekerja keras menuju (pertemuan dengan) Tuhanmu. Maka, engkau pasti menemui-Nya.751)",
      "Terjemah_en": "O man! You are laboring towards your Lord, and you will meet Him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "يَٰٓأَيُّهَا",
          "Arti_kata_in": "wahai",
          "Arti_kata_en": "O",
          "Text_latin  ": "yaayyuha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "mankind",
          "Text_latin  ": "al-insanu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "إِنَّكَ",
          "Arti_kata_in": "sesungguhnya kamu",
          "Arti_kata_en": "Indeed, you",
          "Text_latin  ": "innaka"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "كَادِحٌ",
          "Arti_kata_in": "bekerja keras",
          "Arti_kata_en": "(are) laboring",
          "Text_latin  ": "kadihun"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "إِلَىٰ",
          "Arti_kata_in": "kepada",
          "Arti_kata_en": "to",
          "Text_latin  ": "ila"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_latin  ": "rabbika"
        },
        {
          "Nomor_kata": 7,
          "Kata_arabic": "كَدۡحٗا",
          "Arti_kata_in": "sungguh-sungguh kerja keras",
          "Arti_kata_en": "(with) exertion",
          "Text_latin  ": "kadhan"
        },
        {
          "Nomor_kata": 8,
          "Kata_arabic": "فَمُلَٰقِيهِ",
          "Arti_kata_in": "maka menemuinya",
          "Arti_kata_en": "and you (will) meet Him",
          "Text_latin  ": "famulaqihi"
        }
      ]
    },
    {
      "Nomor_ayat": 7,
      "Ayat_arabic ": "فَاَمَّا مَنْ اُوْتِيَ كِتٰبَهٗ بِيَمِيْنِهٖۙ",
      "Ayat_latin": "fa amma man utiya kitabahu biyaminih",
      "Terjemah_in": "Adapun orang yang catatannya diberikan dari sebelah kanannya,",
      "Terjemah_en": "As for him who is given his book in his right hand.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَأَمَّا",
          "Arti_kata_in": "maka adapun",
          "Arti_kata_en": "Then as for",
          "Text_latin  ": "fa-amma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مَنۡ",
          "Arti_kata_in": "siapa",
          "Arti_kata_en": "(him) who",
          "Text_latin  ": "man"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "أُوتِيَ",
          "Arti_kata_in": "diberikan",
          "Arti_kata_en": "is given",
          "Text_latin  ": "utiya"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "كِتَٰبَهُۥ",
          "Arti_kata_in": "kitabnya/catatannya",
          "Arti_kata_en": "his record",
          "Text_latin  ": "kitabahu"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "بِيَمِينِهِۦ",
          "Arti_kata_in": "sebelah kanannya",
          "Arti_kata_en": "in his right hand",
          "Text_latin  ": "biyaminihi"
        }
      ]
    },
    {
      "Nomor_ayat": 8,
      "Ayat_arabic ": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَّسِيْرًاۙ",
      "Ayat_latin": "fa saufa yuhasabu hisabay yasira",
      "Terjemah_in": "dia akan dihisab dengan pemeriksaan yang mudah",
      "Terjemah_en": "He will have an easy settlement.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَسَوۡفَ",
          "Arti_kata_in": "maka nanti",
          "Arti_kata_en": "Soon",
          "Text_latin  ": "fasawfa"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يُحَاسَبُ",
          "Arti_kata_in": "dia dihisap/diperiksa",
          "Arti_kata_en": "his account will be taken",
          "Text_latin  ": "yuhasabu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "حِسَابٗا",
          "Arti_kata_in": "perhitungan/pemeriksaan",
          "Arti_kata_en": "an account",
          "Text_latin  ": "hisaban"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "يَسِيرٗا",
          "Arti_kata_in": "mudah",
          "Arti_kata_en": "easy",
          "Text_latin  ": "yasiran"
        }
      ]
    },
    {
      "Nomor_ayat": 9,
      "Ayat_arabic ": "وَّيَنْقَلِبُ اِلٰٓى اَهْلِهٖ مَسْرُوْرًاۗ",
      "Ayat_latin": "wa yangqalibu ila ahlihi masrura",
      "Terjemah_in": "dan dia akan kembali kepada keluarganya (yang sama-sama beriman) dengan gembira.",
      "Terjemah_en": "And will return to his family delighted.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَيَنقَلِبُ",
          "Arti_kata_in": "dan dia akan dikembalikan",
          "Arti_kata_en": "And he will return",
          "Text_latin  ": "wayanqalibu"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِلَىٰٓ",
          "Arti_kata_in": "kepada",
          "Arti_kata_en": "to",
          "Text_latin  ": "ila"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "أَهۡلِهِۦ",
          "Arti_kata_in": "keluarganya",
          "Arti_kata_en": "his people",
          "Text_latin  ": "ahlihi"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "مَسۡرُورٗا",
          "Arti_kata_in": "dengan gembira",
          "Arti_kata_en": "happily",
          "Text_latin  ": "masruran"
        }
      ]
    },
    {
      "Nomor_ayat": 10,
      "Ayat_arabic ": "وَاَمَّا مَنْ اُوْتِيَ كِتٰبَهٗ وَرَاۤءَ ظَهْرِهٖۙ",
      "Ayat_latin": "wa amma man utiya kitabahu wara'a zahrih",
      "Terjemah_in": "Adapun orang yang catatannya diberikan dari belakang punggungnya,",
      "Terjemah_en": "But as for him who is given his book behind his back.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَأَمَّا",
          "Arti_kata_in": "dan adapun",
          "Arti_kata_en": "But as for",
          "Text_latin  ": "wa-amma"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "مَنۡ",
          "Arti_kata_in": "siapa/orang",
          "Arti_kata_en": "(him) who",
          "Text_latin  ": "man"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "أُوتِيَ",
          "Arti_kata_in": "diberikan",
          "Arti_kata_en": "is given",
          "Text_latin  ": "utiya"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "كِتَٰبَهُۥ",
          "Arti_kata_in": "kitabnya",
          "Arti_kata_en": "his record",
          "Text_latin  ": "kitabahu"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "وَرَآءَ",
          "Arti_kata_in": "belakang",
          "Arti_kata_en": "behind",
          "Text_latin  ": "waraa"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "ظَهۡرِهِۦ",
          "Arti_kata_in": "punggungnya",
          "Arti_kata_en": "his back",
          "Text_latin  ": "zahrihi"
        }
      ]
    },
    {
      "Nomor_ayat": 11,
      "Ayat_arabic ": "فَسَوْفَ يَدْعُوْا ثُبُوْرًاۙ",
      "Ayat_latin": "fa saufa yad'u subura",
      "Terjemah_in": "dia akan berteriak, “Celakalah aku!”",
      "Terjemah_en": "He will call for death.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَسَوۡفَ",
          "Arti_kata_in": "maka nanti",
          "Arti_kata_en": "Soon",
          "Text_latin  ": "fasawfa"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَدۡعُواْ",
          "Arti_kata_in": "mereka berseru/berteriak",
          "Arti_kata_en": "he will call",
          "Text_latin  ": "yad'u"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ثُبُورٗا",
          "Arti_kata_in": "kebinasaan/kecelakaan",
          "Arti_kata_en": "(for) destruction",
          "Text_latin  ": "thuburan"
        }
      ]
    },
    {
      "Nomor_ayat": 12,
      "Ayat_arabic ": "وَّيَصْلٰى سَعِيْرًاۗ",
      "Ayat_latin": "wa yasla sa'ira",
      "Terjemah_in": "Dia akan memasuki (neraka) Sa‘ir (yang menyala-nyala).",
      "Terjemah_en": "And will enter the Blaze.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَيَصۡلَىٰ",
          "Arti_kata_in": "dan dia akan masuk",
          "Arti_kata_en": "And he will burn",
          "Text_latin  ": "wayasla"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "سَعِيرًا",
          "Arti_kata_in": "api yang menyala-nyala",
          "Arti_kata_en": "(in) a Blaze",
          "Text_latin  ": "sa'iran"
        }
      ]
    },
    {
      "Nomor_ayat": 13,
      "Ayat_arabic ": "اِنَّهٗ كَانَ فِيْٓ اَهْلِهٖ مَسْرُوْرًاۗ",
      "Ayat_latin": "innahu kana fi ahlihi masrura",
      "Terjemah_in": "Sesungguhnya dia dahulu (di dunia) bergembira di kalangan keluarganya (yang sama-sama kafir).",
      "Terjemah_en": "He used to be happy among his family.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "إِنَّهُۥ",
          "Arti_kata_in": "sesungguhnya dia",
          "Arti_kata_en": "Indeed he",
          "Text_latin  ": "innahu"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "كَانَ",
          "Arti_kata_in": "adalah",
          "Arti_kata_en": "had been",
          "Text_latin  ": "kana"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "فِيٓ",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "among",
          "Text_latin  ": "fi"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "أَهۡلِهِۦ",
          "Arti_kata_in": "keluarganya",
          "Arti_kata_en": "his people",
          "Text_latin  ": "ahlihi"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "مَسۡرُورًا",
          "Arti_kata_in": "bergembira",
          "Arti_kata_en": "happy",
          "Text_latin  ": "masruran"
        }
      ]
    },
    {
      "Nomor_ayat": 14,
      "Ayat_arabic ": "اِنَّهٗ ظَنَّ اَنْ لَّنْ يَّحُوْرَ ۛ",
      "Ayat_latin": "innahu zanna al lay yahur",
      "Terjemah_in": "Sesungguhnya dia mengira bahwa dia tidak akan kembali (kepada Tuhannya).",
      "Terjemah_en": "He thought he would never return.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "إِنَّهُۥ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed he",
          "Text_latin  ": "innahu"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ظَنَّ",
          "Arti_kata_in": "dia menyangka",
          "Arti_kata_en": "(had) thought",
          "Text_latin  ": "zanna"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "أَن",
          "Arti_kata_in": "bahwa",
          "Arti_kata_en": "that",
          "Text_latin  ": "an"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "لَّن",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "never",
          "Text_latin  ": "lan"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "يَحُورَ",
          "Arti_kata_in": "dia akan kembali",
          "Arti_kata_en": "he would return",
          "Text_latin  ": "yahura"
        }
      ]
    },
    {
      "Nomor_ayat": 15,
      "Ayat_arabic ": "بَلٰىۛ اِنَّ رَبَّهٗ كَانَ بِهٖ بَصِيْرًاۗ",
      "Ayat_latin": "bala inna rabbahu kana bihi basira",
      "Terjemah_in": "Tidak demikian. Sesungguhnya Tuhannya selalu melihatnya.",
      "Terjemah_en": "In fact, his Lord was watching him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "بَلَىٰٓۚ",
          "Arti_kata_in": "yang benar",
          "Arti_kata_en": "Nay!",
          "Text_latin  ": "bala"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_latin  ": "inna"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "رَبَّهُۥ",
          "Arti_kata_in": "Tuhannya",
          "Arti_kata_en": "his Lord",
          "Text_latin  ": "rabbahu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "كَانَ",
          "Arti_kata_in": "adalah",
          "Arti_kata_en": "was",
          "Text_latin  ": "kana"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "بِهِۦ",
          "Arti_kata_in": "kepadanya",
          "Arti_kata_en": "of him",
          "Text_latin  ": "bihi"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "بَصِيرٗا",
          "Arti_kata_in": "melihat",
          "Arti_kata_en": "seeing",
          "Text_latin  ": "basiran"
        }
      ]
    },
    {
      "Nomor_ayat": 16,
      "Ayat_arabic ": "فَلَآ اُقْسِمُ بِالشَّفَقِۙ",
      "Ayat_latin": "fa la uqsimu bisy-syafaq",
      "Terjemah_in": "Aku bersumpah demi cahaya merah pada waktu senja,",
      "Terjemah_en": "I swear by the twilight.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَلَآ",
          "Arti_kata_in": "maka",
          "Arti_kata_en": "But nay!",
          "Text_latin  ": "fala"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "أُقۡسِمُ",
          "Arti_kata_in": "Aku bersumpah",
          "Arti_kata_en": "I swear",
          "Text_latin  ": "uq'simu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "بِٱلشَّفَقِ",
          "Arti_kata_in": "dengan cahaya merah di waktu senja",
          "Arti_kata_en": "by the twilight glow",
          "Text_latin  ": "bil-shafaqi"
        }
      ]
    },
    {
      "Nomor_ayat": 17,
      "Ayat_arabic ": "وَالَّيْلِ وَمَا وَسَقَۙ",
      "Ayat_latin": "wal-laili wa ma wasaq",
      "Terjemah_in": "demi malam dan apa yang diselubunginya,",
      "Terjemah_en": "And by the night, and what it covers.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَٱلَّيۡلِ",
          "Arti_kata_in": "dan malam",
          "Arti_kata_en": "And the night",
          "Text_latin  ": "wa-al-layli"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "وَمَا",
          "Arti_kata_in": "dan apa",
          "Arti_kata_en": "and what",
          "Text_latin  ": "wama"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "وَسَقَ",
          "Arti_kata_in": "menyelubungi",
          "Arti_kata_en": "it envelops",
          "Text_latin  ": "wasaqa"
        }
      ]
    },
    {
      "Nomor_ayat": 18,
      "Ayat_arabic ": "وَالْقَمَرِ اِذَا اتَّسَقَۙ",
      "Ayat_latin": "wal-qamari izattasaq",
      "Terjemah_in": "dan demi bulan apabila jadi purnama,",
      "Terjemah_en": "And by the moon, as it grows full.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَٱلۡقَمَرِ",
          "Arti_kata_in": "dan bulan",
          "Arti_kata_en": "And the moon",
          "Text_latin  ": "wal-qamari"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_latin  ": "idha"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ٱتَّسَقَ",
          "Arti_kata_in": "sempurna terang",
          "Arti_kata_en": "it becomes full",
          "Text_latin  ": "ittasaqa"
        }
      ]
    },
    {
      "Nomor_ayat": 19,
      "Ayat_arabic ": "لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍۗ",
      "Ayat_latin": "latarkabunna tabaqan 'an tabaq",
      "Terjemah_in": "sungguh, kamu benar-benar akan menjalani tingkat demi tingkat (dalam kehidupan).752)",
      "Terjemah_en": "You will mount stage by stage.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "لَتَرۡكَبُنَّ",
          "Arti_kata_in": "sesungguhnya kamu akan naik/melalui",
          "Arti_kata_en": "You will surely embark",
          "Text_latin  ": "latarkabunna"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "طَبَقًا",
          "Arti_kata_in": "setingkat",
          "Arti_kata_en": "(to) stage",
          "Text_latin  ": "tabaqan"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "عَن",
          "Arti_kata_in": "dari/demi",
          "Arti_kata_en": "from",
          "Text_latin  ": "an"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "طَبَقٖ",
          "Arti_kata_in": "setingkat",
          "Arti_kata_en": "stage",
          "Text_latin  ": "tabaqin"
        }
      ]
    },
    {
      "Nomor_ayat": 20,
      "Ayat_arabic ": "فَمَا لَهُمْ لَا يُؤْمِنُوْنَۙ",
      "Ayat_latin": "fa ma lahum la yu'minun",
      "Terjemah_in": "Maka, mengapa mereka tidak mau beriman?",
      "Terjemah_en": "What is the matter with them that they do not believe?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَمَا",
          "Arti_kata_in": "maka mengapa",
          "Arti_kata_en": "So what",
          "Text_latin  ": "fama"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "لَهُمۡ",
          "Arti_kata_in": "bagi mereka",
          "Arti_kata_en": "(is) for them",
          "Text_latin  ": "lahum"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "لَا",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "not",
          "Text_latin  ": "la"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "يُؤۡمِنُونَ",
          "Arti_kata_in": "mereka beriman",
          "Arti_kata_en": "they believe",
          "Text_latin  ": "yu'minuna"
        }
      ]
    },
    {
      "Nomor_ayat": 21,
      "Ayat_arabic ": "وَاِذَا قُرِئَ عَلَيْهِمُ الْقُرْاٰنُ لَا يَسْجُدُوْنَ ۗ ۩",
      "Ayat_latin": "wa iza quri'a 'alaihimul-qur'anu la yasjudun",
      "Terjemah_in": "Apabila Al-Qur’an dibacakan kepada mereka, mereka tidak (mau) bersujud,",
      "Terjemah_en": "And when the Quran is read to them, they do not bow down?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_latin  ": "wa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "قُرِئَ",
          "Arti_kata_in": "dibacakan",
          "Arti_kata_en": "is recited",
          "Text_latin  ": "quri-a"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "عَلَيۡهِمُ",
          "Arti_kata_in": "atas mereka",
          "Arti_kata_en": "to them",
          "Text_latin  ": "alayhimu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلۡقُرۡءَانُ",
          "Arti_kata_in": "Al Qur'an",
          "Arti_kata_en": "the Quran",
          "Text_latin  ": "al-qur'anu"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "لَا",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "not",
          "Text_latin  ": "la"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "يَسۡجُدُونَۤ۩",
          "Arti_kata_in": "sujud",
          "Arti_kata_en": "they prostrate",
          "Text_latin  ": "yasjuduna"
        }
      ]
    },
    {
      "Nomor_ayat": 22,
      "Ayat_arabic ": "بَلِ الَّذِيْنَ كَفَرُوْا يُكَذِّبُوْنَۖ",
      "Ayat_latin": "balillazina kafaru yukazzibun",
      "Terjemah_in": "bahkan orang-orang yang kufur itu mendustakan(-nya).",
      "Terjemah_en": "In fact, those who disbelieve are in denial.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "بَلِ",
          "Arti_kata_in": "tetapi/bahkan",
          "Arti_kata_en": "Nay!",
          "Text_latin  ": "bali"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "Those who",
          "Text_latin  ": "alladhina"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "كَفَرُواْ",
          "Arti_kata_in": "kafir/ingkar",
          "Arti_kata_en": "disbelieved",
          "Text_latin  ": "kafaru"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "يُكَذِّبُونَ",
          "Arti_kata_in": "mereka mendustakan",
          "Arti_kata_en": "deny",
          "Text_latin  ": "yukadhibuna"
        }
      ]
    },
    {
      "Nomor_ayat": 23,
      "Ayat_arabic ": "وَاللّٰهُ اَعْلَمُ بِمَا يُوْعُوْنَۖ",
      "Ayat_latin": "wallahu a'lamu bima yu'un",
      "Terjemah_in": "Allah lebih mengetahui apa yang mereka sembunyikan (dalam hati mereka).",
      "Terjemah_en": "But God knows what they hide inside.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَٱللَّهُ",
          "Arti_kata_in": "dan Allah",
          "Arti_kata_en": "And Allah",
          "Text_latin  ": "wal-lahu"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "أَعۡلَمُ",
          "Arti_kata_in": "lebih mengetahui",
          "Arti_kata_en": "(is) most knowing",
          "Text_latin  ": "a'lamu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "بِمَا",
          "Arti_kata_in": "terhadap apa",
          "Arti_kata_en": "of what",
          "Text_latin  ": "bima"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "يُوعُونَ",
          "Arti_kata_in": "mereka kumpulkan/simpan",
          "Arti_kata_en": "they keep within themselves",
          "Text_latin  ": "yu'una"
        }
      ]
    },
    {
      "Nomor_ayat": 24,
      "Ayat_arabic ": "فَبَشِّرْهُمْ بِعَذَابٍ اَلِيْمٍۙ",
      "Ayat_latin": "fa basysyir-hum bi'azabin alim",
      "Terjemah_in": "Maka, berilah mereka kabar ‘gembira’ dengan azab yang pedih,",
      "Terjemah_en": "So inform them of a painful punishment.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَبَشِّرۡهُم",
          "Arti_kata_in": "maka beri kabar gembira mereka",
          "Arti_kata_en": "So give them tidings",
          "Text_latin  ": "fabashir'hum"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "بِعَذَابٍ",
          "Arti_kata_in": "dengan azab",
          "Arti_kata_en": "of a punishment",
          "Text_latin  ": "bi'adhabin"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "أَلِيمٍ",
          "Arti_kata_in": "pedih",
          "Arti_kata_en": "painful",
          "Text_latin  ": "alimin"
        }
      ]
    },
    {
      "Nomor_ayat": 25,
      "Ayat_arabic ": "اِلَّا الَّذِيْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِ لَهُمْ اَجْرٌ غَيْرُ مَمْنُوْنٍ ࣖ",
      "Ayat_latin": "illallazina amanu wa 'amilus-salihati lahum ajrun gairu mamnun",
      "Terjemah_in": "Kecuali orang-orang yang beriman dan mengerjakan kebajikan. Bagi merekalah pahala yang tidak putus-putus.",
      "Terjemah_en": "Except those who believe and do good deeds; they will have an undiminished reward.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "إِلَّا",
          "Arti_kata_in": "kecuali",
          "Arti_kata_en": "Except",
          "Text_latin  ": "illa"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "those who",
          "Text_latin  ": "alladhina"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "ءَامَنُواْ",
          "Arti_kata_in": "beriman",
          "Arti_kata_en": "believe",
          "Text_latin  ": "amanu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "وَعَمِلُواْ",
          "Arti_kata_in": "dan mereka berbuat/beramal",
          "Arti_kata_en": "and do",
          "Text_latin  ": "wa'amilu"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "ٱلصَّٰلِحَٰتِ",
          "Arti_kata_in": "kebajikan/saleh",
          "Arti_kata_en": "righteous deeds",
          "Text_latin  ": "as-salihati"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "لَهُمۡ",
          "Arti_kata_in": "bagi mereka",
          "Arti_kata_en": "For them",
          "Text_latin  ": "lahum"
        },
        {
          "Nomor_kata": 7,
          "Kata_arabic": "أَجۡرٌ",
          "Arti_kata_in": "pahala",
          "Arti_kata_en": "(is) a reward",
          "Text_latin  ": "ajrun"
        },
        {
          "Nomor_kata": 8,
          "Kata_arabic": "غَيۡرُ",
          "Arti_kata_in": "lain/tidak",
          "Arti_kata_en": "never",
          "Text_latin  ": "ghayru"
        },
        {
          "Nomor_kata": 9,
          "Kata_arabic": "مَمۡنُونِۭ",
          "Arti_kata_in": "terputus-putus",
          "Arti_kata_en": "ending",
          "Text_latin  ": "mamnunin"
        }
      ]
    }
  ]
}