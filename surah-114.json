{
  "Nomor_surat": 114,
  "Nama_surat": "An-Nas",
  "surat_arabic": "الناس",
  "Arti_surat_in": "Umat Manusia",
  "Arti_surat_en": "The Mankind",
  "Ayat": [
    {
      "Nomor_ayat": 6231,
      "Ayat_Arabic": "قُلْ اَعُوْذُ بِرَبِّ النَّاسِۙ",
      "Text_Latin": "qul a'uzu birabbin-nas",
      "Terjemah_in": "Katakanlah (Nabi Muhammad), “Aku berlindung kepada Tuhan manusia,",
      "Terjemahan_En": "Say, “I seek refuge in the Lord of mankind.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قُلۡ",
          "Arti_kata_in": "katakanlah",
          "Arti_kata_en": "Say",
          "Text_Latin": "qul",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَعُوذُ",
          "Arti_kata_in": "aku berlindung",
          "Arti_kata_en": "I seek refuge",
          "Text_Latin": "a'udhu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِرَبِّ",
          "Arti_kata_in": "Tuhannya",
          "Arti_kata_en": "in (the) Lord",
          "Text_Latin": "birabbi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلنَّاسِ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "(of) mankind",
          "Text_Latin": "an-nasi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6232,
      "Ayat_Arabic": "مَلِكِ النَّاسِۙ",
      "Text_Latin": "malikin-nas",
      "Terjemah_in": "raja manusia,",
      "Terjemahan_En": "The King of mankind.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مَلِكِ",
          "Arti_kata_in": "Rajanya",
          "Arti_kata_en": "(The) King",
          "Text_Latin": "maliki",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلنَّاسِ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "(of) mankind",
          "Text_Latin": "an-nasi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6233,
      "Ayat_Arabic": "اِلٰهِ النَّاسِۙ",
      "Text_Latin": "ilahin-nas",
      "Terjemah_in": "sembahan manusia",
      "Terjemahan_En": "The God of mankind.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِلَٰهِ",
          "Arti_kata_in": "Tuhannya",
          "Arti_kata_en": "(The) God",
          "Text_Latin": "ilahi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلنَّاسِ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "(of) mankind",
          "Text_Latin": "an-nasi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6234,
      "Ayat_Arabic": "مِنْ شَرِّ الْوَسْوَاسِ ەۙ الْخَنَّاسِۖ",
      "Text_Latin": "min syarril-waswasil-khannas",
      "Terjemah_in": "dari kejahatan (setan) pembisik yang bersembunyi",
      "Terjemahan_En": "From the evil of the sneaky whisperer.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مِن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "From",
          "Text_Latin": "min",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَرِّ",
          "Arti_kata_in": "kejahatan",
          "Arti_kata_en": "(the) evil",
          "Text_Latin": "sharri",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡوَسۡوَاسِ",
          "Arti_kata_in": "bisikkan",
          "Arti_kata_en": "(of) the whisperer",
          "Text_Latin": "al-waswasi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡخَنَّاسِ",
          "Arti_kata_in": "menunggu-nunggu/bersembunyi",
          "Arti_kata_en": "the one who withdraws",
          "Text_Latin": "al-khanasi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6235,
      "Ayat_Arabic": "الَّذِيْ يُوَسْوِسُ فِيْ صُدُوْرِ النَّاسِۙ",
      "Text_Latin": "allazi yuwaswisu fi sudurin-nas",
      "Terjemah_in": "yang membisikkan (kejahatan) ke dalam dada manusia,",
      "Terjemahan_En": "Who whispers into the hearts of people.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "The one who",
          "Text_Latin": "alladhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يُوَسۡوِسُ",
          "Arti_kata_in": "membisik-bisikan",
          "Arti_kata_en": "whispers",
          "Text_Latin": "yuwaswisu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "صُدُورِ",
          "Arti_kata_in": "dada",
          "Arti_kata_en": "(the) breasts",
          "Text_Latin": "suduri",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلنَّاسِ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "(of) mankind",
          "Text_Latin": "an-nasi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6236,
      "Ayat_Arabic": "مِنَ الْجِنَّةِ وَالنَّاسِ ࣖ",
      "Text_Latin": "minal-jinnati wan-nas",
      "Terjemah_in": "dari (golongan) jin dan manusia.”",
      "Terjemahan_En": "From among jinn and among people.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مِنَ",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "From",
          "Text_Latin": "mina",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡجِنَّةِ",
          "Arti_kata_in": "jin",
          "Arti_kata_en": "the jinn",
          "Text_Latin": "al-jinati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَٱلنَّاسِ",
          "Arti_kata_in": "dan manusia",
          "Arti_kata_en": "and men",
          "Text_Latin": "wan-nasi",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
