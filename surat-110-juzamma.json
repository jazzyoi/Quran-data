{
  "Nomor_surat": 110,
  "Nama_surat": "An-Nashr",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Ayat_arabic ": "اِذَا جَاۤءَ نَصْرُ اللّٰهِ وَالْفَتْحُۙ",
      "Ayat_latin": "iza ja'a nasrullahi wal-fat-h",
      "Terjemah_in": "Apabila telah datang pertolongan Allah dan kemenangan",
      "Terjemah_en": "When there comes God’s victory, and conquest.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "When",
          "Text_latin  ": "idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "جَآءَ",
          "Arti_kata_in": "datang",
          "Arti_kata_en": "comes",
          "Text_latin  ": "jaa"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "نَصۡرُ",
          "Arti_kata_in": "pertolongan",
          "Arti_kata_en": "(the) Help",
          "Text_latin  ": "nasru"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱللَّهِ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "(of) Allah",
          "Text_latin  ": "al-lahi"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "وَٱلۡفَتۡحُ",
          "Arti_kata_in": "dan kemenangan",
          "Arti_kata_en": "and the Victory",
          "Text_latin  ": "wal-fathu"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Ayat_arabic ": "وَرَاَيْتَ النَّاسَ يَدْخُلُوْنَ فِيْ دِيْنِ اللّٰهِ اَفْوَاجًاۙ",
      "Ayat_latin": "wa ra'aitan-nasa yadkhuluna fi dinillahi afwaja",
      "Terjemah_in": "dan engkau melihat manusia berbondong-bondong masuk agama Allah,",
      "Terjemah_en": "And you see the people entering God’s religion in multitudes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَرَأَيۡتَ",
          "Arti_kata_in": "dan kamu lihat",
          "Arti_kata_en": "And you see",
          "Text_latin  ": "wara-ayta"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلنَّاسَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "the people",
          "Text_latin  ": "an-nasa"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "يَدۡخُلُونَ",
          "Arti_kata_in": "masuk",
          "Arti_kata_en": "entering",
          "Text_latin  ": "yadkhuluna"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "فِي",
          "Arti_kata_in": "kedalam",
          "Arti_kata_en": "into",
          "Text_latin  ": "fi"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "دِينِ",
          "Arti_kata_in": "agama",
          "Arti_kata_en": "(the) religion",
          "Text_latin  ": "dini"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "ٱللَّهِ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "(of) Allah",
          "Text_latin  ": "al-lahi"
        },
        {
          "Nomor_kata": 7,
          "Kata_arabic": "أَفۡوَاجٗا",
          "Arti_kata_in": "berbondong-bondong",
          "Arti_kata_en": "(in) multitudes",
          "Text_latin  ": "afwajan"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Ayat_arabic ": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُۗ اِنَّهٗ كَانَ تَوَّابًا ࣖ",
      "Ayat_latin": "fa sabbih bihamdi rabbika wastagfir-h, innahu kana tawwaba",
      "Terjemah_in": "bertasbihlah dengan memuji Tuhanmu dan mohonlah ampun kepada-Nya. Sesungguhnya Dia Maha Penerima tobat.",
      "Terjemah_en": "Then celebrate the praise of your Lord, and seek His forgiveness. He is the Accepter of Repentance.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَسَبِّحۡ",
          "Arti_kata_in": "maka bertasbihlah",
          "Arti_kata_en": "Then glorify",
          "Text_latin  ": "fasabbih"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "بِحَمۡدِ",
          "Arti_kata_in": "dengan memuji",
          "Arti_kata_en": "(the) praises",
          "Text_latin  ": "bihamdi"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "(of) your Lord",
          "Text_latin  ": "rabbika"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "وَٱسۡتَغۡفِرۡهُۚ",
          "Arti_kata_in": "dan mohonlah ampun",
          "Arti_kata_en": "and ask His forgiveness",
          "Text_latin  ": "wa-is'taghfir'hu"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "إِنَّهُۥ",
          "Arti_kata_in": "sesungguhnya Dia",
          "Arti_kata_en": "Indeed He",
          "Text_latin  ": "innahu"
        },
        {
          "Nomor_kata": 6,
          "Kata_arabic": "كَانَ",
          "Arti_kata_in": "adalah Dia",
          "Arti_kata_en": "is",
          "Text_latin  ": "kana"
        },
        {
          "Nomor_kata": 7,
          "Kata_arabic": "تَوَّابَۢا",
          "Arti_kata_in": "Maha Penerima Taubat",
          "Arti_kata_en": "Oft-Returning",
          "Text_latin  ": "tawwaban"
        }
      ]
    }
  ]
}