        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَعۡطَىٰ",
          "Arti_kata_in": "ia memberikan",
          "Arti_kata_en": "gives",
          "Text_Latin": "a'ta"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَٱتَّقَىٰ",
          "Arti_kata_in": "dan bertaqwa",
          "Arti_kata_en": "and fears",
