          "Arti_kata_en": "By the night",
          "Text_Latin": "wa-al-layli"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَغۡشَىٰ",
          "Arti_kata_in": "ia menutup",
          "Arti_kata_en": "it covers",
          "Text_Latin": "yaghsha"
        }
