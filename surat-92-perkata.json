          "Arti_kata_en": "the male",
          "Text_Latin": "ad-dhakara"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَٱلۡأُنثَىٰٓ",
          "Arti_kata_in": "dan perempuan",
