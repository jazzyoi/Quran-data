{
  "Nomor_surat": 111,
  "Nama_surat": "Al-Lahab",
  "surat_arabic": "اللهب",
  "Arti_surat_in": "Gejolak Api",
  "Arti_surat_en": "The Palm Fiber",
  "Ayat": [
    {
      "Nomor_ayat": 6217,
      "Ayat_Arabic": "تَبَّتْ يَدَآ اَبِيْ لَهَبٍ وَّتَبَّۗ",
      "Text_Latin": "tabbat yada abi lahabiw wa tabb",
      "Terjemah_in": "Binasalah kedua tangan Abu Lahab dan benar-benar binasa dia.763)",
      "Terjemahan_En": "Condemned are the hands of Abee Lahab, and he is condemned.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "تَبَّتۡ",
          "Arti_kata_in": "binasalah",
          "Arti_kata_en": "Perish",
          "Text_Latin": "tabbat",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَدَآ",
          "Arti_kata_in": "kedua tangan",
          "Arti_kata_en": "(the) hands",
          "Text_Latin": "yada",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَبِي",
          "Arti_kata_in": "Abu",
          "Arti_kata_en": "(of) Abu",
          "Text_Latin": "abi",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَهَبٖ",
          "Arti_kata_in": "Lahab",
          "Arti_kata_en": "Lahab",
          "Text_Latin": "lahabin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَتَبَّ",
          "Arti_kata_in": "sebenar-benar binasa",
          "Arti_kata_en": "and perish he",
          "Text_Latin": "watabba",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6218,
      "Ayat_Arabic": "مَآ اَغْنٰى عَنْهُ مَالُهٗ وَمَا كَسَبَۗ",
      "Text_Latin": "ma agna 'an-hu maluhu wa ma kasab",
      "Terjemah_in": "Tidaklah berguna baginya hartanya dan apa yang dia usahakan.",
      "Terjemahan_En": "His wealth did not avail him, nor did what he acquired.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مَآ",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "Not",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَغۡنَىٰ",
          "Arti_kata_in": "berguna",
          "Arti_kata_en": "(will) avail",
          "Text_Latin": "aghna",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَنۡهُ",
          "Arti_kata_in": "dari padanya/kepadanya",
          "Arti_kata_en": "him",
          "Text_Latin": "anhu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَالُهُۥ",
          "Arti_kata_in": "hartanya",
          "Arti_kata_en": "his wealth",
          "Text_Latin": "maluhu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَمَا",
          "Arti_kata_in": "dan apa",
          "Arti_kata_en": "and what",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "كَسَبَ",
          "Arti_kata_in": "yang ia usahakan",
          "Arti_kata_en": "he earned",
          "Text_Latin": "kasaba",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6219,
      "Ayat_Arabic": "سَيَصْلٰى نَارًا ذَاتَ لَهَبٍۙ",
      "Text_Latin": "sayasla naran zata lahab",
      "Terjemah_in": "Kelak dia akan memasuki api yang bergejolak (neraka),",
      "Terjemahan_En": "He will burn in a Flaming Fire.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "سَيَصۡلَىٰ",
          "Arti_kata_in": "kelak ia akan masuk",
          "Arti_kata_en": "He will be burnt",
          "Text_Latin": "sayasla",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَارٗا",
          "Arti_kata_in": "api",
          "Arti_kata_en": "(in) a Fire",
          "Text_Latin": "naran",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ذَاتَ",
          "Arti_kata_in": "mempunyai",
          "Arti_kata_en": "of",
          "Text_Latin": "dhata",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَهَبٖ",
          "Arti_kata_in": "begejolak",
          "Arti_kata_en": "Blazing Flames",
          "Text_Latin": "lahabin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6220,
      "Ayat_Arabic": "وَّامْرَاَتُهٗ ۗحَمَّالَةَ الْحَطَبِۚ",
      "Text_Latin": "wamra'atuh, hammalatal-hatab",
      "Terjemah_in": "(begitu pula) istrinya, pembawa kayu bakar (penyebar fitnah).",
      "Terjemahan_En": "And his wife—the firewood carrier.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱمۡرَأَتُهُۥ",
          "Arti_kata_in": "dan istrinya",
          "Arti_kata_en": "And his wife",
          "Text_Latin": "wa-im'ra-atuhu",
          "Jenis_kata": "Isim"
        },
