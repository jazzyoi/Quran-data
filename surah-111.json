          "Text_Latin": "hammalata",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡحَطَبِ",
          "Arti_kata_in": "kayu bakar",
          "Arti_kata_en": "(of) firewood",
          "Text_Latin": "al-hatabi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6221,
      "Ayat_Arabic": "فِيْ جِيْدِهَا حَبْلٌ مِّنْ مَّسَدٍ ࣖ",
      "Text_Latin": "fi jidiha hablum mim masad",
      "Terjemah_in": "Di lehernya ada tali dari sabut yang dipintal.",
      "Terjemahan_En": "Around her neck is a rope of thorns.",
