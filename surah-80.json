        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أُوْلَٰٓئِكَ",
          "Arti_kata": "mereka itulah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هُمُ",
          "Arti_kata": "mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡكَفَرَةُ",
          "Arti_kata": "orang-orang kafir",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡفَجَرَةُ",
          "Arti_kata": "durhaka",
          "Jenis_kata": null
        }
