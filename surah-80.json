          "Kata_Arabic": "مُّسۡتَبۡشِرَةٞ",
          "Arti_kata": "gembira-ria",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5798,
      "Ayat_Arabic": "وَوُجُوْهٌ يَّوْمَىِٕذٍ عَلَيْهَا غَبَرَةٌۙ",
      "Text_Latin": "wa wujuhuy yauma'izin 'alaiha gabarah",
      "Terjemah_in": "Pada hari itu ada (pula) wajah-wajah yang tertutup debu (suram)",
      "Terjemahan_En": "And Faces on that Day will be covered with misery.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَوُجُوهٞ",
          "Arti_kata": "dan wajah-wajah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمَئِذٍ",
          "Arti_kata": "pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَيۡهَا",
          "Arti_kata": "atasnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "غَبَرَةٞ",
          "Arti_kata": "tertutup debu",
          "Jenis_kata": null
        }
      ]
