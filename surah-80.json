{
  "Nomor_surat": 80,
  "Nama_surat": "'Abasa",
  "surat_arabic": "عبس",
  "Arti_surat_in": "Ia Bermuka Masam",
  "Arti_surat_en": "He Frowned",
  "Ayat": [
    {
      "Nomor_ayat": 5759,
      "Ayat_Arabic": "عَبَسَ وَتَوَلّٰىٓۙ",
      "Text_Latin": "'abasa wa tawalla",
      "Terjemah_in": "Dia (Nabi Muhammad) berwajah masam dan berpaling",
      "Terjemahan_En": "He frowned and turned away.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "عَبَسَ",
          "Arti_kata": "dia bermuka masam",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَتَوَلَّىٰٓ",
          "Arti_kata": "dan dia berpaling",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5760,
      "Ayat_Arabic": "اَنْ جَاۤءَهُ الْاَعْمٰىۗ",
      "Text_Latin": "an ja'ahul-a'ma",
      "Terjemah_in": "karena seorang tunanetra (Abdullah bin Ummi Maktum) telah datang kepadanya.",
      "Terjemahan_En": "When the blind man approached him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَن",
          "Arti_kata": "sesungguhnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "جَآءَهُ",
          "Arti_kata": "datang kepadanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡأَعۡمَىٰ",
          "Arti_kata": "seorang buta",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5761,
      "Ayat_Arabic": "وَمَا يُدْرِيْكَ لَعَلَّهٗ يَزَّكّٰىٓۙ",
      "Text_Latin": "wa ma yudrika la'allahu yazzakka",
      "Terjemah_in": "Tahukah engkau (Nabi Muhammad) boleh jadi dia ingin menyucikan dirinya (dari dosa)",
      "Terjemahan_En": "But how do you know? Perhaps he was seeking to purify himself.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَا",
          "Arti_kata": "dan apakah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يُدۡرِيكَ",
          "Arti_kata": "tahukah kamu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَعَلَّهُۥ",
          "Arti_kata": "barangkali dia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَزَّكَّىٰٓ",
          "Arti_kata": "ia membersihkan diri",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5762,
      "Ayat_Arabic": "اَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰىۗ",
      "Text_Latin": "au yazzakkaru fa tanfa'ahuz-zikra",
      "Terjemah_in": "atau dia (ingin) mendapatkan pengajaran sehingga pengajaran itu bermanfaat baginya?",
      "Terjemahan_En": "Or be reminded, and the message would benefit him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَوۡ",
          "Arti_kata": "atau",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَذَّكَّرُ",
          "Arti_kata": "ia mendapatkan pengajaran",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَتَنفَعَهُ",
          "Arti_kata": "lalu memberi manfaat kepadanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلذِّكۡرَىٰٓ",
          "Arti_kata": "pengajaran",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5763,
      "Ayat_Arabic": "اَمَّا مَنِ اسْتَغْنٰىۙ",
      "Text_Latin": "amma manistagna",
      "Terjemah_in": "Adapun orang yang merasa dirinya serba cukup (para pembesar Quraisy),",
      "Terjemahan_En": "But as for him who was indifferent.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَمَّا",
          "Arti_kata": "adapun",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَنِ",
          "Arti_kata": "siapa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱسۡتَغۡنَىٰ",
          "Arti_kata": "merasa kaya/cukup",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5764,
      "Ayat_Arabic": "فَاَنْتَ لَهٗ تَصَدّٰىۗ",
      "Text_Latin": "fa anta lahu tasadda",
      "Terjemah_in": "engkau (Nabi Muhammad) memberi perhatian kepadanya.",
      "Terjemahan_En": "You gave him your attention.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَنتَ",
          "Arti_kata": "maka kamu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَهُۥ",
          "Arti_kata": "kepadanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "تَصَدَّىٰ",
          "Arti_kata": "menghadapi/layani",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5765,
      "Ayat_Arabic": "وَمَا عَلَيْكَ اَلَّا يَزَّكّٰىۗ",
      "Text_Latin": "wa ma 'alaika alla yazzakka",
      "Terjemah_in": "Padahal, tidak ada (cela) atasmu kalau dia tidak menyucikan diri (beriman).",
      "Terjemahan_En": "Though you are not liable if he does not purify himself.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَا",
          "Arti_kata": "dan tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَلَيۡكَ",
          "Arti_kata": "atasmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَلَّا",
          "Arti_kata": "bahwa tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَزَّكَّىٰ",
          "Arti_kata": "ia membersihkan diri",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5766,
      "Ayat_Arabic": "وَاَمَّا مَنْ جَاۤءَكَ يَسْعٰىۙ",
      "Text_Latin": "wa amma man ja'aka yas'a",
      "Terjemah_in": "Adapun orang yang datang kepadamu dengan bersegera (untuk mendapatkan pengajaran),",
      "Terjemahan_En": "But as for him who came to you seeking.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَمَّا",
          "Arti_kata": "dan adapun",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَن",
          "Arti_kata": "siapa/orang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "جَآءَكَ",
          "Arti_kata": "datang kapadamu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَسۡعَىٰ",
          "Arti_kata": "berjalan/bersegera",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5767,
      "Ayat_Arabic": "وَهُوَ يَخْشٰىۙ",
      "Text_Latin": "wa huwa yakhsya",
      "Terjemah_in": "sedangkan dia takut (kepada Allah),",
      "Terjemahan_En": "In awe.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَهُوَ",
          "Arti_kata": "dan dia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَخۡشَىٰ",
          "Arti_kata": "ia takut",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5768,
      "Ayat_Arabic": "فَاَنْتَ عَنْهُ تَلَهّٰىۚ",
      "Text_Latin": "fa anta 'an-hu talahha",
      "Terjemah_in": "malah engkau (Nabi Muhammad) abaikan.",
      "Terjemahan_En": "To him you were inattentive.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَنتَ",
          "Arti_kata": "maka kamu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَنۡهُ",
          "Arti_kata": "dari padanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "تَلَهَّىٰ",
          "Arti_kata": "kamu mengabaikannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5769,
      "Ayat_Arabic": "كَلَّآ اِنَّهَا تَذْكِرَةٌ ۚ",
      "Text_Latin": "kalla innaha tazkirah",
      "Terjemah_in": "Sekali-kali jangan (begitu)! Sesungguhnya (ajaran Allah) itu merupakan peringatan.",
      "Terjemahan_En": "Do not. This is a Lesson.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّآ",
          "Arti_kata": "sekali-kali jangan/tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِنَّهَا",
          "Arti_kata": "sesungguhnya ia/itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "تَذۡكِرَةٞ",
          "Arti_kata": "peringatan/pengajaran",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5770,
      "Ayat_Arabic": "فَمَنْ شَاۤءَ ذَكَرَهٗ ۘ",
      "Text_Latin": "fa man sya'a zakarah",
      "Terjemah_in": "Siapa yang menghendaki tentulah akan memperhatikannya",
      "Terjemahan_En": "Whoever wills, shall remember it.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَمَن",
          "Arti_kata": "maka barang siapa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَآءَ",
          "Arti_kata": "ia menghendaki",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ذَكَرَهُۥ",
          "Arti_kata": "ia mengingat/memperhatikannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5771,
      "Ayat_Arabic": "فِيْ صُحُفٍ مُّكَرَّمَةٍۙ",
      "Text_Latin": "fi suhufim mukarramah",
      "Terjemah_in": "di dalam suhuf yang dimuliakan (di sisi Allah),",
      "Terjemahan_En": "On honorable pages.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فِي",
          "Arti_kata": "dalam",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "صُحُفٖ",
          "Arti_kata": "lembaran-lembaran",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مُّكَرَّمَةٖ",
          "Arti_kata": "dimuliakan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5772,
      "Ayat_Arabic": "مَّرْفُوْعَةٍ مُّطَهَّرَةٍ ۢ ۙ",
      "Text_Latin": "marfu'atim mutahharah",
      "Terjemah_in": "yang ditinggikan (kedudukannya) lagi disucikan",
      "Terjemahan_En": "Exalted and purified.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مَّرۡفُوعَةٖ",
          "Arti_kata": "ditinggikan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مُّطَهَّرَةِۭ",
          "Arti_kata": "disucikan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5773,
      "Ayat_Arabic": "بِاَيْدِيْ سَفَرَةٍۙ",
      "Text_Latin": "bi'aidi safarah",
      "Terjemah_in": "di tangan para utusan (malaikat)",
      "Terjemahan_En": "By the hands of scribes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "بِأَيۡدِي",
          "Arti_kata": "di tangan-tangan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "سَفَرَةٖ",
          "Arti_kata": "para utusan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5774,
      "Ayat_Arabic": "كِرَامٍۢ بَرَرَةٍۗ",
      "Text_Latin": "kiramim bararah",
      "Terjemah_in": "yang mulia lagi berbudi.",
      "Terjemahan_En": "Noble and devoted.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كِرَامِۭ",
          "Arti_kata": "yang mulia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بَرَرَةٖ",
          "Arti_kata": "yang berbakti",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5775,
      "Ayat_Arabic": "قُتِلَ الْاِنْسَانُ مَآ اَكْفَرَهٗۗ",
      "Text_Latin": "qutilal-insanu ma akfarah",
      "Terjemah_in": "Celakalah manusia! Alangkah kufur dia!",
      "Terjemahan_En": "Perish man! How thankless he is!",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "قُتِلَ",
          "Arti_kata": "dibunuh/binasa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَآ",
          "Arti_kata": "apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَكۡفَرَهُۥ",
          "Arti_kata": "kekafirannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5776,
      "Ayat_Arabic": "مِنْ اَيِّ شَيْءٍ خَلَقَهٗۗ",
      "Text_Latin": "min ayyi syai'in khalaqah",
      "Terjemah_in": "Dari apakah Dia menciptakannya?",
      "Terjemahan_En": "From what did He create him?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مِنۡ",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَيِّ",
          "Arti_kata": "apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "شَيۡءٍ",
          "Arti_kata": "sesuatu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "خَلَقَهُۥ",
          "Arti_kata": "Dia menciptakannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5777,
      "Ayat_Arabic": "مِنْ نُّطْفَةٍۗ خَلَقَهٗ فَقَدَّرَهٗۗ",
      "Text_Latin": "min nutfah, khalaqahu fa qaddarah",
      "Terjemah_in": "Dia menciptakannya dari setetes mani, lalu menentukan (takdir)-nya.",
      "Terjemahan_En": "From a sperm drop He created him, and enabled him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مِن",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نُّطۡفَةٍ",
          "Arti_kata": "setetes mani",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "خَلَقَهُۥ",
          "Arti_kata": "Dia menciptakannya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فَقَدَّرَهُۥ",
          "Arti_kata": "lalu Dia menentukannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5778,
      "Ayat_Arabic": "ثُمَّ السَّبِيْلَ يَسَّرَهٗۙ",
      "Text_Latin": "summas-sabila yassarah",
      "Terjemah_in": "Kemudian, jalannya Dia mudahkan.746)",
      "Terjemahan_En": "Then He eased the way for him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ثُمَّ",
          "Arti_kata": "kemudian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلسَّبِيلَ",
          "Arti_kata": "jalan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَسَّرَهُۥ",
          "Arti_kata": "Dia memudahkannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5779,
      "Ayat_Arabic": "ثُمَّ اَمَاتَهٗ فَاَقْبَرَهٗۙ",
      "Text_Latin": "summa amatahu fa aqbarah",
      "Terjemah_in": "Kemudian, Dia mematikannya lalu menguburkannya.",
      "Terjemahan_En": "Then He puts him to death, and buries him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ثُمَّ",
          "Arti_kata": "kemudian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَمَاتَهُۥ",
          "Arti_kata": "Dia mematikannya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فَأَقۡبَرَهُۥ",
          "Arti_kata": "lalu Dia memasukkannya dalam kubur",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5780,
      "Ayat_Arabic": "ثُمَّ اِذَا شَاۤءَ اَنْشَرَهٗۗ",
      "Text_Latin": "summa iza sya'a ansyarah",
      "Terjemah_in": "Kemudian, jika menghendaki, Dia membangkitkannya kembali.",
      "Terjemahan_En": "Then, when He wills, He will resurrect him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ثُمَّ",
          "Arti_kata": "kemudian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata": "apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "شَآءَ",
          "Arti_kata": "Dia menghendaki",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَنشَرَهُۥ",
          "Arti_kata": "Dia membangkitkan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5781,
      "Ayat_Arabic": "كَلَّا لَمَّا يَقْضِ مَآ اَمَرَهٗۗ",
      "Text_Latin": "kalla lamma yaqdi ma amarah",
      "Terjemah_in": "Sekali-kali jangan (begitu)! Dia (manusia) itu belum melaksanakan apa yang Dia (Allah) perintahkan kepadanya.",
      "Terjemahan_En": "But no, he did not fulfill what He has commanded him.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّا",
          "Arti_kata": "sekali-kali jangan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَمَّا",
          "Arti_kata": "belum",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَقۡضِ",
          "Arti_kata": "ia melaksanakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَآ",
          "Arti_kata": "apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَمَرَهُۥ",
          "Arti_kata": "Dia perintahkan kepadanya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5782,
      "Ayat_Arabic": "فَلْيَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖٓ ۙ",
      "Text_Latin": "falyanzuril-insanu ila ta'amih",
      "Terjemah_in": "Maka, hendaklah manusia itu memperhatikan makanannya.",
      "Terjemahan_En": "Let man consider his food.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَلۡيَنظُرِ",
          "Arti_kata": "maka hendaklah ia memperhatikan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "إِلَىٰ",
          "Arti_kata": "kepada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "طَعَامِهِۦٓ",
          "Arti_kata": "makanannya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5783,
      "Ayat_Arabic": "اَنَّا صَبَبْنَا الْمَاۤءَ صَبًّاۙ",
      "Text_Latin": "anna sababnal-ma'a sabba",
      "Terjemah_in": "Sesungguhnya Kami telah mencurahkan air (dari langit) dengan berlimpah.",
      "Terjemahan_En": "We pour down water in abundance.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَنَّا",
          "Arti_kata": "sesungguhnya kami",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "صَبَبۡنَا",
          "Arti_kata": "Kami telah mencurahkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡمَآءَ",
          "Arti_kata": "air",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "صَبّٗا",
          "Arti_kata": "tercurah",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5784,
      "Ayat_Arabic": "ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّاۙ",
      "Text_Latin": "summa syaqaqnal-arda syaqqa",
      "Terjemah_in": "Kemudian, Kami belah bumi dengan sebaik-baiknya.",
      "Terjemahan_En": "Then crack the soil open.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ثُمَّ",
          "Arti_kata": "kemudian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "شَقَقۡنَا",
          "Arti_kata": "Kami belah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡأَرۡضَ",
          "Arti_kata": "bumi",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "شَقّٗا",
          "Arti_kata": "belahan (sebaik-baiknya)",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5785,
      "Ayat_Arabic": "فَاَنْۢبَتْنَا فِيْهَا حَبًّاۙ",
      "Text_Latin": "fa ambatna fiha habba",
      "Terjemah_in": "Lalu, Kami tumbuhkan padanya biji-bijian,",
      "Terjemahan_En": "And grow in it grains.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَنۢبَتۡنَا",
          "Arti_kata": "lalu Kami tumbuhkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فِيهَا",
          "Arti_kata": "padanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "حَبّٗا",
          "Arti_kata": "biji-bijian",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5786,
      "Ayat_Arabic": "وَّعِنَبًا وَّقَضْبًاۙ",
