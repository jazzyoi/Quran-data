          "Nomor_kata": 1,
          "Kata_Arabic": "تَرۡهَقُهَا",
          "Arti_kata": "menutupinya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "قَتَرَةٌ",
          "Arti_kata": "kegelapan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5800,
      "Ayat_Arabic": "اُولٰۤىِٕكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ ࣖ",
      "Text_Latin": "ula'ika humul-kafaratul-fajarah",
      "Terjemah_in": "Mereka itulah orang-orang kafir lagi para pendurhaka.",
