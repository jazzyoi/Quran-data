          "Nomor_kata": 1,
          "Kata_Arabic": "وَأُمِّهِۦ",
          "Arti_kata": "dan ibunya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَأَبِيهِ",
          "Arti_kata": "dan bapaknya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5794,
      "Ayat_Arabic": "وَصَاحِبَتِهٖ وَبَنِيْهِۗ",
      "Text_Latin": "wa sahibatihi wa banih",
      "Terjemah_in": "serta (dari) istri dan anak-anaknya.",
