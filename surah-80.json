          "Nomor_kata": 2,
          "Kata_Arabic": "وَبَنِيهِ",
          "Arti_kata": "dan anak-anaknya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5795,
      "Ayat_Arabic": "لِكُلِّ امْرِئٍ مِّنْهُمْ يَوْمَىِٕذٍ شَأْنٌ يُّغْنِيْهِۗ",
      "Text_Latin": "likullimri'im min-hum yauma'izin sya'nuy yugnih",
      "Terjemah_in": "Setiap orang dari mereka pada hari itu mempunyai urusan yang menyibukkannya.",
      "Terjemahan_En": "Every one of them, on that Day, will have enough to preoccupy him.",
      "Kata": [
