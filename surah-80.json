          "Nomor_kata": 6,
          "Kata_Arabic": "يُغۡنِيهِ",
          "Arti_kata": "menyibukkan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5796,
      "Ayat_Arabic": "وُجُوْهٌ يَّوْمَىِٕذٍ مُّسْفِرَةٌۙ",
      "Text_Latin": "wujuhuy yauma'izim musfirah",
      "Terjemah_in": "Pada hari itu ada wajah-wajah yang berseri-seri,",
      "Terjemahan_En": "Faces on that Day will be radiant.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وُجُوهٞ",
          "Arti_kata": "wajah-wajah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمَئِذٖ",
          "Arti_kata": "pada hari itu",
