          "Kata_Arabic": "يَوۡمَئِذٖ",
          "Arti_kata": "pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "شَأۡنٞ",
          "Arti_kata": "urusan",
          "Jenis_kata": null
        },
