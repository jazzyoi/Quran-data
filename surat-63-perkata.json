{
  "Nomor_surat": 63,
  "Nama_surat": "Al-Munafiqun",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila/tatkala",
          "Arti_kata_en": "When",
          "Text_Latin": "idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "جَآءَكَ",
          "Arti_kata_in": "datang kepadamu",
          "Arti_kata_en": "come to you",
          "Text_Latin": "jaaka"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡمُنَٰفِقُونَ",
          "Arti_kata_in": "orang-orang munafik",
          "Arti_kata_en": "the hypocrites",
          "Text_Latin": "al-munafiquna"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "قَالُواْ",
          "Arti_kata_in": "mereka berkata",
          "Arti_kata_en": "they say",
          "Text_Latin": "qalu"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "نَشۡهَدُ",
          "Arti_kata_in": "kami menyaksikan/mengetahui",
          "Arti_kata_en": "We testify",
          "Text_Latin": "nashhadu"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "إِنَّكَ",
          "Arti_kata_in": "sesungguhnya kamu",
          "Arti_kata_en": "that you",
          "Text_Latin": "innaka"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "لَرَسُولُ",
          "Arti_kata_in": "benar-benar Rasul",
          "Arti_kata_en": "(are) surely (the) Messenger",
          "Text_Latin": "larasulu"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "ٱللَّهِۗ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "(of) Allah",
          "Text_Latin": "al-lahi"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "وَٱللَّهُ",
          "Arti_kata_in": "dan Allah",
          "Arti_kata_en": "And Allah",
          "Text_Latin": "wal-lahu"
        },
        {
          "Nomor_kata": 10,
          "Kata_Arabic": "يَعۡلَمُ",
          "Arti_kata_in": "mengetahui",
          "Arti_kata_en": "knows",
          "Text_Latin": "ya'lamu"
        },
        {
          "Nomor_kata": 11,
          "Kata_Arabic": "إِنَّكَ",
          "Arti_kata_in": "sesungguhnya kamu",
          "Arti_kata_en": "that you",
          "Text_Latin": "innaka"
        },
        {
          "Nomor_kata": 12,
          "Kata_Arabic": "لَرَسُولُهُۥ",
          "Arti_kata_in": "benar-benar rasul-Nya",
          "Arti_kata_en": "(are) surely His Messenger",
          "Text_Latin": "larasuluhu"
        },
        {
          "Nomor_kata": 13,
          "Kata_Arabic": "وَٱللَّهُ",
          "Arti_kata_in": "dan Allah",
          "Arti_kata_en": "and Allah",
          "Text_Latin": "wal-lahu"
        },
        {
          "Nomor_kata": 14,
          "Kata_Arabic": "يَشۡهَدُ",
          "Arti_kata_in": "menyaksikan",
          "Arti_kata_en": "testifies",
          "Text_Latin": "yashhadu"
        },
        {
          "Nomor_kata": 15,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "that",
          "Text_Latin": "inna"
        },
        {
          "Nomor_kata": 16,
          "Kata_Arabic": "ٱلۡمُنَٰفِقِينَ",
          "Arti_kata_in": "orang-orang munafik",
          "Arti_kata_en": "the hypocrites",
          "Text_Latin": "al-munafiqina"
        },
        {
          "Nomor_kata": 17,
          "Kata_Arabic": "لَكَٰذِبُونَ",
          "Arti_kata_in": "benar-benar pendusta",
          "Arti_kata_en": "(are) surely liars",
          "Text_Latin": "lakadhibuna"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱتَّخَذُوٓاْ",
          "Arti_kata_in": "mereka mengambil/menjadikan",
          "Arti_kata_en": "They take",
          "Text_Latin": "ittakhadhu"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَيۡمَٰنَهُمۡ",
          "Arti_kata_in": "sumpah mereka",
          "Arti_kata_en": "their oaths",
          "Text_Latin": "aymanahum"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "جُنَّةٗ",
          "Arti_kata_in": "tameng/perisai",
          "Arti_kata_en": "(as) a cover",
          "Text_Latin": "junnatan"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فَصَدُّواْ",
          "Arti_kata_in": "lalu mereka menghalangi",
          "Arti_kata_en": "so they turn away",
          "Text_Latin": "fasaddu"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "عَن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "from",
          "Text_Latin": "an"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "سَبِيلِ",
          "Arti_kata_in": "jalan",
          "Arti_kata_en": "(the) Way",
          "Text_Latin": "sabili"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "ٱللَّهِۚ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "(of) Allah",
          "Text_Latin": "al-lahi"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "إِنَّهُمۡ",
          "Arti_kata_in": "sesungguhnya mereka",
          "Arti_kata_en": "Indeed",
          "Text_Latin": "innahum"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "سَآءَ",
          "Arti_kata_in": "amat buruk",
          "Arti_kata_en": "evil is",
          "Text_Latin": "saa"
        },
        {
          "Nomor_kata": 10,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma"
        },
        {
          "Nomor_kata": 11,
          "Kata_Arabic": "كَانُواْ",
          "Arti_kata_in": "mereka adalah",
          "Arti_kata_en": "they used (to)",
          "Text_Latin": "kanu"
        },
        {
          "Nomor_kata": 12,
          "Kata_Arabic": "يَعۡمَلُونَ",
          "Arti_kata_in": "mereka kerjakan",
          "Arti_kata_en": "do",
          "Text_Latin": "ya'maluna"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ذَٰلِكَ",
          "Arti_kata_in": "demikian itu",
          "Arti_kata_en": "That",
          "Text_Latin": "dhalika"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بِأَنَّهُمۡ",
          "Arti_kata_in": "karena sesungguhnya mereka",
          "Arti_kata_en": "(is) because",
          "Text_Latin": "bi-annahum"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ءَامَنُواْ",
          "Arti_kata_in": "mereka beriman",
          "Arti_kata_en": "they believed",
          "Text_Latin": "amanu"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ثُمَّ",
          "Arti_kata_in": "kamudian",
          "Arti_kata_en": "then",
          "Text_Latin": "thumma"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "كَفَرُواْ",
          "Arti_kata_in": "kafir/ingkar",
          "Arti_kata_en": "they disbelieved;",
          "Text_Latin": "kafaru"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "فَطُبِعَ",
          "Arti_kata_in": "lalu dikunci mati",
          "Arti_kata_en": "so were sealed",
          "Text_Latin": "fatubi'a"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "عَلَىٰ",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "[upon]",
          "Text_Latin": "ala"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "قُلُوبِهِمۡ",
          "Arti_kata_in": "hati-hati mereka",
          "Arti_kata_en": "their hearts",
          "Text_Latin": "qulubihim"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "فَهُمۡ",
          "Arti_kata_in": "maka mereka",
          "Arti_kata_en": "so they",
          "Text_Latin": "fahum"
        },
        {
          "Nomor_kata": 10,
          "Kata_Arabic": "لَا",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "(do) not",
          "Text_Latin": "la"
        },
        {
          "Nomor_kata": 11,
          "Kata_Arabic": "يَفۡقَهُونَ",
          "Arti_kata_in": "mengerti",
          "Arti_kata_en": "understand",
          "Text_Latin": "yafqahuna"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "۞وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَأَيۡتَهُمۡ",
          "Arti_kata_in": "kamu melihat mereka",
          "Arti_kata_en": "you see them",
          "Text_Latin": "ra-aytahum"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "تُعۡجِبُكَ",
          "Arti_kata_in": "kamu kagum/tertarik",
          "Arti_kata_en": "pleases you",
          "Text_Latin": "tu'jibuka"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَجۡسَامُهُمۡۖ",
          "Arti_kata_in": "tubuh-tubuh mereka",
          "Arti_kata_en": "their bodies",
          "Text_Latin": "ajsamuhum"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَإِن",
          "Arti_kata_in": "dan jika",
          "Arti_kata_en": "and if",
          "Text_Latin": "wa-in"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "يَقُولُواْ",
          "Arti_kata_in": "mereka berkata",
          "Arti_kata_en": "they speak",
          "Text_Latin": "yaqulu"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "تَسۡمَعۡ",
          "Arti_kata_in": "kamu mendengarkan",
          "Arti_kata_en": "you listen",
          "Text_Latin": "tasma'"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "لِقَوۡلِهِمۡۖ",
          "Arti_kata_in": "pada perkataan mereka",
          "Arti_kata_en": "to their speech",
          "Text_Latin": "liqawlihim"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "كَأَنَّهُمۡ",
          "Arti_kata_in": "seakan-akan mereka",
          "Arti_kata_en": "as if they (were)",
          "Text_Latin": "ka-annahum"
        },
        {
          "Nomor_kata": 10,
          "Kata_Arabic": "خُشُبٞ",
          "Arti_kata_in": "kayu",
          "Arti_kata_en": "pieces of wood",
          "Text_Latin": "khushubun"
        },
        {
          "Nomor_kata": 11,
          "Kata_Arabic": "مُّسَنَّدَةٞۖ",
          "Arti_kata_in": "tersandar",
          "Arti_kata_en": "propped up",
          "Text_Latin": "musannadatun"
        },
        {
          "Nomor_kata": 12,
          "Kata_Arabic": "يَحۡسَبُونَ",
          "Arti_kata_in": "mereka mengira",
          "Arti_kata_en": "They think",
          "Text_Latin": "yahsabuna"
        },
        {
          "Nomor_kata": 13,
          "Kata_Arabic": "كُلَّ",
          "Arti_kata_in": "tiap-tiap",
          "Arti_kata_en": "every",
          "Text_Latin": "kulla"
        },
        {
          "Nomor_kata": 14,
          "Kata_Arabic": "صَيۡحَةٍ",
          "Arti_kata_in": "teriakan keras",
          "Arti_kata_en": "shout",
          "Text_Latin": "sayhatin"
        },
        {
          "Nomor_kata": 15,
          "Kata_Arabic": "عَلَيۡهِمۡۚ",
          "Arti_kata_in": "atas mereka",
          "Arti_kata_en": "(is) against them",
          "Text_Latin": "alayhim"
        },
        {
          "Nomor_kata": 16,
          "Kata_Arabic": "هُمُ",
          "Arti_kata_in": "mereka",
          "Arti_kata_en": "They",
          "Text_Latin": "humu"
        },
        {
          "Nomor_kata": 17,
          "Kata_Arabic": "ٱلۡعَدُوُّ",
          "Arti_kata_in": "musuh",
          "Arti_kata_en": "(are) the enemy",
          "Text_Latin": "al-'aduwu"
        },
        {
          "Nomor_kata": 18,
          "Kata_Arabic": "فَٱحۡذَرۡهُمۡۚ",
          "Arti_kata_in": "maka takutlah/waspadalah terhadap mereka",
          "Arti_kata_en": "so beware of them",
          "Text_Latin": "fa-ih'dharhum"
        },
        {
          "Nomor_kata": 19,
          "Kata_Arabic": "قَٰتَلَهُمُ",
          "Arti_kata_in": "membunuh/membinasakan mereka",
          "Arti_kata_en": "May destroy them",
          "Text_Latin": "qatalahumu"
        },
        {
          "Nomor_kata": 20,
          "Kata_Arabic": "ٱللَّهُۖ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "Allah",
          "Text_Latin": "al-lahu"
        },
        {
          "Nomor_kata": 21,
          "Kata_Arabic": "أَنَّىٰ",
          "Arti_kata_in": "bagaimana",
          "Arti_kata_en": "How",
          "Text_Latin": "anna"
        },
        {
          "Nomor_kata": 22,
          "Kata_Arabic": "يُؤۡفَكُونَ",
          "Arti_kata_in": "mereka dipalingkan",
          "Arti_kata_en": "are they deluded",
          "Text_Latin": "yu'fakuna"
        }
      ]
    },
    {
      "Nomor_ayat": 5,
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata_in": "dan apabila",
          "Arti_kata_en": "And when",
          "Text_Latin": "wa-idha"
        },
