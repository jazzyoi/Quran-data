          "Kata_Arabic": "لَهُمۡ",
          "Arti_kata_in": "bagi mereka",
          "Arti_kata_en": "for them",
          "Text_Latin": "lahum"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَمۡ",
          "Arti_kata_in": "atau",
          "Arti_kata_en": "or",
          "Text_Latin": "am"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "لَمۡ",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "(do) not",
          "Text_Latin": "lam"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "تَسۡتَغۡفِرۡ",
          "Arti_kata_in": "kamu mohonkan ampunan",
          "Arti_kata_en": "ask forgiveness",
          "Text_Latin": "tastaghfir"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "لَهُمۡ",
          "Arti_kata_in": "bagi mereka",
          "Arti_kata_en": "for them",
          "Text_Latin": "lahum"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "لَن",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "Never",
          "Text_Latin": "lan"
        },
        {
          "Nomor_kata": 10,
          "Kata_Arabic": "يَغۡفِرَ",
          "Arti_kata_in": "akan mengampuni",
          "Arti_kata_en": "will forgive",
          "Text_Latin": "yaghfira"
