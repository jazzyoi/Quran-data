          "Kata_Arabic": "يَسۡتَغۡفِرۡ",
          "Arti_kata_in": "memohonkan ampunan",
          "Arti_kata_en": "will ask forgiveness",
          "Text_Latin": "yastaghfir"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "لَكُمۡ",
          "Arti_kata_in": "bagi kalian",
          "Arti_kata_en": "for you",
          "Text_Latin": "lakum"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "رَسُولُ",
          "Arti_kata_in": "rasul",
          "Arti_kata_en": "(the) Messenger",
          "Text_Latin": "rasulu"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "ٱللَّهِ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "(of) Allah",
          "Text_Latin": "al-lahi"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "لَوَّوۡاْ",
          "Arti_kata_in": "mereka memalingkan",
          "Arti_kata_en": "They turn aside",
          "Text_Latin": "lawwaw"
