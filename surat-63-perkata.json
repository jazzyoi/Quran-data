          "Arti_kata_en": "to them",
          "Text_Latin": "lahum"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "تَعَالَوۡاْ",
          "Arti_kata_in": "marilah",
          "Arti_kata_en": "Come",
          "Text_Latin": "ta'alaw"
        },
        {
