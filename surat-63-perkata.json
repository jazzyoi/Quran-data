        {
          "Nomor_kata": 10,
          "Kata_Arabic": "رُءُوسَهُمۡ",
          "Arti_kata_in": "kepala mereka",
          "Arti_kata_en": "their heads",
          "Text_Latin": "ruusahum"
        },
        {
          "Nomor_kata": 11,
          "Kata_Arabic": "وَرَأَيۡتَهُمۡ",
          "Arti_kata_in": "dan kamu lihat mereka",
          "Arti_kata_en": "and you see them",
          "Text_Latin": "wara-aytahum"
        },
        {
          "Nomor_kata": 12,
          "Kata_Arabic": "يَصُدُّونَ",
          "Arti_kata_in": "mereka berpaling",
          "Arti_kata_en": "turning away",
          "Text_Latin": "yasudduna"
        },
        {
          "Nomor_kata": 13,
          "Kata_Arabic": "وَهُم",
          "Arti_kata_in": "dan mereka",
          "Arti_kata_en": "while they",
          "Text_Latin": "wahum"
        },
        {
          "Nomor_kata": 14,
          "Kata_Arabic": "مُّسۡتَكۡبِرُونَ",
          "Arti_kata_in": "menyombongkan",
          "Arti_kata_en": "(are) arrogant",
          "Text_Latin": "mus'takbiruna"
        }
      ]
    },
