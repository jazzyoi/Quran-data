{
  "Nomor_surat": 104,
  "Nama_surat": "Al-Humazah",
  "surat_arabic": "الهمزة",
  "Arti_surat_in": "Pengumpat",
  "Arti_surat_en": "The Slanderer",
  "Ayat": [
    {
      "Nomor_ayat": 6180,
      "Ayat_Arabic": "وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةٍۙ",
      "Text_Latin": "wailul likulli humazatil lumazah",
      "Terjemah_in": "Celakalah setiap pengumpat lagi pencela",
      "Terjemahan_En": "Woe to every slanderer backbiter.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَيۡلٞ",
          "Arti_kata_in": "kecelakaan",
          "Arti_kata_en": "Woe",
          "Text_Latin": "waylun",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لِّكُلِّ",
          "Arti_kata_in": "bagi setiap",
          "Arti_kata_en": "to every",
          "Text_Latin": "likulli",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "هُمَزَةٖ",
          "Arti_kata_in": "pengumpat",
          "Arti_kata_en": "slanderer",
          "Text_Latin": "humazatin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لُّمَزَةٍ",
          "Arti_kata_in": "pencela",
          "Arti_kata_en": "backbiter!",
          "Text_Latin": "lumazatin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6181,
      "Ayat_Arabic": "ۨالَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗۙ",
      "Text_Latin": "allazi jama'a malaw wa 'addadah",
      "Terjemah_in": "yang mengumpulkan harta dan menghitung-hitungnya.",
      "Terjemahan_En": "Who gathers wealth and counts it over.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "The one who",
          "Text_Latin": "alladhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "جَمَعَ",
          "Arti_kata_in": "mengumpulkan",
          "Arti_kata_en": "collects",
          "Text_Latin": "jama'a",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَالٗا",
          "Arti_kata_in": "harta",
          "Arti_kata_en": "wealth",
          "Text_Latin": "malan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَعَدَّدَهُۥ",
          "Arti_kata_in": "dan dia menghitungnya",
          "Arti_kata_en": "and counts it",
          "Text_Latin": "wa'addadahu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6182,
      "Ayat_Arabic": "يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗۚ",
      "Text_Latin": "yahsabu anna malahu akhladah",
      "Terjemah_in": "Dia (manusia) mengira bahwa hartanya dapat mengekalkannya.",
      "Terjemahan_En": "Thinking that his wealth has made him immortal.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَحۡسَبُ",
          "Arti_kata_in": "dia mengira",
          "Arti_kata_en": "Thinking",
          "Text_Latin": "yahsabu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَنَّ",
          "Arti_kata_in": "bahwasanya",
          "Arti_kata_en": "that",
          "Text_Latin": "anna",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَالَهُۥٓ",
          "Arti_kata_in": "hartanya",
          "Arti_kata_en": "his wealth",
          "Text_Latin": "malahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَخۡلَدَهُۥ",
          "Arti_kata_in": "mengekalkannya",
          "Arti_kata_en": "will make him immortal",
          "Text_Latin": "akhladahu",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6183,
      "Ayat_Arabic": "كَلَّا لَيُنْۢبَذَنَّ فِى الْحُطَمَةِۖ",
      "Text_Latin": "kalla layumbazanna fil-hutamah",
      "Terjemah_in": "Sekali-kali tidak! Pasti dia akan dilemparkan ke dalam (neraka) Hutamah.",
      "Terjemahan_En": "By no means. He will be thrown into the Crusher.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّاۖ",
          "Arti_kata_in": "sekali-kali tidak",
          "Arti_kata_en": "Nay!",
          "Text_Latin": "kalla",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَيُنۢبَذَنَّ",
          "Arti_kata_in": "sungguh dia akan dilemparkan",
          "Arti_kata_en": "Surely he will be thrown",
          "Text_Latin": "layunbadhanna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡحُطَمَةِ",
          "Arti_kata_in": "Hutamah",
          "Arti_kata_en": "the Crusher",
          "Text_Latin": "al-hutamati",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6184,
      "Ayat_Arabic": "وَمَآ اَدْرٰىكَ مَا الْحُطَمَةُ ۗ",
      "Text_Latin": "wa ma adraka mal-hutamah",
      "Terjemah_in": "Tahukah kamu apakah (neraka) Hutamah?",
      "Terjemahan_En": "And what will make you realize what the Crusher is?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَآ",
          "Arti_kata_in": "dan apakah",
          "Arti_kata_en": "And what",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَدۡرَىٰكَ",
          "Arti_kata_in": "kamu tahu",
          "Arti_kata_en": "will make you know",
          "Text_Latin": "adraka",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡحُطَمَةُ",
          "Arti_kata_in": "Hutamah",
          "Arti_kata_en": "the Crusher (is)",
          "Text_Latin": "al-hutamatu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6185,
      "Ayat_Arabic": "نَارُ اللّٰهِ الْمُوْقَدَةُۙ",
      "Text_Latin": "narullahil-muqadah",
      "Terjemah_in": "(Ia adalah) api (azab) Allah yang dinyalakan",
      "Terjemahan_En": "God's kindled Fire.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "نَارُ",
          "Arti_kata_in": "api",
          "Arti_kata_en": "A Fire",
          "Text_Latin": "naru",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱللَّهِ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "Allah",
          "Text_Latin": "al-lahi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡمُوقَدَةُ",
          "Arti_kata_in": "dinyalakan",
          "Arti_kata_en": "kindled",
          "Text_Latin": "al-muqadatu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6186,
      "Ayat_Arabic": "الَّتِيْ تَطَّلِعُ عَلَى الْاَفْـِٕدَةِۗ",
      "Text_Latin": "allati tattali'u 'alal-af'idah",
      "Terjemah_in": "yang (membakar) naik sampai ke hati.",
      "Terjemahan_En": "That laps to the hearts.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّتِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "Which",
          "Text_Latin": "allati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تَطَّلِعُ",
          "Arti_kata_in": "naik",
          "Arti_kata_en": "mounts up",
          "Text_Latin": "tattali'u",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَى",
          "Arti_kata_in": "ke atas/sampai",
          "Arti_kata_en": "to",
          "Text_Latin": "ala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡأَفِۡٔدَةِ",
          "Arti_kata_in": "hati",
          "Arti_kata_en": "the hearts",
          "Text_Latin": "al-afidati",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6187,
      "Ayat_Arabic": "اِنَّهَا عَلَيْهِمْ مُّؤْصَدَةٌۙ",
      "Text_Latin": "innaha 'alaihim mu'sadah",
      "Terjemah_in": "Sesungguhnya dia (api itu) tertutup rapat (sebagai hukuman) atas mereka,",
      "Terjemahan_En": "It closes in on them.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّهَا",
          "Arti_kata_in": "sesungguhnya ia (api)",
          "Arti_kata_en": "Indeed it",
          "Text_Latin": "innaha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَلَيۡهِم",
          "Arti_kata_in": "atas mereka",
          "Arti_kata_en": "(will be) upon them",
          "Text_Latin": "alayhim",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مُّؤۡصَدَةٞ",
          "Arti_kata_in": "terikat/ditutup rapat",
          "Arti_kata_en": "closed over",
          "Text_Latin": "mu'sadatun",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6188,
      "Ayat_Arabic": "فِيْ عَمَدٍ مُّمَدَّدَةٍ ࣖ",
      "Text_Latin": "fi 'amadim mumaddadah",
      "Terjemah_in": "(sedangkan mereka) diikat pada tiang-tiang yang panjang.",
      "Terjemahan_En": "In extended columns.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "dalam/pada",
          "Arti_kata_en": "In",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَمَدٖ",
          "Arti_kata_in": "tiang",
          "Arti_kata_en": "columns",
          "Text_Latin": "amadin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مُّمَدَّدَةِۭ",
          "Arti_kata_in": "panjang",
          "Arti_kata_en": "extended",
          "Text_Latin": "mumaddadatin",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
}