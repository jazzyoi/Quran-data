{
  "Nomor_surat": 107,
  "Nama_surat": "Al-Ma'un",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Ayat_arabic ": "اَرَءَيْتَ الَّذِيْ يُكَذِّبُ بِالدِّيْنِۗ",
      "Ayat_latin": "a ra'aitallazi yukazzibu bid-din",
      "Terjemah_in": "Tahukah kamu (orang) yang mendustakan agama?",
      "Terjemah_en": "Have you considered him who denies the religion?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "أَرَءَيۡتَ",
          "Arti_kata_in": "tahukah kamu",
          "Arti_kata_en": "Have you seen",
          "Text_latin  ": "ara-ayta"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "the one who",
          "Text_latin  ": "alladhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "يُكَذِّبُ",
          "Arti_kata_in": "dia mendustakan",
          "Arti_kata_en": "denies",
          "Text_latin  ": "yukadhibu"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "بِٱلدِّينِ",
          "Arti_kata_in": "dengan agama",
          "Arti_kata_en": "the Judgment",
          "Text_latin  ": "bil-dini"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Ayat_arabic ": "فَذٰلِكَ الَّذِيْ يَدُعُّ الْيَتِيْمَۙ",
      "Ayat_latin": "fa zalikallazi yadu''ul-yatim",
      "Terjemah_in": "Itulah orang yang menghardik anak yatim",
      "Terjemah_en": "It is he who mistreats the orphan.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَذَٰلِكَ",
          "Arti_kata_in": "maka itulah",
          "Arti_kata_en": "Then that",
          "Text_latin  ": "fadhalika"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "(is) the one who",
          "Text_latin  ": "alladhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "يَدُعُّ",
          "Arti_kata_in": "dia menghardik",
          "Arti_kata_en": "repulses",
          "Text_latin  ": "yadu'u"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "ٱلۡيَتِيمَ",
          "Arti_kata_in": "anak yatim",
          "Arti_kata_en": "the orphan",
          "Text_latin  ": "al-yatima"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Ayat_arabic ": "وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْكِيْنِۗ",
      "Ayat_latin": "wa la yahuddu 'ala ta'amil-miskin",
      "Terjemah_in": "dan tidak menganjurkan untuk memberi makan orang miskin.",
      "Terjemah_en": "And does not encourage the feeding of the poor.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَلَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And (does) not",
          "Text_latin  ": "wala"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَحُضُّ",
          "Arti_kata_in": "menganjurkan",
          "Arti_kata_en": "feel the urge",
          "Text_latin  ": "yahuddu"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "عَلَىٰ",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "to",
          "Text_latin  ": "ala"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "طَعَامِ",
          "Arti_kata_in": "memberi makan",
          "Arti_kata_en": "feed",
          "Text_latin  ": "ta'ami"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "ٱلۡمِسۡكِينِ",
          "Arti_kata_in": "orang miskin",
          "Arti_kata_en": "the poor",
          "Text_latin  ": "al-mis'kini"
        }
      ]
    },
    {
      "Nomor_ayat": 4,
      "Ayat_arabic ": "فَوَيْلٌ لِّلْمُصَلِّيْنَۙ",
      "Ayat_latin": "fa wailul lil-musallin",
      "Terjemah_in": "Celakalah orang-orang yang melaksanakan salat,",
      "Terjemah_en": "So woe to those who pray.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فَوَيۡلٞ",
          "Arti_kata_in": "maka celakalah",
          "Arti_kata_en": "So woe",
          "Text_latin  ": "fawaylun"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "لِّلۡمُصَلِّينَ",
          "Arti_kata_in": "orang yang sholat",
          "Arti_kata_en": "to those who pray",
          "Text_latin  ": "lil'musallina"
        }
      ]
    },
    {
      "Nomor_ayat": 5,
      "Ayat_arabic ": "الَّذِيْنَ هُمْ عَنْ صَلَاتِهِمْ سَاهُوْنَۙ",
      "Ayat_latin": "allazina hum 'an salatihim sahun",
      "Terjemah_in": "(yaitu) yang lalai terhadap salatnya,761)",
      "Terjemah_en": "Those who are heedless of their prayers.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "Those who",
          "Text_latin  ": "alladhina"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "هُمۡ",
          "Arti_kata_in": "mereka",
          "Arti_kata_en": "[they]",
          "Text_latin  ": "hum"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "عَن",
          "Arti_kata_in": "dar",
          "Arti_kata_en": "of",
          "Text_latin  ": "an"
        },
        {
          "Nomor_kata": 4,
          "Kata_arabic": "صَلَاتِهِمۡ",
          "Arti_kata_in": "sholat mereka",
          "Arti_kata_en": "their prayers",
          "Text_latin  ": "salatihim"
        },
        {
          "Nomor_kata": 5,
          "Kata_arabic": "سَاهُونَ",
          "Arti_kata_in": "lalai",
          "Arti_kata_en": "(are) neglectful",
          "Text_latin  ": "sahuna"
        }
      ]
    },
    {
      "Nomor_ayat": 6,
      "Ayat_arabic ": "الَّذِيْنَ هُمْ يُرَاۤءُوْنَۙ",
      "Ayat_latin": "allazina hum yura'un",
      "Terjemah_in": "yang berbuat riya,762)",
      "Terjemah_en": "Those who put on the appearance.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "Those who",
          "Text_latin  ": "alladhina"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "هُمۡ",
          "Arti_kata_in": "mereka",
          "Arti_kata_en": "[they]",
          "Text_latin  ": "hum"
        },
        {
          "Nomor_kata": 3,
          "Kata_arabic": "يُرَآءُونَ",
          "Arti_kata_in": "mereka berbuat ria",
          "Arti_kata_en": "make show",
          "Text_latin  ": "yurauna"
        }
      ]
    },
    {
      "Nomor_ayat": 7,
      "Ayat_arabic ": "وَيَمْنَعُوْنَ الْمَاعُوْنَ ࣖ",
      "Ayat_latin": "wa yamna'unal-ma'un",
      "Terjemah_in": "dan enggan (memberi) bantuan.",
      "Terjemah_en": "And withhold the assistance.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "وَيَمۡنَعُونَ",
          "Arti_kata_in": "dan mereka mencegah/enggan",
          "Arti_kata_en": "And they deny",
          "Text_latin  ": "wayamna'una"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "ٱلۡمَاعُونَ",
          "Arti_kata_in": "pertolongan",
          "Arti_kata_en": "[the] small kindness",
          "Text_latin  ": "al-ma'una"
        }
      ]
    }
  ]
}