          "Arti_kata_in": "apakah",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَدۡرَىٰكَ",
          "Arti_kata_in": "kamu melihat",
          "Arti_kata_en": "can make you know",
          "Text_Latin": "adraka",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "يَوۡمُ",
          "Arti_kata_in": "hari",
          "Arti_kata_en": "(is the) Day",
          "Text_Latin": "yawmu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "ٱلدِّينِ",
          "Arti_kata_in": "pembalasan",
          "Arti_kata_en": "(of) the Judgment",
          "Text_Latin": "ad-dini",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5848,
      "Ayat_Arabic": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـًٔا ۗوَالْاَمْرُ يَوْمَىِٕذٍ لِّلّٰهِ ࣖ",
      "Text_Latin": "yauma la tamliku nafsul linafsin syai'a, wal-amru yauma'izil lillah",
      "Terjemah_in": "(Itulah) hari (ketika) seseorang tidak berdaya (menolong) orang lain sedikit pun. Segala urusan pada hari itu adalah milik Allah.",
      "Terjemahan_En": "The Day when no soul will avail another soul anything; and the decision on that Day is God’s.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَوۡمَ",
          "Arti_kata_in": "hari",
          "Arti_kata_en": "(The) Day",
          "Text_Latin": "yawma",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَا",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "not",
          "Text_Latin": "la",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "تَمۡلِكُ",
          "Arti_kata_in": "berdaya/berkuasa",
          "Arti_kata_en": "will have power",
          "Text_Latin": "tamliku",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "نَفۡسٞ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "a soul",
          "Text_Latin": "nafsun",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "لِّنَفۡسٖ",
          "Arti_kata_in": "bagi diri/seseorang",
          "Arti_kata_en": "for a soul",
          "Text_Latin": "linafsin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "شَيۡٔٗاۖ",
          "Arti_kata_in": "sesuatu/sedikitpun",
          "Arti_kata_en": "anything",
          "Text_Latin": "shayan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "وَٱلۡأَمۡرُ",
          "Arti_kata_in": "dan urusan",
          "Arti_kata_en": "and the Command",
          "Text_Latin": "wal-amru",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "يَوۡمَئِذٖ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_Latin": "yawma-idhin",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "لِّلَّهِ",
          "Arti_kata_in": "bagi Allah",
          "Arti_kata_en": "(will be) with Allah",
          "Text_Latin": "lillahi",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
