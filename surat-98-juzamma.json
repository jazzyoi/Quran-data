          "Kata_arabic": "أَهۡلِ",
          "Arti_kata_in": "ahli",
          "Arti_kata_en": "(the) People",
          "Text_latin  ": "ahli"
        },
        {
          "Nomor_kata": 7,
          "Kata_arabic": "ٱلۡكِتَٰبِ",
          "Arti_kata_in": "kitab",
          "Arti_kata_en": "of the Book",
          "Text_latin  ": "al-kitabi"
        },
        {
          "Nomor_kata": 8,
          "Kata_arabic": "وَٱلۡمُشۡرِكِينَ",
