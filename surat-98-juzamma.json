{
  "Nomor_surat": 98,
  "Nama_surat": "Al-Bayyinah",
  "Ayat": [
    {
      "Nomor_ayat": 1,
      "Ayat_arabic ": "لَمْ يَكُنِ الَّذِيْنَ كَفَرُوْا مِنْ اَهْلِ الْكِتٰبِ وَالْمُشْرِكِيْنَ مُنْفَكِّيْنَ حَتّٰى تَأْتِيَهُمُ الْبَيِّنَةُۙ",
      "Ayat_latin": "lam yakunillazina kafaru min ahlil-kitabi wal-musyrikina munfakkina hatta ta'tiyahumul-bayyinah",
      "Terjemah_in": "Orang-orang yang kufur dari golongan Ahlulkitab dan orang-orang musyrik tidak akan meninggalkan (kekufuran mereka) sampai datang kepada mereka bukti yang nyata,",
      "Terjemah_en": "Those who disbelieved among the People of the Scripture, and the Polytheists, were not apart, until the Clear Evidence came to them.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "لَمۡ",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "Not",
          "Text_latin  ": "lam"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "يَكُنِ",
          "Arti_kata_in": "ada",
          "Arti_kata_en": "were",
          "Text_latin  ": "yakuni"
        },
        {
