    },
    {
      "Nomor_ayat": 7,
      "Ayat_arabic ": "اِنَّ الَّذِيْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِ اُولٰۤىِٕكَ هُمْ خَيْرُ الْبَرِيَّةِۗ",
      "Ayat_latin": "innallazina amanu wa 'amilus-salihati ula'ika hum khairul-bariyyah",
      "Terjemah_in": "Sesungguhnya orang-orang yang beriman dan mengerjakan kebajikan, mereka itulah sebaik-baik makhluk.",
      "Terjemah_en": "As for those who believe and lead a righteous life—these are the best of creatures.",
      "Kata": [
        {
          "Nomor_kata": 1,
