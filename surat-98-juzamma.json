          "Arti_kata_in": "suci",
          "Arti_kata_en": "purified",
          "Text_latin  ": "mutahharatan"
        }
      ]
    },
    {
      "Nomor_ayat": 3,
      "Ayat_arabic ": "فِيْهَا كُتُبٌ قَيِّمَةٌ  ۗ",
      "Ayat_latin": "fiha kutubung qayyimah",
      "Terjemah_in": "yang di dalamnya terdapat (isi) kitab-kitab yang lurus (benar).",
      "Terjemah_en": "In them are valuable writings.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "فِيهَا",
          "Arti_kata_in": "di dalamnya",
          "Arti_kata_en": "Wherein",
          "Text_latin  ": "fiha"
        },
        {
          "Nomor_kata": 2,
          "Kata_arabic": "كُتُبٞ",
          "Arti_kata_in": "kitab-kitab",
          "Arti_kata_en": "(are) writings",
          "Text_latin  ": "kutubun"
