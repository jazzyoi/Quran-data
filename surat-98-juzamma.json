          "Arti_kata_in": "bukti nyata",
          "Arti_kata_en": "the clear evidence",
          "Text_latin  ": "al-bayinatu"
        }
      ]
    },
    {
      "Nomor_ayat": 2,
      "Ayat_arabic ": "رَسُوْلٌ مِّنَ اللّٰهِ يَتْلُوْا صُحُفًا مُّطَهَّرَةًۙ",
      "Ayat_latin": "rasulum minallahi yatlu suhufam mutahharah",
      "Terjemah_in": "(yaitu) seorang Rasul dari Allah (Nabi Muhammad) yang membacakan lembaran-lembaran suci (Al-Qur’an)",
      "Terjemah_en": "A messenger from God reciting purified scripts.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_arabic": "رَسُولٞ",
          "Arti_kata_in": "seorang rasul",
          "Arti_kata_en": "A Messenger",
          "Text_latin  ": "rasulun"
        },
        {
