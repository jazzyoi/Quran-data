{
  "Nomor_surat": 103,
  "Nama_surat": "Al-'Ashr",
  "surat_arabic": "العصر",
  "Arti_surat_in": "Masa",
  "Arti_surat_en": "The Declining Day",
  "Ayat": [
    {
      "Nomor_ayat": 6177,
      "Ayat_Arabic": "وَالْعَصْرِۙ",
      "Text_Latin": "wal-'asr",
      "Terjemah_in": "Demi masa,",
      "Terjemahan_En": "By time.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡعَصۡرِ",
          "Arti_kata_in": "demi waktu",
          "Arti_kata_en": "By the time",
          "Text_Latin": "wal-'asri",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6178,
      "Ayat_Arabic": "اِنَّ الْاِنْسَانَ لَفِيْ خُسْرٍۙ",
      "Text_Latin": "innal-insana lafi khusr",
      "Terjemah_in": "sesungguhnya manusia benar-benar berada dalam kerugian,",
      "Terjemahan_En": "The human being is in loss.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_Latin": "inna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "mankind",
          "Text_Latin": "al-insana",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَفِي",
          "Arti_kata_in": "benar-benar dalam",
          "Arti_kata_en": "(is) surely in",
          "Text_Latin": "lafi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "خُسۡرٍ",
          "Arti_kata_in": "kerugian",
          "Arti_kata_en": "loss",
          "Text_Latin": "khus'rin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6179,
      "Ayat_Arabic": "اِلَّا الَّذِيْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِ وَتَوَاصَوْا بِالْحَقِّ ەۙ وَتَوَاصَوْا بِالصَّبْرِ ࣖ",
      "Text_Latin": "illallazina amanu wa 'amilus-salihati wa tawasau bil-haqqi wa tawasau bis-sabr",
      "Terjemah_in": "kecuali orang-orang yang beriman dan beramal saleh serta saling menasihati untuk kebenaran dan kesabaran.",
      "Terjemahan_En": "Except those who believe, and do good works, and encourage truth, and recommend patience.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِلَّا",
          "Arti_kata_in": "kecuali",
          "Arti_kata_en": "Except",
          "Text_Latin": "illa",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "those who",
          "Text_Latin": "alladhina",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ءَامَنُواْ",
          "Arti_kata_in": "beriman",
          "Arti_kata_en": "believe",
          "Text_Latin": "amanu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَعَمِلُواْ",
          "Arti_kata_in": "dan mereka berbuat/beramal",
          "Arti_kata_en": "and do",
          "Text_Latin": "wa'amilu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلصَّٰلِحَٰتِ",
          "Arti_kata_in": "kebajikan/sholeh",
          "Arti_kata_en": "righteous deeds",
          "Text_Latin": "as-salihati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "وَتَوَاصَوۡاْ",
          "Arti_kata_in": "dan mereka saling berwasiat/menasehati",
          "Arti_kata_en": "and enjoin each other",
          "Text_Latin": "watawasaw",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "بِٱلۡحَقِّ",
          "Arti_kata_in": "dengan kebenaran",
          "Arti_kata_en": "to the truth",
          "Text_Latin": "bil-haqi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "وَتَوَاصَوۡاْ",
          "Arti_kata_in": "dan mereka saling berwasiat/menasehati",
          "Arti_kata_en": "and enjoin each other",
          "Text_Latin": "watawasaw",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "بِٱلصَّبۡرِ",
          "Arti_kata_in": "dengan kesabaran",
          "Arti_kata_en": "to [the] patience",
          "Text_Latin": "bil-sabri",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
}