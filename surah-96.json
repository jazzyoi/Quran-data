{
  "Nomor_surat": 96,
  "Nama_surat": "Al-'Alaq",
  "surat_arabic": "العلق",
  "Arti_surat_in": "Segumpal Darah",
  "Arti_surat_en": "The Blood Clot",
  "Ayat": [
    {
      "Nomor_ayat": 6107,
      "Ayat_Arabic": "اِقْرَأْ بِاسْمِ رَبِّكَ الَّذِيْ خَلَقَۚ",
      "Text_Latin": "iqra' bismi rabbikallazi khalaq",
      "Terjemah_in": "Bacalah dengan (menyebut) nama Tuhanmu yang menciptakan!",
      "Terjemahan_En": "Read: In the Name of your Lord who created.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱقۡرَأۡ",
          "Arti_kata_in": "bacalah",
          "Arti_kata_en": "Read",
          "Text_Latin": "iq'ra",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بِٱسۡمِ",
          "Arti_kata_in": "dengan nama",
          "Arti_kata_en": "in (the) name",
          "Text_Latin": "bi-is'mi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "(of) your Lord",
          "Text_Latin": "rabbika",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "the One Who",
          "Text_Latin": "alladhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "خَلَقَ",
          "Arti_kata_in": "menciptakan",
          "Arti_kata_en": "created",
          "Text_Latin": "khalaqa",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6108,
      "Ayat_Arabic": "خَلَقَ الْاِنْسَانَ مِنْ عَلَقٍۚ",
      "Text_Latin": "khalaqal-insana min 'alaq",
      "Terjemah_in": "Dia menciptakan manusia dari segumpal darah.",
      "Terjemahan_En": "Created man from a clot.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "خَلَقَ",
          "Arti_kata_in": "menciptakan",
          "Arti_kata_en": "He created",
          "Text_Latin": "khalaqa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "man",
          "Text_Latin": "al-insana",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مِنۡ",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "from",
          "Text_Latin": "min",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "عَلَقٍ",
          "Arti_kata_in": "segumpal darah",
          "Arti_kata_en": "a clinging substance",
          "Text_Latin": "alaqin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6109,
      "Ayat_Arabic": "اِقْرَأْ وَرَبُّكَ الْاَكْرَمُۙ",
      "Text_Latin": "iqra' wa rabbukal-akram",
      "Terjemah_in": "Bacalah! Tuhanmulah Yang Maha Mulia,",
      "Terjemahan_En": "Read: And your Lord is the Most Generous.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱقۡرَأۡ",
          "Arti_kata_in": "bacalah",
          "Arti_kata_en": "Read",
          "Text_Latin": "iq'ra",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَرَبُّكَ",
          "Arti_kata_in": "dan Tuhanmu",
          "Arti_kata_en": "and your Lord",
          "Text_Latin": "warabbuka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡأَكۡرَمُ",
          "Arti_kata_in": "amat mulia",
          "Arti_kata_en": "(is) the Most Generous",
          "Text_Latin": "al-akramu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6110,
      "Ayat_Arabic": "الَّذِيْ عَلَّمَ بِالْقَلَمِۙ",
      "Text_Latin": "allazi 'allama bil-qalam",
      "Terjemah_in": "yang mengajar (manusia) dengan pena.",
      "Terjemahan_En": "He who taught by the pen.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "The One Who",
          "Text_Latin": "alladhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَلَّمَ",
          "Arti_kata_in": "Dia mengajar",
          "Arti_kata_en": "taught",
          "Text_Latin": "allama",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلۡقَلَمِ",
          "Arti_kata_in": "dengan kalam",
          "Arti_kata_en": "by the pen",
          "Text_Latin": "bil-qalami",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6111,
      "Ayat_Arabic": "عَلَّمَ الْاِنْسَانَ مَا لَمْ يَعْلَمْۗ",
      "Text_Latin": "'allamal-insana ma lam ya'lam",
      "Terjemah_in": "Dia mengajarkan manusia apa yang tidak diketahuinya.",
      "Terjemahan_En": "Taught man what he never knew.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "عَلَّمَ",
          "Arti_kata_in": "Dia mengajarkan",
          "Arti_kata_en": "Taught",
          "Text_Latin": "allama",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "man",
          "Text_Latin": "al-insana",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَمۡ",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "not",
          "Text_Latin": "lam",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "يَعۡلَمۡ",
          "Arti_kata_in": "dia ketahui",
          "Arti_kata_en": "he knew",
          "Text_Latin": "ya'lam",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6112,
      "Ayat_Arabic": "كَلَّآ اِنَّ الْاِنْسَانَ لَيَطْغٰىٓ ۙ",
      "Text_Latin": "kalla innal-insana layatga",
      "Terjemah_in": "Sekali-kali tidak! Sesungguhnya manusia itu benar-benar melampaui batas",
      "Terjemahan_En": "In fact, man oversteps all bounds.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّآ",
          "Arti_kata_in": "sekali-kali tidak",
          "Arti_kata_en": "Nay!",
          "Text_Latin": "kalla",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_Latin": "inna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "man",
          "Text_Latin": "al-insana",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَيَطۡغَىٰٓ",
          "Arti_kata_in": "benar-benar melampui batas",
          "Arti_kata_en": "surely transgresses",
          "Text_Latin": "layatgha",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6113,
      "Ayat_Arabic": "اَنْ رَّاٰهُ اسْتَغْنٰىۗ",
      "Text_Latin": "ar ra'ahustagna",
      "Terjemah_in": "ketika melihat dirinya serba berkecukupan.",
      "Terjemahan_En": "When he considers himself exempt.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَن",
          "Arti_kata_in": "bahwa",
          "Arti_kata_en": "Because",
          "Text_Latin": "an",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَّءَاهُ",
          "Arti_kata_in": "ia melihatnya",
          "Arti_kata_en": "he sees himself",
          "Text_Latin": "raahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱسۡتَغۡنَىٰٓ",
          "Arti_kata_in": "dia serba cukup",
          "Arti_kata_en": "self-sufficient",
          "Text_Latin": "is'taghna",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6114,
      "Ayat_Arabic": "اِنَّ اِلٰى رَبِّكَ الرُّجْعٰىۗ",
      "Text_Latin": "inna ila rabbikar-ruj'a",
      "Terjemah_in": "Sesungguhnya hanya kepada Tuhanmulah tempat kembali(-mu).",
      "Terjemahan_En": "But to your Lord is the return.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_Latin": "inna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِلَىٰ",
          "Arti_kata_in": "kepada",
          "Arti_kata_en": "to",
          "Text_Latin": "ila",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_Latin": "rabbika",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلرُّجۡعَىٰٓ",
          "Arti_kata_in": "tempat kembali",
          "Arti_kata_en": "(is) the return",
          "Text_Latin": "ar-ruj'a",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6115,
      "Ayat_Arabic": "اَرَاَيْتَ الَّذِيْ يَنْهٰىۙ",
      "Text_Latin": "a ra'aitallazi yan-ha",
      "Terjemah_in": "Tahukah kamu tentang orang yang melarang",
      "Terjemahan_En": "Have you seen him who prevents?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَرَءَيۡتَ",
          "Arti_kata_in": "apakah kamu lihat/pendapatmu",
          "Arti_kata_en": "Have you seen",
          "Text_Latin": "ara-ayta",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلَّذِي",
          "Arti_kata_in": "yang/orang-orang",
          "Arti_kata_en": "the one who",
          "Text_Latin": "alladhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَنۡهَىٰ",
          "Arti_kata_in": "ia melarang",
          "Arti_kata_en": "forbids",
          "Text_Latin": "yanha",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6116,
      "Ayat_Arabic": "عَبْدًا اِذَا صَلّٰىۗ",
      "Text_Latin": "'abdan iza salla",
      "Terjemah_in": "seorang hamba ketika dia melaksanakan salat?",
      "Terjemahan_En": "A servant when he prays?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "عَبۡدًا",
          "Arti_kata_in": "hamba",
          "Arti_kata_en": "A slave",
          "Text_Latin": "abdan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "صَلَّىٰٓ",
          "Arti_kata_in": "sholat",
          "Arti_kata_en": "he prays",
          "Text_Latin": "salla",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6117,
      "Ayat_Arabic": "اَرَاَيْتَ اِنْ كَانَ عَلَى الْهُدٰىٓۙ",
      "Text_Latin": "a ra'aita ing kana 'alal-huda",
      "Terjemah_in": "Bagaimana pendapatmu kalau terbukti dia berada di dalam kebenaran",
      "Terjemahan_En": "Do you think he is upon guidance?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَرَءَيۡتَ",
          "Arti_kata_in": "apakah kamu lihat/pendapatmu",
          "Arti_kata_en": "Have you seen",
          "Text_Latin": "ara-ayta",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِن",
          "Arti_kata_in": "jika",
          "Arti_kata_en": "if",
          "Text_Latin": "in",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كَانَ",
          "Arti_kata_in": "adalah",
          "Arti_kata_en": "he is",
          "Text_Latin": "kana",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "عَلَى",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "upon",
          "Text_Latin": "ala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡهُدَىٰٓ",
          "Arti_kata_in": "petunjuk",
          "Arti_kata_en": "[the] guidance",
          "Text_Latin": "al-huda",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6118,
      "Ayat_Arabic": "اَوْ اَمَرَ بِالتَّقْوٰىۗ",
      "Text_Latin": "au amara bit-taqwa",
      "Terjemah_in": "atau dia menyuruh bertakwa (kepada Allah)?",
      "Terjemahan_En": "Or advocates righteousness?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَوۡ",
          "Arti_kata_in": "atau",
          "Arti_kata_en": "Or",
          "Text_Latin": "aw",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَمَرَ",
          "Arti_kata_in": "dia menyuruh",
          "Arti_kata_en": "he enjoins",
          "Text_Latin": "amara",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلتَّقۡوَىٰٓ",
          "Arti_kata_in": "dengan taqwa",
          "Arti_kata_en": "[of the] righteousness",
          "Text_Latin": "bil-taqwa",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6119,
      "Ayat_Arabic": "اَرَاَيْتَ اِنْ كَذَّبَ وَتَوَلّٰىۗ",
      "Text_Latin": "a ra'aita ing kazzaba wa tawalla",
      "Terjemah_in": "Bagaimana pendapatmu kalau dia mendustakan (kebenaran) dan berpaling (dari keimanan)?",
      "Terjemahan_En": "Do you see how he disbelieved and turned away?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَرَءَيۡتَ",
          "Arti_kata_in": "apakah kamu lihat/pendapatmu",
          "Arti_kata_en": "Have you seen",
          "Text_Latin": "ara-ayta",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِن",
          "Arti_kata_in": "jika",
          "Arti_kata_en": "if",
          "Text_Latin": "in",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كَذَّبَ",
          "Arti_kata_in": "mendustakan",
          "Arti_kata_en": "he denies",
          "Text_Latin": "kadhaba",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَتَوَلَّىٰٓ",
          "Arti_kata_in": "dan dia berpaling",
          "Arti_kata_en": "and turns away",
          "Text_Latin": "watawalla",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6120,
      "Ayat_Arabic": "اَلَمْ يَعْلَمْ بِاَنَّ اللّٰهَ يَرٰىۗ",
      "Text_Latin": "a lam ya'lam bi'annallaha yara",
      "Terjemah_in": "Tidakkah dia mengetahui bahwa sesungguhnya Allah melihat (segala perbuatannya)?",
      "Terjemahan_En": "Does he not know that God sees?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَلَمۡ",
          "Arti_kata_in": "apakah tidak/tidaklah",
          "Arti_kata_en": "Does not",
          "Text_Latin": "alam",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَعۡلَم",
          "Arti_kata_in": "dia mengetahui",
          "Arti_kata_en": "he know",
          "Text_Latin": "ya'lam",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِأَنَّ",
          "Arti_kata_in": "bahwa sesungguhnya",
          "Arti_kata_en": "that",
          "Text_Latin": "bi-anna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱللَّهَ",
          "Arti_kata_in": "Allah",
          "Arti_kata_en": "Allah",
          "Text_Latin": "al-laha",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "يَرَىٰ",
          "Arti_kata_in": "Dia melihat",
          "Arti_kata_en": "sees",
          "Text_Latin": "yara",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6121,
      "Ayat_Arabic": "كَلَّا لَىِٕنْ لَّمْ يَنْتَهِ ەۙ لَنَسْفَعًاۢ بِالنَّاصِيَةِۙ",
      "Text_Latin": "kalla la'il lam yantahi lanasfa'am bin-nasiyah",
      "Terjemah_in": "Sekali-kali tidak! Sungguh, jika dia tidak berhenti (berbuat demikian), niscaya Kami tarik ubun-ubunnya (ke dalam neraka),",
      "Terjemahan_En": "No. If he does not desist, We will drag him by the forelock.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّا",
          "Arti_kata_in": "sekali-kali tidak",
