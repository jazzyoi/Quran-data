          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّا",
          "Arti_kata": "sekali-kali",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَا",
          "Arti_kata": "jangan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "تُطِعۡهُ",
          "Arti_kata": "kamu patuh kepadanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَٱسۡجُدۡۤ",
          "Arti_kata": "dan sujudlah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَٱقۡتَرِب۩",
          "Arti_kata": "dan dekatkanlah",
