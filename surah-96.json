      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَلَمۡ",
          "Arti_kata": "apakah tidak/tidaklah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَعۡلَم",
          "Arti_kata": "dia mengetahui",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِأَنَّ",
          "Arti_kata": "bahwa sesungguhnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱللَّهَ",
          "Arti_kata": "Allah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "يَرَىٰ",
          "Arti_kata": "Dia melihat",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6121,
      "Ayat_Arabic": "كَلَّا لَىِٕنْ لَّمْ يَنْتَهِ ەۙ لَنَسْفَعًاۢ بِالنَّاصِيَةِۙ",
      "Text_Latin": "kalla la'il lam yantahi lanasfa'am bin-nasiyah",
      "Terjemah_in": "Sekali-kali tidak! Sungguh, jika dia tidak berhenti (berbuat demikian), niscaya Kami tarik ubun-ubunnya (ke dalam neraka),",
      "Terjemahan_En": "No. If he does not desist, We will drag him by the forelock.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّا",
          "Arti_kata": "sekali-kali tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَئِن",
          "Arti_kata": "sungguh jika",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَّمۡ",
          "Arti_kata": "tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَنتَهِ",
          "Arti_kata": "dia berhenti",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "لَنَسۡفَعَۢا",
          "Arti_kata": "niscaya kami pegang/tarik",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "بِٱلنَّاصِيَةِ",
          "Arti_kata": "dengan umbun-umbun",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6122,
      "Ayat_Arabic": "نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍۚ",
      "Text_Latin": "nasiyating kazibatin khati'ah",
      "Terjemah_in": "(yaitu) ubun-ubun orang yang mendustakan (kebenaran) dan durhaka.",
      "Terjemahan_En": "A deceitful, sinful forelock.",
      "Kata": [
        {
