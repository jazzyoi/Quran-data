        {
          "Nomor_kata": 1,
          "Kata_Arabic": "عَبۡدًا",
          "Arti_kata": "hamba",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata": "apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "صَلَّىٰٓ",
          "Arti_kata": "sholat",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6117,
      "Ayat_Arabic": "اَرَاَيْتَ اِنْ كَانَ عَلَى الْهُدٰىٓۙ",
      "Text_Latin": "a ra'aita ing kana 'alal-huda",
      "Terjemah_in": "Bagaimana pendapatmu kalau terbukti dia berada di dalam kebenaran",
      "Terjemahan_En": "Do you think he is upon guidance?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَرَءَيۡتَ",
          "Arti_kata": "apakah kamu lihat/pendapatmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِن",
          "Arti_kata": "jika",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كَانَ",
          "Arti_kata": "adalah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "عَلَى",
          "Arti_kata": "atas",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡهُدَىٰٓ",
          "Arti_kata": "petunjuk",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6118,
      "Ayat_Arabic": "اَوْ اَمَرَ بِالتَّقْوٰىۗ",
      "Text_Latin": "au amara bit-taqwa",
      "Terjemah_in": "atau dia menyuruh bertakwa (kepada Allah)?",
      "Terjemahan_En": "Or advocates righteousness?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَوۡ",
          "Arti_kata": "atau",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَمَرَ",
          "Arti_kata": "dia menyuruh",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلتَّقۡوَىٰٓ",
          "Arti_kata": "dengan taqwa",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6119,
      "Ayat_Arabic": "اَرَاَيْتَ اِنْ كَذَّبَ وَتَوَلّٰىۗ",
      "Text_Latin": "a ra'aita ing kazzaba wa tawalla",
      "Terjemah_in": "Bagaimana pendapatmu kalau dia mendustakan (kebenaran) dan berpaling (dari keimanan)?",
      "Terjemahan_En": "Do you see how he disbelieved and turned away?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَرَءَيۡتَ",
          "Arti_kata": "apakah kamu lihat/pendapatmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِن",
          "Arti_kata": "jika",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كَذَّبَ",
          "Arti_kata": "mendustakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَتَوَلَّىٰٓ",
          "Arti_kata": "dan dia berpaling",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6120,
      "Ayat_Arabic": "اَلَمْ يَعْلَمْ بِاَنَّ اللّٰهَ يَرٰىۗ",
      "Text_Latin": "a lam ya'lam bi'annallaha yara",
      "Terjemah_in": "Tidakkah dia mengetahui bahwa sesungguhnya Allah melihat (segala perbuatannya)?",
