{
  "Nomor_surat": 96,
  "Nama_surat": "Al-'Alaq",
  "surat_arabic": "العلق",
  "Arti_surat_in": "Segumpal Darah",
  "Arti_surat_en": "The Blood Clot",
  "Ayat": [
    {
      "Nomor_ayat": 6107,
      "Ayat_Arabic": "اِقْرَأْ بِاسْمِ رَبِّكَ الَّذِيْ خَلَقَۚ",
      "Text_Latin": "iqra' bismi rabbikallazi khalaq",
      "Terjemah_in": "Bacalah dengan (menyebut) nama Tuhanmu yang menciptakan!",
      "Terjemahan_En": "Read: In the Name of your Lord who created.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱقۡرَأۡ",
          "Arti_kata": "bacalah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بِٱسۡمِ",
          "Arti_kata": "dengan nama",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata": "Tuhanmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلَّذِي",
          "Arti_kata": "yang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "خَلَقَ",
          "Arti_kata": "menciptakan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6108,
      "Ayat_Arabic": "خَلَقَ الْاِنْسَانَ مِنْ عَلَقٍۚ",
      "Text_Latin": "khalaqal-insana min 'alaq",
      "Terjemah_in": "Dia menciptakan manusia dari segumpal darah.",
      "Terjemahan_En": "Created man from a clot.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "خَلَقَ",
          "Arti_kata": "menciptakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مِنۡ",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "عَلَقٍ",
          "Arti_kata": "segumpal darah",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6109,
      "Ayat_Arabic": "اِقْرَأْ وَرَبُّكَ الْاَكْرَمُۙ",
      "Text_Latin": "iqra' wa rabbukal-akram",
      "Terjemah_in": "Bacalah! Tuhanmulah Yang Maha Mulia,",
      "Terjemahan_En": "Read: And your Lord is the Most Generous.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱقۡرَأۡ",
          "Arti_kata": "bacalah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَرَبُّكَ",
          "Arti_kata": "dan Tuhanmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡأَكۡرَمُ",
          "Arti_kata": "amat mulia",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6110,
      "Ayat_Arabic": "الَّذِيْ عَلَّمَ بِالْقَلَمِۙ",
      "Text_Latin": "allazi 'allama bil-qalam",
      "Terjemah_in": "yang mengajar (manusia) dengan pena.",
      "Terjemahan_En": "He who taught by the pen.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِي",
          "Arti_kata": "yang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَلَّمَ",
          "Arti_kata": "Dia mengajar",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلۡقَلَمِ",
          "Arti_kata": "dengan kalam",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6111,
      "Ayat_Arabic": "عَلَّمَ الْاِنْسَانَ مَا لَمْ يَعْلَمْۗ",
      "Text_Latin": "'allamal-insana ma lam ya'lam",
      "Terjemah_in": "Dia mengajarkan manusia apa yang tidak diketahuinya.",
      "Terjemahan_En": "Taught man what he never knew.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "عَلَّمَ",
          "Arti_kata": "Dia mengajarkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata": "apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَمۡ",
          "Arti_kata": "tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "يَعۡلَمۡ",
          "Arti_kata": "dia ketahui",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6112,
      "Ayat_Arabic": "كَلَّآ اِنَّ الْاِنْسَانَ لَيَطْغٰىٓ ۙ",
      "Text_Latin": "kalla innal-insana layatga",
      "Terjemah_in": "Sekali-kali tidak! Sesungguhnya manusia itu benar-benar melampaui batas",
      "Terjemahan_En": "In fact, man oversteps all bounds.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّآ",
          "Arti_kata": "sekali-kali tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata": "sesungguhnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡإِنسَٰنَ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَيَطۡغَىٰٓ",
          "Arti_kata": "benar-benar melampui batas",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6113,
      "Ayat_Arabic": "اَنْ رَّاٰهُ اسْتَغْنٰىۗ",
      "Text_Latin": "ar ra'ahustagna",
      "Terjemah_in": "ketika melihat dirinya serba berkecukupan.",
      "Terjemahan_En": "When he considers himself exempt.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَن",
          "Arti_kata": "bahwa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَّءَاهُ",
          "Arti_kata": "ia melihatnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱسۡتَغۡنَىٰٓ",
          "Arti_kata": "dia serba cukup",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6114,
      "Ayat_Arabic": "اِنَّ اِلٰى رَبِّكَ الرُّجْعٰىۗ",
      "Text_Latin": "inna ila rabbikar-ruj'a",
      "Terjemah_in": "Sesungguhnya hanya kepada Tuhanmulah tempat kembali(-mu).",
      "Terjemahan_En": "But to your Lord is the return.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata": "sesungguhnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِلَىٰ",
          "Arti_kata": "kepada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبِّكَ",
          "Arti_kata": "Tuhanmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلرُّجۡعَىٰٓ",
          "Arti_kata": "tempat kembali",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6115,
      "Ayat_Arabic": "اَرَاَيْتَ الَّذِيْ يَنْهٰىۙ",
      "Text_Latin": "a ra'aitallazi yan-ha",
      "Terjemah_in": "Tahukah kamu tentang orang yang melarang",
      "Terjemahan_En": "Have you seen him who prevents?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَرَءَيۡتَ",
          "Arti_kata": "apakah kamu lihat/pendapatmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلَّذِي",
          "Arti_kata": "yang/orang-orang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَنۡهَىٰ",
          "Arti_kata": "ia melarang",
          "Jenis_kata": null
        }
      ]
    },
    {
