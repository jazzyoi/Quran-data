          "Arti_kata": "Zabaniyah",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6125,
      "Ayat_Arabic": "كَلَّاۗ  لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ ۩ ࣖ",
      "Text_Latin": "kalla, la tuti'hu wasjud waqtarib",
      "Terjemah_in": "Sekali-kali tidak! Janganlah patuh kepadanya, (tetapi) sujud dan mendekatlah (kepada Allah).",
      "Terjemahan_En": "No, do not obey him; but kneel down, and come near.",
