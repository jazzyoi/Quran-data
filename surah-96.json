      "Text_Latin": "sanad'uz-zabaniyah",
      "Terjemah_in": "Kelak Kami akan memanggil (Malaikat) Zabaniah (penyiksa orang-orang yang berdosa).759)",
      "Terjemahan_En": "We will call the Guards.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "سَنَدۡعُ",
          "Arti_kata": "kelak Kami memanggil",
