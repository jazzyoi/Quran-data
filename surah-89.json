{
  "Nomor_surat": 89,
  "Nama_surat": "Al-Fajr",
  "surat_arabic": "الفجر",
  "Arti_surat_in": "Fajar",
  "Arti_surat_en": "The Dawn",
  "Ayat": [
    {
      "Nomor_ayat": 5994,
      "Ayat_Arabic": "وَالْفَجْرِۙ",
      "Text_Latin": "wal-fajr",
      "Terjemah_in": "Demi waktu fajar,",
      "Terjemahan_En": "By the daybreak.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡفَجۡرِ",
          "Arti_kata_in": "demi fajar",
          "Arti_kata_en": "By the dawn",
          "Text_Latin": "wal-fajri",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5995,
      "Ayat_Arabic": "وَلَيَالٍ عَشْرٍۙ",
      "Text_Latin": "wa layalin 'asyr",
      "Terjemah_in": "demi malam yang sepuluh,754)",
      "Terjemahan_En": "And ten nights.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَيَالٍ",
          "Arti_kata_in": "dan malam-malam",
          "Arti_kata_en": "And the nights",
          "Text_Latin": "walayalin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَشۡرٖ",
          "Arti_kata_in": "sepuluh",
          "Arti_kata_en": "ten",
          "Text_Latin": "ashrin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5996,
      "Ayat_Arabic": "وَّالشَّفْعِ وَالْوَتْرِۙ",
      "Text_Latin": "wasy-syaf'i wal-watr",
      "Terjemah_in": "demi yang genap dan yang ganjil,",
      "Terjemahan_En": "And the even and the odd.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلشَّفۡعِ",
          "Arti_kata_in": "dan yang genap",
          "Arti_kata_en": "And the even",
          "Text_Latin": "was-shaf'i",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَٱلۡوَتۡرِ",
          "Arti_kata_in": "dan yang ganjil",
          "Arti_kata_en": "and the odd",
          "Text_Latin": "wal-watri",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5997,
      "Ayat_Arabic": "وَالَّيْلِ اِذَا يَسْرِۚ",
      "Text_Latin": "wal-laili iza yasr",
      "Terjemah_in": "dan demi malam apabila berlalu.",
      "Terjemahan_En": "And the night as it recedes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلَّيۡلِ",
          "Arti_kata_in": "dan malam",
          "Arti_kata_en": "And the night",
          "Text_Latin": "wa-al-layli",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَسۡرِ",
          "Arti_kata_in": "berlalu",
          "Arti_kata_en": "it passes",
          "Text_Latin": "yasri",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 5998,
      "Ayat_Arabic": "هَلْ فِيْ ذٰلِكَ قَسَمٌ لِّذِيْ حِجْرٍۗ",
      "Text_Latin": "hal fi zalika qasamul lizi hijr",
      "Terjemah_in": "Apakah pada yang demikian itu terdapat sumpah (yang dapat diterima) oleh (orang) yang berakal?",
      "Terjemahan_En": "Is there in this an oath for a rational person?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "هَلۡ",
          "Arti_kata_in": "apakah/bukankah",
          "Arti_kata_en": "Is",
          "Text_Latin": "hal",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "pada",
          "Arti_kata_en": "in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ذَٰلِكَ",
          "Arti_kata_in": "itu/yang demikian",
          "Arti_kata_en": "that",
          "Text_Latin": "dhalika",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "قَسَمٞ",
          "Arti_kata_in": "sumpah",
          "Arti_kata_en": "an oath",
          "Text_Latin": "qasamun",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "لِّذِي",
          "Arti_kata_in": "bagi memiliki",
          "Arti_kata_en": "for those",
          "Text_Latin": "lidhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "حِجۡرٍ",
          "Arti_kata_in": "akal",
          "Arti_kata_en": "who understand",
          "Text_Latin": "hij'rin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 5999,
      "Ayat_Arabic": "اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍۖ",
      "Text_Latin": "a lam tara kaifa fa'ala rabbuka bi'ad",
      "Terjemah_in": "Tidakkah engkau (Nabi Muhammad) memperhatikan bagaimana Tuhanmu berbuat terhadap (kaum) ‘Ad,",
      "Terjemahan_En": "Have you not seen how your Lord dealt with Aad?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَلَمۡ",
          "Arti_kata_in": "tidakkah",
          "Arti_kata_en": "Do not",
          "Text_Latin": "alam",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تَرَ",
          "Arti_kata_in": "lihat/perhatikan",
          "Arti_kata_en": "you see",
          "Text_Latin": "tara",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كَيۡفَ",
          "Arti_kata_in": "bagaimana",
          "Arti_kata_en": "how",
          "Text_Latin": "kayfa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فَعَلَ",
          "Arti_kata_in": "berbuat",
          "Arti_kata_en": "dealt",
          "Text_Latin": "fa'ala",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "رَبُّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_Latin": "rabbuka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "بِعَادٍ",
          "Arti_kata_in": "terhadap kaum 'Ad",
          "Arti_kata_en": "with Aad",
          "Text_Latin": "bi'adin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6000,
      "Ayat_Arabic": "اِرَمَ ذَاتِ الْعِمَادِۖ",
      "Text_Latin": "irama zatil-'imad",
      "Terjemah_in": "(yaitu) penduduk Iram (ibu kota kaum ‘Ad) yang mempunyai bangunan-bangunan yang tinggi",
      "Terjemahan_En": "Erum of the pillars.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِرَمَ",
          "Arti_kata_in": "kaum Iram",
          "Arti_kata_en": "Iram",
          "Text_Latin": "irama",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ذَاتِ",
          "Arti_kata_in": "memiliki",
          "Arti_kata_en": "possessors (of)",
          "Text_Latin": "dhati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡعِمَادِ",
          "Arti_kata_in": "tiang/bangunan tinggi",
          "Arti_kata_en": "lofty pillars",
          "Text_Latin": "al-'imadi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6001,
      "Ayat_Arabic": "الَّتِيْ لَمْ يُخْلَقْ مِثْلُهَا فِى الْبِلَادِۖ",
      "Text_Latin": "allati lam yukhlaq misluha fil-bilad",
      "Terjemah_in": "yang sebelumnya tidak pernah dibangun (suatu kota pun) seperti itu di negeri-negeri (lain)?",
      "Terjemahan_En": "The like of which was never created in the land.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّتِي",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "Which",
          "Text_Latin": "allati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَمۡ",
          "Arti_kata_in": "tidak/belum",
          "Arti_kata_en": "not",
          "Text_Latin": "lam",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يُخۡلَقۡ",
          "Arti_kata_in": "diciptakan/dibangun",
          "Arti_kata_en": "had been created",
          "Text_Latin": "yukh'laq",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مِثۡلُهَا",
          "Arti_kata_in": "seperti itu/serupa itu",
          "Arti_kata_en": "like them",
          "Text_Latin": "mith'luha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "pada",
          "Arti_kata_en": "in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "ٱلۡبِلَٰدِ",
          "Arti_kata_in": "negeri",
          "Arti_kata_en": "the cities",
          "Text_Latin": "al-biladi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6002,
      "Ayat_Arabic": "وَثَمُوْدَ الَّذِيْنَ جَابُوا الصَّخْرَ بِالْوَادِۖ",
      "Text_Latin": "wa samudallazina jabus-sakhra bil-wad",
      "Terjemah_in": "(Tidakkah engkau perhatikan pula kaum) Samud yang memotong batu-batu besar di lembah755)",
      "Terjemahan_En": "And Thamood—those who carved the rocks in the valley.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَثَمُودَ",
          "Arti_kata_in": "dan Samud",
          "Arti_kata_en": "And Thamud",
          "Text_Latin": "wathamuda",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "who",
          "Text_Latin": "alladhina",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "جَابُواْ",
          "Arti_kata_in": "(mereka) memotong",
          "Arti_kata_en": "carved out",
          "Text_Latin": "jabu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلصَّخۡرَ",
          "Arti_kata_in": "batu-batu besar",
          "Arti_kata_en": "the rocks",
          "Text_Latin": "as-sakhra",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "بِٱلۡوَادِ",
          "Arti_kata_in": "di lembah",
          "Arti_kata_en": "in the valley",
          "Text_Latin": "bil-wadi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6003,
      "Ayat_Arabic": "وَفِرْعَوْنَ ذِى الْاَوْتَادِۖ",
      "Text_Latin": "wa fir'auna zil-autad",
      "Terjemah_in": "dan Fir‘aun yang mempunyai pasak-pasak (bangunan yang besar)",
      "Terjemahan_En": "And Pharaoh of the Stakes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَفِرۡعَوۡنَ",
          "Arti_kata_in": "dan Fir'aun",
          "Arti_kata_en": "And Firaun",
          "Text_Latin": "wafir'awna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ذِي",
          "Arti_kata_in": "memiliki",
          "Arti_kata_en": "owner of",
          "Text_Latin": "dhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡأَوۡتَادِ",
          "Arti_kata_in": "pasak-pasak (bala tentara)",
          "Arti_kata_en": "stakes",
          "Text_Latin": "al-awtadi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6004,
      "Ayat_Arabic": "الَّذِيْنَ طَغَوْا فِى الْبِلَادِۖ",
      "Text_Latin": "allazina tagau fil-bilad",
      "Terjemah_in": "yang berbuat sewenang-wenang dalam negeri,",
      "Terjemahan_En": "Those who committed excesses in the lands.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِينَ",
          "Arti_kata_in": "orang-orang yang",
          "Arti_kata_en": "Who",
          "Text_Latin": "alladhina",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "طَغَوۡاْ",
          "Arti_kata_in": "(mereka) melampui batas",
          "Arti_kata_en": "transgressed",
          "Text_Latin": "taghaw",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "pada",
          "Arti_kata_en": "in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡبِلَٰدِ",
          "Arti_kata_in": "negeri-negeri itu",
          "Arti_kata_en": "the lands",
          "Text_Latin": "al-biladi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6005,
      "Ayat_Arabic": "فَاَكْثَرُوْا فِيْهَا الْفَسَادَۖ",
      "Text_Latin": "fa aksaru fihal-fasad",
      "Terjemah_in": "lalu banyak berbuat kerusakan di dalamnya (negeri itu),",
      "Terjemahan_En": "And spread much corruption therein.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَكۡثَرُواْ",
          "Arti_kata_in": "lalu mereka banyak berbuat",
          "Arti_kata_en": "And made much",
          "Text_Latin": "fa-aktharu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فِيهَا",
          "Arti_kata_in": "didalamnya",
          "Arti_kata_en": "therein",
          "Text_Latin": "fiha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡفَسَادَ",
          "Arti_kata_in": "kerusakan",
          "Arti_kata_en": "corruption",
          "Text_Latin": "al-fasada",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6006,
      "Ayat_Arabic": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۖ",
      "Text_Latin": "fa sabba 'alaihim rabbuka sauta 'azab",
      "Terjemah_in": "maka Tuhanmu menimpakan cemeti azab (yang dahsyat) kepada mereka?",
      "Terjemahan_En": "So your Lord poured down upon them a scourge of punishment.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَصَبَّ",
          "Arti_kata_in": "maka menimpakan",
          "Arti_kata_en": "So poured",
          "Text_Latin": "fasabba",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَلَيۡهِمۡ",
          "Arti_kata_in": "atas mereka",
          "Arti_kata_en": "on them",
          "Text_Latin": "alayhim",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبُّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_Latin": "rabbuka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "سَوۡطَ",
          "Arti_kata_in": "cemeti/cambuk",
          "Arti_kata_en": "scourge",
          "Text_Latin": "sawta",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "عَذَابٍ",
          "Arti_kata_in": "azab",
          "Arti_kata_en": "(of) punishment",
          "Text_Latin": "adhabin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6007,
      "Ayat_Arabic": "اِنَّ رَبَّكَ لَبِالْمِرْصَادِۗ",
      "Text_Latin": "inna rabbaka labil-mirsad",
      "Terjemah_in": "Sesungguhnya Tuhanmu benar-benar mengawasi.",
      "Terjemahan_En": "Your Lord is on the lookout.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata_in": "sesungguhnya",
          "Arti_kata_en": "Indeed",
          "Text_Latin": "inna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَبَّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_Latin": "rabbaka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَبِٱلۡمِرۡصَادِ",
          "Arti_kata_in": "benar-benar mengawasi",
          "Arti_kata_en": "(is) surely Ever Watchful",
          "Text_Latin": "labil-mir'sadi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6008,
      "Ayat_Arabic": "فَاَمَّا الْاِنْسَانُ اِذَا مَا ابْتَلٰىهُ رَبُّهٗ فَاَكْرَمَهٗ وَنَعَّمَهٗۙ فَيَقُوْلُ رَبِّيْٓ اَكْرَمَنِۗ",
      "Text_Latin": "fa ammal-insanu iza mabtalahu rabbuhu fa akramahu wa na''amahu fa yaqulu rabbi akraman",
      "Terjemah_in": "Adapun manusia, apabila Tuhan mengujinya lalu memuliakannya dan memberinya kenikmatan, berkatalah dia, “Tuhanku telah memuliakanku.”",
      "Terjemahan_En": "As for man, whenever his Lord tests him, and honors him, and prospers him, he says, “My Lord has honored me.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَمَّا",
          "Arti_kata_in": "maka adapun",
          "Arti_kata_en": "And as for",
          "Text_Latin": "fa-amma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "man",
          "Text_Latin": "al-insanu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "does",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱبۡتَلَىٰهُ",
          "Arti_kata_in": "mengujinya",
          "Arti_kata_en": "try him",
          "Text_Latin": "ib'talahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "رَبُّهُۥ",
          "Arti_kata_in": "Tuhannya",
          "Arti_kata_en": "his Lord",
          "Text_Latin": "rabbuhu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "فَأَكۡرَمَهُۥ",
          "Arti_kata_in": "lalu Dia memuliakannya",
          "Arti_kata_en": "and is generous to him",
          "Text_Latin": "fa-akramahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "وَنَعَّمَهُۥ",
          "Arti_kata_in": "dan Dia memberikan nikmat padanya",
          "Arti_kata_en": "and favors him",
          "Text_Latin": "wana'amahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "فَيَقُولُ",
          "Arti_kata_in": "maka ia akan berkata",
          "Arti_kata_en": "he says",
          "Text_Latin": "fayaqulu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 10,
          "Kata_Arabic": "رَبِّيٓ",
          "Arti_kata_in": "Tuhanku",
          "Arti_kata_en": "My Lord",
          "Text_Latin": "rabbi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 11,
          "Kata_Arabic": "أَكۡرَمَنِ",
          "Arti_kata_in": "Dia telah memuliakanku",
          "Arti_kata_en": "has honored me",
          "Text_Latin": "akramani",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6009,
      "Ayat_Arabic": "وَاَمَّآ اِذَا مَا ابْتَلٰىهُ فَقَدَرَ عَلَيْهِ رِزْقَهٗ ەۙ فَيَقُوْلُ رَبِّيْٓ اَهَانَنِۚ",
      "Text_Latin": "wa amma iza mabtalahu fa qadara 'alaihi rizqahu fa yaqulu rabbi ahanan",
      "Terjemah_in": "Sementara itu, apabila Dia mengujinya lalu membatasi rezekinya, berkatalah dia, “Tuhanku telah menghinaku.”756)",
      "Terjemahan_En": "But whenever He tests him, and restricts his livelihood for him, he says, “My Lord has insulted me.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَمَّآ",
          "Arti_kata_in": "dan adapun/tetapi",
          "Arti_kata_en": "But",
          "Text_Latin": "wa-amma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "when",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "does",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱبۡتَلَىٰهُ",
          "Arti_kata_in": "mengujinya",
          "Arti_kata_en": "He try him",
          "Text_Latin": "ib'talahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "فَقَدَرَ",
          "Arti_kata_in": "lalu Dia menentukan/menyempitkan",
          "Arti_kata_en": "and restricts",
          "Text_Latin": "faqadara",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "عَلَيۡهِ",
          "Arti_kata_in": "atasnya",
          "Arti_kata_en": "for him",
          "Text_Latin": "alayhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "رِزۡقَهُۥ",
          "Arti_kata_in": "rizkinya",
          "Arti_kata_en": "his provision",
          "Text_Latin": "riz'qahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "فَيَقُولُ",
          "Arti_kata_in": "lalu dia akan berkata",
          "Arti_kata_en": "then he says",
          "Text_Latin": "fayaqulu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "رَبِّيٓ",
          "Arti_kata_in": "Tuhanku",
          "Arti_kata_en": "My Lord",
          "Text_Latin": "rabbi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 10,
          "Kata_Arabic": "أَهَٰنَنِ",
          "Arti_kata_in": "Dia menghinaku",
          "Arti_kata_en": "(has) humiliated me",
          "Text_Latin": "ahanani",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6010,
      "Ayat_Arabic": "كَلَّا بَلْ لَّا تُكْرِمُوْنَ الْيَتِيْمَۙ",
      "Text_Latin": "kalla bal la tukrimunal-yatim",
      "Terjemah_in": "Sekali-kali tidak! Sebaliknya, kamu tidak memuliakan anak yatim,757)",
      "Terjemahan_En": "Not at all. But you do not honor the orphan.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّاۖ",
          "Arti_kata_in": "sekali-kali tidak",
          "Arti_kata_en": "Nay!",
          "Text_Latin": "kalla",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "بَل",
          "Arti_kata_in": "tetapi/bahkan",
          "Arti_kata_en": "But",
          "Text_Latin": "bal",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَّا",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "not",
          "Text_Latin": "la",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "تُكۡرِمُونَ",
          "Arti_kata_in": "kamu memuliakan",
          "Arti_kata_en": "you honor",
          "Text_Latin": "tuk'rimuna",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡيَتِيمَ",
          "Arti_kata_in": "anak yatim",
          "Arti_kata_en": "the orphan",
          "Text_Latin": "al-yatima",
          "Jenis_kata": "Fiil Madhi"
        }
      ]
    },
    {
      "Nomor_ayat": 6011,
      "Ayat_Arabic": "وَلَا تَحٰۤضُّوْنَ عَلٰى طَعَامِ الْمِسْكِيْنِۙ",
      "Text_Latin": "wa la tahadduna 'ala ta'amil-miskin",
      "Terjemah_in": "tidak saling mengajak memberi makan orang miskin,",
      "Terjemahan_En": "And you do not urge the feeding of the poor.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And not",
          "Text_Latin": "wala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تَحَٰٓضُّونَ",
          "Arti_kata_in": "saling menganjurkan",
          "Arti_kata_en": "you feel the urge",
          "Text_Latin": "tahadduna",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَىٰ",
          "Arti_kata_in": "atas",
          "Arti_kata_en": "to",
          "Text_Latin": "ala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "طَعَامِ",
          "Arti_kata_in": "memberi makan",
          "Arti_kata_en": "feed",
          "Text_Latin": "ta'ami",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡمِسۡكِينِ",
          "Arti_kata_in": "orang miskin",
          "Arti_kata_en": "the poor",
          "Text_Latin": "al-mis'kini",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6012,
      "Ayat_Arabic": "وَتَأْكُلُوْنَ التُّرَاثَ اَكْلًا لَّمًّاۙ",
      "Text_Latin": "wa ta'kulunat-turasa aklal lamma",
      "Terjemah_in": "memakan harta warisan dengan cara mencampurbaurkan (yang halal dan yang haram),",
      "Terjemahan_En": "And you devour inheritance with all greed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَتَأۡكُلُونَ",
          "Arti_kata_in": "dan kamu memakan",
          "Arti_kata_en": "And you consume",
          "Text_Latin": "watakuluna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلتُّرَاثَ",
          "Arti_kata_in": "harta warisan",
          "Arti_kata_en": "the inheritance",
          "Text_Latin": "at-turatha",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَكۡلٗا",
          "Arti_kata_in": "dengan makan",
          "Arti_kata_en": "devouring",
          "Text_Latin": "aklan",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَّمّٗا",
          "Arti_kata_in": "loba",
          "Arti_kata_en": "altogether",
          "Text_Latin": "lamman",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6013,
      "Ayat_Arabic": "وَّتُحِبُّوْنَ الْمَالَ حُبًّا جَمًّاۗ",
      "Text_Latin": "wa tuhibbunal-mala hubban jamma",
      "Terjemah_in": "dan mencintai harta dengan kecintaan yang berlebihan.",
      "Terjemahan_En": "And you love wealth with immense love.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَتُحِبُّونَ",
          "Arti_kata_in": "dan kamu mencintai",
          "Arti_kata_en": "And you love",
          "Text_Latin": "watuhibbuna",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡمَالَ",
          "Arti_kata_in": "harta",
          "Arti_kata_en": "wealth",
          "Text_Latin": "al-mala",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "حُبّٗا",
          "Arti_kata_in": "cinta",
          "Arti_kata_en": "(with) love",
          "Text_Latin": "hubban",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "جَمّٗا",
          "Arti_kata_in": "berlebihan",
          "Arti_kata_en": "exceeding",
          "Text_Latin": "jamman",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6014,
      "Ayat_Arabic": "كَلَّآ اِذَا دُكَّتِ الْاَرْضُ دَكًّا دَكًّاۙ",
      "Text_Latin": "kalla iza dukkatil-ardu dakkan dakka",
      "Terjemah_in": "Jangan sekali-kali begitu! Apabila bumi diguncangkan berturut-turut (berbenturan),",
      "Terjemahan_En": "No—when the earth is leveled, pounded, and crushed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّآۖ",
          "Arti_kata_in": "sekali-kali tidak",
          "Arti_kata_en": "Nay",
          "Text_Latin": "kalla",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata_in": "apabila",
          "Arti_kata_en": "When",
          "Text_Latin": "idha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "دُكَّتِ",
          "Arti_kata_in": "digoncangkan/dihancurkan",
          "Arti_kata_en": "is leveled",
          "Text_Latin": "dukkati",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡأَرۡضُ",
          "Arti_kata_in": "bumi",
          "Arti_kata_en": "the earth",
          "Text_Latin": "al-ardu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "دَكّٗا",
          "Arti_kata_in": "goncangan",
          "Arti_kata_en": "pounded",
          "Text_Latin": "dakkan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "دَكّٗا",
          "Arti_kata_in": "goncangan",
          "Arti_kata_en": "(and) crushed",
          "Text_Latin": "dakkan",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6015,
      "Ayat_Arabic": "وَّجَاۤءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّاۚ",
      "Text_Latin": "wa ja'a rabbuka wal-malaku saffan saffa",
      "Terjemah_in": "Tuhanmu datang, begitu pula para malaikat (yang datang) berbaris-baris,",
      "Terjemahan_En": "And your Lord comes, with the angels, row after row.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَجَآءَ",
          "Arti_kata_in": "dan datang",
          "Arti_kata_en": "And comes",
          "Text_Latin": "wajaa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَبُّكَ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_Latin": "rabbuka",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَٱلۡمَلَكُ",
          "Arti_kata_in": "dan malaikat",
          "Arti_kata_en": "and the Angels",
          "Text_Latin": "wal-malaku",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "صَفّٗا",
          "Arti_kata_in": "berbaris",
          "Arti_kata_en": "rank",
          "Text_Latin": "saffan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "صَفّٗا",
          "Arti_kata_in": "baris",
          "Arti_kata_en": "(upon) rank",
          "Text_Latin": "saffan",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6016,
      "Ayat_Arabic": "وَجِايْۤءَ يَوْمَىِٕذٍۢ بِجَهَنَّمَۙ يَوْمَىِٕذٍ يَّتَذَكَّرُ الْاِنْسَانُ وَاَنّٰى لَهُ الذِّكْرٰىۗ",
      "Text_Latin": "wa ji'a yauma'izim bijahannama yauma'iziy yatazakkarul-insanu wa anna lahuz-zikra",
      "Terjemah_in": "dan pada hari itu (neraka) Jahanam didatangkan, sadarlah manusia pada hari itu juga. Akan tetapi, bagaimana bisa kesadaran itu bermanfaat baginya?",
      "Terjemahan_En": "And on that Day, Hell is brought forward. On that Day, man will remember, but how will remembrance avail him?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَجِاْيٓءَ",
          "Arti_kata_in": "dan didatangkan/diperlihatkan",
          "Arti_kata_en": "And is brought",
          "Text_Latin": "wajia",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمَئِذِۭ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "that Day",
          "Text_Latin": "yawma-idhin",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِجَهَنَّمَۚ",
          "Arti_kata_in": "neraka Jahanam",
          "Arti_kata_en": "Hell",
          "Text_Latin": "bijahannama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَوۡمَئِذٖ",
          "Arti_kata_in": "pada hari itu",
          "Arti_kata_en": "That Day",
          "Text_Latin": "yawma-idhin",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "يَتَذَكَّرُ",
          "Arti_kata_in": "akan ingat",
          "Arti_kata_en": "will remember",
          "Text_Latin": "yatadhakkaru",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "man",
          "Text_Latin": "al-insanu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "وَأَنَّىٰ",
          "Arti_kata_in": "dan bagaimana",
          "Arti_kata_en": "but how",
          "Text_Latin": "wa-anna",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "لَهُ",
          "Arti_kata_in": "baginya",
          "Arti_kata_en": "(will be) for him",
          "Text_Latin": "lahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "ٱلذِّكۡرَىٰ",
          "Arti_kata_in": "ingat/mengingat",
          "Arti_kata_en": "the remembrance",
          "Text_Latin": "ad-dhik'ra",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6017,
      "Ayat_Arabic": "يَقُوْلُ يٰلَيْتَنِيْ قَدَّمْتُ لِحَيَاتِيْۚ",
      "Text_Latin": "yaqulu ya laitani qaddamtu lihayati",
      "Terjemah_in": "Dia berkata, “Oh, seandainya dahulu aku mengerjakan (kebajikan) untuk hidupku ini!”",
      "Terjemahan_En": "He will say, “If only I had forwarded for my life.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَقُولُ",
          "Arti_kata_in": "dia berkata",
          "Arti_kata_en": "He will say",
          "Text_Latin": "yaqulu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَٰلَيۡتَنِي",
          "Arti_kata_in": "alangkah baiknya aku dulu",
          "Arti_kata_en": "O! I wish",
          "Text_Latin": "yalaytani",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "قَدَّمۡتُ",
          "Arti_kata_in": "aku dahulukan/kerjakan",
          "Arti_kata_en": "I had sent forth",
          "Text_Latin": "qaddamtu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لِحَيَاتِي",
          "Arti_kata_in": "untuk hidupku",
          "Arti_kata_en": "for my life",
          "Text_Latin": "lihayati",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6018,
      "Ayat_Arabic": "فَيَوْمَىِٕذٍ لَّا يُعَذِّبُ عَذَابَهٗٓ اَحَدٌ ۙ",
      "Text_Latin": "fa yauma'izil la yu'azzibu 'azabahu ahad",
      "Terjemah_in": "Pada hari itu tidak ada seorang pun yang mampu mengazab (seadil) azab-Nya.",
      "Terjemahan_En": "On that Day, none will punish as He punishes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَيَوۡمَئِذٖ",
          "Arti_kata_in": "maka pada hari itu",
          "Arti_kata_en": "So that Day",
          "Text_Latin": "fayawma-idhin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَّا",
          "Arti_kata_in": "tidak",
          "Arti_kata_en": "not",
          "Text_Latin": "la",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يُعَذِّبُ",
          "Arti_kata_in": "menyiksa",
          "Arti_kata_en": "will punish",
          "Text_Latin": "yu'adhibu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "عَذَابَهُۥٓ",
          "Arti_kata_in": "siksa-Nya",
          "Arti_kata_en": "(as) His punishment",
          "Text_Latin": "adhabahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَحَدٞ",
          "Arti_kata_in": "seorang/satu",
          "Arti_kata_en": "anyone",
          "Text_Latin": "ahadun",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6019,
      "Ayat_Arabic": "وَّلَا يُوْثِقُ وَثَاقَهٗٓ اَحَدٌ ۗ",
      "Text_Latin": "wa la yusiqu wasaqahu ahad",
      "Terjemah_in": "Tidak ada seorang pun juga yang mampu mengikat (sekuat) ikatan-Nya.",
      "Terjemahan_En": "And none will shackle as He shackles.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَا",
          "Arti_kata_in": "dan tidak",
          "Arti_kata_en": "And not",
          "Text_Latin": "wala",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يُوثِقُ",
          "Arti_kata_in": "mengikat",
          "Arti_kata_en": "will bind",
          "Text_Latin": "yuthiqu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَثَاقَهُۥٓ",
          "Arti_kata_in": "ikatan-Nya",
          "Arti_kata_en": "(as) His binding",
          "Text_Latin": "wathaqahu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَحَدٞ",
          "Arti_kata_in": "seorang/satu",
          "Arti_kata_en": "anyone",
          "Text_Latin": "ahadun",
          "Jenis_kata": "Fiil Mudhorik"
        }
      ]
    },
    {
      "Nomor_ayat": 6020,
      "Ayat_Arabic": "يٰٓاَيَّتُهَا النَّفْسُ الْمُطْمَىِٕنَّةُۙ",
      "Text_Latin": "ya ayyatuhan-nafsul-mutma'innah",
      "Terjemah_in": "Wahai jiwa yang tenang,",
      "Terjemahan_En": "But as for you, O tranquil soul.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَٰٓأَيَّتُهَا",
          "Arti_kata_in": "hai",
          "Arti_kata_en": "O",
          "Text_Latin": "yaayyatuha",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلنَّفۡسُ",
          "Arti_kata_in": "jiwa/diri",
          "Arti_kata_en": "soul",
          "Text_Latin": "an-nafsu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡمُطۡمَئِنَّةُ",
          "Arti_kata_in": "tenang",
          "Arti_kata_en": "who is satisfied",
          "Text_Latin": "al-mut'ma-inatu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6021,
      "Ayat_Arabic": "ارْجِعِيْٓ اِلٰى رَبِّكِ رَاضِيَةً مَّرْضِيَّةً ۚ",
      "Text_Latin": "irji'i ila rabbiki radiyatam mardiyyah",
      "Terjemah_in": "kembalilah kepada Tuhanmu dengan rida dan diridai.",
      "Terjemahan_En": "Return to your Lord, pleased and accepted.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱرۡجِعِيٓ",
          "Arti_kata_in": "kembalilah",
          "Arti_kata_en": "Return",
          "Text_Latin": "ir'ji'i",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِلَىٰ",
          "Arti_kata_in": "kepada",
          "Arti_kata_en": "to",
          "Text_Latin": "ila",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبِّكِ",
          "Arti_kata_in": "Tuhanmu",
          "Arti_kata_en": "your Lord",
          "Text_Latin": "rabbiki",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "رَاضِيَةٗ",
          "Arti_kata_in": "rida/puas",
          "Arti_kata_en": "well pleased",
          "Text_Latin": "radiyatan",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "مَّرۡضِيَّةٗ",
          "Arti_kata_in": "diridhoi",
          "Arti_kata_en": "and pleasing",
          "Text_Latin": "mardiyyatan",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6022,
      "Ayat_Arabic": "فَادْخُلِيْ فِيْ عِبٰدِيْۙ",
      "Text_Latin": "fadkhuli fi 'ibadi",
      "Terjemah_in": "Lalu, masuklah ke dalam golongan hamba-hamba-Ku",
      "Terjemahan_En": "Enter among My servants.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱدۡخُلِي",
          "Arti_kata_in": "maka masuklah",
          "Arti_kata_en": "So enter",
          "Text_Latin": "fa-ud'khuli",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "among",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عِبَٰدِي",
          "Arti_kata_in": "hamba-Ku",
          "Arti_kata_en": "My slaves",
          "Text_Latin": "ibadi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6023,
      "Ayat_Arabic": "وَادْخُلِيْ جَنَّتِيْ ࣖࣖ",
      "Text_Latin": "wadkhuli jannati",
      "Terjemah_in": "dan masuklah ke dalam surga-Ku!",
      "Terjemahan_En": "Enter My Paradise.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱدۡخُلِي",
          "Arti_kata_in": "dan masuklah",
          "Arti_kata_en": "And enter",
          "Text_Latin": "wa-ud'khuli",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "جَنَّتِي",
          "Arti_kata_in": "surga-Ku",
          "Arti_kata_en": "My Paradise",
          "Text_Latin": "jannati",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
}