          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6011,
      "Ayat_Arabic": "وَلَا تَحٰۤضُّوْنَ عَلٰى طَعَامِ الْمِسْكِيْنِۙ",
      "Text_Latin": "wa la tahadduna 'ala ta'amil-miskin",
      "Terjemah_in": "tidak saling mengajak memberi makan orang miskin,",
      "Terjemahan_En": "And you do not urge the feeding of the poor.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَا",
          "Arti_kata": "dan tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تَحَٰٓضُّونَ",
          "Arti_kata": "saling menganjurkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عَلَىٰ",
          "Arti_kata": "atas",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "طَعَامِ",
          "Arti_kata": "memberi makan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡمِسۡكِينِ",
          "Arti_kata": "orang miskin",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6012,
      "Ayat_Arabic": "وَتَأْكُلُوْنَ التُّرَاثَ اَكْلًا لَّمًّاۙ",
      "Text_Latin": "wa ta'kulunat-turasa aklal lamma",
      "Terjemah_in": "memakan harta warisan dengan cara mencampurbaurkan (yang halal dan yang haram),",
      "Terjemahan_En": "And you devour inheritance with all greed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَتَأۡكُلُونَ",
          "Arti_kata": "dan kamu memakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلتُّرَاثَ",
          "Arti_kata": "harta warisan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أَكۡلٗا",
          "Arti_kata": "dengan makan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لَّمّٗا",
          "Arti_kata": "loba",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6013,
      "Ayat_Arabic": "وَّتُحِبُّوْنَ الْمَالَ حُبًّا جَمًّاۗ",
      "Text_Latin": "wa tuhibbunal-mala hubban jamma",
      "Terjemah_in": "dan mencintai harta dengan kecintaan yang berlebihan.",
      "Terjemahan_En": "And you love wealth with immense love.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَتُحِبُّونَ",
          "Arti_kata": "dan kamu mencintai",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡمَالَ",
          "Arti_kata": "harta",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "حُبّٗا",
          "Arti_kata": "cinta",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "جَمّٗا",
          "Arti_kata": "berlebihan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6014,
      "Ayat_Arabic": "كَلَّآ اِذَا دُكَّتِ الْاَرْضُ دَكًّا دَكًّاۙ",
      "Text_Latin": "kalla iza dukkatil-ardu dakkan dakka",
      "Terjemah_in": "Jangan sekali-kali begitu! Apabila bumi diguncangkan berturut-turut (berbenturan),",
      "Terjemahan_En": "No—when the earth is leveled, pounded, and crushed.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَلَّآۖ",
          "Arti_kata": "sekali-kali tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata": "apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "دُكَّتِ",
          "Arti_kata": "digoncangkan/dihancurkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡأَرۡضُ",
          "Arti_kata": "bumi",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "دَكّٗا",
          "Arti_kata": "goncangan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "دَكّٗا",
          "Arti_kata": "goncangan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6015,
      "Ayat_Arabic": "وَّجَاۤءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّاۚ",
      "Text_Latin": "wa ja'a rabbuka wal-malaku saffan saffa",
      "Terjemah_in": "Tuhanmu datang, begitu pula para malaikat (yang datang) berbaris-baris,",
      "Terjemahan_En": "And your Lord comes, with the angels, row after row.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَجَآءَ",
          "Arti_kata": "dan datang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَبُّكَ",
          "Arti_kata": "Tuhanmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَٱلۡمَلَكُ",
          "Arti_kata": "dan malaikat",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "صَفّٗا",
          "Arti_kata": "berbaris",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "صَفّٗا",
          "Arti_kata": "baris",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6016,
      "Ayat_Arabic": "وَجِايْۤءَ يَوْمَىِٕذٍۢ بِجَهَنَّمَۙ يَوْمَىِٕذٍ يَّتَذَكَّرُ الْاِنْسَانُ وَاَنّٰى لَهُ الذِّكْرٰىۗ",
      "Text_Latin": "wa ji'a yauma'izim bijahannama yauma'iziy yatazakkarul-insanu wa anna lahuz-zikra",
      "Terjemah_in": "dan pada hari itu (neraka) Jahanam didatangkan, sadarlah manusia pada hari itu juga. Akan tetapi, bagaimana bisa kesadaran itu bermanfaat baginya?",
      "Terjemahan_En": "And on that Day, Hell is brought forward. On that Day, man will remember, but how will remembrance avail him?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَجِاْيٓءَ",
          "Arti_kata": "dan didatangkan/diperlihatkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمَئِذِۭ",
          "Arti_kata": "pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِجَهَنَّمَۚ",
          "Arti_kata": "neraka Jahanam",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَوۡمَئِذٖ",
          "Arti_kata": "pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "يَتَذَكَّرُ",
          "Arti_kata": "akan ingat",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "وَأَنَّىٰ",
          "Arti_kata": "dan bagaimana",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "لَهُ",
          "Arti_kata": "baginya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "ٱلذِّكۡرَىٰ",
          "Arti_kata": "ingat/mengingat",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6017,
      "Ayat_Arabic": "يَقُوْلُ يٰلَيْتَنِيْ قَدَّمْتُ لِحَيَاتِيْۚ",
      "Text_Latin": "yaqulu ya laitani qaddamtu lihayati",
      "Terjemah_in": "Dia berkata, “Oh, seandainya dahulu aku mengerjakan (kebajikan) untuk hidupku ini!”",
      "Terjemahan_En": "He will say, “If only I had forwarded for my life.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَقُولُ",
          "Arti_kata": "dia berkata",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَٰلَيۡتَنِي",
          "Arti_kata": "alangkah baiknya aku dulu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "قَدَّمۡتُ",
          "Arti_kata": "aku dahulukan/kerjakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "لِحَيَاتِي",
          "Arti_kata": "untuk hidupku",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6018,
      "Ayat_Arabic": "فَيَوْمَىِٕذٍ لَّا يُعَذِّبُ عَذَابَهٗٓ اَحَدٌ ۙ",
      "Text_Latin": "fa yauma'izil la yu'azzibu 'azabahu ahad",
      "Terjemah_in": "Pada hari itu tidak ada seorang pun yang mampu mengazab (seadil) azab-Nya.",
      "Terjemahan_En": "On that Day, none will punish as He punishes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَيَوۡمَئِذٖ",
          "Arti_kata": "maka pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَّا",
          "Arti_kata": "tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يُعَذِّبُ",
          "Arti_kata": "menyiksa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "عَذَابَهُۥٓ",
          "Arti_kata": "siksa-Nya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "أَحَدٞ",
          "Arti_kata": "seorang/satu",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6019,
      "Ayat_Arabic": "وَّلَا يُوْثِقُ وَثَاقَهٗٓ اَحَدٌ ۗ",
      "Text_Latin": "wa la yusiqu wasaqahu ahad",
      "Terjemah_in": "Tidak ada seorang pun juga yang mampu mengikat (sekuat) ikatan-Nya.",
      "Terjemahan_En": "And none will shackle as He shackles.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَا",
          "Arti_kata": "dan tidak",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يُوثِقُ",
          "Arti_kata": "mengikat",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "وَثَاقَهُۥٓ",
          "Arti_kata": "ikatan-Nya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "أَحَدٞ",
          "Arti_kata": "seorang/satu",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6020,
      "Ayat_Arabic": "يٰٓاَيَّتُهَا النَّفْسُ الْمُطْمَىِٕنَّةُۙ",
      "Text_Latin": "ya ayyatuhan-nafsul-mutma'innah",
      "Terjemah_in": "Wahai jiwa yang tenang,",
      "Terjemahan_En": "But as for you, O tranquil soul.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَٰٓأَيَّتُهَا",
          "Arti_kata": "hai",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلنَّفۡسُ",
          "Arti_kata": "jiwa/diri",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡمُطۡمَئِنَّةُ",
          "Arti_kata": "tenang",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6021,
      "Ayat_Arabic": "ارْجِعِيْٓ اِلٰى رَبِّكِ رَاضِيَةً مَّرْضِيَّةً ۚ",
      "Text_Latin": "irji'i ila rabbiki radiyatam mardiyyah",
      "Terjemah_in": "kembalilah kepada Tuhanmu dengan rida dan diridai.",
      "Terjemahan_En": "Return to your Lord, pleased and accepted.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱرۡجِعِيٓ",
          "Arti_kata": "kembalilah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِلَىٰ",
          "Arti_kata": "kepada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبِّكِ",
          "Arti_kata": "Tuhanmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "رَاضِيَةٗ",
          "Arti_kata": "rida/puas",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "مَّرۡضِيَّةٗ",
          "Arti_kata": "diridhoi",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6022,
      "Ayat_Arabic": "فَادْخُلِيْ فِيْ عِبٰدِيْۙ",
      "Text_Latin": "fadkhuli fi 'ibadi",
      "Terjemah_in": "Lalu, masuklah ke dalam golongan hamba-hamba-Ku",
      "Terjemahan_En": "Enter among My servants.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱدۡخُلِي",
          "Arti_kata": "maka masuklah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فِي",
          "Arti_kata": "dalam",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عِبَٰدِي",
          "Arti_kata": "hamba-Ku",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6023,
      "Ayat_Arabic": "وَادْخُلِيْ جَنَّتِيْ ࣖࣖ",
      "Text_Latin": "wadkhuli jannati",
      "Terjemah_in": "dan masuklah ke dalam surga-Ku!",
      "Terjemahan_En": "Enter My Paradise.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱدۡخُلِي",
          "Arti_kata": "dan masuklah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "جَنَّتِي",
          "Arti_kata": "surga-Ku",
          "Jenis_kata": null
        }
      ]
    }
  ]
}