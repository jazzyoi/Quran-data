{
  "Nomor_surat": 89,
  "Nama_surat": "Al-Fajr",
  "surat_arabic": "الفجر",
  "Arti_surat_in": "Fajar",
  "Arti_surat_en": "The Dawn",
  "Ayat": [
    {
      "Nomor_ayat": 5994,
      "Ayat_Arabic": "وَالْفَجْرِۙ",
      "Text_Latin": "wal-fajr",
      "Terjemah_in": "Demi waktu fajar,",
      "Terjemahan_En": "By the daybreak.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡفَجۡرِ",
          "Arti_kata": "demi fajar",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5995,
      "Ayat_Arabic": "وَلَيَالٍ عَشْرٍۙ",
      "Text_Latin": "wa layalin 'asyr",
      "Terjemah_in": "demi malam yang sepuluh,754)",
      "Terjemahan_En": "And ten nights.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَلَيَالٍ",
          "Arti_kata": "dan malam-malam",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَشۡرٖ",
          "Arti_kata": "sepuluh",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5996,
      "Ayat_Arabic": "وَّالشَّفْعِ وَالْوَتْرِۙ",
      "Text_Latin": "wasy-syaf'i wal-watr",
      "Terjemah_in": "demi yang genap dan yang ganjil,",
      "Terjemahan_En": "And the even and the odd.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلشَّفۡعِ",
          "Arti_kata": "dan yang genap",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "وَٱلۡوَتۡرِ",
          "Arti_kata": "dan yang ganjil",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5997,
      "Ayat_Arabic": "وَالَّيْلِ اِذَا يَسْرِۚ",
      "Text_Latin": "wal-laili iza yasr",
      "Terjemah_in": "dan demi malam apabila berlalu.",
      "Terjemahan_En": "And the night as it recedes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلَّيۡلِ",
          "Arti_kata": "dan malam",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata": "apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يَسۡرِ",
          "Arti_kata": "berlalu",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5998,
      "Ayat_Arabic": "هَلْ فِيْ ذٰلِكَ قَسَمٌ لِّذِيْ حِجْرٍۗ",
      "Text_Latin": "hal fi zalika qasamul lizi hijr",
      "Terjemah_in": "Apakah pada yang demikian itu terdapat sumpah (yang dapat diterima) oleh (orang) yang berakal?",
      "Terjemahan_En": "Is there in this an oath for a rational person?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "هَلۡ",
          "Arti_kata": "apakah/bukankah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فِي",
          "Arti_kata": "pada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ذَٰلِكَ",
          "Arti_kata": "itu/yang demikian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "قَسَمٞ",
          "Arti_kata": "sumpah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "لِّذِي",
          "Arti_kata": "bagi memiliki",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "حِجۡرٍ",
          "Arti_kata": "akal",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5999,
      "Ayat_Arabic": "اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍۖ",
      "Text_Latin": "a lam tara kaifa fa'ala rabbuka bi'ad",
      "Terjemah_in": "Tidakkah engkau (Nabi Muhammad) memperhatikan bagaimana Tuhanmu berbuat terhadap (kaum) ‘Ad,",
      "Terjemahan_En": "Have you not seen how your Lord dealt with Aad?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَلَمۡ",
          "Arti_kata": "tidakkah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تَرَ",
          "Arti_kata": "lihat/perhatikan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كَيۡفَ",
          "Arti_kata": "bagaimana",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "فَعَلَ",
          "Arti_kata": "berbuat",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "رَبُّكَ",
          "Arti_kata": "Tuhanmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "بِعَادٍ",
          "Arti_kata": "terhadap kaum 'Ad",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6000,
      "Ayat_Arabic": "اِرَمَ ذَاتِ الْعِمَادِۖ",
      "Text_Latin": "irama zatil-'imad",
      "Terjemah_in": "(yaitu) penduduk Iram (ibu kota kaum ‘Ad) yang mempunyai bangunan-bangunan yang tinggi",
      "Terjemahan_En": "Erum of the pillars.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِرَمَ",
          "Arti_kata": "kaum Iram",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ذَاتِ",
          "Arti_kata": "memiliki",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡعِمَادِ",
          "Arti_kata": "tiang/bangunan tinggi",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6001,
      "Ayat_Arabic": "الَّتِيْ لَمْ يُخْلَقْ مِثْلُهَا فِى الْبِلَادِۖ",
      "Text_Latin": "allati lam yukhlaq misluha fil-bilad",
      "Terjemah_in": "yang sebelumnya tidak pernah dibangun (suatu kota pun) seperti itu di negeri-negeri (lain)?",
      "Terjemahan_En": "The like of which was never created in the land.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّتِي",
          "Arti_kata": "yang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "لَمۡ",
          "Arti_kata": "tidak/belum",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "يُخۡلَقۡ",
          "Arti_kata": "diciptakan/dibangun",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مِثۡلُهَا",
          "Arti_kata": "seperti itu/serupa itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "فِي",
          "Arti_kata": "pada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "ٱلۡبِلَٰدِ",
          "Arti_kata": "negeri",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6002,
      "Ayat_Arabic": "وَثَمُوْدَ الَّذِيْنَ جَابُوا الصَّخْرَ بِالْوَادِۖ",
      "Text_Latin": "wa samudallazina jabus-sakhra bil-wad",
      "Terjemah_in": "(Tidakkah engkau perhatikan pula kaum) Samud yang memotong batu-batu besar di lembah755)",
      "Terjemahan_En": "And Thamood—those who carved the rocks in the valley.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَثَمُودَ",
          "Arti_kata": "dan Samud",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلَّذِينَ",
          "Arti_kata": "orang-orang yang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "جَابُواْ",
          "Arti_kata": "(mereka) memotong",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلصَّخۡرَ",
          "Arti_kata": "batu-batu besar",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "بِٱلۡوَادِ",
          "Arti_kata": "di lembah",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6003,
      "Ayat_Arabic": "وَفِرْعَوْنَ ذِى الْاَوْتَادِۖ",
      "Text_Latin": "wa fir'auna zil-autad",
      "Terjemah_in": "dan Fir‘aun yang mempunyai pasak-pasak (bangunan yang besar)",
      "Terjemahan_En": "And Pharaoh of the Stakes.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَفِرۡعَوۡنَ",
          "Arti_kata": "dan Fir'aun",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ذِي",
          "Arti_kata": "memiliki",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡأَوۡتَادِ",
          "Arti_kata": "pasak-pasak (bala tentara)",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6004,
      "Ayat_Arabic": "الَّذِيْنَ طَغَوْا فِى الْبِلَادِۖ",
      "Text_Latin": "allazina tagau fil-bilad",
      "Terjemah_in": "yang berbuat sewenang-wenang dalam negeri,",
      "Terjemahan_En": "Those who committed excesses in the lands.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِينَ",
          "Arti_kata": "orang-orang yang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "طَغَوۡاْ",
          "Arti_kata": "(mereka) melampui batas",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فِي",
          "Arti_kata": "pada",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡبِلَٰدِ",
          "Arti_kata": "negeri-negeri itu",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6005,
      "Ayat_Arabic": "فَاَكْثَرُوْا فِيْهَا الْفَسَادَۖ",
      "Text_Latin": "fa aksaru fihal-fasad",
      "Terjemah_in": "lalu banyak berbuat kerusakan di dalamnya (negeri itu),",
      "Terjemahan_En": "And spread much corruption therein.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَكۡثَرُواْ",
          "Arti_kata": "lalu mereka banyak berbuat",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فِيهَا",
          "Arti_kata": "didalamnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡفَسَادَ",
          "Arti_kata": "kerusakan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6006,
      "Ayat_Arabic": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۖ",
      "Text_Latin": "fa sabba 'alaihim rabbuka sauta 'azab",
      "Terjemah_in": "maka Tuhanmu menimpakan cemeti azab (yang dahsyat) kepada mereka?",
      "Terjemahan_En": "So your Lord poured down upon them a scourge of punishment.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَصَبَّ",
          "Arti_kata": "maka menimpakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَلَيۡهِمۡ",
          "Arti_kata": "atas mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "رَبُّكَ",
          "Arti_kata": "Tuhanmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "سَوۡطَ",
          "Arti_kata": "cemeti/cambuk",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "عَذَابٍ",
          "Arti_kata": "azab",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6007,
      "Ayat_Arabic": "اِنَّ رَبَّكَ لَبِالْمِرْصَادِۗ",
      "Text_Latin": "inna rabbaka labil-mirsad",
      "Terjemah_in": "Sesungguhnya Tuhanmu benar-benar mengawasi.",
      "Terjemahan_En": "Your Lord is on the lookout.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata": "sesungguhnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَبَّكَ",
          "Arti_kata": "Tuhanmu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَبِٱلۡمِرۡصَادِ",
          "Arti_kata": "benar-benar mengawasi",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6008,
      "Ayat_Arabic": "فَاَمَّا الْاِنْسَانُ اِذَا مَا ابْتَلٰىهُ رَبُّهٗ فَاَكْرَمَهٗ وَنَعَّمَهٗۙ فَيَقُوْلُ رَبِّيْٓ اَكْرَمَنِۗ",
      "Text_Latin": "fa ammal-insanu iza mabtalahu rabbuhu fa akramahu wa na''amahu fa yaqulu rabbi akraman",
      "Terjemah_in": "Adapun manusia, apabila Tuhan mengujinya lalu memuliakannya dan memberinya kenikmatan, berkatalah dia, “Tuhanku telah memuliakanku.”",
      "Terjemahan_En": "As for man, whenever his Lord tests him, and honors him, and prospers him, he says, “My Lord has honored me.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَمَّا",
          "Arti_kata": "maka adapun",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡإِنسَٰنُ",
          "Arti_kata": "manusia",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "إِذَا",
          "Arti_kata": "apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَا",
          "Arti_kata": "apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱبۡتَلَىٰهُ",
          "Arti_kata": "mengujinya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "رَبُّهُۥ",
          "Arti_kata": "Tuhannya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "فَأَكۡرَمَهُۥ",
          "Arti_kata": "lalu Dia memuliakannya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "وَنَعَّمَهُۥ",
          "Arti_kata": "dan Dia memberikan nikmat padanya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "فَيَقُولُ",
          "Arti_kata": "maka ia akan berkata",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 10,
          "Kata_Arabic": "رَبِّيٓ",
          "Arti_kata": "Tuhanku",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 11,
          "Kata_Arabic": "أَكۡرَمَنِ",
          "Arti_kata": "Dia telah memuliakanku",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6009,
      "Ayat_Arabic": "وَاَمَّآ اِذَا مَا ابْتَلٰىهُ فَقَدَرَ عَلَيْهِ رِزْقَهٗ ەۙ فَيَقُوْلُ رَبِّيْٓ اَهَانَنِۚ",
      "Text_Latin": "wa amma iza mabtalahu fa qadara 'alaihi rizqahu fa yaqulu rabbi ahanan",
      "Terjemah_in": "Sementara itu, apabila Dia mengujinya lalu membatasi rezekinya, berkatalah dia, “Tuhanku telah menghinaku.”756)",
      "Terjemahan_En": "But whenever He tests him, and restricts his livelihood for him, he says, “My Lord has insulted me.”",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَمَّآ",
          "Arti_kata": "dan adapun/tetapi",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "إِذَا",
          "Arti_kata": "apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata": "apa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱبۡتَلَىٰهُ",
          "Arti_kata": "mengujinya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "فَقَدَرَ",
          "Arti_kata": "lalu Dia menentukan/menyempitkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "عَلَيۡهِ",
          "Arti_kata": "atasnya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "رِزۡقَهُۥ",
          "Arti_kata": "rizkinya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 8,
          "Kata_Arabic": "فَيَقُولُ",
          "Arti_kata": "lalu dia akan berkata",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 9,
          "Kata_Arabic": "رَبِّيٓ",
          "Arti_kata": "Tuhanku",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 10,
          "Kata_Arabic": "أَهَٰنَنِ",
          "Arti_kata": "Dia menghinaku",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6010,
      "Ayat_Arabic": "كَلَّا بَلْ لَّا تُكْرِمُوْنَ الْيَتِيْمَۙ",
      "Text_Latin": "kalla bal la tukrimunal-yatim",
      "Terjemah_in": "Sekali-kali tidak! Sebaliknya, kamu tidak memuliakan anak yatim,757)",
      "Terjemahan_En": "Not at all. But you do not honor the orphan.",
      "Kata": [
        {
