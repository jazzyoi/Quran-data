{
  "Nomor_surat": 106,
  "Nama_surat": "Quraysh",
  "surat_arabic": "قريش",
  "Arti_surat_in": "Suku Quraisy",
  "Arti_surat_en": "Quraish",
  "Ayat": [
    {
      "Nomor_ayat": 6194,
      "Ayat_Arabic": "لِاِيْلٰفِ قُرَيْشٍۙ",
      "Text_Latin": "li'ilafi quraisy",
      "Terjemah_in": "Disebabkan oleh kebiasaan orang-orang Quraisy,",
      "Terjemahan_En": "For the security of Quraish.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لِإِيلَٰفِ",
          "Arti_kata_in": "karena kebiasaan",
          "Arti_kata_en": "For (the) familiarity",
          "Text_Latin": "liilafi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "قُرَيۡشٍ",
          "Arti_kata_in": "orang-orang Qurais",
          "Arti_kata_en": "(of the) Quraish",
          "Text_Latin": "qurayshin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6195,
      "Ayat_Arabic": "اٖلٰفِهِمْ رِحْلَةَ الشِّتَاۤءِ وَالصَّيْفِۚ",
      "Text_Latin": "ilafihim rihlatasy-syita'i was-saif",
      "Terjemah_in": "(yaitu) kebiasaan mereka bepergian pada musim dingin dan musim panas (sehingga mendapatkan banyak keuntungan),",
      "Terjemahan_En": "Their security during winter and summer journeys.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِۦلَٰفِهِمۡ",
          "Arti_kata_in": "kebiasaan mereka",
          "Arti_kata_en": "Their familiarity",
          "Text_Latin": "ilafihim",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رِحۡلَةَ",
          "Arti_kata_in": "perjalanan/bepergian",
          "Arti_kata_en": "(with the) journey",
          "Text_Latin": "rih'lata",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلشِّتَآءِ",
          "Arti_kata_in": "dimusim dingin",
          "Arti_kata_en": "(of) winter",
          "Text_Latin": "as-shitai",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَٱلصَّيۡفِ",
          "Arti_kata_in": "dan musim panas",
          "Arti_kata_en": "and summer",
          "Text_Latin": "was-sayfi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6196,
      "Ayat_Arabic": "فَلْيَعْبُدُوْا رَبَّ هٰذَا الْبَيْتِۙ",
      "Text_Latin": "falya'budu rabba hazal-bait",
      "Terjemah_in": "maka hendaklah mereka menyembah Tuhan (pemilik) rumah ini (Ka‘bah)",
      "Terjemahan_En": "Let them worship the Lord of this House.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَلۡيَعۡبُدُواْ",
          "Arti_kata_in": "maka hendaklah mereka menyembah",
          "Arti_kata_en": "So let them worship",
          "Text_Latin": "falya'budu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَبَّ",
          "Arti_kata_in": "Tuhan",
          "Arti_kata_en": "(the) Lord",
          "Text_Latin": "rabba",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "هَٰذَا",
          "Arti_kata_in": "ini",
          "Arti_kata_en": "(of) this",
          "Text_Latin": "hadha",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡبَيۡتِ",
          "Arti_kata_in": "rumah",
          "Arti_kata_en": "House",
          "Text_Latin": "al-bayti",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6197,
      "Ayat_Arabic": "الَّذِيْٓ اَطْعَمَهُمْ مِّنْ جُوْعٍ ەۙ وَّاٰمَنَهُمْ مِّنْ خَوْفٍ ࣖ",
      "Text_Latin": "allazi at'amahum min ju'iw wa amanahum min khauf",
      "Terjemah_in": "yang telah memberi mereka makanan untuk menghilangkan lapar dan mengamankan mereka dari rasa takut.",
      "Terjemahan_En": "Who has fed them against hunger, and has secured them against fear.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِيٓ",
          "Arti_kata_in": "yang",
          "Arti_kata_en": "The One Who",
          "Text_Latin": "alladhi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَطۡعَمَهُم",
          "Arti_kata_in": "Dia memberi makan mereka",
          "Arti_kata_en": "feeds them",
          "Text_Latin": "at'amahum",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مِّن",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "against",
          "Text_Latin": "min",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "جُوعٖ",
          "Arti_kata_in": "kelaparan",
          "Arti_kata_en": "hunger",
          "Text_Latin": "ju'in",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَءَامَنَهُم",
          "Arti_kata_in": "dan Dia memberikan keamanan mereka",
          "Arti_kata_en": "and gives them security",
          "Text_Latin": "waamanahum",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "مِّنۡ",
          "Arti_kata_in": "dari",
          "Arti_kata_en": "against",
          "Text_Latin": "min",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "خَوۡفِۭ",
          "Arti_kata_in": "ketakutan",
          "Arti_kata_en": "fear",
          "Text_Latin": "khawfin",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
}