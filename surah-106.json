{
  "Nomor_surat": 106,
  "Nama_surat": "Quraysh",
  "surat_arabic": "قريش",
  "Arti_surat_in": "Suku Quraisy",
  "Arti_surat_en": "Quraish",
  "Ayat": [
    {
      "Nomor_ayat": 6194,
      "Ayat_Arabic": "لِاِيْلٰفِ قُرَيْشٍۙ",
      "Text_Latin": "li'ilafi quraisy",
      "Terjemah_in": "Disebabkan oleh kebiasaan orang-orang Quraisy,",
      "Terjemahan_En": "For the security of Quraish.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لِإِيلَٰفِ",
          "Arti_kata": "karena kebiasaan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "قُرَيۡشٍ",
          "Arti_kata": "orang-orang Qurais",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6195,
      "Ayat_Arabic": "اٖلٰفِهِمْ رِحْلَةَ الشِّتَاۤءِ وَالصَّيْفِۚ",
      "Text_Latin": "ilafihim rihlatasy-syita'i was-saif",
      "Terjemah_in": "(yaitu) kebiasaan mereka bepergian pada musim dingin dan musim panas (sehingga mendapatkan banyak keuntungan),",
      "Terjemahan_En": "Their security during winter and summer journeys.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِۦلَٰفِهِمۡ",
          "Arti_kata": "kebiasaan mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رِحۡلَةَ",
          "Arti_kata": "perjalanan/bepergian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلشِّتَآءِ",
          "Arti_kata": "dimusim dingin",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "وَٱلصَّيۡفِ",
          "Arti_kata": "dan musim panas",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6196,
      "Ayat_Arabic": "فَلْيَعْبُدُوْا رَبَّ هٰذَا الْبَيْتِۙ",
      "Text_Latin": "falya'budu rabba hazal-bait",
      "Terjemah_in": "maka hendaklah mereka menyembah Tuhan (pemilik) rumah ini (Ka‘bah)",
      "Terjemahan_En": "Let them worship the Lord of this House.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَلۡيَعۡبُدُواْ",
          "Arti_kata": "maka hendaklah mereka menyembah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "رَبَّ",
          "Arti_kata": "Tuhan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "هَٰذَا",
          "Arti_kata": "ini",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡبَيۡتِ",
          "Arti_kata": "rumah",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 6197,
      "Ayat_Arabic": "الَّذِيْٓ اَطْعَمَهُمْ مِّنْ جُوْعٍ ەۙ وَّاٰمَنَهُمْ مِّنْ خَوْفٍ ࣖ",
      "Text_Latin": "allazi at'amahum min ju'iw wa amanahum min khauf",
      "Terjemah_in": "yang telah memberi mereka makanan untuk menghilangkan lapar dan mengamankan mereka dari rasa takut.",
      "Terjemahan_En": "Who has fed them against hunger, and has secured them against fear.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلَّذِيٓ",
          "Arti_kata": "yang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَطۡعَمَهُم",
          "Arti_kata": "Dia memberi makan mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مِّن",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "جُوعٖ",
          "Arti_kata": "kelaparan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَءَامَنَهُم",
          "Arti_kata": "dan Dia memberikan keamanan mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 6,
          "Kata_Arabic": "مِّنۡ",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 7,
          "Kata_Arabic": "خَوۡفِۭ",
          "Arti_kata": "ketakutan",
          "Jenis_kata": null
        }
      ]
    }
  ]
}