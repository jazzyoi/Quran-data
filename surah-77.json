    },
    {
      "Nomor_ayat": 5662,
      "Ayat_Arabic": "وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ࣖ",
      "Text_Latin": "wailuy yauma'izil lil-mukazzibin",
      "Terjemah_in": "Celakalah pada hari itu para pendusta (kebenaran).",
      "Terjemahan_En": "Woe on that Day to the falsifiers.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَيۡلٞ",
          "Arti_kata": "kecelakaan",
          "Jenis_kata": null
        },
        {
