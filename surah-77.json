        {
          "Nomor_kata": 6,
          "Kata_Arabic": "تَعۡمَلُونَ",
          "Arti_kata": "kamu telah kerjakan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5666,
      "Ayat_Arabic": "اِنَّا كَذٰلِكَ نَجْزِى الْمُحْسِنِيْنَ",
      "Text_Latin": "inna kazalika najzil-muhsinin",
      "Terjemah_in": "Sesungguhnya demikianlah Kami beri balasan kepada orang-orang yang berbuat baik.",
      "Terjemahan_En": "This is how We reward the doers of good.",
