    {
      "Nomor_ayat": 5668,
      "Ayat_Arabic": "كُلُوْا وَتَمَتَّعُوْا قَلِيْلًا اِنَّكُمْ مُّجْرِمُوْنَ",
      "Text_Latin": "kulu wa tamatta'u qalilan innakum mujrimun",
