          "Kata_Arabic": "ظِلَٰلٖ",
          "Arti_kata": "naungan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "وَعُيُونٖ",
          "Arti_kata": "dan mata air",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5664,
      "Ayat_Arabic": "وَّفَوَاكِهَ مِمَّا يَشْتَهُوْنَۗ",
      "Text_Latin": "wa fawakiha mimma yasytahun",
      "Terjemah_in": "serta buah-buahan yang mereka sukai.",
      "Terjemahan_En": "And fruits as they desire.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَفَوَٰكِهَ",
          "Arti_kata": "dan buah-buahan",
          "Jenis_kata": null
