          "Kata_Arabic": "لِّلۡمُكَذِّبِينَ",
          "Arti_kata": "bagi orang-orang yang mendustakan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5663,
      "Ayat_Arabic": "اِنَّ الْمُتَّقِيْنَ فِيْ ظِلٰلٍ وَّعُيُوْنٍۙ",
      "Text_Latin": "innal-muttaqina fi zilaliw wa 'uyun",
      "Terjemah_in": "Sesungguhnya orang-orang yang bertakwa berada dalam naungan (pepohonan surga yang teduh) dan (ada di sekitar) mata air",
      "Terjemahan_En": "The righteous will be amidst shades and fountains.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّ",
          "Arti_kata": "sesungguhnya",
          "Jenis_kata": null
