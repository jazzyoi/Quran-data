          "Kata_Arabic": "ٱلۡمُتَّقِينَ",
          "Arti_kata": "orang-orang yang bertakwa",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فِي",
          "Arti_kata": "dalam",
          "Jenis_kata": null
