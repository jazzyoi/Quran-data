{
  "Nomor_surat": 77,
  "Nama_surat": "Al-Mursalat",
  "surat_arabic": "المرسلات",
  "Arti_surat_in": "Malaikat-Malaikat Yang Diutus",
  "Arti_surat_en": "The Emissaries",
  "Ayat": [
    {
      "Nomor_ayat": 5623,
      "Ayat_Arabic": "وَالْمُرْسَلٰتِ عُرْفًاۙ",
      "Text_Latin": "wal-mursalati 'urfa",
      "Terjemah_in": "Demi (malaikat-malaikat) yang diutus untuk membawa kebaikan",
      "Terjemahan_En": "By those unleashed in succession.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلۡمُرۡسَلَٰتِ",
          "Arti_kata": "demi yang dikirim",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عُرۡفٗا",
          "Arti_kata": "kebaikan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5624,
      "Ayat_Arabic": "فَالْعٰصِفٰتِ عَصْفًاۙ",
      "Text_Latin": "fal-'asifati 'asfa",
      "Terjemah_in": "dan (malaikat-malaikat) yang terbang dengan kencang;",
      "Terjemahan_En": "Storming turbulently.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱلۡعَٰصِفَٰتِ",
          "Arti_kata": "lalu yang bertiup",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "عَصۡفٗا",
          "Arti_kata": "keras/kencang",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5625,
      "Ayat_Arabic": "وَّالنّٰشِرٰتِ نَشْرًاۙ",
      "Text_Latin": "wan-nasyirati nasyra",
      "Terjemah_in": "demi (malaikat-malaikat) yang menyebarkan (rahmat Allah) dengan seluas-luasnya,738)",
      "Terjemahan_En": "Scattering far and wide.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَٱلنَّٰشِرَٰتِ",
          "Arti_kata": "dan yang menyebarkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَشۡرٗا",
          "Arti_kata": "sebaran seluas-luasnya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5626,
      "Ayat_Arabic": "فَالْفٰرِقٰتِ فَرْقًاۙ",
      "Text_Latin": "fal-fariqati farqa",
      "Terjemah_in": "dan (malaikat-malaikat) yang membedakan (antara yang baik dan yang buruk) dengan sejelas-jelasnya,",
      "Terjemahan_En": "Separating decisively.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱلۡفَٰرِقَٰتِ",
          "Arti_kata": "lalu yang membedakan/memisahkan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فَرۡقٗا",
          "Arti_kata": "sebeda-bedanya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5627,
      "Ayat_Arabic": "فَالْمُلْقِيٰتِ ذِكْرًاۙ",
      "Text_Latin": "fal-mulqiyati zikra",
      "Terjemah_in": "serta (malaikat-malaikat) yang menyampaikan wahyu",
      "Terjemahan_En": "Delivering a message.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَٱلۡمُلۡقِيَٰتِ",
          "Arti_kata": "lalu yang menyampaikan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ذِكۡرًا",
          "Arti_kata": "peringatan/pengajaran",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5628,
      "Ayat_Arabic": "عُذْرًا اَوْ نُذْرًاۙ",
      "Text_Latin": "'uzran au nuzra",
      "Terjemah_in": "untuk (menolak) alasan atau (memberi) peringatan,",
      "Terjemahan_En": "Excusing or warning.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "عُذۡرًا",
          "Arti_kata": "alasan/pembelaan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَوۡ",
          "Arti_kata": "atau",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نُذۡرًا",
          "Arti_kata": "peringatan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5629,
      "Ayat_Arabic": "اِنَّمَا تُوْعَدُوْنَ لَوَاقِعٌۗ",
      "Text_Latin": "innama tu'aduna lawaqi'",
      "Terjemah_in": "sesungguhnya apa yang dijanjikan kepadamu pasti terjadi.",
      "Terjemahan_En": "Surely what you are promised will happen.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِنَّمَا",
          "Arti_kata": "sesungguhnya hanyalah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "تُوعَدُونَ",
          "Arti_kata": "kamu dijanjikan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لَوَٰقِعٞ",
          "Arti_kata": "pasti terjadi",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5630,
      "Ayat_Arabic": "فَاِذَا النُّجُوْمُ طُمِسَتْۙ",
      "Text_Latin": "fa izan-nujumu tumisat",
      "Terjemah_in": "Apabila bintang-bintang dihapuskan (cahayanya),",
      "Terjemahan_En": "When the stars are obliterated.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَإِذَا",
          "Arti_kata": "maka apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلنُّجُومُ",
          "Arti_kata": "bintang-bintang",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "طُمِسَتۡ",
          "Arti_kata": "dihapuskan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5631,
      "Ayat_Arabic": "وَاِذَا السَّمَاۤءُ فُرِجَتْۙ",
      "Text_Latin": "wa izas-sama'u furijat",
      "Terjemah_in": "apabila langit dibelah,",
      "Terjemahan_En": "And the sky is fractured.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata": "dan apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلسَّمَآءُ",
          "Arti_kata": "langit",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "فُرِجَتۡ",
          "Arti_kata": "dibelah",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5632,
      "Ayat_Arabic": "وَاِذَا الْجِبَالُ نُسِفَتْۙ",
      "Text_Latin": "wa izal-jibalu nusifat",
      "Terjemah_in": "apabila gunung-gunung dihancurleburkan,",
      "Terjemahan_En": "And the mountains are blown away.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata": "dan apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡجِبَالُ",
          "Arti_kata": "gunung-gunung",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "نُسِفَتۡ",
          "Arti_kata": "dihancurkan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5633,
      "Ayat_Arabic": "وَاِذَا الرُّسُلُ اُقِّتَتْۗ",
      "Text_Latin": "wa izar-rusulu uqqitat",
      "Terjemah_in": "dan apabila rasul-rasul telah ditetapkan waktunya,739)",
      "Terjemahan_En": "And the messengers are alerted.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَإِذَا",
          "Arti_kata": "dan apabila",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلرُّسُلُ",
          "Arti_kata": "rasul-rasul",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أُقِّتَتۡ",
          "Arti_kata": "ditetapkan waktunya",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5634,
      "Ayat_Arabic": "لِاَيِّ يَوْمٍ اُجِّلَتْۗ",
      "Text_Latin": "li'ayyi yaumin ujjilat",
      "Terjemah_in": "(niscaya dikatakan kepada mereka,) “Sampai hari apakah ditangguhkan (azab orang kafir itu)?”",
      "Terjemahan_En": "Until which day is it deferred?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لِأَيِّ",
          "Arti_kata": "untuk manakah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمٍ",
          "Arti_kata": "hari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "أُجِّلَتۡ",
          "Arti_kata": "ditentukan/ditangguhkan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5635,
      "Ayat_Arabic": "لِيَوْمِ الْفَصْلِۚ",
      "Text_Latin": "liyaumil-fasl",
      "Terjemah_in": "Sampai hari Keputusan.",
      "Terjemahan_En": "Until the Day of Decision.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "لِيَوۡمِ",
          "Arti_kata": "untuk/sampai hari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡفَصۡلِ",
          "Arti_kata": "keputusan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5636,
      "Ayat_Arabic": "وَمَآ اَدْرٰىكَ مَا يَوْمُ الْفَصْلِۗ",
      "Text_Latin": "wa ma adraka ma yaumul-fasl",
      "Terjemah_in": "Tahukah kamu apakah hari Keputusan itu?",
      "Terjemahan_En": "And what will teach you what the Day of Decision is?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَآ",
          "Arti_kata": "dan apakah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَدۡرَىٰكَ",
          "Arti_kata": "tahukah kamu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata": "apakah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "يَوۡمُ",
          "Arti_kata": "hari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡفَصۡلِ",
          "Arti_kata": "keputusan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5637,
      "Ayat_Arabic": "وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ",
      "Text_Latin": "wailuy yauma'izil lil-mukazzibin",
      "Terjemah_in": "Celakalah pada hari itu para pendusta (kebenaran).",
      "Terjemahan_En": "Woe on that Day to the liars.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَيۡلٞ",
          "Arti_kata": "kecelakaan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمَئِذٖ",
          "Arti_kata": "pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لِّلۡمُكَذِّبِينَ",
          "Arti_kata": "bagi orang-orang yang mendustakan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5638,
      "Ayat_Arabic": "اَلَمْ نُهْلِكِ الْاَوَّلِيْنَۗ",
      "Text_Latin": "a lam nuhlikil-awwalin",
      "Terjemah_in": "Bukankah Kami telah membinasakan orang-orang dahulu?",
      "Terjemahan_En": "Did We not destroy the ancients?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَلَمۡ",
          "Arti_kata": "tidaklah/bukanlah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نُهۡلِكِ",
          "Arti_kata": "Kami telah membinasakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡأَوَّلِينَ",
          "Arti_kata": "orang-orang yang dahulu",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5639,
      "Ayat_Arabic": "ثُمَّ نُتْبِعُهُمُ الْاٰخِرِيْنَ",
      "Text_Latin": "summa nutbi'uhumul-akhirin",
      "Terjemah_in": "Lalu, Kami susuli mereka dengan (mengazab) orang-orang yang datang kemudian.",
      "Terjemahan_En": "Then succeeded them with the others?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ثُمَّ",
          "Arti_kata": "kemudian",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نُتۡبِعُهُمُ",
          "Arti_kata": "Kami ikutkan/iringi mereka",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلۡأٓخِرِينَ",
          "Arti_kata": "orang-orang yang kemudian",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5640,
      "Ayat_Arabic": "كَذٰلِكَ نَفْعَلُ بِالْمُجْرِمِيْنَ",
      "Text_Latin": "kazalika naf'alu bil-mujrimin",
      "Terjemah_in": "Demikianlah Kami memperlakukan para pendurhaka.",
      "Terjemahan_En": "This is how We deal with the guilty.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "كَذَٰلِكَ",
          "Arti_kata": "seperti demikianlah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَفۡعَلُ",
          "Arti_kata": "Kami berbuat",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "بِٱلۡمُجۡرِمِينَ",
          "Arti_kata": "terhadap orang-orang berdosa",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5641,
      "Ayat_Arabic": "وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ",
      "Text_Latin": "wailuy yauma'izil lil-mukazzibin",
      "Terjemah_in": "Celakalah pada hari itu para pendusta (kebenaran).",
      "Terjemahan_En": "Woe on that Day to the rejecters.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَيۡلٞ",
          "Arti_kata": "kecelakaan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَوۡمَئِذٖ",
          "Arti_kata": "pada hari itu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "لِّلۡمُكَذِّبِينَ",
          "Arti_kata": "bagi orang-orang yang mendustakan",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5642,
      "Ayat_Arabic": "اَلَمْ نَخْلُقْكُّمْ مِّنْ مَّاۤءٍ مَّهِيْنٍۙ",
      "Text_Latin": "a lam nakhlukkum mim ma'im mahin",
      "Terjemah_in": "Bukankah Kami menciptakanmu dari air yang hina (mani)?",
      "Terjemahan_En": "Did We not create you from an insignificant fluid?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "أَلَمۡ",
          "Arti_kata": "tidaklah/bukankah",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "نَخۡلُقكُّم",
          "Arti_kata": "Kami menciptakan",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مِّن",
          "Arti_kata": "dari",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَّآءٖ",
          "Arti_kata": "air",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "مَّهِينٖ",
          "Arti_kata": "yang hina",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5643,
      "Ayat_Arabic": "فَجَعَلْنٰهُ فِيْ قَرَارٍ مَّكِيْنٍ",
      "Text_Latin": "fa ja'alnahu fi qararim makin",
      "Terjemah_in": "Kemudian, Kami meletakkannya di dalam tempat yang kukuh (rahim)",
      "Terjemahan_En": "Then lodged it in a secure place?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَجَعَلۡنَٰهُ",
          "Arti_kata": "lalu Kami jadikannya",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فِي",
          "Arti_kata": "dalam",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "قَرَارٖ",
          "Arti_kata": "tempat",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَّكِينٍ",
          "Arti_kata": "kokoh",
          "Jenis_kata": null
        }
      ]
    },
    {
      "Nomor_ayat": 5644,
      "Ayat_Arabic": "اِلٰى قَدَرٍ مَّعْلُوْمٍۙ",
      "Text_Latin": "ila qadarim ma'lum",
      "Terjemah_in": "sampai waktu yang ditentukan.",
      "Terjemahan_En": "For a known term?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "إِلَىٰ",
          "Arti_kata": "kepada/sampai",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "قَدَرٖ",
          "Arti_kata": "ketentuan/waktu",
          "Jenis_kata": null
        },
        {
          "Nomor_kata": 3,
