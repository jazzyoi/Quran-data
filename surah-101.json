{
  "Nomor_surat": 101,
  "Nama_surat": "Al-Qari'ah",
  "surat_arabic": "القارعة",
  "Arti_surat_in": "Hari Kiamat",
  "Arti_surat_en": "The Calamity",
  "Ayat": [
    {
      "Nomor_ayat": 6158,
      "Ayat_Arabic": "اَلْقَارِعَةُۙ",
      "Text_Latin": "al-qari'ah",
      "Terjemah_in": "Al-Qāri‘ah (hari Kiamat yang menggetarkan).",
      "Terjemahan_En": "The Shocker.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "ٱلۡقَارِعَةُ",
          "Arti_kata_in": "hari kiamat",
          "Arti_kata_en": "The Striking Calamity!",
          "Text_Latin": "al-qari'atu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6159,
      "Ayat_Arabic": "مَا الْقَارِعَةُ ۚ",
      "Text_Latin": "mal-qari'ah",
      "Terjemah_in": "Apakah al-Qāri‘ah itu?",
      "Terjemahan_En": "What is the Shocker?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apakah",
          "Arti_kata_en": "What",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡقَارِعَةُ",
          "Arti_kata_in": "hari kiamat",
          "Arti_kata_en": "(is) the Striking Calamity",
          "Text_Latin": "al-qari'atu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6160,
      "Ayat_Arabic": "وَمَآ اَدْرٰىكَ مَا الْقَارِعَةُ ۗ",
      "Text_Latin": "wa ma adraka mal-qari'ah",
      "Terjemah_in": "Tahukah kamu apakah al-Qāri‘ah itu?",
      "Terjemahan_En": "What will explain to you what the Shocker is?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَآ",
          "Arti_kata_in": "dan apakah",
          "Arti_kata_en": "And what",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَدۡرَىٰكَ",
          "Arti_kata_in": "kamu tahu",
          "Arti_kata_en": "will make you know",
          "Text_Latin": "adraka",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡقَارِعَةُ",
          "Arti_kata_in": "hari kiamat",
          "Arti_kata_en": "(is) the Striking Calamity",
          "Text_Latin": "al-qari'atu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6161,
      "Ayat_Arabic": "يَوْمَ يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِۙ",
      "Text_Latin": "yauma yakunun-nasu kal-farasyil-mabsus",
      "Terjemah_in": "Pada hari itu manusia seperti laron yang beterbangan",
      "Terjemahan_En": "The Day when the people will be like scattered moths.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "يَوۡمَ",
          "Arti_kata_in": "hari",
          "Arti_kata_en": "(The) Day",
          "Text_Latin": "yawma",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "يَكُونُ",
          "Arti_kata_in": "adalah",
          "Arti_kata_en": "will be",
          "Text_Latin": "yakunu",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ٱلنَّاسُ",
          "Arti_kata_in": "manusia",
          "Arti_kata_en": "the mankind",
          "Text_Latin": "an-nasu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "كَٱلۡفَرَاشِ",
          "Arti_kata_in": "seperti anai-anai",
          "Arti_kata_en": "like moths",
          "Text_Latin": "kal-farashi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 5,
          "Kata_Arabic": "ٱلۡمَبۡثُوثِ",
          "Arti_kata_in": "bertebaran",
          "Arti_kata_en": "scattered",
          "Text_Latin": "al-mabthuthi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6162,
      "Ayat_Arabic": "وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِۗ",
      "Text_Latin": "wa takunul-jibalu kal-'ihnil-manfusy",
      "Terjemah_in": "dan gunung-gunung seperti bulu yang berhamburan.",
      "Terjemahan_En": "And the mountains will be like tufted wool.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَتَكُونُ",
          "Arti_kata_in": "dan adalah",
          "Arti_kata_en": "And will be",
          "Text_Latin": "watakunu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "ٱلۡجِبَالُ",
          "Arti_kata_in": "gunung-gunung",
          "Arti_kata_en": "the mountains",
          "Text_Latin": "al-jibalu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "كَٱلۡعِهۡنِ",
          "Arti_kata_in": "seperti bulu",
          "Arti_kata_en": "like wool",
          "Text_Latin": "kal-'ih'ni",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "ٱلۡمَنفُوشِ",
          "Arti_kata_in": "dihambur-hamburkan",
          "Arti_kata_en": "fluffed up",
          "Text_Latin": "al-manfushi",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6163,
      "Ayat_Arabic": "فَاَمَّا مَنْ ثَقُلَتْ مَوَازِينُهٗۙ",
      "Text_Latin": "fa amma man saqulat mawazinuh",
      "Terjemah_in": "Siapa yang berat timbangan (kebaikan)-nya,",
      "Terjemahan_En": "As for he whose scales are heavy.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأَمَّا",
          "Arti_kata_in": "maka adapun",
          "Arti_kata_en": "Then as for",
          "Text_Latin": "fa-amma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَن",
          "Arti_kata_in": "siapa/orang",
          "Arti_kata_en": "(him) whose",
          "Text_Latin": "man",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "ثَقُلَتۡ",
          "Arti_kata_in": "berat",
          "Arti_kata_en": "are heavy",
          "Text_Latin": "thaqulat",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَوَٰزِينُهُۥ",
          "Arti_kata_in": "timbangannya",
          "Arti_kata_en": "his scales",
          "Text_Latin": "mawazinuhu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6164,
      "Ayat_Arabic": "فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍۗ",
      "Text_Latin": "fa huwa fi 'isyatir radiyah",
      "Terjemah_in": "dia berada dalam kehidupan yang menyenangkan.",
      "Terjemahan_En": "He will be in a pleasant life.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَهُوَ",
          "Arti_kata_in": "maka dia",
          "Arti_kata_en": "Then he",
          "Text_Latin": "fahuwa",
          "Jenis_kata": "Fiil Madhi"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "فِي",
          "Arti_kata_in": "dalam",
          "Arti_kata_en": "(will be) in",
          "Text_Latin": "fi",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "عِيشَةٖ",
          "Arti_kata_in": "kehidupan",
          "Arti_kata_en": "a life",
          "Text_Latin": "ishatin",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "رَّاضِيَةٖ",
          "Arti_kata_in": "memuaskan",
          "Arti_kata_en": "pleasant",
          "Text_Latin": "radiyatin",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6165,
      "Ayat_Arabic": "وَاَمَّا مَنْ خَفَّتْ مَوَازِيْنُهٗۙ",
      "Text_Latin": "wa amma man khaffat mawazinuh",
      "Terjemah_in": "Adapun orang yang ringan timbangan (kebaikan)-nya,",
      "Terjemahan_En": "But as for he whose scales are light.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَأَمَّا",
          "Arti_kata_in": "dan adapun",
          "Arti_kata_en": "But as for",
          "Text_Latin": "wa-amma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "مَنۡ",
          "Arti_kata_in": "orang",
          "Arti_kata_en": "(him) whose",
          "Text_Latin": "man",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "خَفَّتۡ",
          "Arti_kata_in": "ringan",
          "Arti_kata_en": "are light",
          "Text_Latin": "khaffat",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "مَوَٰزِينُهُۥ",
          "Arti_kata_in": "timbangannya",
          "Arti_kata_en": "his scales",
          "Text_Latin": "mawazinuhu",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6166,
      "Ayat_Arabic": "فَاُمُّهٗ هَاوِيَةٌ  ۗ",
      "Text_Latin": "fa ummuhu hawiyah",
      "Terjemah_in": "tempat kembalinya adalah (neraka) Hawiyah.",
      "Terjemahan_En": "His home is the Abyss.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "فَأُمُّهُۥ",
          "Arti_kata_in": "maka tempat kembalinya",
          "Arti_kata_en": "His abode",
          "Text_Latin": "fa-ummuhu",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "هَاوِيَةٞ",
          "Arti_kata_in": "jurang yang dalam/neraka Hawiyah",
          "Arti_kata_en": "(will be the) Pit",
          "Text_Latin": "hawiyatun",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6167,
      "Ayat_Arabic": "وَمَآ اَدْرٰىكَ مَا هِيَهْۗ",
      "Text_Latin": "wa ma adraka ma hiyah",
      "Terjemah_in": "Tahukah kamu apakah (neraka Hawiyah) itu?",
      "Terjemahan_En": "Do you know what it is?",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "وَمَآ",
          "Arti_kata_in": "dan apakah",
          "Arti_kata_en": "And what",
          "Text_Latin": "wama",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "أَدۡرَىٰكَ",
          "Arti_kata_in": "kamu tahu",
          "Arti_kata_en": "will make you know",
          "Text_Latin": "adraka",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 3,
          "Kata_Arabic": "مَا",
          "Arti_kata_in": "apa",
          "Arti_kata_en": "what",
          "Text_Latin": "ma",
          "Jenis_kata": "Isim"
        },
        {
          "Nomor_kata": 4,
          "Kata_Arabic": "هِيَهۡ",
          "Arti_kata_in": "itu",
          "Arti_kata_en": "it is",
          "Text_Latin": "hiyah",
          "Jenis_kata": "Isim"
        }
      ]
    },
    {
      "Nomor_ayat": 6168,
      "Ayat_Arabic": "نَارٌ حَامِيَةٌ ࣖ",
      "Text_Latin": "narun hamiyah",
      "Terjemah_in": "(Ia adalah) api yang sangat panas.",
      "Terjemahan_En": "A Raging Fire.",
      "Kata": [
        {
          "Nomor_kata": 1,
          "Kata_Arabic": "نَارٌ",
          "Arti_kata_in": "api",
          "Arti_kata_en": "A Fire",
          "Text_Latin": "narun",
          "Jenis_kata": "Fiil Mudhorik"
        },
        {
          "Nomor_kata": 2,
          "Kata_Arabic": "حَامِيَةُۢ",
          "Arti_kata_in": "sangat panas",
          "Arti_kata_en": "intensely hot",
          "Text_Latin": "hamiyatun",
          "Jenis_kata": "Isim"
        }
      ]
    }
  ]
}